local R=require('../src/ReplicatedStorage/Shared/TaxiRules')
local n=0;local function check(value,name)n+=1;assert(value,name)end
check(R.fare(100,25,.05)==30,'fare uses server distance')
check(R.fare(101,25,.05)==31,'fare rounds up whole currency')
check(not R.fare(0/0,25,.05),'invalid fare distance rejected')
check(not R.fare(-1,25,.05),'negative distance rejected')
check(not R.fare(100,math.huge,.05),'infinite amount rejected')
check(R.plausible(20,.5,76),'normal movement sample accepted')
check(not R.plausible(500,.25,76),'teleport rejected')
check(not R.plausible(10,-1,76),'reversed clock rejected')
check(not R.plausible(0/0,1,76),'invalid movement rejected')
check(R.canServe(true,true,18,5,18),'parked service at boundary accepted')
check(not R.canServe(false,true,0,0,18),'no role no pickup')
check(not R.canServe(true,false,0,0,18),'must be actual driver')
check(not R.canServe(true,true,19,0,18),'far destination denied')
check(not R.canServe(true,true,0,5.1,18),'must park before service')
check(R.canFinish('dropoff',10,300,300,76,18),'completed real route accepted')
check(not R.canFinish('pickup',10,300,300,76,18),'cannot finish before boarding')
check(not R.canFinish('dropoff',.01,300,300,76,18),'instant arrival denied')
check(not R.canFinish('dropoff',10,300,100,76,18),'insufficient traveled distance denied')
check(not R.canFinish('dropoff',10,0/0,300,76,18),'invalid route rejected')
print('PASS TaxiRules: '..n..' checks')
