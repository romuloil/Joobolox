</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000004"><Properties><string name="Name">DialogConfig</string><ProtectedString name="Source">-- DialogConfig (ModuleScript)
-- Caminho: ReplicatedStorage &gt; Shared &gt; DialogConfig
-- Todas as falas dos NPCs e do tutorial. Para mudar um texto, mude só aqui.

local DialogConfig = {}

-- Primeira vez no jogo
DialogConfig.Welcome = {
	"Olá! Eu sou o Seu Bento. Seja muito bem-vindo a Little Little Kinder!",
	"Aqui você escolhe uma profissão, ganha dinheiro, cuida da sua casa e faz amigos.",
	"Você ganhou uma bicicleta! Toque no botão Bicicleta (ou aperte B) quando quiser pedalar.",
	"Quer que eu te mostre a cidade rapidinho?",
}

-- Quando o jogador conversa com o Seu Bento depois
DialogConfig.GuideTalk = {
	"Olá de novo! Quer rever a cidade ou saber dos empregos?",
}

-- Quando o jogador pergunta sobre empregos
DialogConfig.JobsInfo = {
	"O quadro de empregos fica aqui na praça, do outro lado do ponto onde você nasce. É só chegar perto e escolher!",
	"Tem vaga de Pizzaiolo na La Paulistana, Atendente no Minas Market e Entregador na Sherlex.",
	"Para trabalhar como taxista, vá à sede amarela da LXR Táxis. O plantão policial começa na delegacia ou na prisão.",
	"Cada profissão tem seu uniforme. Retire o seu no local de trabalho; táxi e viatura também saem da garagem da profissão.",
	"Cada pedido concluído paga na hora. Para largar o emprego, toque em Sair na faixa laranja.",
}

-- Fala final (depois do tour ou de recusar o tour)
DialogConfig.Final = {
	"Se se perder, toque no botãozinho de mapa lá no alto da tela (ou aperte M) para ver onde fica cada lugar.",
	"Para ir longe rápido, use o botão Carro (ou a tecla V). Nas placas verdes das esquinas tem o nome de cada rua.",
	"Quer ganhar dinheiro? O quadro de empregos fica aqui na praça, pertinho de mim.",
}

-- Tour: primeiro a vista do alto, depois cada estabelecimento (pelo nome da placa)
DialogConfig.TourIntro = "Este é o nosso bairro! Tudo começa aqui na rotatória da praça."
DialogConfig.TourStops = {
	{ place = "La Paulistana", text = "La Paulistana: a melhor pizza da cidade. Aqui você poderá trabalhar como pizzaiolo." },
	{ place = "Minas Market", text = "Minas Market: a mercearia do bairro. Precisa de gente para repor as prateleiras!" },
	{ place = "Sherlex", text = "Sherlex: a empresa de entregas. Com a sua bicicleta você já consegue entregar pacotes." },
	{ place = "Duto Pet Shop", text = "Duto Pet Shop: aqui a gente dá banho e cuida dos bichinhos da cidade." },
}

return DialogConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000005"><Properties><string name="Name">GameConfig</string><ProtectedString name="Source">-- GameConfig (ModuleScript)
-- Caminho: ReplicatedStorage &gt; Shared &gt; GameConfig
-- Configurações centrais do jogo. Servidor e cliente leem daqui.
-- Mude valores aqui em vez de espalhar números pelos scripts.

local GameConfig = {}

GameConfig.GameName = "Little Life: Minha Cidade"
GameConfig.CityName = "Little Little Kinder"
GameConfig.Version = "Marco 5.3 — LXR Táxis e Profissões"

-- Nomes oficiais (documento mestre, seção 5)
GameConfig.Places = {
	Pizzaria = "La Paulistana",
	Mercearia = "Minas Market",
	Entregas = "Sherlex",
	PetShop = "Duto Pet Shop",
	Onibus = "Um Tijo",
	Bombeiros = "Corpo de Bombeiros de Little Little Kinder",
	Policia = "Centro Policial de Little Little Kinder",
	Banco = "Banco Nacional de Little Little Kinder",
	Taxi = "LXR Táxis",
}

-- Nomes dos RemoteEvents (criados pelo servidor em ReplicatedStorage &gt; Remotes)
GameConfig.Remotes = {
	VehicleRequest = "VehicleRequest", -- cliente pede para montar/desmontar a bicicleta
	UIUpdate = "UIUpdate", -- servidor avisa a interface sobre mudanças
	TutorialRequest = "TutorialRequest", -- cliente avisa que está pronto / terminou o tutorial
	JobRequest = "JobRequest", -- cliente pede para entrar/sair de um emprego
	PoliceRequest = "PoliceRequest", -- intenções policiais, sempre validadas no servidor
	TaxiRequest = "TaxiRequest", -- serviço LXR, validado no servidor
}

-- Economia (valores PROVISÓRIOS, ajustar depois de testar)
GameConfig.Economy = {
	CurrencySymbol = "$",
	StartingMoney = 100, -- dinheiro de quem entra pela primeira vez
	MaxMoney = 1000000000, -- limite de segurança
}

-- Bônus diário (regra confirmada: 24h contadas a partir do resgate; o valor é PROVISÓRIO)
GameConfig.DailyBonus = {
	Amount = 50,
	Cooldown = 24 * 60 * 60, -- segundos
}

-- Salvamento (DataStore). Mudar o nome da store APAGA o progresso salvo de todos.
GameConfig.Data = {
	StoreName = "LittleLifePlayerData_v1",
	AutosaveInterval = 120, -- segundos entre salvamentos automáticos
	Retries = 3, -- tentativas antes de desistir de carregar/salvar
}

-- NPC guia da praça
GameConfig.Guide = {
	Name = "Seu Bento",
	Position = Vector3.new(8, 0, 24), -- perto do spawn, na praça (fora do anel de flores)
	TalkDistance = 12, -- distância máxima (studs) para conversar
	SkinColor = Color3.fromRGB(205, 150, 110),
	ShirtColor = Color3.fromRGB(240, 170, 60),
	PantsColor = Color3.fromRGB(60, 80, 120),
}

-- Personagem
GameConfig.WalkSpeed = 16 -- velocidade normal a pé (padrão do Roblox)

-- Bicicleta inicial (gratuita para todos)
GameConfig.Bike = {
	Speed = 30, -- velocidade enquanto pedala
	ToggleCooldown = 1, -- segundos mínimos entre montar e desmontar
	FrameColor = Color3.fromRGB(46, 160, 220), -- quadro
	AccentColor = Color3.fromRGB(60, 45, 35), -- selim e manoplas
	WheelColor = Color3.fromRGB(30, 30, 34), -- pneus e pedais
	MetalColor = Color3.fromRGB(190, 190, 198), -- raios, guidão, pedivela
	WheelRadius = 0.85,
	SeatOffsetY = 0, -- sobe (+) ou desce (-) o selim se o personagem ficar flutuando ou afundado
	PedalSpeed = 0.45, -- voltas do pedal por volta da roda
}

-- Veículo pessoal do protótipo e sedãs exclusivos dos empregos.
-- Cada carro é só dados: o CarBuilder monta pelo tamanho e cores daqui. Novos carros = nova entrada.
-- Esportivo baixo em cunha inspirado no BMW i8 (pedido do Luís), com nome e marca próprios
-- (o Roblox não deixa usar marcas reais).
GameConfig.Cars = {
	Vortex = {
		Name = "Vortex Volt",
		Length = 17.5,
		Width = 7.6,
		BodyColor = Color3.fromRGB(38, 40, 46), -- grafite fosco
		TrimColor = Color3.fromRGB(12, 12, 14), -- teto, asas, para-choques (preto brilhante)
		AccentColor = Color3.fromRGB(0, 150, 255), -- detalhes azuis
		GlassColor = Color3.fromRGB(30, 38, 48),
		RimColor = Color3.fromRGB(200, 30, 35), -- rodas vermelhas
		CaliperColor = Color3.fromRGB(60, 60, 66),
		SeatColor = Color3.fromRGB(60, 45, 40),
		Reflectance = 0.05,
		WheelRadius = 1.5,
		MaxSpeed = 85, -- studs/s (a bike faz 30)
		ReverseSpeed = 22,
		Acceleration = 32,
		Brake = 70,
		Drag = 14, -- quanto perde de velocidade sem acelerar
		TurnRate = 1.8, -- giro em radianos/s
		Hover = 2.0, -- altura do centro do chassi acima do chão
	},
}
-- Sedãs de serviço: somente as garagens dos respectivos empregos os liberam.
local function serviceSedan(name, role, bodyColor, maxSpeed)
	return {
		Name = name, Role = role, Style = "Sedan", Length = 18.6, Width = 7.6,
		BodyColor = bodyColor, TrimColor = Color3.fromRGB(25, 29, 34),
		AccentColor = role == "Taxista" and Color3.fromRGB(27, 79, 150) or Color3.fromRGB(235, 237, 240),
		GlassColor = Color3.fromRGB(112, 153, 180), RimColor = Color3.fromRGB(193, 200, 207),
		CaliperColor = Color3.fromRGB(60, 65, 70), SeatColor = Color3.fromRGB(37, 42, 47),
		Reflectance = 0.04, WheelRadius = 1.35, MaxSpeed = maxSpeed, ReverseSpeed = 19,
		Acceleration = 28, Brake = 72, Drag = 15, TurnRate = 1.65, Hover = 2.1,
	}
end
GameConfig.Cars.Taxi = serviceSedan("LXR Táxi Cidade", "Taxista", Color3.fromRGB(246, 193, 38), 70)
GameConfig.Cars.Police = serviceSedan("Kinder Patrulha", "Policial", Color3.fromRGB(24, 66, 115), 80)
GameConfig.WorkCars = { Taxista = "Taxi", Policial = "Police" }
GameConfig.CarModel = "Vortex" -- carro que o botão "Carro" chama
GameConfig.CarCooldown = 2 -- segundos entre pedidos de chamar/sair do carro

-- Mapa do bairro inicial (medidas em studs; 1 stud ≈ 28 cm)
GameConfig.Map = {
	GroundSize = 2400, -- inclui a prisão afastada e sua estrada de acesso
	RoundaboutOuterRadius = 74, -- borda externa do asfalto da rotatória
	RoundaboutIslandRadius = 50, -- praça no meio (primeiro lugar que o jogador vê)
	RoadWidth = 24,
	RoadLength = 560, -- comprimento de cada rua que sai da rotatória (até o anel externo)
	InnerRingRadius = 330, -- anel de rua do meio (forma os quarteirões)
	SidewalkWidth = 6,
	TreeSeed = 2026, -- muda a posição das árvores aleatórias
	RandomTrees = 160,
	-- Nomes das ruas (1 a 8 = ruas que saem da praça; ímpares comerciais, pares residenciais)
	StreetNames = {
		"Avenida das Palmeiras", "Rua das Flores", "Avenida do Comércio", "Rua dos Ipês",
		"Avenida Central", "Rua das Acácias", "Avenida da Paz", "Rua do Sol",
	},
	InnerRingName = "Avenida Circular",
	OuterRingName = "Rua do Contorno",
}

-- Paleta (documento mestre, seção 3)
GameConfig.Colors = {
	Grass = Color3.fromRGB(106, 170, 74),
	GrassDark = Color3.fromRGB(84, 145, 60),
	Asphalt = Color3.fromRGB(70, 72, 78),
	Sidewalk = Color3.fromRGB(200, 196, 186),
	RoadLine = Color3.fromRGB(245, 245, 240),
	Trunk = Color3.fromRGB(110, 78, 50),
	Leaves = { Color3.fromRGB(70, 150, 60), Color3.fromRGB(90, 170, 70), Color3.fromRGB(60, 130, 55) },
	Walls = {
		Color3.fromRGB(245, 235, 215),
		Color3.fromRGB(240, 220, 190),
		Color3.fromRGB(215, 230, 240),
		Color3.fromRGB(240, 210, 200),
		Color3.fromRGB(225, 235, 210),
	},
	Roofs = {
		Color3.fromRGB(180, 70, 55),
		Color3.fromRGB(150, 90, 60),
		Color3.fromRGB(80, 90, 110),
		Color3.fromRGB(170, 110, 70),
	},
	Door = Color3.fromRGB(120, 80, 50),
	Window = Color3.fromRGB(160, 210, 240),
	Water = Color3.fromRGB(90, 170, 230),
	Flowers = { Color3.fromRGB(240, 90, 110), Color3.fromRGB(250, 210, 70), Color3.fromRGB(180, 110, 220) },
}

return GameConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000006"><Properties><string name="Name">JobConfig</string><ProtectedString name="Source">-- JobConfig (ModuleScript)
-- Caminho: ReplicatedStorage &gt; Shared &gt; JobConfig
-- Profissões (documento mestre, seção 7): vagas, pagamento e como cada pedido é montado.
-- Servidor e cliente leem daqui. Pagamentos são PROVISÓRIOS (seção 21).
--
-- Cada profissão tem makeOrder(rng, ctx), que sorteia um pedido e devolve:
--   { title, pay, tip, parTime, steps = { etapa, etapa, ... } }
-- Tipos de etapa:
--   * estação:  { station = "Forno", text, action, hold, carry, waitBefore, burnAfter, burn, reveal }
--   * coleta:   { kind = "collect", options = {estações}, need = {estação = quantidade}, text, hold, carry }
--               várias estações ficam ativas e o jogador precisa escolher as CERTAS
--               (ex.: ingredientes do sabor pedido). Escolha errada não conta.
--   * casa:     { point = ponto de entrega (dado pelo servidor), travel = true, ... }
-- Extras (qualquer etapa): onBegin / onDone / onCollect = nome de uma ação especial do servidor
--   (ex.: "customerCome" faz um cliente NPC entrar na loja), waitText = texto da espera,
--   count = mostra o progresso da coleta como "3/5 produtos".
-- carry = o que o jogador passa a segurar depois da etapa ("Dough", {kind="Crate", color=...}) ou false para largar.
-- tip = gorjeta paga se o pedido terminar em até parTime segundos (e a pizza não queimar).

local JobConfig = {}

JobConfig.Order = { "Pizzaiolo", "Atendente", "Entregador" }

---------------------------------------------------------------------------
-- Pizzaria
---------------------------------------------------------------------------

-- Poucos ingredientes: molho e queijo vão em todas; cada sabor tem só 1 ou 2 coberturas.
-- base = true: fica no grupo "BASE" da bancada (os outros ficam em "COBERTURAS").
JobConfig.Ingredients = {
	{ id = "Molho", label = "Molho", color = Color3.fromRGB(200, 40, 35), base = true },
	{ id = "Queijo", label = "Queijo", color = Color3.fromRGB(250, 215, 100), base = true },
	{ id = "Tomate", label = "Tomate", color = Color3.fromRGB(230, 60, 50) },
	{ id = "Manjericao", label = "Manjericão", color = Color3.fromRGB(60, 150, 60) },
	{ id = "Calabresa", label = "Calabresa", color = Color3.fromRGB(150, 50, 45) },
	{ id = "Presunto", label = "Presunto", color = Color3.fromRGB(240, 160, 160) },
	{ id = "Ovo", label = "Ovo", color = Color3.fromRGB(255, 250, 235) },
}

JobConfig.Flavors = {
	{ id = "Marguerita", label = "Marguerita", ingredients = { "Molho", "Queijo", "Tomate", "Manjericao" }, pay = 30 },
	{ id = "Calabresa", label = "Calabresa", ingredients = { "Molho", "Queijo", "Calabresa" }, pay = 30 },
	{ id = "Portuguesa", label = "Portuguesa", ingredients = { "Molho", "Queijo", "Presunto", "Ovo" }, pay = 35 },
}

local function ingredientById(id)
	for _, ing in ipairs(JobConfig.Ingredients) do
		if ing.id == id then
			return ing
		end
	end
end

local function pizzaOrder(rng)
	local flavor = JobConfig.Flavors[rng:NextInteger(1, #JobConfig.Flavors)]
	local options, need = {}, {}
	for _, ing in ipairs(JobConfig.Ingredients) do
		table.insert(options, "Ing_" .. ing.id)
	end
	for _, id in ipairs(flavor.ingredients) do
		need["Ing_" .. id] = 1
	end
	local name = "Pizza " .. flavor.label
	return {
		title = name,
		flavor = flavor.id, -- a tela mostra a comanda com o desenho e os ingredientes
		ingredients = flavor.ingredients,
		pay = flavor.pay,
		tip = 10,
		parTime = 90,
		steps = {
			{ station = "BalcaoPizza", text = "Novo pedido: " .. name .. "! Pegue a comanda no balcão", action = "Pegar comanda", hold = 0.5, onDone = "pizzaCustomerCome" },
			{ station = "Massa", text = "Pegue uma massa", action = "Pegar massa", hold = 0.6, carry = "Dough" },
			{ station = "MesaMontagem", text = "Abra a massa na mesa", action = "Abrir massa", hold = 1.5, carry = "RawPizza" },
			{ kind = "collect", options = options, need = need, text = "Monte a " .. flavor.label .. " (veja a comanda):", hold = 0.4, toppings = true },
			{ station = "Forno", text = "Coloque a pizza no forno", action = "Colocar no forno", hold = 0.8, carry = false },
			{
				station = "Forno",
				text = "Tire a pizza do forno antes que queime!",
				action = "Tirar do forno",
				hold = 0.6,
				waitBefore = 8, -- assando
				burnAfter = 15, -- segundos depois de pronta para queimar
				carry = "CookedPizza",
				burn = {
					carry = "BurntPizza",
					text = "A pizza queimou! Jogue no lixo e faça outra",
					steps = { { station = "Lixo", text = "Jogue a pizza queimada no lixo", action = "Jogar fora", hold = 0.5, carry = false } },
					restartAt = 2, -- volta para "pegar massa", com o mesmo sabor
				},
			},
			{ station = "Embalagem", text = "Coloque a pizza na caixa", action = "Embalar pizza", hold = 1, carry = "PizzaBox" },
			{ station = "BalcaoPizza", text = "Entregue a " .. name .. " no balcão", action = "Entregar pizza", hold = 0.6, carry = false, onDone = "pizzaCustomerReceive" },
		},
	}
end

---------------------------------------------------------------------------
-- Mercearia
---------------------------------------------------------------------------

JobConfig.Categories = {
	{ id = "Frutas", label = "Frutas", color = Color3.fromRGB(230, 70, 60), products = { "Maçã", "Banana", "Uva", "Laranja" } },
	{ id = "Bebidas", label = "Bebidas", color = Color3.fromRGB(70, 140, 220), products = { "Suco", "Leite", "Água", "Refri" } },
	{ id = "Limpeza", label = "Limpeza", color = Color3.fromRGB(110, 200, 210), products = { "Sabão", "Detergente", "Esponja" } },
	{ id = "Padaria", label = "Padaria", color = Color3.fromRGB(220, 170, 90), products = { "Pão", "Bolo", "Biscoito" } },
}

-- ctx.lane = número do caixa deste atendente (1 ou 2: cada atendente tem o seu)
local function marketOrder(rng, ctx)
	local lane = ctx.lane or 1
	local roll = rng:NextNumber()
	if roll &lt; 0.45 then
		-- Atender um cliente (NPC) que entra na loja e vem até o seu caixa
		local items = rng:NextInteger(3, 6)
		local total = 0
		local belt, need, products, rows = {}, {}, {}, {}
		for k = 1, items do
			local station = ("Esteira%d_%d"):format(lane, k)
			local cat = JobConfig.Categories[rng:NextInteger(1, #JobConfig.Categories)]
			local name = cat.products[rng:NextInteger(1, #cat.products)]
			local price = rng:NextInteger(3, 12)
			total += price
			table.insert(belt, station)
			need[station] = 1
			products[station] = { color = cat.color, label = name }
			-- cada produto vira uma linha da comanda (✓ quando passa no leitor)
			table.insert(rows, { label = ("%s  $%d"):format(name, price), color = cat.color, station = station, step = 2 })
		end
		table.insert(rows, { label = "Embalar na sacola", color = Color3.fromRGB(240, 240, 235), from = 3, to = 3 })
		table.insert(rows, { label = "Cobrar o cliente", color = Color3.fromRGB(120, 220, 140), from = 4, to = 4 })
		return {
			title = "Cliente no caixa " .. lane,
			card = { title = "Compras do cliente", footer = ("Total: $%d"):format(total), rows = rows },
			pay = 8 + 2 * items, -- tarefa mais fácil: paga menos que repor
			tip = 3,
			parTime = 55,
			steps = {
				{ station = "Checkout" .. lane, text = ("Vá para o caixa %d e chame o próximo cliente"):format(lane), action = "Chamar cliente", hold = 0.4, onDone = "customerCome", items = items },
				{ kind = "collect", options = belt, need = need, count = "produtos", products = products, text = "Passe as compras do cliente no leitor:", hold = 0.3, onBegin = "customerArrive", onCollect = "scanItem", waitText = "o cliente chega em" },
				{ station = "Bag" .. lane, text = "Coloque as compras na sacola", action = "Embalar compras", hold = 1.2, onDone = "customerBag" },
				{ station = "Checkout" .. lane, text = ("Cobre %s %d do cliente"):format("$", total), action = "Receber pagamento", hold = 0.8, onDone = "customerLeave" },
			},
		}
	elseif roll &lt; 0.8 then
		-- Repor 2 ou 3 prateleiras: caixa certa do estoque -&gt; prateleira -&gt; caixa vazia na reciclagem
		local pool = table.clone(JobConfig.Categories)
		local count = rng:NextInteger(2, 3)
		local cats = {}
		for _ = 1, count do
			table.insert(cats, table.remove(pool, rng:NextInteger(1, #pool)))
		end
		local options = {}
		for _, c in ipairs(JobConfig.Categories) do
			table.insert(options, "Caixa_" .. c.id)
		end
		local names, ids = {}, {}
		for _, cat in ipairs(cats) do
			table.insert(names, cat.label)
			table.insert(ids, cat.id)
		end
		local steps, rows = {}, {}
		for i, cat in ipairs(cats) do
			local first = #steps + 1
			table.insert(rows, { label = "Repor " .. cat.label, color = cat.color, from = first, to = first + 2 })
			local tag = ("(%d de %d) "):format(i, count)
			table.insert(steps, {
				kind = "collect",
				options = options,
				need = { ["Caixa_" .. cat.id] = 1 },
				text = tag .. "Pegue no estoque a caixa de " .. cat.label .. ":",
				hold = 0.6,
				carry = { kind = "Crate", color = cat.color },
				onBegin = i == 1 and "shelvesEmpty" or nil,
				cats = i == 1 and ids or nil,
			})
			table.insert(steps, { station = "Prateleira_" .. cat.id, text = tag .. "Reponha a prateleira de " .. cat.label, action = "Repor " .. cat.label, hold = 2.5, carry = "EmptyBox", onDone = "shelfFill", cat = cat.id })
			table.insert(steps, { station = "Reciclagem", text = tag .. "Jogue a caixa vazia na reciclagem", action = "Reciclar", hold = 0.5, carry = false })
		end
		return {
			title = "Repor " .. table.concat(names, ", "),
			card = { title = "Reposição", footer = "Caixa certa, prateleira, reciclagem", rows = rows },
			pay = 14 * count,
			tip = 3 * count,
			parTime = 28 * count,
			steps = steps,
		}
	end
	-- Limpar uma sujeira no chão
	local spill = rng:NextInteger(1, 3)
	return {
		title = "Limpeza",
		card = {
			title = "Limpeza",
			footer = "Procure a mancha laranja",
			rows = {
				{ label = "Pegar o esfregão", color = Color3.fromRGB(240, 200, 40), from = 1, to = 1 },
				{ label = "Limpar a sujeira", color = Color3.fromRGB(240, 150, 40), from = 2, to = 2 },
				{ label = "Guardar o esfregão", color = Color3.fromRGB(90, 160, 220), from = 3, to = 3 },
			},
		},
		pay = 20,
		tip = 5,
		parTime = 40,
		steps = {
			{ station = "Esfregao", text = "Derrubaram suco no chão! Pegue o esfregão", action = "Pegar esfregão", hold = 0.5, carry = "Mop" },
			{ station = "Sujeira_" .. spill, text = "Limpe a sujeira (procure a mancha laranja no chão)", action = "Limpar", hold = 3, reveal = true },
			{ station = "Esfregao", text = "Guarde o esfregão", action = "Guardar esfregão", hold = 0.5, carry = false },
		},
	}
end

---------------------------------------------------------------------------
-- Entregas
---------------------------------------------------------------------------

-- ctx.pickHouses(n) devolve n casas diferentes { point, address, position }; ctx.origin = posição do balcão
local function deliveryOrder(rng, ctx)
	local count = rng:NextInteger(1, 3)
	local houses = ctx.pickHouses(count)
	count = #houses
	local steps = {
		{ station = "BalcaoPacotes", text = ("Retire %d pacote%s no balcão"):format(count, count &gt; 1 and "s" or ""), action = "Retirar pacotes", hold = 0.8, carry = { kind = "Package", count = count } },
	}
	local route, last = 0, ctx.origin
	for i, house in ipairs(houses) do
		route += (house.position - last).Magnitude
		last = house.position
		local left = count - i
		table.insert(steps, {
			point = house.point,
			text = ("Entregue o pacote %d de %d em %s (veja no Mapa)"):format(i, count, house.address),
			action = "Entregar pacote",
			hold = 0.8,
			travel = true,
			onDone = "deliveryThanks", -- o morador abre a porta e recebe o pacote
			carry = left &gt; 0 and { kind = "Package", count = left } or false,
		})
	end
	return {
		title = count &gt; 1 and ("Rota de %d entregas"):format(count) or "Entrega",
		pay = 12 * count + math.floor(route * 0.03),
		tip = 4 * count,
		parTime = route / 22 + 15,
		steps = steps,
	}
end

---------------------------------------------------------------------------
-- Profissões
---------------------------------------------------------------------------

JobConfig.Jobs = {
	Pizzaiolo = {
		Name = "Pizzaiolo",
		Place = "La Paulistana",
		Slots = 2,
		PayText = "$30 a $35 por pizza + gorjeta",
		Color = Color3.fromRGB(200, 50, 45),
		Description = "Faça Marguerita, Calabresa ou Portuguesa com os ingredientes certos. Não deixe queimar!",
		makeOrder = pizzaOrder,
	},
	Atendente = {
		Name = "Atendente",
		Place = "Minas Market",
		Slots = 2,
		Lanes = true, -- cada atendente fica com um caixa (1 ou 2)
		PayText = "$14 a $42 por tarefa + gorjeta",
		Color = Color3.fromRGB(40, 140, 70),
		Description = "Atenda clientes no caixa, reponha 2 ou 3 prateleiras com as caixas certas e limpe a loja.",
		makeOrder = marketOrder,
	},
	Entregador = {
		Name = "Entregador Sherlex",
		Place = "Sherlex",
		Slots = 2,
		PayText = "$15+ por pacote, mais longe paga mais",
		Color = Color3.fromRGB(240, 140, 30),
		Description = "Rotas de 1 a 3 pacotes para endereços da cidade (rua e número). Vá de bike ou de carro!",
		makeOrder = deliveryOrder,
	},
}

-- Nome que aparece no botão de cada estação de coleta
function JobConfig.optionLabel(station)
	local ing = station:match("^Ing_(.+)$")
	if ing then
		local data = ingredientById(ing)
		return "Colocar " .. (data and data.label or ing)
	end
	local cat = station:match("^Caixa_(.+)$")
	if cat then
		return "Pegar caixa de " .. cat
	end
	if station:match("^Esteira") then
		return "Passar no leitor"
	end
	return "Usar"
end

-- Nome curto de uma estação na lista de "precisa" (ex.: "Queijo")
function JobConfig.shortLabel(station)
	local ing = station:match("^Ing_(.+)$")
	if ing then
		local data = ingredientById(ing)
		return data and data.label or ing
	end
	return station:match("^Caixa_(.+)$") or station
end

JobConfig.ingredientById = ingredientById

-- Regras gerais
JobConfig.InteractDistance = 12 -- distância máxima (studs) que o servidor aceita para uma interação
JobConfig.BoardDistance = 14 -- distância máxima do quadro de empregos para pegar um emprego
JobConfig.NextOrderDelay = 2 -- segundos entre terminar um pedido e começar o próximo
JobConfig.MinStepSeconds = 0.3 -- tempo mínimo entre duas ações (evita cliques automáticos)
JobConfig.TravelSpeed = 95 -- velocidade máxima aceita (studs/s) em etapas de viagem; a bike faz 30 e o carro até 80

-- Posição do quadro de empregos na praça (lado oposto ao Seu Bento)
JobConfig.BoardPosition = Vector3.new(-9, 0, 21)

return JobConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000007"><Properties><string name="Name">PizzaArt</string><ProtectedString name="Source">-- PizzaArt (ModuleScript)
-- Caminho: ReplicatedStorage &gt; Shared &gt; PizzaArt
-- Desenhos simples de pizza e de ingredientes feitos só com Frames (sem imagens enviadas).
-- Usado no cardápio da pizzaria (SurfaceGui, servidor) e na comanda da tela (cliente).
-- Tudo em escala: o desenho ocupa o Frame "parent" inteiro, de qualquer tamanho.

local PizzaArt = {}

local CRUST = Color3.fromRGB(215, 150, 70)
local SAUCE = Color3.fromRGB(200, 45, 35)
local CHEESE = Color3.fromRGB(250, 215, 100)

local function circle(parent, cx, cy, size, color, z)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(cx, cy)
	f.Size = UDim2.fromScale(size, size)
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.ZIndex = z or 2
	f.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = f
	return f
end

local function rect(parent, cx, cy, w, h, color, rotation, z, round)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(cx, cy)
	f.Size = UDim2.fromScale(w, h)
	f.Rotation = rotation or 0
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.ZIndex = z or 2
	f.Parent = parent
	if round then
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(round, 0)
		c.Parent = f
	end
	return f
end

local function ring(parent, cx, cy, size, color, z)
	local f = circle(parent, cx, cy, size, color, z)
	f.BackgroundTransparency = 1
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = 2
	s.Parent = f
	return f
end

-- Mantém o desenho quadrado dentro de qualquer Frame
local function square(parent)
	local holder = Instance.new("Frame")
	holder.Name = "Art"
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.Size = UDim2.fromScale(1, 1)
	holder.Parent = parent
	local ratio = Instance.new("UIAspectRatioConstraint")
	ratio.AspectRatio = 1
	ratio.Parent = holder
	return holder
end

---------------------------------------------------------------------------
-- Cada ingrediente desenhado num ponto (cx, cy) com tamanho s (frações do desenho)
---------------------------------------------------------------------------

local DRAW = {
	Molho = function(p, cx, cy, s, z)
		circle(p, cx, cy, s, SAUCE, z)
		circle(p, cx - s * 0.18, cy - s * 0.18, s * 0.25, Color3.fromRGB(235, 90, 70), z + 1)
	end,
	Queijo = function(p, cx, cy, s, z)
		rect(p, cx, cy, s, s * 0.75, CHEESE, -10, z, 0.15)
		circle(p, cx - s * 0.2, cy, s * 0.18, Color3.fromRGB(225, 180, 60), z + 1)
		circle(p, cx + s * 0.22, cy - s * 0.15, s * 0.13, Color3.fromRGB(225, 180, 60), z + 1)
	end,
	Tomate = function(p, cx, cy, s, z)
		circle(p, cx, cy, s, Color3.fromRGB(225, 50, 45), z)
		circle(p, cx, cy, s * 0.6, Color3.fromRGB(245, 110, 90), z + 1)
		circle(p, cx, cy, s * 0.15, Color3.fromRGB(250, 220, 140), z + 2)
	end,
	Manjericao = function(p, cx, cy, s, z)
		rect(p, cx, cy, s * 0.55, s, Color3.fromRGB(50, 150, 55), 40, z, 1)
		rect(p, cx, cy, s * 0.06, s * 0.8, Color3.fromRGB(90, 190, 90), 40, z + 1)
	end,
	Calabresa = function(p, cx, cy, s, z)
		circle(p, cx, cy, s, Color3.fromRGB(150, 45, 40), z)
		circle(p, cx, cy, s * 0.78, Color3.fromRGB(190, 70, 60), z + 1)
		circle(p, cx - s * 0.15, cy - s * 0.1, s * 0.14, Color3.fromRGB(240, 200, 180), z + 2)
		circle(p, cx + s * 0.18, cy + s * 0.12, s * 0.12, Color3.fromRGB(240, 200, 180), z + 2)
	end,
	Presunto = function(p, cx, cy, s, z)
		rect(p, cx, cy, s, s * 0.8, Color3.fromRGB(240, 150, 160), 15, z, 0.3)
		rect(p, cx, cy, s * 0.7, s * 0.12, Color3.fromRGB(250, 205, 210), 15, z + 1, 1)
	end,
	Ovo = function(p, cx, cy, s, z)
		circle(p, cx, cy, s, Color3.fromRGB(255, 252, 245), z)
		circle(p, cx + s * 0.05, cy - s * 0.05, s * 0.45, Color3.fromRGB(250, 185, 40), z + 1)
	end,
	Cebola = function(p, cx, cy, s, z)
		ring(p, cx, cy, s, Color3.fromRGB(245, 235, 250), z)
	end,
}

-- Posições das coberturas em cima da pizza (frações do desenho)
local SPOTS = {
	{ 0.5, 0.3 }, { 0.3, 0.42 }, { 0.7, 0.42 }, { 0.38, 0.66 }, { 0.62, 0.66 }, { 0.5, 0.5 }, { 0.26, 0.6 }, { 0.74, 0.6 },
}

-- Desenha uma pizza do sabor (lista de ingredientes) dentro de parent
function PizzaArt.pizza(parent, ingredients)
	local p = square(parent)
	circle(p, 0.5, 0.5, 1, CRUST, 2)
	circle(p, 0.5, 0.5, 0.86, SAUCE, 3)
	circle(p, 0.5, 0.5, 0.78, CHEESE, 4)
	-- só as coberturas (molho e queijo já são a base)
	local toppings = {}
	for _, id in ipairs(ingredients) do
		if id ~= "Molho" and id ~= "Queijo" then
			table.insert(toppings, id)
		end
	end
	local spot = 1
	local per = #toppings &gt; 0 and math.floor(#SPOTS / #toppings) or 0
	for t, id in ipairs(toppings) do
		local draw = DRAW[id]
		for k = 1, per do
			local pos = SPOTS[((spot - 1) % #SPOTS) + 1]
			spot += 1
			if draw then
				draw(p, pos[1] + (t - 1) * 0.02, pos[2], 0.17, 6 + t * 3)
			end
		end
	end
	-- linhas das fatias
	for _, angle in ipairs({ 0, 60, 120 }) do
		local line = rect(p, 0.5, 0.5, 0.78, 0.012, Color3.fromRGB(190, 120, 50), angle, 20)
		line.BackgroundTransparency = 0.3
	end
	return p
end

-- Desenha só um ingrediente (para etiquetas e para a comanda)
function PizzaArt.ingredient(parent, id)
	local p = square(parent)
	local draw = DRAW[id]
	if draw then
		draw(p, 0.5, 0.5, 0.8, 2)
	end
	return p
end

return PizzaArt
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000008"><Properties><string name="Name">PoliceConfig</string><ProtectedString name="Source">-- Polícia cartunesca: ferramentas não letais, três vagas e ações validadas no servidor.
local PoliceConfig = {}
PoliceConfig.Slots = 3
PoliceConfig.InteractionDistance = 11
PoliceConfig.SprayRange = 65
PoliceConfig.SprayCooldown = 1.1
PoliceConfig.StunSeconds = 6
PoliceConfig.CuffDistance = 8
PoliceConfig.SuspectSeconds = 120
PoliceConfig.TrainingSeconds = 75
PoliceConfig.TrainingCooldown = 15
PoliceConfig.ReportCooldown = 10
PoliceConfig.MaxReports = 24
PoliceConfig.DoorSeconds = 0.65
PoliceConfig.Gear = {
	{ id = "Spray", name = "Lançador de água", color = Color3.fromRGB(33, 125, 205) },
	{ id = "Cuff", name = "Algemas", color = Color3.fromRGB(160, 172, 184) },
	{ id = "Flashlight", name = "Lanterna", color = Color3.fromRGB(45, 55, 72) },
	{ id = "Radio", name = "Rádio", color = Color3.fromRGB(38, 45, 60) },
}
PoliceConfig.ReportCategories = {
	Seguranca = "Inspeção de segurança concluída",
	Patrulha = "Ronda e pontos de controle verificados",
	Manutencao = "Solicitação de manutenção nas instalações",
}
return PoliceConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000009"><Properties><string name="Name">PoliceRules</string><ProtectedString name="Source">-- Regras puras: compartilhá-las não dá autoridade ao cliente.
local Rules = {}
function Rules.finite(value)
	return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end
function Rules.point(point)
	local kind = type(point)
	return (kind == "table" or kind == "userdata" or kind == "vector")
		and Rules.finite(point.X) and Rules.finite(point.Y) and Rules.finite(point.Z)
end
function Rules.canJoin(alive, detained, count, slots)
	return alive == true and not detained and Rules.finite(count) and Rules.finite(slots)
		and count &gt;= 0 and slots &gt; 0 and count &lt; slots
end
function Rules.canCapture(onDuty, equipped, distance, now, stunnedUntil, wanted, detained, protected)
	return onDuty == true and equipped == true and wanted == true and not detained and not protected
		and Rules.finite(distance) and distance &gt;= 0 and distance &lt;= 8
		and Rules.finite(now) and Rules.finite(stunnedUntil) and now &lt; stunnedUntil
end
function Rules.validDirection(point)
	if not Rules.point(point) then return false end
	local lengthSquared = point.X * point.X + point.Y * point.Y + point.Z * point.Z
	return Rules.finite(lengthSquared) and lengthSquared &gt; 0.0001 and lengthSquared &lt; 100000000
end
function Rules.validReport(category)
	return category == "Seguranca" or category == "Patrulha" or category == "Manutencao"
end
return Rules
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000A"><Properties><string name="Name">PrisonRules</string><ProtectedString name="Source">-- Regras puras da prisão: sem serviços Roblox, dinheiro ou efeitos colaterais.
-- São usadas pelo servidor; publicá-las no Shared não concede autoridade ao cliente.
local PrisonRules = {}

function PrisonRules.isFinite(value)
	return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end

function PrisonRules.isFinitePoint(point)
	local kind = type(point)
	if kind ~= "table" and kind ~= "userdata" and kind ~= "vector" then
		return false
	end
	return PrisonRules.isFinite(point.X)
		and PrisonRules.isFinite(point.Y) and PrisonRules.isFinite(point.Z)
end

function PrisonRules.deadline(now, duration)
	if not PrisonRules.isFinite(now) or not PrisonRules.isFinite(duration) or duration &lt;= 0 then
		return nil
	end
	local result = now + duration
	return PrisonRules.isFinite(result) and result or nil
end

function PrisonRules.remaining(endsAt, now)
	if not PrisonRules.isFinite(endsAt) or not PrisonRules.isFinite(now) then
		return 0
	end
	return math.max(0, endsAt - now)
end

-- expected/index são índices do PRÓXIMO ponto (1..N). O tempo de percurso
-- desconta o alcance do prompt e tolera uma pequena diferença de replicação.
function PrisonRules.canAdvance(expected, index, distance, elapsed, pathDistance, walkSpeed, alive)
	if not alive then
		return false, "character"
	end
	if not PrisonRules.isFinite(expected) or expected &lt; 1 or expected % 1 ~= 0
		or not PrisonRules.isFinite(index) or expected ~= index then
		return false, "sequence"
	end
	if not PrisonRules.isFinite(distance) or distance &lt; 0 or distance &gt; 10 then
		return false, "distance"
	end
	if not PrisonRules.isFinite(elapsed) or elapsed &lt; 0
		or not PrisonRules.isFinite(pathDistance) or pathDistance &lt; 0
		or not PrisonRules.isFinite(walkSpeed) or walkSpeed &lt;= 0 then
		return false, "travel"
	end
	local minimumTime = math.max(0, (pathDistance - 10) / (walkSpeed * 1.35) - 0.5)
	if elapsed &lt; minimumTime then
		return false, "travel"
	end
	return true
end

-- Uma margem pequena absorve atualizações de posição agrupadas pela rede.
-- O tempo entre checkpoints também é conferido, independentemente desta amostra.
function PrisonRules.movementAllowed(distance, elapsed, walkSpeed)
	return PrisonRules.isFinite(distance) and distance &gt;= 0
		and PrisonRules.isFinite(elapsed) and elapsed &gt;= 0
		and PrisonRules.isFinite(walkSpeed) and walkSpeed &gt; 0
		and distance &lt;= 6 + elapsed * walkSpeed * 1.65
end

return PrisonRules
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000B"><Properties><string name="Name">RigMeasure</string><ProtectedString name="Source">-- RigMeasure (ModuleScript)
-- Caminho: ReplicatedStorage &gt; Shared &gt; RigMeasure
-- Mede o boneco do jogador (R15 ou R6): onde ficam quadris e ombros em relação ao
-- HumanoidRootPart e o comprimento de pernas e braços. O servidor usa isso para
-- montar a bicicleta do tamanho certo, e o cliente para animar a pedalada.

local RigMeasure = {}

local function find(character, partName, jointName)
	local part = character:FindFirstChild(partName)
	return part and part:FindFirstChild(jointName)
end

-- Distância do pivô da junta até a ponta da peça (sola do pé / ponta do braço)
local function reachBelow(joint, part)
	return math.max(0, joint.C1.Position.Y + part.Size.Y / 2)
end

local function measureR15(character)
	local root = character:FindFirstChild("HumanoidRootPart")
	local j = {
		Root = find(character, "LowerTorso", "Root"),
		Waist = find(character, "UpperTorso", "Waist"),
		LeftHip = find(character, "LeftUpperLeg", "LeftHip"),
		RightHip = find(character, "RightUpperLeg", "RightHip"),
		LeftKnee = find(character, "LeftLowerLeg", "LeftKnee"),
		RightKnee = find(character, "RightLowerLeg", "RightKnee"),
		LeftAnkle = find(character, "LeftFoot", "LeftAnkle"),
		RightAnkle = find(character, "RightFoot", "RightAnkle"),
		LeftShoulder = find(character, "LeftUpperArm", "LeftShoulder"),
		RightShoulder = find(character, "RightUpperArm", "RightShoulder"),
		LeftElbow = find(character, "LeftLowerArm", "LeftElbow"),
		RightElbow = find(character, "RightLowerArm", "RightElbow"),
		LeftWrist = find(character, "LeftHand", "LeftWrist"),
		RightWrist = find(character, "RightHand", "RightWrist"),
	}
	for _, joint in pairs(j) do
		if not joint then
			return nil
		end
	end

	-- Pose de descanso, calculada só pelas juntas (não depende da animação do momento)
	local lowerTorso = j.Root.C0 * j.Root.C1:Inverse()
	local upperTorso = lowerTorso * j.Waist.C0 * j.Waist.C1:Inverse()

	return {
		rigType = "R15",
		root = root,
		joints = j,
		hip = { Left = (lowerTorso * j.LeftHip.C0).Position, Right = (lowerTorso * j.RightHip.C0).Position },
		shoulder = { Left = (upperTorso * j.LeftShoulder.C0).Position, Right = (upperTorso * j.RightShoulder.C0).Position },
		legL1 = (j.LeftHip.C1.Position - j.LeftKnee.C0.Position).Magnitude,
		legL2 = (j.LeftKnee.C1.Position - j.LeftAnkle.C0.Position).Magnitude + reachBelow(j.LeftAnkle, character.LeftFoot),
		armL1 = (j.LeftShoulder.C1.Position - j.LeftElbow.C0.Position).Magnitude,
		armL2 = (j.LeftElbow.C1.Position - j.LeftWrist.C0.Position).Magnitude + j.LeftWrist.C1.Position.Magnitude,
	}
end

local function measureR6(character)
	local root = character:FindFirstChild("HumanoidRootPart")
	local torso = character:FindFirstChild("Torso")
	local rootJoint = root and root:FindFirstChild("RootJoint")
	if not torso or not rootJoint then
		return nil
	end
	local j = {
		LeftHip = torso:FindFirstChild("Left Hip"),
		RightHip = torso:FindFirstChild("Right Hip"),
		LeftShoulder = torso:FindFirstChild("Left Shoulder"),
		RightShoulder = torso:FindFirstChild("Right Shoulder"),
	}
	local leg, arm = character:FindFirstChild("Left Leg"), character:FindFirstChild("Left Arm")
	if not (j.LeftHip and j.RightHip and j.LeftShoulder and j.RightShoulder and leg and arm) then
		return nil
	end
	local t = rootJoint.C0 * rootJoint.C1:Inverse()
	return {
		rigType = "R6",
		root = root,
		joints = j,
		hip = { Left = (t * j.LeftHip.C0).Position, Right = (t * j.RightHip.C0).Position },
		shoulder = { Left = (t * j.LeftShoulder.C0).Position, Right = (t * j.RightShoulder.C0).Position },
		legL1 = reachBelow(j.LeftHip, leg),
		legL2 = 0, -- R6 não tem joelho
		armL1 = reachBelow(j.LeftShoulder, arm),
		armL2 = 0,
	}
end

-- Retorna a medida do boneco, ou nil se faltar alguma junta (avatar diferente do padrão)
function RigMeasure.measure(character)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	local ok, result = pcall(function()
		if humanoid.RigType == Enum.HumanoidRigType.R15 then
			return measureR15(character)
		end
		return measureR6(character)
	end)
	return ok and result or nil
end

return RigMeasure
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000C"><Properties><string name="Name">StreetNPCConfig</string><ProtectedString name="Source">-- Moradores de rua usam o mesmo NPCKit dos clientes e das pessoas da praça.
-- As distâncias são medidas ao longo das avenidas; a posição final vem da calçada real.
