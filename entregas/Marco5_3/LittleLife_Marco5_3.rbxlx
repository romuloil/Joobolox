local function prison(parent)
	return PrisonBuilder.build(parent)
end

function CivicBuilder.build(map)
 if CivicBuilder.sites then return CivicBuilder.sites end
 local locations=map:FindFirstChild("CivicLocations")
 local fresh=locations==nil
 if fresh then
  locations=folder(map,"CivicLocations")
  local roads=folder(map,"CivicRoads")
  for _,road in ipairs(Config.Roads)do street(roads,road)end
 end
 CivicBuilder.sites=prison(locations)
 local stationModel=locations:FindFirstChild(Config.Station.Name)
 local intake,police,workplace
 if stationModel then
  assert(stationModel:GetAttribute("Architecture")=="BlueGlassCivic","A delegacia antiga precisa ser regenerada para o Marco 5.3")
  local function q(name)local target=assert(stationModel:FindFirstChild(name),name);return assert(target:FindFirstChildOfClass("ProximityPrompt"))end
  local spawns={};for i=1,3 do spawns[i]=assert(stationModel:FindFirstChild("PoliceVehicleSpawn"..i))end
  intake=q("SimulaçãoStudio")
  police={dutyPrompts={q("PlantaoDelegacia")},armoryPrompts={q("ArmariaDelegacia")},reportPrompts={q("OcorrenciasDelegacia")}}
  workplace={uniformPrompts={q("UniformeDelegacia")},vehiclePrompts={q("ViaturaDelegacia")},vehicleSpawns=spawns}
 else intake,police,workplace=station(locations)end
 CivicBuilder.sites.intakePrompt=intake
 local function worldPath(points)
  local result={};for _,p in ipairs(points)do table.insert(result,Config.Station.CFrame*p)end;return result
 end
 CivicBuilder.sites.stationRoutes={
  {name="nova delegacia / recepção",points=worldPath({Vector3.new(0,4,-74),Vector3.new(0,4,-3),Vector3.new(17,4,12)})},
  {name="nova delegacia / vestiário",points=worldPath({Vector3.new(0,4,-3),Vector3.new(-20,4,12),Vector3.new(-26,4,28),Vector3.new(-38,4,28),Vector3.new(-38,4,42),Vector3.new(-26,4,42)})},
  {name="nova delegacia / garagem",points=worldPath({Vector3.new(0,4,-3),Vector3.new(0,4,-15),Vector3.new(-20,4,-20),Vector3.new(-53,4,-26)})},
 }
 for key,prompts in pairs(police)do
  for _,target in ipairs(prompts)do table.insert(CivicBuilder.sites.police[key],target)end
 end
 local taxi=TaxiSiteBuilder.build(map)
 CivicBuilder.sites.taxi=taxi
 CivicBuilder.sites.workplaces={Policial=workplace,Taxista={uniformPrompts={taxi.uniformPrompt},vehiclePrompts={taxi.vehiclePrompt},vehicleSpawns=taxi.vehicleSpawns}}
 if CivicBuilder.sites.prisonWorkplace then
  for key,items in pairs(CivicBuilder.sites.prisonWorkplace)do
   workplace[key]=workplace[key]or{}
   for _,item in ipairs(items)do table.insert(workplace[key],item)end
  end
 end
 map:SetAttribute("CivicReady",true)
 return CivicBuilder.sites
end
return CivicBuilder
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000017"><Properties><string name="Name">DailyBonusService</string><ProtectedString name="Source">-- DailyBonusService (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; DailyBonusService
-- Regra (documento mestre, seção 12):
--   * o bônus fica disponível até o jogador concluir uma tarefa válida;
--   * ao resgatar, começa um tempo de espera de 24 horas;
--   * quem não entra não perde nada (não existe sequência diária);
--   * sair, trocar de servidor ou reconectar não reinicia nem duplica.
-- A hora do último resgate fica salva no DataStore (os.time(), igual em todos os servidores).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))
local EconomyService = require(script.Parent:WaitForChild("EconomyService"))

local DailyBonusService = {}

local BONUS = GameConfig.DailyBonus

local function publish(player, lastClaim)
	-- O cliente usa este horário só para mostrar a contagem regressiva
	player:SetAttribute("BonusReadyAt", lastClaim + BONUS.Cooldown)
end

function DailyBonusService.isAvailable(player)
	local data = PlayerDataService.get(player)
	if not data then
		return false
	end
	return os.time() - data.lastBonusClaim &gt;= BONUS.Cooldown
end

-- Chamado pelo MissionService quando uma tarefa válida é concluída.
-- Retorna o valor pago (0 se o bônus não estava disponível).
function DailyBonusService.tryClaim(player)
	if not DailyBonusService.isAvailable(player) then
		return 0
	end
	local now = os.time()
	PlayerDataService.set(player, "lastBonusClaim", now)
	if not EconomyService.add(player, BONUS.Amount, "Bônus diário") then
		return 0
	end
	publish(player, now)
	-- Salva na hora: se o jogador trocar de servidor, o outro já sabe que ele resgatou
	task.spawn(PlayerDataService.save, player)
	return BONUS.Amount
end

function DailyBonusService.init()
	PlayerDataService.onLoaded(function(player, data)
		publish(player, data.lastBonusClaim)
	end)
end

return DailyBonusService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000018"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source">-- EconomyService (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; EconomyService
-- Único lugar que mexe no dinheiro dos jogadores.
-- O dinheiro aparece na lista de jogadores (leaderstats) e no atributo "Money",
-- que a interface do cliente só LÊ.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))

local EconomyService = {}

local ECON = GameConfig.Economy

local function isValidAmount(amount)
	return type(amount) == "number" and amount == amount and amount &gt; 0 and amount &lt;= ECON.MaxMoney and math.floor(amount) == amount
end

local function publish(player, money)
	player:SetAttribute("Money", money)
	local stats = player:FindFirstChild("leaderstats")
	local value = stats and stats:FindFirstChild("Dinheiro")
	if value then
		value.Value = money
	end
end

function EconomyService.getMoney(player)
	local data = PlayerDataService.get(player)
	return data and data.money or nil
end

-- Dá dinheiro ao jogador. reason é só para o log. Retorna true se pagou.
function EconomyService.add(player, amount, reason)
	if not isValidAmount(amount) then
		warn(("[EconomyService] Valor inválido para %s: %s"):format(player.Name, tostring(amount)))
		return false
	end
	local data = PlayerDataService.get(player)
	if not data then
		return false -- dados ainda não carregaram: não paga
	end
	local newMoney = math.min(data.money + amount, ECON.MaxMoney)
	PlayerDataService.set(player, "money", newMoney)
	publish(player, newMoney)
	print(("[EconomyService] +%d para %s (%s). Saldo: %d"):format(amount, player.Name, tostring(reason), newMoney))
	return true
end

-- Tira dinheiro (compras, no futuro). Retorna false se não tiver saldo.
function EconomyService.spend(player, amount, reason)
	if not isValidAmount(amount) then
		return false
	end
	local data = PlayerDataService.get(player)
	if not data or data.money &lt; amount then
		return false
	end
	local newMoney = data.money - amount
	PlayerDataService.set(player, "money", newMoney)
	publish(player, newMoney)
	print(("[EconomyService] -%d de %s (%s). Saldo: %d"):format(amount, player.Name, tostring(reason), newMoney))
	return true
end

function EconomyService.init()
	local function setupStats(player)
		if player:FindFirstChild("leaderstats") then
			return
		end
		local stats = Instance.new("Folder")
		stats.Name = "leaderstats" -- nome obrigatório para aparecer na lista de jogadores
		local value = Instance.new("IntValue")
		value.Name = "Dinheiro"
		value.Parent = stats
		stats.Parent = player
	end
	Players.PlayerAdded:Connect(setupStats)
	for _, player in ipairs(Players:GetPlayers()) do
		setupStats(player)
	end

	PlayerDataService.onLoaded(function(player, data)
		setupStats(player)
		publish(player, data.money)
	end)
end

return EconomyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000019"><Properties><string name="Name">JobService</string><ProtectedString name="Source">-- JobService (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; JobService
-- Quadro de empregos e vagas (documento mestre, seção 7):
--   * o jogador ESCOLHE a profissão no quadro da praça (nada é automático);
--   * cada profissão tem um limite de vagas; lotada = escolher outra;
--   * a vaga é liberada ao sair do emprego ou ao desconectar (sem vaga presa).
-- Profissão atual é estado da sessão: não fica salva.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local JobConfig = require(Shared:WaitForChild("JobConfig"))
local SecurityService = require(script.Parent:WaitForChild("SecurityService"))
local MissionService = require(script.Parent:WaitForChild("MissionService"))
local JobSiteBuilder = require(script.Parent:WaitForChild("JobSiteBuilder"))
local MarketService = require(script.Parent:WaitForChild("MarketService"))
local CityNPCService = require(script.Parent:WaitForChild("CityNPCService"))
local WorkRoleService = require(script.Parent:WaitForChild("WorkRoleService"))

local JobService = {}

local uiUpdate
local jobOf = {} -- jobOf[player] = id da profissão
local counts = {} -- counts[id] = vagas ocupadas

for id in pairs(JobConfig.Jobs) do
	counts[id] = 0
end

local function broadcastSlots()
	uiUpdate:FireAllClients("JobSlots", { counts = counts })
end

local function isNearBoard(player)
	local _, _, root = SecurityService.getLivingCharacter(player)
	local board = JobSiteBuilder.board
	return root and board and (root.Position - board.Position).Magnitude &lt;= JobConfig.BoardDistance
end

function JobService.getJob(player)
	return jobOf[player]
end

-- Libera a vaga. notify = false quando o jogador está saindo do jogo.
function JobService.leave(player, notify)
	local id = jobOf[player]
	if not id then
		return
	end
	jobOf[player] = nil
	WorkRoleService.clear(player, id)
	counts[id] = math.max(0, counts[id] - 1)
	MissionService.stopJob(player)
	if notify ~= false then
		player:SetAttribute("Job", nil)
		uiUpdate:FireClient(player, "JobChanged", { job = nil })
	end
	print(("[JobService] %s saiu de %s. Vagas: %d/%d"):format(player.Name, id, counts[id], JobConfig.Jobs[id].Slots))
	broadcastSlots()
end

function JobService.join(player, id)
	if player:GetAttribute("TaxiDuty") then
		uiUpdate:FireClient(player, "Notice", { text = "Encerre o turno na LXR Táxis antes de escolher outro emprego." })
		return
	end
	if player:GetAttribute("PoliceDuty") then
		uiUpdate:FireClient(player, "Notice", { text = "Encerre o plantão policial antes de escolher outro emprego." })
		return
	end
	if player:GetAttribute("Detained") then
		uiUpdate:FireClient(player, "Notice", { text = "Aguarde sua liberação para escolher um emprego." })
		return
	end
	local job = JobConfig.Jobs[id]
	if not job or jobOf[player] == id then
		return
	end
	if not isNearBoard(player) then
		uiUpdate:FireClient(player, "JobRefused", { reason = "far" })
		return
	end
	if counts[id] &gt;= job.Slots then
		uiUpdate:FireClient(player, "JobRefused", { reason = "full", job = id })
		return
	end
	-- Trocar de profissão libera a vaga antiga primeiro
	if jobOf[player] then
		JobService.leave(player)
	end
	local assigned = WorkRoleService.assign(player, id)
	if not assigned then
		uiUpdate:FireClient(player, "Notice", { text = "Encerre seu outro emprego antes de assumir esta vaga." })
		return
	end
	jobOf[player] = id
	counts[id] += 1
	player:SetAttribute("Job", id)
	uiUpdate:FireClient(player, "JobChanged", { job = id })
	print(("[JobService] %s virou %s. Vagas: %d/%d"):format(player.Name, id, counts[id], job.Slots))
	broadcastSlots()
	MissionService.startJob(player, id)
end

local function onJobRequest(player, action, id)
	if not SecurityService.checkRate(player, "JobRequest", 0.5) then
		return
	end
	if not SecurityService.isShortString(action, 16) then
		return
	end
	if action == "Join" and SecurityService.isShortString(id, 32) then
		JobService.join(player, id)
	elseif action == "Leave" then
		JobService.leave(player)
	end
end

function JobService.init(remotes)
	uiUpdate = remotes[GameConfig.Remotes.UIUpdate]

	local ok, boardPrompt = pcall(JobSiteBuilder.build)
	if not ok then
		warn("[JobService] Erro ao montar os locais de trabalho: " .. tostring(boardPrompt))
		return
	end
	MissionService.init(remotes, JobSiteBuilder)
	MarketService.init(MissionService, JobSiteBuilder) -- clientes NPC e prateleiras do Minas Market
	CityNPCService.init(MissionService, JobSiteBuilder) -- Marco 5: funcionários, clientes, moradores e praça

	boardPrompt.Triggered:Connect(function(player)
		if not SecurityService.checkRate(player, "JobBoard", 0.5) or not isNearBoard(player) then
			return
		end
		uiUpdate:FireClient(player, "JobBoard", { counts = counts, current = jobOf[player] })
	end)
	remotes[GameConfig.Remotes.JobRequest].OnServerEvent:Connect(onJobRequest)

	Players.PlayerRemoving:Connect(function(player)
		JobService.leave(player, false) -- desconectou: vaga liberada na hora
		jobOf[player] = nil
	end)
end

return JobService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000001A"><Properties><string name="Name">JobSiteBuilder</string><ProtectedString name="Source">-- JobSiteBuilder (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; JobSiteBuilder
-- Monta os lugares de trabalho do Marco 4, separados do mapa (pasta Workspace &gt; JobStations):
--   * quadro de empregos na praça;
--   * interior decorado de cada loja, com as estações de trabalho (bancada, forno, prateleiras, caixa...);
--   * pontos de entrega na porta de cada casa (Entregador Sherlex).
-- Cada estação tem um ProximityPrompt DESLIGADO no servidor; o cliente liga só a
-- estação da etapa atual de quem está trabalhando. Quem valida tudo é o MissionService.
-- As lojas são ocas (MapBuilder); aqui entram os móveis, a decoração e as estações de dentro.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local JobConfig = require(Shared:WaitForChild("JobConfig"))
local PizzaArt = require(Shared:WaitForChild("PizzaArt"))

local JobSiteBuilder = {}

local WOOD = Color3.fromRGB(150, 105, 65)
local STEEL = Color3.fromRGB(185, 190, 195)
local CARDBOARD = Color3.fromRGB(200, 160, 110)
local DARK = Color3.fromRGB(45, 45, 50)

-- points[nome] = { part, prompt, visual, job, station }
-- groups[job][station] = lista de nomes de pontos (ex.: 3 prateleiras)
JobSiteBuilder.points = {}
JobSiteBuilder.groups = {}
JobSiteBuilder.houses = {} -- pontos de entrega nas casas: { point = nome, address = "Rua das Flores, 12" }
JobSiteBuilder.market = nil -- dados do Minas Market para o MarketService (caixas, porta, prateleiras)
JobSiteBuilder.board = nil -- peça do quadro de empregos
-- Lugares dos NPCs em cada loja (Marco 5): shops[jobId] = { base, door = {fora, dentro}, staff, customers }
-- staff = onde o funcionário NPC fica atrás do balcão; customers = onde o cliente NPC espera
JobSiteBuilder.shops = {}

-- Posições na planta de cada loja (x, z no chão da loja; -Z é o lado da porta)
local SHOP_SPOTS = {
	Pizzaiolo = { staff = { -12.5, -6.6 }, customers = { { -14.5, -12 }, { -10.5, -12 } } },
	Atendente = { staff = { 8, -7.4 } },
	Entregador = { staff = { 0, -0.6 } },
	PetShop = { staff = { 13, -6.6 } },
}

local function part(parent, props)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Color = props.Color or Color3.new(1, 1, 1)
	p.Size = props.Size
	p.CFrame = props.CFrame
	p.Name = props.Name or "Part"
	if props.Shape then
		p.Shape = props.Shape
	end
	if props.Transparency then
		p.Transparency = props.Transparency
	end
	if props.CanCollide ~= nil then
		p.CanCollide = props.CanCollide
	end
	p.Parent = parent
	return p
end

local function signText(target, text, color)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = target
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = color or DARK
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.Parent = gui
	return label
end

local function addPrompt(target, objectText)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "JobPrompt"
	prompt.ObjectText = objectText
	prompt.ActionText = "Usar"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false -- o cliente liga só para quem está nesta etapa
	prompt.Parent = target
	return prompt
end

local function register(name, jobId, station, target, visual, objectText, reach)
	local prompt = addPrompt(target, objectText)
	if reach then
		prompt.MaxActivationDistance = reach -- estações coladas (ex.: potes de ingredientes)
	end
	local visualRef = Instance.new("ObjectValue")
	visualRef.Name = "Visual"
	visualRef.Value = visual
	visualRef.Parent = target
	JobSiteBuilder.points[name] = { part = target, prompt = prompt, visual = visual, job = jobId, station = station }
	local byJob = JobSiteBuilder.groups[jobId] or {}
	JobSiteBuilder.groups[jobId] = byJob
	byJob[station] = byJob[station] or {}
	table.insert(byJob[station], name)
	target.Name = name
	return prompt
end

-- Balcão fechado (caixa sólida com tampo colorido). Devolve o corpo.
local function counter(m, cf, size, bodyColor, topColor)
	local body = part(m, { Name = "Body", Size = Vector3.new(size.X, size.Y - 0.3, size.Z), CFrame = cf * CFrame.new(0, (size.Y - 0.3) / 2, 0), Color = bodyColor })
	part(m, { Name = "Top", Size = Vector3.new(size.X + 0.2, 0.3, size.Z + 0.2), CFrame = cf * CFrame.new(0, size.Y - 0.15, 0), Color = topColor })
	return body
end

local function crate(m, cf, s)
	return part(m, { Name = "Box", Size = Vector3.new(s, s, s), CFrame = cf, Color = CARDBOARD, Material = Enum.Material.Cardboard })
end

---------------------------------------------------------------------------
-- Móveis de decoração (sem interação)
---------------------------------------------------------------------------

local function model(name, parent)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

-- Piso quadriculado sobre o chão da loja (não colide, só visual)
local function tiles(parent, base, w, d, size, c1, c2)
	local f = model("Piso", parent)
	local nx, nz = math.floor(w / size), math.floor(d / size)
	for i = 0, nx - 1 do
		for k = 0, nz - 1 do
			local p = part(f, {
				Name = "Tile",
				Size = Vector3.new(size, 0.05, size),
				CFrame = base * CFrame.new(-w / 2 + size / 2 + i * size, 0.03, -d / 2 + size / 2 + k * size),
				Color = ((i + k) % 2 == 0) and c1 or c2,
				CanCollide = false,
			})
			p.CanQuery = false
			p.CastShadow = false
		end
	end
end

local function stool(parent, cf, color)
	-- Assento de verdade (o jogador fica virado para o -Z do cf). Senta apertando E (SeatService).
	local m = model("Banco", parent)
	part(m, { ClassName = "Seat", Name = "Seat", Size = Vector3.new(1.6, 0.3, 1.6), CFrame = cf * CFrame.new(0, 2, 0), Color = color })
	part(m, { Name = "Cushion", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.35, 1.8, 1.8), CFrame = cf * CFrame.new(0, 2.05, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = color, CanCollide = false })
	part(m, { Name = "Leg", Size = Vector3.new(0.3, 1.9, 0.3), CFrame = cf * CFrame.new(0, 0.95, 0), Color = DARK, Material = Enum.Material.Metal })
end

local function diningTable(parent, cf, topColor, seatColor)
	local m = model("MesaCliente", parent)
	part(m, { Name = "Top", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 3.4, 3.4), CFrame = cf * CFrame.new(0, 3, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = topColor })
	part(m, { Name = "Leg", Size = Vector3.new(0.4, 2.85, 0.4), CFrame = cf * CFrame.new(0, 1.43, 0), Color = DARK, Material = Enum.Material.Metal })
	for _, x in ipairs({ -2.4, 2.4 }) do
		-- cada banco olha para a mesa
		stool(parent, cf * CFrame.new(x, 0, 0) * CFrame.Angles(0, x &lt; 0 and -math.pi / 2 or math.pi / 2, 0), seatColor)
	end
end

local function plant(parent, cf)
	local m = model("Planta", parent)
	part(m, { Name = "Pot", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.6, 1.6, 1.6), CFrame = cf * CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(170, 90, 60), Material = Enum.Material.Slate })
	part(m, { Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.8, 2.4), CFrame = cf * CFrame.new(0, 2.8, 0), Color = Color3.fromRGB(70, 150, 60), Material = Enum.Material.Grass, CanCollide = false })
end

-- Prateleira de parede com objetos coloridos (potes, latas, pacotes)
local function wallShelf(parent, cf, width, colors, levels)
	local m = model("PrateleiraParede", parent)
	for level = 0, (levels or 2) - 1 do
		local shelfCf = cf * CFrame.new(0, 4.5 + level * 2, 0)
		part(m, { Name = "Board", Size = Vector3.new(width, 0.2, 1.2), CFrame = shelfCf, Color = WOOD, Material = Enum.Material.Wood })
		local n = math.floor(width / 1.1)
		for k = 0, n - 1 do
			part(m, {
				Name = "Item",
				Size = Vector3.new(0.7, 0.9, 0.7),
				CFrame = shelfCf * CFrame.new(-width / 2 + 0.6 + k * 1.1, 0.55, 0),
				Color = colors[((k + level) % #colors) + 1],
				CanCollide = false,
			})
		end
	end
end

local function wallSign(parent, cf, size, text, textColor, bgColor)
	local p = part(parent, { Name = "Quadro", Size = size, CFrame = cf, Color = bgColor })
	signText(p, text, textColor)
	return p
end

-- Etiqueta do pote: desenho do ingrediente + nome
local function ingredientLabel(target, ing)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 0
	gui.Parent = target
	local icon = Instance.new("Frame")
	icon.BackgroundTransparency = 1
	icon.Position = UDim2.fromScale(0.02, 0.05)
	icon.Size = UDim2.fromScale(0.36, 0.9)
	icon.Parent = gui
	PizzaArt.ingredient(icon, ing.id)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(0.38, 0)
	label.Size = UDim2.fromScale(0.6, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = DARK
	label.Text = ing.label
	label.Parent = gui
end

-- Cardápio da parede: um desenho de cada pizza, com o nome e o preço embaixo
local function menuBoard(parent, cf, size)
	local board = part(parent, { Name = "Cardapio", Size = size, CFrame = cf, Color = Color3.fromRGB(40, 35, 30) })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = board
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.fromScale(1, 0.17)
	title.Position = UDim2.fromScale(0, 0.02)
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 220, 120)
	title.Text = "CARDÁPIO"
	title.Parent = gui
	local n = #JobConfig.Flavors
	for i, flavor in ipairs(JobConfig.Flavors) do
		local col = Instance.new("Frame")
		col.BackgroundTransparency = 1
		col.Position = UDim2.fromScale((i - 1) / n, 0.2)
		col.Size = UDim2.fromScale(1 / n, 0.8)
		col.Parent = gui
		local art = Instance.new("Frame")
		art.BackgroundTransparency = 1
		art.Position = UDim2.fromScale(0.1, 0)
		art.Size = UDim2.fromScale(0.8, 0.72)
		art.Parent = col
		PizzaArt.pizza(art, flavor.ingredients)
		local name = Instance.new("TextLabel")
		name.BackgroundTransparency = 1
		name.Position = UDim2.fromScale(0, 0.74)
		name.Size = UDim2.fromScale(1, 0.2)
		name.Font = Enum.Font.GothamBold
		name.TextScaled = true
		name.TextColor3 = Color3.new(1, 1, 1)
		name.Text = flavor.label
		name.Parent = col
	end
	return board
end

---------------------------------------------------------------------------
-- Interior de cada loja. base = chão de dentro, olhando para a rua (-Z).
-- Dentro: x de -21 a 21, z de -17 (vitrine/porta) a 17 (fundo).
-- O corredor da porta (x entre -4 e 4, perto da frente) fica livre.
---------------------------------------------------------------------------

local function buildPizzaria(folder, base)
	local job = "Pizzaiolo"
	local function at(x, z)
		return base * CFrame.new(x, 0, z)
	end
	local RED = Color3.fromRGB(200, 50, 45)
	local CREAM = Color3.fromRGB(245, 235, 215)
	local decor = model("Decoracao", folder)
	tiles(decor, base, 42, 34, 3.5, Color3.fromRGB(240, 240, 235), Color3.fromRGB(190, 60, 55))

	-- Fundo da cozinha: massas, mesa de montagem, forno, lixo e caixas de pizza
	local m = model("Massa", folder)
	local body = counter(m, at(-17, 14.5), Vector3.new(5, 3.4, 3), CREAM, WOOD)
	part(m, { Name = "Tray", Size = Vector3.new(4, 0.3, 2.4), CFrame = body.CFrame * CFrame.new(0, 1.85, 0), Color = STEEL, Material = Enum.Material.Metal })
	for i = 0, 5 do
		part(m, { Name = "Dough", Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9), CFrame = body.CFrame * CFrame.new(-1.4 + (i % 3) * 1.4, 2.3, -0.5 + math.floor(i / 3) * 1), Color = Color3.fromRGB(245, 230, 200) })
	end
	register("Pizzaiolo_Massa_1", job, "Massa", body, m, "Massas")

	m = model("MesaMontagem", folder)
	body = counter(m, at(-10.5, 14.5), Vector3.new(6, 3.4, 3), STEEL, STEEL)
	part(m, { Name = "Board", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.15, 2.4, 2.4), CFrame = body.CFrame * CFrame.new(0, 1.93, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(190, 140, 90), Material = Enum.Material.Wood })
	part(m, { Name = "RollingPin", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 0.4, 0.4), CFrame = body.CFrame * CFrame.new(2.2, 2.05, 0) * CFrame.Angles(0, math.rad(90), 0), Color = WOOD })
	register("Pizzaiolo_MesaMontagem_1", job, "MesaMontagem", body, m, "Mesa de montagem")

	m = model("Forno", folder)
	local oven = part(m, { Name = "Oven", Size = Vector3.new(7, 5, 5), CFrame = at(1, 14) * CFrame.new(0, 2.5, 0), Color = Color3.fromRGB(170, 85, 60), Material = Enum.Material.Brick })
	part(m, { Name = "Dome", Shape = Enum.PartType.Ball, Size = Vector3.new(6.6, 3.4, 4.6), CFrame = oven.CFrame * CFrame.new(0, 2.5, 0), Color = Color3.fromRGB(170, 85, 60), Material = Enum.Material.Brick })
	part(m, { Name = "Mouth", Size = Vector3.new(3.2, 2, 0.2), CFrame = oven.CFrame * CFrame.new(0, 0.6, -2.5), Color = Color3.fromRGB(25, 20, 20) })
	local fire = part(m, { Name = "Fire", Size = Vector3.new(2.6, 0.5, 0.2), CFrame = oven.CFrame * CFrame.new(0, -0.1, -2.45), Color = Color3.fromRGB(255, 140, 40), Material = Enum.Material.Neon, CanCollide = false })
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 150, 60)
	glow.Range = 8
	glow.Brightness = 1.5
	glow.Parent = fire
	part(m, { Name = "Chimney", Size = Vector3.new(1.2, 8, 1.2), CFrame = oven.CFrame * CFrame.new(2, 6.5, 1.5), Color = DARK, Material = Enum.Material.Metal })
	register("Pizzaiolo_Forno_1", job, "Forno", oven, m, "Forno a lenha")

	m = model("Lixo", folder)
	local bin = part(m, { Name = "Bin", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 2.2, 2.2), CFrame = at(7, 15) * CFrame.new(0, 1.5, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(70, 80, 75), Material = Enum.Material.Metal })
	part(m, { Name = "Lid", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 2.4, 2.4), CFrame = at(7, 15) * CFrame.new(0, 3.1, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(50, 55, 50), Material = Enum.Material.Metal })
	register("Pizzaiolo_Lixo_1", job, "Lixo", bin, m, "Lixo")

	m = model("Embalagem", folder)
	body = counter(m, at(12.5, 14.5), Vector3.new(6, 3.4, 3), CREAM, RED)
	for i = 0, 5 do
		part(m, { Name = "PizzaBox", Size = Vector3.new(2.4, 0.4, 2.4), CFrame = body.CFrame * CFrame.new(-1.4, 1.95 + i * 0.42, 0) * CFrame.Angles(0, 0.05 * i, 0), Color = Color3.fromRGB(245, 240, 230) })
	end
	part(m, { Name = "OpenBox", Size = Vector3.new(2.4, 0.15, 2.4), CFrame = body.CFrame * CFrame.new(1.5, 1.8, 0), Color = Color3.fromRGB(245, 240, 230) })
	register("Pizzaiolo_Embalagem_1", job, "Embalagem", body, m, "Caixas de pizza")
	part(decor, { Name = "Wood", Size = Vector3.new(2.5, 1.2, 1.2), CFrame = at(18, 15) * CFrame.new(0, 0.6, 0), Color = Color3.fromRGB(120, 80, 45), Material = Enum.Material.Wood })

	-- Bancada de ingredientes: grupo BASE (molho e queijo, vão em todas) e grupo COBERTURAS.
	-- Cada pote tem uma etiqueta com o desenho do ingrediente e o nome.
	local island = model("BancadaIngredientes", decor)
	local spacing = 3
	local xs, x = {}, -18
	local lastBase
	for i, ing in ipairs(JobConfig.Ingredients) do
		if lastBase and not ing.base then
			x += 1.5 -- espaço entre os dois grupos
			lastBase = nil
		end
		xs[i] = x
		if ing.base then
			lastBase = true
		end
		x += spacing
	end
	local left, right = xs[1] - 1.8, xs[#xs] + 1.8
	local islandCf = at((left + right) / 2, 6)
	counter(island, islandCf, Vector3.new(right - left, 3.4, 3), CREAM, STEEL)
	local baseEnd, topStart
	for i, ing in ipairs(JobConfig.Ingredients) do
		local px = xs[i] - (left + right) / 2
		local pm = model("Ing_" .. ing.id, folder)
		local pot = part(pm, { Name = "Pot", Size = Vector3.new(2.2, 0.8, 2.2), CFrame = islandCf * CFrame.new(px, 3.8, 0), Color = STEEL, Material = Enum.Material.Metal })
		part(pm, { Name = "Content", Size = Vector3.new(1.9, 0.2, 1.9), CFrame = islandCf * CFrame.new(px, 4.25, 0), Color = ing.color, CanCollide = false })
		local label = part(pm, { Name = "Label", Size = Vector3.new(2.8, 1.3, 0.1), CFrame = islandCf * CFrame.new(px, 2.3, -1.56), Color = Color3.new(1, 1, 1) })
		ingredientLabel(label, ing)
		register("Pizzaiolo_Ing_" .. ing.id .. "_1", job, "Ing_" .. ing.id, pot, pm, ing.label, 4)
		if ing.base then
			baseEnd = px
		elseif not topStart then
			topStart = px
		end
	end
	-- Plaquinhas dos grupos, atrás dos potes
	local baseStart = xs[1] - (left + right) / 2
	local topEnd = xs[#xs] - (left + right) / 2
	local groupSign = part(island, { Name = "Grupo", Size = Vector3.new(baseEnd - baseStart + 2.4, 0.9, 0.15), CFrame = islandCf * CFrame.new((baseStart + baseEnd) / 2, 5.2, 1.2), Color = RED })
	signText(groupSign, "BASE (vai em todas)", Color3.new(1, 1, 1))
	groupSign = part(island, { Name = "Grupo", Size = Vector3.new(topEnd - topStart + 2.4, 0.9, 0.15), CFrame = islandCf * CFrame.new((topStart + topEnd) / 2, 5.2, 1.2), Color = Color3.fromRGB(60, 120, 60) })
	signText(groupSign, "COBERTURAS (veja a comanda)", Color3.new(1, 1, 1))

	-- Balcão de retirada (pedido e entrega) perto da porta
	m = model("BalcaoPizza", folder)
	body = counter(m, at(-12.5, -9), Vector3.new(9, 3.6, 2.5), CREAM, RED)
	local tag = part(m, { Name = "Tag", Size = Vector3.new(4, 0.9, 0.1), CFrame = body.CFrame * CFrame.new(0, 0.6, -1.3), Color = Color3.new(1, 1, 1) })
	signText(tag, "PEDIDOS", RED)
	part(m, { Name = "Register", Size = Vector3.new(1.4, 0.9, 1.2), CFrame = body.CFrame * CFrame.new(3, 2.3, 0.3), Color = DARK })
	part(m, { Name = "Ticket", Size = Vector3.new(0.8, 1.1, 0.05), CFrame = body.CFrame * CFrame.new(-2.5, 2.4, 0.4) * CFrame.Angles(math.rad(-15), 0, 0), Color = Color3.new(1, 1, 1) })
	register("Pizzaiolo_BalcaoPizza_1", job, "BalcaoPizza", body, m, "Balcão de pedidos")

	-- Salão: mesas com bancos de sentar, cardápio, prateleiras e plantas
	for _, pos in ipairs({ { 9, -12 }, { 16, -12 }, { 9, -4 }, { 16, -4 } }) do
		diningTable(decor, at(pos[1], pos[2]), CREAM, RED)
	end
	menuBoard(decor, base * CFrame.new(-7, 10.5, 16.9), Vector3.new(16, 6.5, 0.2))
	wallShelf(decor, base * CFrame.new(20.3, 1.5, 6) * CFrame.Angles(0, math.pi / 2, 0), 8, { Color3.fromRGB(110, 60, 40), Color3.fromRGB(230, 200, 120), RED }, 2)
	wallShelf(decor, base * CFrame.new(-20.3, 1.5, -2) * CFrame.Angles(0, -math.pi / 2, 0), 10, { Color3.fromRGB(80, 150, 60), Color3.fromRGB(245, 235, 215) }, 2)
	plant(decor, at(-19, -15))
	plant(decor, at(19, -15))
	plant(decor, at(19, 9))
end

local function buildMarket(folder, base)
	local job = "Atendente"
	local function at(x, z)
		return base * CFrame.new(x, 0, z)
	end
	local GREEN = Color3.fromRGB(40, 140, 70)
	local LIGHT = Color3.fromRGB(235, 240, 220)
	local decor = model("Decoracao", folder)
	tiles(decor, base, 42, 34, 4, Color3.fromRGB(235, 235, 230), Color3.fromRGB(215, 225, 215))

	-- Estoque no fundo: uma pilha de caixas de cada tipo, com etiqueta
	part(decor, { Name = "Pallet", Size = Vector3.new(12, 0.5, 4), CFrame = at(14.7, 14) * CFrame.new(0, 0.25, 0), Color = WOOD, Material = Enum.Material.WoodPlanks })
	for i, cat in ipairs(JobConfig.Categories) do
		local x = 10.5 + (i - 1) * 2.8
		local m = model("Caixa_" .. cat.id, folder)
		local box = part(m, { Name = "Box", Size = Vector3.new(2.2, 2, 2.2), CFrame = at(x, 14) * CFrame.new(0, 1.5, 0), Color = cat.color, Material = Enum.Material.Cardboard })
		part(m, { Name = "Box2", Size = Vector3.new(2, 1.8, 2), CFrame = at(x, 14) * CFrame.new(0, 3.4, 0) * CFrame.Angles(0, 0.15 * i, 0), Color = cat.color, Material = Enum.Material.Cardboard })
		local label = part(m, { Name = "Label", Size = Vector3.new(2, 0.7, 0.1), CFrame = box.CFrame * CFrame.new(0, 0, -1.16), Color = Color3.new(1, 1, 1) })
		signText(label, cat.label, DARK)
		register("Atendente_Caixa_" .. cat.id .. "_1", job, "Caixa_" .. cat.id, box, m, "Caixa de " .. cat.label, 4)
	end
	wallSign(decor, base * CFrame.new(14.7, 8, 16.9), Vector3.new(8, 1.4, 0.2), "ESTOQUE", Color3.new(1, 1, 1), GREEN)

	local m = model("Reciclagem", folder)
	local bin = part(m, { Name = "Bin", Size = Vector3.new(2.6, 3, 2.2), CFrame = at(6.5, 15) * CFrame.new(0, 1.5, 0), Color = Color3.fromRGB(50, 150, 80) })
	local tag = part(m, { Name = "Tag", Size = Vector3.new(2.2, 0.7, 0.1), CFrame = bin.CFrame * CFrame.new(0, 0.6, -1.16), Color = Color3.new(1, 1, 1) })
	signText(tag, "RECICLE", Color3.fromRGB(50, 150, 80))
	register("Atendente_Reciclagem_1", job, "Reciclagem", bin, m, "Reciclagem")

	-- Gôndolas: uma por tipo de produto, com placa em cima
	local function gondola(parent, cf, colors, title)
		local g = model("Prateleira", parent)
		local back = part(g, { Name = "Back", Size = Vector3.new(7, 6, 0.3), CFrame = cf * CFrame.new(0, 3, 0.7), Color = LIGHT })
		for level = 0, 3 do
			local shelfCf = cf * CFrame.new(0, 0.5 + level * 1.5, 0)
			part(g, { Name = "Shelf", Size = Vector3.new(7, 0.2, 1.4), CFrame = shelfCf, Color = GREEN })
			for k = 0, 5 do
				part(g, { Name = "Product", Size = Vector3.new(0.8, 0.9, 0.8), CFrame = shelfCf * CFrame.new(-2.9 + k * 1.15, 0.55, 0), Color = colors[((k + level) % #colors) + 1], CanCollide = false })
			end
		end
		if title then
			local sign = part(g, { Name = "Title", Size = Vector3.new(5, 1, 0.2), CFrame = cf * CFrame.new(0, 7, 0.6), Color = GREEN })
			signText(sign, title, Color3.new(1, 1, 1))
		end
		return g, back
	end
	local shades = function(c)
		return { c, c:Lerp(Color3.new(1, 1, 1), 0.35), c:Lerp(Color3.new(0, 0, 0), 0.25) }
	end
	local shelves = {}
	for i, cat in ipairs(JobConfig.Categories) do
		local x = ({ -15, -6, 6, 15 })[i]
		local g, back = gondola(folder, at(x, 2), shades(cat.color), cat.label)
		g.Name = "Prateleira_" .. cat.id
		register("Atendente_Prateleira_" .. cat.id .. "_1", job, "Prateleira_" .. cat.id, back, g, "Prateleira de " .. cat.label)
		local products = {}
		for _, child in ipairs(g:GetChildren()) do
			if child.Name == "Product" then
				table.insert(products, child)
			end
		end
		shelves[cat.id] = products
	end
	gondola(decor, at(-15, 12), shades(Color3.fromRGB(250, 200, 60)))
	gondola(decor, at(-6, 12), shades(Color3.fromRGB(240, 240, 240)))

	-- Dois caixas (um para cada atendente). O cliente NPC fica do lado da porta (-Z),
	-- o atendente atrás do balcão. Na esteira aparecem as compras do cliente.
	local lanes = {}
	for lane, laneX in ipairs({ 8, 16 }) do
		local cm = model("Caixa" .. lane, folder)
		local body = counter(cm, at(laneX, -10), Vector3.new(6, 3.4, 3), LIGHT, GREEN)
		part(cm, { Name = "Belt", Size = Vector3.new(3.6, 0.1, 1.4), CFrame = body.CFrame * CFrame.new(-1.1, 1.6, -0.5), Color = DARK, Material = Enum.Material.Rubber })
		part(cm, { Name = "Register", Size = Vector3.new(1.4, 0.9, 1.1), CFrame = body.CFrame * CFrame.new(1.2, 2.3, 0.8), Color = DARK })
		part(cm, { Name = "Screen", Size = Vector3.new(1, 0.6, 0.1), CFrame = body.CFrame * CFrame.new(1.2, 3.05, 0.6) * CFrame.Angles(math.rad(-20), 0, 0), Color = Color3.fromRGB(120, 220, 140), Material = Enum.Material.Neon })
		local scanner = part(cm, { Name = "Scanner", Size = Vector3.new(0.9, 0.12, 1), CFrame = body.CFrame * CFrame.new(1, 1.66, -0.5), Color = Color3.fromRGB(255, 60, 60), Material = Enum.Material.Neon, CanCollide = false })
		local post = part(cm, { Name = "Post", Size = Vector3.new(0.3, 5, 0.3), CFrame = body.CFrame * CFrame.new(-2.7, 4.2, 0.9), Color = DARK, Material = Enum.Material.Metal })
		local laneSign = part(cm, { Name = "LaneSign", Size = Vector3.new(2.6, 1.1, 0.2), CFrame = post.CFrame * CFrame.new(0, 2.6, 0), Color = GREEN })
		signText(laneSign, "CAIXA " .. lane, Color3.new(1, 1, 1))
		register("Atendente_Checkout" .. lane, job, "Checkout" .. lane, body, cm, "Caixa " .. lane)

		-- Sacolas na ponta do balcão
		local bm = model("Sacolas" .. lane, folder)
		local holder = part(bm, { Name = "Holder", Size = Vector3.new(1.4, 0.2, 1.2), CFrame = body.CFrame * CFrame.new(2.4, 1.7, -0.5), Color = Color3.fromRGB(200, 200, 200), Material = Enum.Material.Metal })
		for k = 0, 1 do
			part(bm, { Name = "Bag", Size = Vector3.new(0.6, 0.9, 0.5), CFrame = holder.CFrame * CFrame.new(-0.3 + k * 0.6, 0.55, 0), Color = Color3.fromRGB(240, 240, 235), Material = Enum.Material.Fabric, CanCollide = false })
		end
		register("Atendente_Bag" .. lane, job, "Bag" .. lane, holder, bm, "Sacolas")

		-- Lugares das compras na esteira (ficam invisíveis até o cliente chegar)
		local slots = {}
		for k = 1, 6 do
			local item = part(folder, {
				Name = "Produto",
				Size = Vector3.new(0.45, 0.7, 0.45),
				CFrame = body.CFrame * CFrame.new(-2.65 + (k - 1) * 0.55, 2.0, -0.5),
				Color = Color3.new(1, 1, 1),
				Transparency = 1,
				CanCollide = false,
			})
			register(("Atendente_Esteira%d_%d"):format(lane, k), job, ("Esteira%d_%d"):format(lane, k), item, item, "Produto", 5)
			slots[k] = item
		end
		lanes[lane] = {
			customerSpot = at(laneX, -13.4), -- onde o cliente para, de frente para o balcão
			scanner = scanner,
			bag = holder,
			slots = slots,
		}
	end

	-- Limpeza: balde com esfregão e 3 lugares onde a sujeira pode aparecer
	m = model("Esfregao", folder)
	local bucket = part(m, { Name = "Bucket", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.6, 1.8, 1.8), CFrame = at(-19, 14.5) * CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(240, 200, 40) })
	part(m, { Name = "Handle", Size = Vector3.new(0.25, 4.5, 0.25), CFrame = at(-19, 14.5) * CFrame.new(0.3, 2.6, 0) * CFrame.Angles(0, 0, math.rad(8)), Color = Color3.fromRGB(150, 110, 70), Material = Enum.Material.Wood })
	register("Atendente_Esfregao_1", job, "Esfregao", bucket, m, "Esfregão")
	for i, pos in ipairs({ { -10.5, -3 }, { 0, 8 }, { 10.5, 6 } }) do
		local spill = part(folder, {
			Name = "Sujeira",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.08, 4.5, 4.5),
			CFrame = at(pos[1], pos[2]) * CFrame.new(0, 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(240, 150, 40),
			Material = Enum.Material.Glass,
			Transparency = 1, -- aparece só quando alguém precisa limpar
			CanCollide = false,
		})
		register("Atendente_Sujeira_" .. i, job, "Sujeira_" .. i, spill, spill, "Sujeira")
	end

	-- Banca de frutas, geladeira e plantas
	for i, x in ipairs({ -15, -9 }) do
		local stand = model("BancaFrutas", decor)
		local crateTop = part(stand, { Name = "Stand", Size = Vector3.new(4.5, 2.2, 3), CFrame = at(x, -12) * CFrame.new(0, 1.1, 0) * CFrame.Angles(math.rad(-12), 0, 0), Color = WOOD, Material = Enum.Material.WoodPlanks })
		local fruit = i == 1 and Color3.fromRGB(230, 60, 50) or Color3.fromRGB(250, 170, 40)
		for k = 0, 5 do
			part(stand, { Name = "Fruit", Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9), CFrame = crateTop.CFrame * CFrame.new(-1.6 + (k % 3) * 1.6, 1.4, -0.6 + math.floor(k / 3) * 1.2), Color = fruit, CanCollide = false })
		end
	end
	local fridge = part(decor, { Name = "Geladeira", Size = Vector3.new(2.5, 7, 10), CFrame = at(-19.6, -5) * CFrame.new(0, 3.5, 0), Color = Color3.fromRGB(150, 210, 240), Material = Enum.Material.Glass, Transparency = 0.3 })
	local cold = Instance.new("PointLight")
	cold.Color = Color3.fromRGB(150, 210, 255)
	cold.Range = 8
	cold.Parent = fridge
	plant(decor, at(-19.5, -15.5))
	wallSign(decor, base * CFrame.new(-8, 10.5, 16.9), Vector3.new(16, 3, 0.2), "Produtos fresquinhos de Minas!", Color3.new(1, 1, 1), GREEN)

	JobSiteBuilder.market = {
		base = base,
		door = { base * CFrame.new(0, 0, -24), base * CFrame.new(0, 0, -14) }, -- fora da porta -&gt; logo depois da porta
		lanes = lanes,
		shelves = shelves,
	}
end

local function buildSherlex(folder, base)
	local job = "Entregador"
	local function at(x, z)
		return base * CFrame.new(x, 0, z)
	end
	local ORANGE = Color3.fromRGB(240, 140, 30)
	local decor = model("Decoracao", folder)
	tiles(decor, base, 42, 34, 6, Color3.fromRGB(205, 205, 210), Color3.fromRGB(190, 190, 198))

	-- Balcão de coleta de frente para a porta
	local m = model("BalcaoPacotes", folder)
	local body = counter(m, at(0, -3), Vector3.new(10, 3.6, 2.5), Color3.fromRGB(235, 235, 240), ORANGE)
	crate(m, body.CFrame * CFrame.new(-3.2, 2.65, 0), 1.4)
	crate(m, body.CFrame * CFrame.new(-1.6, 2.45, 0.2) * CFrame.Angles(0, 0.4, 0), 1)
	crate(m, body.CFrame * CFrame.new(3.2, 2.55, 0) * CFrame.Angles(0, -0.2, 0), 1.2)
	local tag = part(m, { Name = "Tag", Size = Vector3.new(5, 0.9, 0.1), CFrame = body.CFrame * CFrame.new(0, 0.6, -1.3), Color = Color3.new(1, 1, 1) })
	signText(tag, "COLETA", ORANGE)
	register("Entregador_BalcaoPacotes_1", job, "BalcaoPacotes", body, m, "Balcão de pacotes")

	-- Estantes de metal com pacotes no fundo
	for _, x in ipairs({ -14, -4, 6, 15 }) do
		local rack = model("Estante", decor)
		for _, sx in ipairs({ -3.2, 3.2 }) do
			part(rack, { Name = "Post", Size = Vector3.new(0.3, 9, 0.3), CFrame = at(x + sx, 15.5) * CFrame.new(0, 4.5, 0), Color = ORANGE, Material = Enum.Material.Metal })
		end
		for level = 0, 2 do
			local shelfCf = at(x, 15.5) * CFrame.new(0, 1 + level * 3, 0)
			part(rack, { Name = "Shelf", Size = Vector3.new(7, 0.2, 2.4), CFrame = shelfCf, Color = STEEL, Material = Enum.Material.Metal })
			for k = 0, 2 do
				local s = 1 + ((k + level + x) % 3) * 0.3
				crate(rack, shelfCf * CFrame.new(-2.2 + k * 2.2, 0.1 + s / 2, 0) * CFrame.Angles(0, 0.15 * (k - 1), 0), s)
			end
		end
	end

	-- Esteira de pacotes na lateral
	local belt = model("Esteira", decor)
	part(belt, { Name = "Base", Size = Vector3.new(3, 2.6, 16), CFrame = at(-18.5, 0) * CFrame.new(0, 1.3, 0), Color = DARK, Material = Enum.Material.Metal })
	part(belt, { Name = "Belt", Size = Vector3.new(2.6, 0.15, 16), CFrame = at(-18.5, 0) * CFrame.new(0, 2.65, 0), Color = Color3.fromRGB(30, 30, 30), Material = Enum.Material.Rubber })
	for i, z in ipairs({ -5, -1, 4 }) do
		crate(belt, at(-18.5, z) * CFrame.new(0, 3.3, 0) * CFrame.Angles(0, 0.3 * i, 0), 1.2)
	end

	-- Mesa com computador, pilhas de caixas e plantas
	local desk = model("Escritorio", decor)
	part(desk, { Name = "Desk", Size = Vector3.new(6, 0.3, 3), CFrame = at(15, -10) * CFrame.new(0, 3, 0), Color = WOOD, Material = Enum.Material.Wood })
	part(desk, { Name = "Base", Size = Vector3.new(5.6, 2.8, 2.6), CFrame = at(15, -10) * CFrame.new(0, 1.4, 0.1), Color = Color3.fromRGB(230, 230, 235) })
	part(desk, { Name = "Monitor", Size = Vector3.new(2.2, 1.4, 0.2), CFrame = at(15, -10) * CFrame.new(0, 4, 0.6), Color = Color3.fromRGB(120, 180, 240), Material = Enum.Material.Neon })
	stool(decor, at(15, -7.5), ORANGE)
	for i, pos in ipairs({ { 8, 6 }, { 10, 7.5 }, { -9, 7 } }) do
		crate(decor, at(pos[1], pos[2]) * CFrame.new(0, 1.2, 0) * CFrame.Angles(0, 0.4 * i, 0), 2.4)
	end
	wallSign(decor, base * CFrame.new(-2, 12, 16.9), Vector3.new(14, 2.6, 0.2), "SHERLEX ENTREGAS", Color3.new(1, 1, 1), ORANGE)
	plant(decor, at(-19, -15))
	plant(decor, at(19, -15))
end

-- Duto Pet Shop: só decoração por enquanto (a profissão de cuidador chega no Marco 9)
local function buildPetShop(folder, base)
	local function at(x, z)
		return base * CFrame.new(x, 0, z)
	end
	local PURPLE = Color3.fromRGB(130, 80, 200)
	local decor = model("Decoracao", folder)
	tiles(decor, base, 42, 34, 4, Color3.fromRGB(245, 240, 250), Color3.fromRGB(225, 210, 240))
	-- Banheira de banho
	local tub = model("Banheira", decor)
	part(tub, { Name = "Tub", Size = Vector3.new(6, 2.6, 3.5), CFrame = at(-14, 14) * CFrame.new(0, 1.3, 0), Color = Color3.new(1, 1, 1) })
	part(tub, { Name = "Water", Size = Vector3.new(5.4, 0.2, 2.9), CFrame = at(-14, 14) * CFrame.new(0, 2.5, 0), Color = Color3.fromRGB(120, 200, 240), Material = Enum.Material.Glass, Transparency = 0.3, CanCollide = false })
	-- Mesa de tosa
	counter(decor, at(-4, 14.5), Vector3.new(5, 3.2, 3), STEEL, PURPLE)
	-- Caminhas de pet
	for i, x in ipairs({ 6, 11, 16 }) do
		local bed = Color3.fromHSV((0.75 + i * 0.08) % 1, 0.4, 0.95)
		part(decor, { Name = "Caminha", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 3.4, 3.4), CFrame = at(x, 13) * CFrame.new(0, 0.4, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = bed, Material = Enum.Material.Fabric })
	end
	wallShelf(decor, base * CFrame.new(-20.3, 1, 0) * CFrame.Angles(0, -math.pi / 2, 0), 14, { PURPLE, Color3.fromRGB(250, 200, 60), Color3.fromRGB(110, 190, 90) }, 2)
	counter(decor, at(13, -9), Vector3.new(7, 3.6, 2.5), Color3.fromRGB(245, 240, 250), PURPLE)
	wallSign(decor, base * CFrame.new(0, 10.5, 16.9), Vector3.new(16, 3, 0.2), "Banho · Tosa · Carinho", Color3.new(1, 1, 1), PURPLE)
	plant(decor, at(-19, -15))
	plant(decor, at(19, -15))
end

-- Ponto de entrega invisível na frente da porta de cada casa
local function buildHouseDeliveries(folder, houses)
	for _, house in ipairs(houses:GetChildren()) do
		local door = house:FindFirstChild("Door")
		local number = house:GetAttribute("HouseNumber") -- número único da casa (para o nome do ponto)
		local address = house:GetAttribute("Address") or ("Casa " .. tostring(number))
		if door and number then
			local point = part(folder, {
				Name = "Casa",
				Size = Vector3.new(4, 4, 2),
				CFrame = door.CFrame * CFrame.new(0, -1.5, -2.5),
				Transparency = 1,
				CanCollide = false,
			})
			point.CanQuery = false
			point.CanTouch = false
			local name = "Entregador_Casa_" .. number
			register(name, "Entregador", "House", point, door, address)
			table.insert(JobSiteBuilder.houses, { point = name, address = address })
		end
	end
end

local function buildBoard(folder)
	local pos = JobConfig.BoardPosition
	local cf = CFrame.lookAt(Vector3.new(pos.X, 0.9, pos.Z), Vector3.new(0, 0.9, 20))
	local m = Instance.new("Model")
	m.Name = "QuadroDeEmpregos"
	m.Parent = folder
	for _, x in ipairs({ -2.6, 2.6 }) do
		part(m, { Name = "Post", Size = Vector3.new(0.5, 7, 0.5), CFrame = cf * CFrame.new(x, 3.5, 0), Color = WOOD, Material = Enum.Material.Wood })
	end
	local board = part(m, { Name = "Board", Size = Vector3.new(5.6, 3.6, 0.4), CFrame = cf * CFrame.new(0, 4.6, 0), Color = Color3.fromRGB(110, 75, 45), Material = Enum.Material.Wood })
	part(m, { Name = "Roof", Size = Vector3.new(6.6, 0.4, 1.4), CFrame = cf * CFrame.new(0, 6.9, 0), Color = Color3.fromRGB(180, 70, 55) })
	local paper = part(m, { Name = "Paper", Size = Vector3.new(4.8, 2.9, 0.1), CFrame = board.CFrame * CFrame.new(0, 0, -0.25), Color = Color3.fromRGB(250, 245, 230) })
	signText(paper, "EMPREGOS", Color3.fromRGB(30, 80, 150))

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "BoardPrompt"
	prompt.ActionText = "Ver empregos"
	prompt.ObjectText = "Quadro de empregos"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = board
	JobSiteBuilder.board = board
	return prompt
end

local function shopFrame(shops, placeName)
	local shop = shops:WaitForChild(placeName, 10)
	return shop and shop:GetAttribute("BaseCFrame") -- chão de dentro da loja (MapBuilder)
end

-- Devolve o ProximityPrompt do quadro de empregos
function JobSiteBuilder.build()
	local old = Workspace:FindFirstChild("JobStations")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "JobStations"

	local boardPrompt = buildBoard(root)

	local map = Workspace:WaitForChild("Map")
	local shops = map:WaitForChild("JobLocations")
	local builders = {
		{ GameConfig.Places.Pizzaria, "Pizzaiolo", buildPizzaria },
		{ GameConfig.Places.Mercearia, "Atendente", buildMarket },
		{ GameConfig.Places.Entregas, "Entregador", buildSherlex },
		{ GameConfig.Places.PetShop, "PetShop", buildPetShop },
	}
	for _, entry in ipairs(builders) do
		local cf = shopFrame(shops, entry[1])
		if cf then
			local folder = Instance.new("Folder")
			folder.Name = entry[2]
			folder.Parent = root
			entry[3](folder, cf)
			local spots = SHOP_SPOTS[entry[2]] or {}
			local shop = { base = cf, door = { cf * CFrame.new(0, 0, -24), cf * CFrame.new(0, 0, -14) }, customers = {} }
			if spots.staff then
				shop.staff = cf * CFrame.new(spots.staff[1], 0, spots.staff[2]) -- olhando para a porta
			end
			for _, c in ipairs(spots.customers or {}) do
				table.insert(shop.customers, cf * CFrame.new(c[1], 0, c[2]) * CFrame.Angles(0, math.pi, 0)) -- olhando para o balcão
			end
			JobSiteBuilder.shops[entry[2]] = shop
		else
			warn("[JobSiteBuilder] Loja não encontrada: " .. entry[1])
		end
	end

	local houses = map:FindFirstChild("Houses")
	if houses then
		local deliveries = Instance.new("Folder")
		deliveries.Name = "Entregas"
		deliveries.Parent = root
		buildHouseDeliveries(deliveries, houses)
	end

	root.Parent = Workspace
	return boardPrompt
end

return JobSiteBuilder
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000001B"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source">-- MapBuilder (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; MapBuilder
-- Monta a cidade de Little Little Kinder com peças simples:
--   * praça com rotatória no centro e 8 ruas saindo dela;
--   * dois anéis de rua (meio e borda) ligando as ruas, formando quarteirões;
--   * 4 estabelecimentos com interior (La Paulistana, Minas Market, Sherlex, Duto Pet Shop);
--   * casas de 3 modelos (térrea com varanda, sobrado, com garagem);
--   * cada rua tem nome e placas; casas e prédios são numerados POR RUA, em ordem:
--     ímpares de um lado, pares do outro, crescendo a partir da praça (como numa cidade de verdade);
--   * prédios com comércio no térreo nas ruas comerciais; árvores, postes e faixas de pedestre.
-- Cada lote é conferido antes de construir: nada fica em cima de rua ou de outra construção.
--
-- Se já existir uma pasta "Map" no Workspace (por exemplo, se você construir
-- o mapa à mão no futuro), este módulo não faz nada.

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

local CivicConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("CivicConfig"))
local CivicBuilder = require(script.Parent:WaitForChild("CivicBuilder"))

local MapBuilder = {}

local M = GameConfig.Map
local C = GameConfig.Colors

local ROAD_TOP = 0.5 -- altura da superfície das ruas
local SIDEWALK_TOP = 0.8
local RADIAL_START = 50 -- as ruas começam dentro da rotatória
local RADIAL_END = RADIAL_START + M.RoadLength -- onde fica o anel externo
local CROSSING_GAP = M.RoadWidth / 2 + M.SidewalkWidth + 8 -- espaço livre em volta dos cruzamentos

local rng = Random.new(M.TreeSeed)
-- A forma das árvores usa outro gerador: detalhes não redistribuem os lotes.
local treeRng = Random.new(M.TreeSeed + 9417)

-- Nomes das ruas (índice = rua radial; ímpares são comerciais, pares residenciais)
local STREET_NAMES = M.StreetNames
local INNER_RING_NAME = M.InnerRingName
local OUTER_RING_NAME = M.OuterRingName

-- Rua com contador de números: lado -1 = ímpares (1, 3, 5...), lado +1 = pares (2, 4, 6...)
local function newStreet(name)
	return { name = name, next = { [-1] = 1, [1] = 2 } }
end

local function takeNumber(street, side)
	local n = street.next[side]
	street.next[side] = n + 2
	return n
end

---------------------------------------------------------------------------
-- Funções auxiliares
---------------------------------------------------------------------------

local function makePart(parent, props)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Color = props.Color or Color3.new(1, 1, 1)
	p.Size = props.Size
	p.CFrame = props.CFrame
	if props.Shape then
		p.Shape = props.Shape
	end
	if props.Transparency then
		p.Transparency = props.Transparency
	end
	if props.CanCollide ~= nil then
		p.CanCollide = props.CanCollide
	end
	if props.CastShadow ~= nil then
		p.CastShadow = props.CastShadow
	end
	p.Name = props.Name or "Part"
	p.Parent = parent
	return p
end

local function folder(name, parent)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function model(name, parent)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

-- Cilindro "deitado" no chão (eixo vertical). height = espessura, radius = raio.
local function flatCylinder(parent, name, center, radius, height, color, material)
	return makePart(parent, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material,
	})
end

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

-- Texto pintado na frente (face -Z) de uma peça
local function addSurfaceText(part, text, textColor, bgColor)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = bgColor or Color3.new(1, 1, 1)
	label.BackgroundTransparency = bgColor and 0 or 1
	label.TextColor3 = textColor
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.Parent = gui
end

---------------------------------------------------------------------------
-- Partes do mapa
---------------------------------------------------------------------------

-- Placa de nome de rua (verde, como as de verdade), legível dos dois lados.
-- cf: frente virada para a rua; a placa fica paralela à rua.
local function buildStreetSign(parent, cf, name)
	local sign = model("PlacaDeRua", parent)
	makePart(sign, { Name = "Post", Size = Vector3.new(0.35, 9, 0.35), CFrame = cf * CFrame.new(0, 4.5, 0), Color = Color3.fromRGB(70, 75, 80), Material = Enum.Material.Metal })
	local board = makePart(sign, { Name = "Board", Size = Vector3.new(10, 1.5, 0.2), CFrame = cf * CFrame.new(0, 8.6, 0), Color = Color3.fromRGB(30, 110, 60), CanCollide = false })
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = 0
		gui.Parent = board
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.new(1, 1, 1)
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.Text = name
		label.Parent = gui
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.new(1, 1, 1)
		stroke.Thickness = 3
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = label
	end
end

local function buildGround(parent)
	-- BasePart tem limite de 2048 studs por eixo. Mosaico sem lacunas mantém
	-- a estrada e a prisão apoiadas mesmo quando o mapa ultrapassa esse limite.
	local tiles = math.max(1, math.ceil(M.GroundSize / 1200))
	local tileSize = M.GroundSize / tiles
	for x = 1, tiles do
		for z = 1, tiles do
			makePart(parent, {
				Name = ("Ground_%d_%d"):format(x, z),
				Size = Vector3.new(tileSize, 1, tileSize),
				CFrame = CFrame.new(-M.GroundSize / 2 + (x - 0.5) * tileSize, -0.5, -M.GroundSize / 2 + (z - 0.5) * tileSize),
				Color = C.Grass,
				Material = Enum.Material.Grass,
			})
		end
	end
end

local function buildSpawn(parent)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "StartSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0 -- sem campo de força
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.CFrame = CFrame.new(0, 0.6, 20)
	spawn.Color = C.Sidewalk
	spawn.Material = Enum.Material.Concrete
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = parent
end

-- Tronco em segmentos inclinados, raízes expostas e copa assimétrica.
-- 16 peças por árvore; raízes/copa não atrapalham os caminhos nem criam degraus.
local function buildTree(parent, position, scale)
	scale = scale or 1
	local tree = model("Tree", parent)
	local leafColor = C.Leaves[rng:NextInteger(1, #C.Leaves)]
	local yaw = treeRng:NextNumber(0, math.pi * 2)
	local base = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
	local function world(p) return (base * CFrame.new(p * scale)).Position end
	local function limb(name, a, b, width, collide)
		local pa, pb = world(a), world(b)
		return makePart(tree, {
			Name = name,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new((pb - pa).Magnitude + 0.15 * scale, width * scale, width * scale),
			CFrame = CFrame.lookAt((pa + pb) / 2, pb) * CFrame.Angles(0, math.pi / 2, 0),
			Color = C.Trunk,
			Material = Enum.Material.Wood,
			CanCollide = collide == true,
		})
	end
	local bend = treeRng:NextNumber(0.7, 1.6)
	local low = Vector3.new(0, 0.3, 0)
	local knee = Vector3.new(bend * 0.35, 2.6, -0.25)
	local shoulder = Vector3.new(bend, 4.7, 0.3)
	local top = Vector3.new(bend - 0.45, 6.9, -0.4)
	limb("TroncoBase", low, knee, 1.55, true)
	limb("TroncoCurvo", knee, shoulder, 1.2, true)
	limb("TroncoAlto", shoulder, top, 0.85, true)
	limb("GalhoAberto", shoulder, Vector3.new(-1.8, 6.3, 0.7), 0.65, false)
	limb("GalhoInclinado", top, Vector3.new(2.8, 7.6, 1.3), 0.5, false)
	for i = 1, 4 do
		local angle = i * math.pi / 2 + treeRng:NextNumber(-0.35, 0.35)
		local length = treeRng:NextNumber(2.8, 3.8)
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local elbow = dir * (length * 0.5) + Vector3.new(0, 0.35, 0)
		limb("RaizAparente", Vector3.new(0, 0.65, 0), elbow, 0.8, false)
		limb("PontaDeRaiz", elbow, dir * length + Vector3.new(0, 0.08, 0), 0.38, false)
	end
	local crowns = {
		{ pos = Vector3.new(bend + 0.2, 7.5, 0.8), size = Vector3.new(6.7, 4.7, 5.5) },
		{ pos = Vector3.new(-1.6, 7.1, 0.4), size = Vector3.new(4.3, 3.8, 4.8) },
		{ pos = Vector3.new(2.2, 8.9, -0.5), size = Vector3.new(4.8, 3.7, 4.2) },
	}
	for i, crown in ipairs(crowns) do
		local variation = treeRng:NextNumber(0.9, 1.08)
		makePart(tree, {
			Name = "CopaIrregular" .. i,
			Shape = Enum.PartType.Ball,
			Size = crown.size * (scale * variation),
			CFrame = CFrame.new(world(crown.pos)) * CFrame.Angles(0.12 * i, yaw + 0.3 * i, 0.15 * (i - 2)),
			Color = leafColor:Lerp(C.Leaves[(i % #C.Leaves) + 1], 0.18),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	tree:SetAttribute("OrganicRoots", true)
	return tree
end

-- Praça central: é o primeiro lugar que o jogador vê, então é a parte mais caprichada.
-- Chafariz de 3 andares com água caindo, piso de pedra com desenho, letreiro da cidade,
-- coreto, gramados com árvores e flores, palmeiras, bancos, postes antigos e carrinho de sorvete.
-- Ângulo 90° = lado do ponto de nascimento (+Z), onde ficam o Seu Bento e o quadro de empregos.
local function buildRoundabout(parent)
	local f = folder("Roundabout", parent)
	local R = M.RoundaboutIslandRadius
	local STONE = Color3.fromRGB(214, 196, 170)
	local STONE_DARK = Color3.fromRGB(176, 150, 125)
	local MARBLE = Color3.fromRGB(240, 238, 232)
	local IRON = Color3.fromRGB(40, 44, 48)
	local function polar(angleDeg, radius, y)
		local a = math.rad(angleDeg)
		return Vector3.new(math.cos(a) * radius, y or 0, math.sin(a) * radius)
	end

	-- Asfalto da rotatória, meio-fio e piso de pedra
	flatCylinder(f, "RoundaboutRoad", Vector3.new(0, ROAD_TOP + 0.05 - 0.5, 0), M.RoundaboutOuterRadius, 1, C.Asphalt, Enum.Material.Asphalt)
	flatCylinder(f, "Curb", Vector3.new(0, 0.4, 0), R + 1, 1, C.Sidewalk, Enum.Material.Concrete)
	flatCylinder(f, "Plaza", Vector3.new(0, 0.45, 0), R, 1, STONE, Enum.Material.Pavement)
	-- desenho no piso: anéis e raios de pedra mais escura
	for _, ring in ipairs({ { 15, 2 }, { 34, 1.6 } }) do
		local n = 28
		for i = 1, n do
			local a1, a2 = (i - 1) / n * 360, i / n * 360
			local p1, p2 = polar(a1, ring[1], 0.97), polar(a2, ring[1], 0.97)
			makePart(f, { Name = "FloorRing", Size = Vector3.new(ring[2], 0.06, (p2 - p1).Magnitude + 0.3), CFrame = CFrame.lookAt((p1 + p2) / 2, p2), Color = STONE_DARK, Material = Enum.Material.Pavement, CanCollide = false, CastShadow = false })
		end
	end
	for i = 0, 7 do
		local p1, p2 = polar(i * 45, 16, 0.97), polar(i * 45, R - 1, 0.97)
		makePart(f, { Name = "FloorRay", Size = Vector3.new(1.6, 0.06, (p2 - p1).Magnitude), CFrame = CFrame.lookAt((p1 + p2) / 2, p2), Color = STONE_DARK, Material = Enum.Material.Pavement, CanCollide = false, CastShadow = false })
	end

	-- Chafariz de 3 andares
	local function bowl(name, y, radius, depth)
		flatCylinder(f, name .. "Rim", Vector3.new(0, y, 0), radius, depth, MARBLE, Enum.Material.Marble)
		local water = flatCylinder(f, name .. "Water", Vector3.new(0, y + depth / 2 - 0.05, 0), radius - 0.6, 0.15, C.Water, Enum.Material.Glass)
		water.Transparency = 0.2
		water.CanCollide = false
	end
	bowl("Basin", 1.5, 11, 2)
	flatCylinder(f, "BasinStep", Vector3.new(0, 0.8, 0), 12, 0.6, STONE_DARK, Enum.Material.Pavement)
	makePart(f, { Name = "Column", Shape = Enum.PartType.Cylinder, Size = Vector3.new(6, 2.2, 2.2), CFrame = CFrame.new(0, 5, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = MARBLE, Material = Enum.Material.Marble })
	bowl("Middle", 7.6, 5.5, 1)
	makePart(f, { Name = "Column2", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 1.4, 1.4), CFrame = CFrame.new(0, 9.6, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = MARBLE, Material = Enum.Material.Marble })
	bowl("Top", 11.3, 2.6, 0.8)
	makePart(f, { Name = "Finial", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), CFrame = CFrame.new(0, 12.6, 0), Color = Color3.fromRGB(220, 180, 70), Material = Enum.Material.Metal })
	-- água caindo (partículas) no topo e nos jatinhos em volta
	local function spray(pos, speed, rate, size)
		local emitterPart = makePart(f, { Name = "Spray", Size = Vector3.new(0.4, 0.4, 0.4), CFrame = CFrame.new(pos), Transparency = 1, CanCollide = false })
		emitterPart.CanQuery = false
		local e = Instance.new("ParticleEmitter")
		e.Color = ColorSequence.new(Color3.fromRGB(200, 235, 255))
		e.LightEmission = 0.3
		e.Size = NumberSequence.new(size)
		e.Transparency = NumberSequence.new(0.2, 0.8)
		e.Lifetime = NumberRange.new(0.9, 1.3)
		e.Rate = rate
		e.Speed = NumberRange.new(speed)
		e.SpreadAngle = Vector2.new(25, 25)
		e.Acceleration = Vector3.new(0, -30, 0)
		e.EmissionDirection = Enum.NormalId.Top
		e.Parent = emitterPart
	end
	spray(Vector3.new(0, 13.2, 0), 12, 40, 0.6)
	for i = 0, 7 do
		spray(polar(i * 45 + 22.5, 9.5, 2.3), 10, 12, 0.4)
	end
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(150, 210, 255)
	glow.Range = 16
	glow.Brightness = 0.8
	glow.Parent = f:FindFirstChild("BasinWater")

	-- Anel de flores em volta do chafariz
	for i = 1, 32 do
		local p = polar(i / 32 * 360, 13.6, 1.2)
		makePart(f, { Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.new(1.5, 1.2, 1.5), CFrame = CFrame.new(p), Color = C.Flowers[(i % #C.Flowers) + 1], Material = Enum.Material.Grass, CanCollide = false })
	end

	-- 4 gramados com árvore/coreto e flores (nas diagonais, entre os caminhos)
	local function lawn(angleDeg)
		local center = polar(angleDeg, 30, 0)
		flatCylinder(f, "Lawn", center + Vector3.new(0, 1.0, 0), 9, 0.3, C.GrassDark, Enum.Material.Grass)
		flatCylinder(f, "LawnBorder", center + Vector3.new(0, 0.95, 0), 9.6, 0.25, MARBLE, Enum.Material.Marble)
		for k = 1, 10 do
			local p = center + polar(k * 36, 7.6, 1.6)
			makePart(f, { Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.1, 1.4), CFrame = CFrame.new(p), Color = C.Flowers[((k + angleDeg) % #C.Flowers) + 1], Material = Enum.Material.Grass, CanCollide = false })
		end
		return center
	end
	local lawns = {}
	for _, a in ipairs({ 45, 135, 225, 315 }) do
		lawns[a] = lawn(a)
	end
	buildTree(f, lawns[45] + Vector3.new(0, 1, 0), 1.3)
	buildTree(f, lawns[135] + Vector3.new(0, 1, 0), 1.3)
	buildTree(f, lawns[315] + Vector3.new(0, 1, 0), 1.2)

	-- Coreto (clássico de praça) no gramado de 225°
	local gz = model("Coreto", f)
	local gc = lawns[225]
	flatCylinder(gz, "Floor", gc + Vector3.new(0, 1.6, 0), 6.5, 1.2, MARBLE, Enum.Material.Marble)
	for k = 0, 7 do
		local p = gc + polar(k * 45, 5.8, 0)
		makePart(gz, { Name = "Column", Size = Vector3.new(0.5, 8, 0.5), CFrame = CFrame.new(p + Vector3.new(0, 6.2, 0)), Color = Color3.new(1, 1, 1) })
		local q = gc + polar(k * 45 + 45, 5.8, 0)
		if k ~= 2 then -- uma abertura para entrar
			makePart(gz, { Name = "Rail", Size = Vector3.new(0.25, 1.2, (q - p).Magnitude), CFrame = CFrame.lookAt((p + q) / 2 + Vector3.new(0, 3, 0), q + Vector3.new(0, 3, 0)), Color = Color3.new(1, 1, 1) })
		end
	end
	for k = 0, 7 do
		local p = gc + polar(k * 45 + 22.5, 3.4, 0)
		makePart(gz, {
			ClassName = "WedgePart",
			Name = "Roof",
			Size = Vector3.new(4.8, 2.6, 3.8),
			CFrame = CFrame.lookAt(p + Vector3.new(0, 11.4, 0), gc + Vector3.new(0, 11.4, 0)) * CFrame.Angles(0, math.pi, 0),
			Color = Color3.fromRGB(190, 70, 60),
		})
	end
	makePart(gz, { Name = "RoofTop", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.2, 1.2), CFrame = CFrame.new(gc + Vector3.new(0, 13.1, 0)), Color = Color3.fromRGB(220, 180, 70), Material = Enum.Material.Metal })

	-- Letreiro da cidade atrás do chafariz, de frente para quem nasce
	local sign = model("LetreiroCidade", f)
	local signCf = CFrame.lookAt(Vector3.new(0, 0, -21), Vector3.new(0, 0, 20))
	makePart(sign, { Name = "Base", Size = Vector3.new(26, 1.6, 3), CFrame = signCf * CFrame.new(0, 1.7, 0), Color = MARBLE, Material = Enum.Material.Marble })
	local board = makePart(sign, { Name = "Board", Size = Vector3.new(24, 4, 0.6), CFrame = signCf * CFrame.new(0, 4.6, 0), Color = Color3.fromRGB(30, 80, 150) })
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 30
		gui.LightInfluence = 0
		gui.Parent = board
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.RichText = true
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		-- cada letra de uma cor (bem colorido)
		local colors = { "#FF6B6B", "#FFD93D", "#6BCB77", "#4D96FF", "#FF9F45", "#C77DFF" }
		local text, k = "", 0
		for _, ch in utf8.codes(GameConfig.CityName) do
			local c = utf8.char(ch)
			if c ~= " " then
				k += 1
			end
			text ..= ('&lt;font color="%s"&gt;%s&lt;/font&gt;'):format(colors[(k % #colors) + 1], c)
		end
		label.Text = text
		label.Parent = gui
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 3
		stroke.Color = Color3.new(1, 1, 1)
		stroke.Parent = label
	end
	for _, x in ipairs({ -12.5, 12.5 }) do
		makePart(sign, { Name = "Post", Size = Vector3.new(1, 6.6, 1), CFrame = signCf * CFrame.new(x, 3.3, 0), Color = MARBLE, Material = Enum.Material.Marble })
	end
	for _, x in ipairs({ -9, -3, 3, 9 }) do
		makePart(sign, { Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.new(2, 1.6, 2), CFrame = signCf * CFrame.new(x, 2.8, -1.4), Color = C.Flowers[(x % #C.Flowers) + 1], Material = Enum.Material.Grass, CanCollide = false })
	end

	-- Bancos de madeira com pés de ferro, virados para o chafariz (sentar com E)
	for _, a in ipairs({ 22.5, 157.5, 202.5, 247.5, 292.5, 337.5 }) do
		local pos = polar(a, 21, 0.95)
		local cf = CFrame.lookAt(pos, Vector3.new(0, 0.95, 0))
		local bench = model("Bench", f)
		makePart(bench, { ClassName = "Seat", Name = "Seat", Size = Vector3.new(6, 0.4, 2), CFrame = cf * CFrame.new(0, 1.6, 0), Color = Color3.fromRGB(150, 95, 55), Material = Enum.Material.Wood })
		makePart(bench, { Name = "Back", Size = Vector3.new(6, 1.6, 0.3), CFrame = cf * CFrame.new(0, 2.8, 0.9) * CFrame.Angles(math.rad(-10), 0, 0), Color = Color3.fromRGB(150, 95, 55), Material = Enum.Material.Wood })
		for _, x in ipairs({ -2.6, 2.6 }) do
			makePart(bench, { Name = "Leg", Size = Vector3.new(0.3, 1.6, 2), CFrame = cf * CFrame.new(x, 0.8, 0.1), Color = IRON, Material = Enum.Material.Metal })
		end
	end

	-- Postes antigos (dois globos) e palmeiras no anel de fora
	local function oldLamp(pos)
		local lamp = model("PosteAntigo", f)
		makePart(lamp, { Name = "Pole", Size = Vector3.new(0.5, 9, 0.5), CFrame = CFrame.new(pos + Vector3.new(0, 5.4, 0)), Color = IRON, Material = Enum.Material.Metal })
		makePart(lamp, { Name = "Arm", Size = Vector3.new(3.2, 0.25, 0.25), CFrame = CFrame.new(pos + Vector3.new(0, 9.4, 0)), Color = IRON, Material = Enum.Material.Metal })
		for _, x in ipairs({ -1.6, 1.6 }) do
			local globe = makePart(lamp, { Name = "Globe", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.2, 1.2), CFrame = CFrame.new(pos + Vector3.new(x, 10.1, 0)), Color = Color3.fromRGB(255, 245, 210), Material = Enum.Material.Neon })
			local l = Instance.new("PointLight")
			l.Range = 14
			l.Brightness = 0.8
			l.Color = Color3.fromRGB(255, 230, 180)
			l.Parent = globe
		end
	end
	for _, a in ipairs({ 0, 90 - 40, 90 + 40, 180, 270 }) do
		oldLamp(polar(a, 40, 0.95))
	end
	local function palm(pos)
		local p = model("Palmeira", f)
		local h = 14
		for k = 0, 6 do
			local y = 1 + k * (h / 7)
			makePart(p, { Name = "Trunk", Size = Vector3.new(1.1 - k * 0.06, h / 7 + 0.1, 1.1 - k * 0.06), CFrame = CFrame.new(pos + Vector3.new(k * 0.18, y + h / 14, 0)), Color = Color3.fromRGB(140, 110, 75), Material = Enum.Material.Wood })
		end
		local top = pos + Vector3.new(1.3, h + 1, 0)
		for k = 0, 6 do
			local a = math.rad(k * 360 / 7)
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			makePart(p, { Name = "Leaf", Size = Vector3.new(1.4, 0.2, 6), CFrame = CFrame.lookAt(top + dir * 2.6, top + dir * 6) * CFrame.Angles(math.rad(-20), 0, 0), Color = Color3.fromRGB(60, 150, 60), Material = Enum.Material.Grass, CanCollide = false })
		end
	end
	for _, a in ipairs({ 22.5 + 45, 157.5 - 45, 202.5, 337.5 }) do
		palm(polar(a, 45, 0.95))
	end

	-- Cerca viva baixa na borda, com aberturas nas faixas de pedestre (a cada 45°)
	for i = 0, 7 do
		for _, half in ipairs({ -1, 1 }) do
			local a1 = i * 45 + half * 9
			local a2 = i * 45 + half * 36
			local p1, p2 = polar(a1, R - 2, 1.6), polar(a2, R - 2, 1.6)
			makePart(f, { Name = "Hedge", Size = Vector3.new(1.4, 1.4, (p2 - p1).Magnitude), CFrame = CFrame.lookAt((p1 + p2) / 2, p2), Color = C.Leaves[1], Material = Enum.Material.Grass })
		end
	end

	-- Carrinho de sorvete
	local cart = model("CarrinhoSorvete", f)
	local cartCf = CFrame.lookAt(polar(200, 33, 0.95), Vector3.new(0, 0.95, 0))
	makePart(cart, { Name = "Box", Size = Vector3.new(4, 2.6, 2.4), CFrame = cartCf * CFrame.new(0, 2.2, 0), Color = Color3.fromRGB(250, 245, 235) })
	makePart(cart, { Name = "Stripe", Size = Vector3.new(4.05, 0.5, 2.45), CFrame = cartCf * CFrame.new(0, 2.6, 0), Color = Color3.fromRGB(240, 120, 160) })
	makePart(cart, { Name = "Umbrella", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 6, 6), CFrame = cartCf * CFrame.new(0, 7, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(240, 120, 160), CanCollide = false })
	makePart(cart, { Name = "UmbrellaPole", Size = Vector3.new(0.2, 3.6, 0.2), CFrame = cartCf * CFrame.new(0, 5.2, 0), Color = IRON })
	for _, x in ipairs({ -1.6, 1.6 }) do
		makePart(cart, { Name = "Wheel", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 1.4, 1.4), CFrame = cartCf * CFrame.new(x, 1.3, 1.3), Color = IRON })
	end
	for k = 0, 2 do
		makePart(cart, { Name = "Scoop", Shape = Enum.PartType.Ball, Size = Vector3.new(0.7, 0.7, 0.7), CFrame = cartCf * CFrame.new(-1 + k, 3.7, 0), Color = ({ Color3.fromRGB(250, 200, 220), Color3.fromRGB(140, 90, 60), Color3.fromRGB(250, 240, 200) })[k + 1] })
	end
end


local function buildLamp(parent, cf)
	local lamp = model("StreetLamp", parent)
	makePart(lamp, {
		Name = "Pole",
		Size = Vector3.new(0.6, 12, 0.6),
		CFrame = cf * CFrame.new(0, 6 + SIDEWALK_TOP, 0),
		Color = Color3.fromRGB(50, 55, 60),
		Material = Enum.Material.Metal,
	})
	local head = makePart(lamp, {
		Name = "Light",
		Size = Vector3.new(1.6, 0.8, 1.6),
		CFrame = cf * CFrame.new(0, 12.3 + SIDEWALK_TOP, 0),
		Color = Color3.fromRGB(255, 240, 200),
		Material = Enum.Material.Neon,
	})
	local light = Instance.new("PointLight")
	light.Range = 18
	light.Brightness = 1
	light.Color = Color3.fromRGB(255, 230, 180)
	light.Parent = head
end

---------------------------------------------------------------------------
-- Espaço ocupado: cada lote, rua e árvore vira um retângulo (visto de cima).
-- Nada é construído onde já existe algo: assim casas, lojas e ruas nunca se sobrepõem.
---------------------------------------------------------------------------

local blocks = {}

local function rect(cf, sizeX, sizeZ)
	local r, l = cf.RightVector, cf.LookVector
	return {
		c = Vector2.new(cf.X, cf.Z),
		ax = Vector2.new(r.X, r.Z).Unit,
		az = Vector2.new(l.X, l.Z).Unit,
		hx = sizeX / 2,
		hz = sizeZ / 2,
	}
end

local function reach(o, axis)
	return o.hx * math.abs(o.ax:Dot(axis)) + o.hz * math.abs(o.az:Dot(axis))
end

local function overlaps(a, b)
	for _, axis in ipairs({ a.ax, a.az, b.ax, b.az }) do
		if math.abs((b.c - a.c):Dot(axis)) &gt; reach(a, axis) + reach(b, axis) then
			return false
		end
	end
	return true
end

local function isFree(o)
	local radius = math.sqrt(o.hx * o.hx + o.hz * o.hz)
	if o.c.Magnitude - radius &lt; M.RoundaboutOuterRadius + M.SidewalkWidth + 3 then
		return false -- praça e rotatória
	end
	local edge = M.GroundSize / 2 - 4
	if math.abs(o.c.X) + radius &gt; edge or math.abs(o.c.Y) + radius &gt; edge then
		return false
	end
	for _, b in ipairs(blocks) do
		if overlaps(o, b) then
			return false
		end
	end
	return true
end

local function occupy(o)
	table.insert(blocks, o)
end

-- Trecho de rua: guarda para as construções não invadirem (asfalto + calçadas)
local roads = {} -- { a, b } em Vector3
local function addRoadArea(a, b)
	table.insert(roads, { a = a, b = b })
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(mid, b)
	occupy(rect(cf, M.RoadWidth + 2 * M.SidewalkWidth + 1, (b - a).Magnitude + M.RoadWidth))
end

-- Lote ao lado de uma rua. t = distância desde o início do trecho; side = +1 direita, -1 esquerda.
-- Devolve o CFrame do centro do lote, com a frente (-Z) virada para a rua.
local function lotBeside(a, b, t, side, depth)
	local dir = (b - a).Unit
	local perp = Vector3.new(-dir.Z, 0, dir.X)
	local offset = M.RoadWidth / 2 + M.SidewalkWidth + 0.6 + depth / 2
	local center = a + dir * t + perp * side * offset
	return CFrame.lookAt(center, center - perp * side)
end

---------------------------------------------------------------------------
-- Ruas
---------------------------------------------------------------------------

local function sidewalkStrip(parent, a, b, side)
	local dir = (b - a).Unit
	local perp = Vector3.new(-dir.Z, 0, dir.X)
	local len = (b - a).Magnitude
	if len &lt; 2 then
		return
	end
	local mid = (a + b) / 2 + perp * side * (M.RoadWidth / 2 + M.SidewalkWidth / 2)
	makePart(parent, {
		Name = "Sidewalk",
		Size = Vector3.new(M.SidewalkWidth, 1, len),
		CFrame = CFrame.lookAt(mid, mid + dir) + Vector3.new(0, SIDEWALK_TOP - 0.5, 0),
		Color = C.Sidewalk,
		Material = Enum.Material.Concrete,
	})
end

local function dashes(parent, a, b, skip)
	local dir = (b - a).Unit
	local len = (b - a).Magnitude
	for d = 10, len - 10, 14 do
		local p = a + dir * d
		local blocked = false
		for _, s in ipairs(skip or {}) do
			if (p - s).Magnitude &lt; CROSSING_GAP then
				blocked = true
			end
		end
		if not blocked then
			makePart(parent, {
				Name = "Line",
				Size = Vector3.new(0.6, 0.1, 6),
				CFrame = CFrame.lookAt(p, p + dir) + Vector3.new(0, ROAD_TOP + 0.08, 0),
				Color = C.RoadLine,
				CanCollide = false,
				CastShadow = false,
			})
		end
	end
end

local function asphalt(parent, a, b, extra, lift)
	local mid = (a + b) / 2
	makePart(parent, {
		Name = "Asphalt",
		Size = Vector3.new(M.RoadWidth, 1, (b - a).Magnitude + extra),
		CFrame = CFrame.lookAt(mid, b) + Vector3.new(0, ROAD_TOP - 0.5 + lift, 0),
		Color = C.Asphalt,
		Material = Enum.Material.Asphalt,
	})
end

-- Faixa de pedestres atravessando a rua no ponto p
local function crosswalk(parent, p, dir)
	local perp = Vector3.new(-dir.Z, 0, dir.X)
	for i = -4, 4 do
		local s = p + perp * i * 2.4
		makePart(parent, {
			Name = "Crosswalk",
			Size = Vector3.new(1.4, 0.1, 5),
			CFrame = CFrame.lookAt(s, s + dir) + Vector3.new(0, ROAD_TOP + 0.08, 0),
			Color = C.RoadLine,
			CanCollide = false,
			CastShadow = false,
		})
	end
end

local function buildRoads(parent, dirs)
	local f = folder("Roads", parent)
	local inner, outer = M.InnerRingRadius, RADIAL_END
	-- 8 ruas radiais; calçadas interrompidas onde cruzam os anéis
	for _, dir in ipairs(dirs) do
		local road = folder("Road", f)
		local a, b = dir * RADIAL_START, dir * RADIAL_END
		asphalt(road, a, b, 0, 0)
		addRoadArea(dir * (M.RoundaboutOuterRadius - 4), b)
		local cuts = {
			{ M.RoundaboutOuterRadius, inner - CROSSING_GAP },
			{ inner + CROSSING_GAP, outer - CROSSING_GAP },
		}
		for _, cut in ipairs(cuts) do
			for _, side in ipairs({ -1, 1 }) do
				sidewalkStrip(road, dir * cut[1], dir * cut[2], side)
			end
		end
		dashes(road, dir * (M.RoundaboutOuterRadius + 4), b, { dir * inner })
		crosswalk(road, dir * (M.RoundaboutOuterRadius + 10), dir)
	end
	-- Anel do meio e anel externo (octógonos ligando as radiais)
	for _, radius in ipairs({ inner, outer }) do
		local ring = folder(radius == inner and "InnerRing" or "OuterRing", f)
		for i, dir in ipairs(dirs) do
			local nextDir = dirs[(i % #dirs) + 1]
			local a, b = dir * radius, nextDir * radius
			asphalt(ring, a, b, M.RoadWidth, 0.06)
			addRoadArea(a, b)
			local along = (b - a).Unit
			for _, side in ipairs({ -1, 1 }) do
				sidewalkStrip(ring, a + along * CROSSING_GAP, b - along * CROSSING_GAP, side)
			end
			dashes(ring, a, b, { a, b })
		end
	end
end

local function buildStreetLamps(parent, dirs)
	local lateral = M.RoadWidth / 2 + M.SidewalkWidth / 2 + 1
	for _, dir in ipairs(dirs) do
		local perp = Vector3.new(-dir.Z, 0, dir.X)
		local n = 0
		for d = M.RoundaboutOuterRadius + 30, RADIAL_END - 30, 60 do
			if math.abs(d - M.InnerRingRadius) &gt; CROSSING_GAP + 4 then
				n += 1
				local side = (n % 2 == 0) and 1 or -1
				local p = dir * d + perp * side * lateral
				buildLamp(parent, CFrame.lookAt(p, p - perp * side))
			end
		end
	end
end

---------------------------------------------------------------------------
-- Casas (3 modelos: térrea com varanda, sobrado com sacada, casa com garagem)
---------------------------------------------------------------------------

local HOUSE_LOT_D = 38
local houseCount = 0

local function gableRoof(parent, cf, w, d, wallTop, color, wallColor)
	local angle = math.rad(28)
	local rise = (d / 2) * math.tan(angle)
	local slope = (d / 2) / math.cos(angle) + 1.6
	for _, side in ipairs({ -1, 1 }) do
		makePart(parent, {
			Name = "Roof",
			Size = Vector3.new(w + 2.4, 0.8, slope),
			CFrame = cf * CFrame.new(0, wallTop + rise / 2 + 0.3, side * d / 4) * CFrame.Angles(side * angle, 0, 0),
			Color = color,
		})
	end
	for _, x in ipairs({ -w / 2 + 0.5, w / 2 - 0.5 }) do
		for _, back in ipairs({ false, true }) do
			makePart(parent, {
				ClassName = "WedgePart",
				Name = "Gable",
				Size = Vector3.new(1, rise, d / 2),
				CFrame = cf * CFrame.new(x, wallTop + rise / 2, (back and 1 or -1) * d / 4) * (back and CFrame.Angles(0, math.pi, 0) or CFrame.new()),
				Color = wallColor,
			})
		end
	end
	return rise
end

-- Janela com moldura branca e peitoril
local function window(parent, cf, w, h)
	makePart(parent, { Name = "WindowFrame", Size = Vector3.new(w + 0.6, h + 0.6, 0.25), CFrame = cf, Color = Color3.fromRGB(250, 250, 248) })
	makePart(parent, { Name = "Window", Size = Vector3.new(w, h, 0.3), CFrame = cf * CFrame.new(0, 0, -0.05), Color = C.Window, Material = Enum.Material.Glass, Transparency = 0.15 })
	makePart(parent, { Name = "Sill", Size = Vector3.new(w + 1, 0.3, 0.6), CFrame = cf * CFrame.new(0, -h / 2 - 0.4, -0.2), Color = Color3.fromRGB(250, 250, 248) })
end

local function bush(parent, pos, size)
	makePart(parent, {
		Name = "Bush",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(size, size * 0.8, size),
		CFrame = CFrame.new(pos + Vector3.new(0, size * 0.3, 0)),
		Color = C.Leaves[rng:NextInteger(1, #C.Leaves)],
		Material = Enum.Material.Grass,
		CanCollide = false,
	})
end

-- lotCf = centro do lote, frente (-Z) virada para a rua
-- address = { street = nome da rua, number = número na rua }
local function buildHouse(parent, lotCf, lotW, variant, address)
	houseCount += 1
	local id = houseCount -- número único (nome do modelo e do ponto de entrega)
	local number = address.number
	local functional = id &lt;= 6
	local house = model("Casa " .. id, parent)
	local wallColor = C.Walls[rng:NextInteger(1, #C.Walls)]
	local roofColor = C.Roofs[rng:NextInteger(1, #C.Roofs)]
	local garage = variant == 3
	local twoFloors = variant == 2
	local w = garage and (lotW - 22) or (lotW - 12)
	local d = 18
	local h = twoFloors and 20 or 11
	local frontZ = -HOUSE_LOT_D / 2 + 11 -- frente da casa (depois do jardim)
	local bodyX = garage and -5 or 0
	local cf = lotCf * CFrame.new(bodyX, 0, frontZ + d / 2)
	local front = -d / 2

	makePart(house, { Name = "Foundation", Size = Vector3.new(w + 2, 1, d + 2), CFrame = cf * CFrame.new(0, 0.5, 0), Color = C.Sidewalk, Material = Enum.Material.Concrete })
	makePart(house, { Name = "Walls", Size = Vector3.new(w, h, d), CFrame = cf * CFrame.new(0, 1 + h / 2, 0), Color = wallColor })
	makePart(house, { Name = "BaseBand", Size = Vector3.new(w + 0.2, 1.2, d + 0.2), CFrame = cf * CFrame.new(0, 1.6, 0), Color = Color3.fromRGB(150, 140, 130), Material = Enum.Material.Slate })
	gableRoof(house, cf, w, d, 1 + h, roofColor, wallColor)

	-- Porta com moldura e plaquinha do número
	makePart(house, { Name = "DoorFrame", Size = Vector3.new(5, 8, 0.3), CFrame = cf * CFrame.new(0, 1 + 4, front - 0.1), Color = Color3.fromRGB(250, 250, 248) })
	makePart(house, { Name = "Door", Size = Vector3.new(4, 7, 0.4), CFrame = cf * CFrame.new(0, 1 + 3.5, front - 0.2), Color = C.Door, Material = Enum.Material.Wood })
	local plate = makePart(house, { Name = "NumberPlate", Size = Vector3.new(1.6, 1, 0.1), CFrame = cf * CFrame.new(3.4, 1 + 6, front - 0.1), Color = Color3.fromRGB(30, 60, 110) })
	addSurfaceText(plate, tostring(number), Color3.new(1, 1, 1), Color3.fromRGB(30, 60, 110))

	-- Janelas do térreo (e do andar de cima no sobrado)
	local wx = math.min(w / 2 - 3.5, 7)
	for _, x in ipairs({ -wx, wx }) do
		window(house, cf * CFrame.new(x, 1 + 5.5, front - 0.15), 4, 4)
	end
	if twoFloors then
		for _, x in ipairs({ -wx, 0, wx }) do
			window(house, cf * CFrame.new(x, 1 + 15, front - 0.15), 3.6, 4)
		end
		-- Sacada com vidro
		makePart(house, { Name = "Balcony", Size = Vector3.new(8, 0.5, 3), CFrame = cf * CFrame.new(0, 1 + 11.2, front - 1.5), Color = Color3.fromRGB(240, 240, 238) })
		makePart(house, { Name = "BalconyGlass", Size = Vector3.new(8, 2.4, 0.2), CFrame = cf * CFrame.new(0, 1 + 12.6, front - 2.9), Color = Color3.fromRGB(200, 230, 245), Material = Enum.Material.Glass, Transparency = 0.5 })
	else
		-- Varanda com colunas
		makePart(house, { Name = "Porch", Size = Vector3.new(math.min(w - 2, 14), 0.6, 5), CFrame = cf * CFrame.new(0, 1.3, front - 2.5), Color = Color3.fromRGB(170, 130, 95), Material = Enum.Material.WoodPlanks })
		local pw = math.min(w - 2, 14)
		for _, x in ipairs({ -pw / 2 + 0.5, pw / 2 - 0.5 }) do
			makePart(house, { Name = "Column", Size = Vector3.new(0.7, 7.5, 0.7), CFrame = cf * CFrame.new(x, 1.6 + 3.75, front - 4.5), Color = Color3.fromRGB(250, 250, 248) })
		end
		makePart(house, { Name = "PorchRoof", Size = Vector3.new(pw + 1, 0.5, 5.6), CFrame = cf * CFrame.new(0, 9.6, front - 2.6) * CFrame.Angles(math.rad(-10), 0, 0), Color = roofColor })
	end
	if rng:NextNumber() &lt; 0.6 then
		makePart(house, { Name = "Chimney", Size = Vector3.new(2, 7, 2), CFrame = cf * CFrame.new(w / 2 - 4, 1 + h + 3, 3), Color = Color3.fromRGB(150, 80, 60), Material = Enum.Material.Brick })
	end

	-- Garagem ao lado
	if garage then
		local gcf = lotCf * CFrame.new(bodyX + w / 2 + 6, 0, frontZ + 7)
		makePart(house, { Name = "Garage", Size = Vector3.new(12, 9, 14), CFrame = gcf * CFrame.new(0, 1 + 4.5, 0), Color = wallColor })
		makePart(house, { Name = "GarageRoof", Size = Vector3.new(13, 0.6, 15), CFrame = gcf * CFrame.new(0, 10.3, 0), Color = roofColor })
		makePart(house, { Name = "GarageDoor", Size = Vector3.new(9, 7, 0.3), CFrame = gcf * CFrame.new(0, 1 + 3.5, -7.1), Color = Color3.fromRGB(235, 235, 235), Material = Enum.Material.DiamondPlate })
		makePart(house, { Name = "Driveway", Size = Vector3.new(9, 0.2, 12), CFrame = lotCf * CFrame.new(bodyX + w / 2 + 6, 0.6, -HOUSE_LOT_D / 2 + 6), Color = Color3.fromRGB(170, 170, 170), Material = Enum.Material.Concrete, CanCollide = false })
	end

	-- Caminho, cerca viva, caixa de correio e jardim
	local pathLen = 11 - (twoFloors and 0 or 5)
	makePart(house, { Name = "Path", Size = Vector3.new(3, 0.2, pathLen), CFrame = cf * CFrame.new(0, 0.6, front - (twoFloors and 0 or 5) - pathLen / 2), Color = C.Sidewalk, Material = Enum.Material.Concrete, CanCollide = false })
	local hedgeZ = -HOUSE_LOT_D / 2 + 0.8
	local hedgeLen = (lotW - 4) / 2 - 2.5
	for _, dir in ipairs({ -1, 1 }) do
		local x = dir * (2.5 + hedgeLen / 2)
		if not (garage and dir == 1) then
			makePart(house, { Name = "Hedge", Size = Vector3.new(hedgeLen, 1.8, 1.2), CFrame = lotCf * CFrame.new(x + (garage and 0 or 0), 0.9, hedgeZ), Color = C.Leaves[1], Material = Enum.Material.Grass })
		end
	end
	makePart(house, { Name = "MailPost", Size = Vector3.new(0.3, 3.4, 0.3), CFrame = lotCf * CFrame.new(-3.4, 1.7, hedgeZ - 0.3), Color = Color3.fromRGB(60, 60, 65) })
	local mailbox = makePart(house, { Name = "Mailbox", Size = Vector3.new(1, 0.9, 1.6), CFrame = lotCf * CFrame.new(-3.4, 3.6, hedgeZ - 0.3), Color = Color3.fromRGB(200, 60, 50), CanCollide = false })
	-- número também na caixa de correio (dá para ler da rua)
	local mailPlate = makePart(house, { Name = "MailNumber", Size = Vector3.new(0.9, 0.6, 0.05), CFrame = mailbox.CFrame * CFrame.new(0, 0, -0.83), Color = Color3.new(1, 1, 1), CanCollide = false })
	addSurfaceText(mailPlate, tostring(number), Color3.fromRGB(30, 60, 110), Color3.new(1, 1, 1))
	bush(house, (cf * CFrame.new(-w / 2 + 1.5, 0, front - 1.5)).Position, 2.6)
	bush(house, (cf * CFrame.new(w / 2 - 1.5, 0, front - 1.5)).Position, 2.6)
	if rng:NextNumber() &lt; 0.5 then
		buildTree(house, (lotCf * CFrame.new(rng:NextNumber(-lotW / 2 + 4, lotW / 2 - 4), 0, HOUSE_LOT_D / 2 - 3)).Position, 0.9)
	end

	house:SetAttribute("HouseNumber", id)
	house:SetAttribute("Street", address.street)
	house:SetAttribute("StreetNumber", number)
	house:SetAttribute("Address", ("%s, %d"):format(address.street, number))
	if functional then
		house:SetAttribute("Functional", true) -- interior será adicionado no Marco 6
	end
	return house
end

---------------------------------------------------------------------------
-- Prédios (comércio no térreo, apartamentos em cima). Só fachada por enquanto.
---------------------------------------------------------------------------

local BUSINESS = {
	"Padaria Pão Quente", "Farmácia Vida", "Café da Esquina", "Livraria Letra", "Sorveteria Gelato",
	"Barbearia do Zé", "Floricultura Flora", "Ótica Visão", "Lanchonete Sabor", "Academia Força",
	"Papelaria Arco-Íris", "Lavanderia Bolha", "Doceria Doce Lar", "Brinquedos Kinder", "Açougue Boi Bom",
}
local BUILDING_COLORS = {
	Color3.fromRGB(220, 200, 170), Color3.fromRGB(190, 120, 90), Color3.fromRGB(170, 190, 200),
	Color3.fromRGB(230, 225, 215), Color3.fromRGB(150, 160, 175), Color3.fromRGB(210, 170, 140),
	Color3.fromRGB(120, 170, 160),
}
local AWNINGS = {
	Color3.fromRGB(200, 60, 50), Color3.fromRGB(40, 120, 180), Color3.fromRGB(60, 150, 80),
	Color3.fromRGB(230, 160, 40), Color3.fromRGB(130, 80, 170),
}
local BUILDING_LOT_D = 34

local function buildBuilding(parent, lotCf, lotW, floors, address)
	local b = model("Predio", parent)
	local w, d = lotW - 4, BUILDING_LOT_D - 8
	local floorH = 7
	local groundH = 11 -- térreo alto (loja)
	local h = groundH + (floors - 1) * floorH
	local cf = lotCf * CFrame.new(0, 0, -BUILDING_LOT_D / 2 + 6 + d / 2)
	local front = -d / 2
	local color = BUILDING_COLORS[rng:NextInteger(1, #BUILDING_COLORS)]
	local trim = Color3.fromRGB(245, 245, 240)
	local awning = AWNINGS[rng:NextInteger(1, #AWNINGS)]

	makePart(b, { Name = "Plaza", Size = Vector3.new(lotW, 0.3, BUILDING_LOT_D), CFrame = lotCf * CFrame.new(0, 0.55, 0), Color = Color3.fromRGB(185, 180, 172), Material = Enum.Material.Concrete })
	makePart(b, { Name = "Body", Size = Vector3.new(w, h, d), CFrame = cf * CFrame.new(0, 0.7 + h / 2, 0), Color = color, Material = Enum.Material.SmoothPlastic })
	-- Térreo alto: vitrine, porta, toldo e letreiro. Toldo, letreiro e frisos não colidem
	-- (assim ninguém usa a fachada como escada para subir no prédio).
	makePart(b, { Name = "Shopfront", Size = Vector3.new(w - 4, 7.2, 0.3), CFrame = cf * CFrame.new(0, 0.7 + 4, front - 0.1), Color = Color3.fromRGB(180, 215, 235), Material = Enum.Material.Glass, Transparency = 0.25 })
	makePart(b, { Name = "Door", Size = Vector3.new(4, 7, 0.4), CFrame = cf * CFrame.new(0, 0.7 + 3.5, front - 0.2), Color = Color3.fromRGB(60, 60, 65) })
	makePart(b, { Name = "Awning", Size = Vector3.new(w - 1, 0.4, 3.4), CFrame = cf * CFrame.new(0, 0.7 + 8.3, front - 1.6) * CFrame.Angles(math.rad(-14), 0, 0), Color = awning, CanCollide = false })
	local sign = makePart(b, { Name = "Sign", Size = Vector3.new(math.min(w - 6, 22), 1.8, 0.3), CFrame = cf * CFrame.new(0, 0.7 + 9.8, front - 0.2), Color = Color3.new(1, 1, 1), CanCollide = false })
	addSurfaceText(sign, BUSINESS[rng:NextInteger(1, #BUSINESS)], awning, Color3.new(1, 1, 1))
	local plate = makePart(b, { Name = "NumberPlate", Size = Vector3.new(1.8, 1, 0.1), CFrame = cf * CFrame.new(3, 0.7 + 7.6, front - 0.25), Color = Color3.fromRGB(30, 60, 110), CanCollide = false })
	addSurfaceText(plate, tostring(address.number), Color3.new(1, 1, 1), Color3.fromRGB(30, 60, 110))
	-- Andares: janelas separadas por colunas, na frente e nas laterais + friso
	for f = 1, floors - 1 do
		local y = 0.7 + groundH + (f - 1) * floorH + floorH / 2
		local panes = math.max(2, math.floor((w - 2) / 7))
		local paneW = (w - 2) / panes
		for k = 0, panes - 1 do
			makePart(b, { Name = "Windows", Size = Vector3.new(paneW - 1, 3.6, 0.3), CFrame = cf * CFrame.new(-(w - 2) / 2 + paneW * (k + 0.5), y, front - 0.1), Color = C.Window, Material = Enum.Material.Glass, Transparency = 0.1, CanCollide = false })
		end
		for _, side in ipairs({ -1, 1 }) do
			makePart(b, { Name = "Windows", Size = Vector3.new(0.3, 3.6, d - 4), CFrame = cf * CFrame.new(side * (w / 2 + 0.1), y, 0), Color = C.Window, Material = Enum.Material.Glass, Transparency = 0.1, CanCollide = false })
		end
		makePart(b, { Name = "Ledge", Size = Vector3.new(w + 0.6, 0.4, 0.8), CFrame = cf * CFrame.new(0, y - floorH / 2, front - 0.3), Color = trim, CanCollide = false })
	end
	b:SetAttribute("Address", ("%s, %d"):format(address.street, address.number))
	-- Topo: platibanda, caixa d'água e ar-condicionado
	makePart(b, { Name = "Parapet", Size = Vector3.new(w + 1, 1.2, d + 1), CFrame = cf * CFrame.new(0, 0.7 + h + 0.6, 0), Color = trim })
	makePart(b, { Name = "WaterTank", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 4, 4), CFrame = cf * CFrame.new(w / 4, 0.7 + h + 2.5, d / 4) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(80, 120, 170) })
	makePart(b, { Name = "AC", Size = Vector3.new(3, 2, 3), CFrame = cf * CFrame.new(-w / 4, 0.7 + h + 1.6, -d / 6), Color = Color3.fromRGB(200, 200, 205), Material = Enum.Material.Metal })
	for _, x in ipairs({ -w / 2 + 2, w / 2 - 2 }) do
		local planter = makePart(b, { Name = "Planter", Size = Vector3.new(2.4, 1.2, 2.4), CFrame = lotCf * CFrame.new(x, 1.2, -BUILDING_LOT_D / 2 + 2.5), Color = Color3.fromRGB(120, 115, 110), Material = Enum.Material.Concrete })
		bush(b, planter.Position + Vector3.new(0, 0.4, 0), 2.2)
	end
	return b
end

-- Estabelecimento com interior (dá para entrar). Frente = lado -Z do cframe.
-- Aqui fica só o prédio (paredes, vitrine, porta aberta, teto, luzes, placa).
-- Os móveis e as estações de trabalho de dentro são montados pelo JobSiteBuilder,
-- que encontra o chão de dentro pelo atributo "BaseCFrame" da loja.
local SHOP_W, SHOP_D, SHOP_H = 44, 36, 21
local SHOP_YARD = 10 -- calçadinha entre a loja e a calçada da rua
local function buildShop(parent, cf, name, mainColor, accentColor)
	local W, D, H, T = SHOP_W, SHOP_D, SHOP_H, 1
	local FLOOR = 1 -- altura do chão de dentro
	local DOOR_W, DOOR_H = 6, 9
	local shop = model(name, parent)
	local base = cf * CFrame.new(0, FLOOR, 0)

	makePart(shop, {
		Name = "Yard",
		Size = Vector3.new(W + 6, 0.4, SHOP_YARD),
		CFrame = cf * CFrame.new(0, 0.6, -D / 2 - SHOP_YARD / 2),
		Color = Color3.fromRGB(150, 150, 150),
		Material = Enum.Material.Concrete,
	})
	makePart(shop, {
		Name = "Floor",
		Size = Vector3.new(W, FLOOR - 0.2, D),
		CFrame = cf * CFrame.new(0, 0.2 + (FLOOR - 0.2) / 2, 0),
		Color = Color3.fromRGB(225, 220, 210),
		Material = Enum.Material.SmoothPlastic,
	})

	local function wall(nameW, size, pos, color, material, transparency)
		return makePart(shop, {
			Name = nameW,
			Size = size,
			CFrame = base * CFrame.new(pos),
			Color = color or mainColor,
			Material = material or Enum.Material.SmoothPlastic,
			Transparency = transparency,
		})
	end

	-- Fundo e laterais
	wall("WallBack", Vector3.new(W, H, T), Vector3.new(0, H / 2, D / 2 - T / 2))
	wall("WallLeft", Vector3.new(T, H, D), Vector3.new(-W / 2 + T / 2, H / 2, 0))
	wall("WallRight", Vector3.new(T, H, D), Vector3.new(W / 2 - T / 2, H / 2, 0))

	-- Frente: mureta + vitrine dos dois lados da porta, faixa de cima inteira
	local sideW = (W - DOOR_W) / 2
	local zFront = -D / 2 + T / 2
	for _, dir in ipairs({ -1, 1 }) do
		local x = dir * (DOOR_W / 2 + sideW / 2)
		wall("WallFront", Vector3.new(sideW, 1.5, T), Vector3.new(x, 0.75, zFront))
		wall("Storefront", Vector3.new(sideW - 1, DOOR_H - 1.5, 0.3), Vector3.new(x, 1.5 + (DOOR_H - 1.5) / 2, zFront), Color3.fromRGB(190, 225, 245), Enum.Material.Glass, 0.55)
		wall("WindowPost", Vector3.new(0.6, DOOR_H - 1.5, T), Vector3.new(dir * (W / 2 - 0.8), 1.5 + (DOOR_H - 1.5) / 2, zFront), accentColor)
		wall("DoorFrame", Vector3.new(0.6, DOOR_H, T + 0.2), Vector3.new(dir * (DOOR_W / 2 + 0.3), DOOR_H / 2, zFront), accentColor)
	end
	wall("WallFront", Vector3.new(W, H - DOOR_H, T), Vector3.new(0, DOOR_H + (H - DOOR_H) / 2, zFront))

	-- Teto, beiral e luzes de dentro
	wall("Ceiling", Vector3.new(W, 0.6, D), Vector3.new(0, H + 0.3, 0), Color3.fromRGB(245, 245, 240))
	wall("Parapet", Vector3.new(W + 1, 1.5, D + 1), Vector3.new(0, H + 1.35, 0), accentColor)
	for _, x in ipairs({ -W / 4, W / 4 }) do
		for _, z in ipairs({ -D / 4, D / 4 }) do
			local lamp = wall("CeilingLamp", Vector3.new(5, 0.2, 2), Vector3.new(x, H - 0.1, z), Color3.fromRGB(255, 250, 230), Enum.Material.Neon)
			lamp.CanCollide = false
			local light = Instance.new("PointLight")
			light.Range = 22
			light.Brightness = 1.2
			light.Color = Color3.fromRGB(255, 245, 225)
			light.Shadows = false
			light.Parent = lamp
		end
	end

	-- Toldo e placa
	makePart(shop, {
		Name = "Awning",
		Size = Vector3.new(W - 2, 0.5, 5),
		CFrame = base * CFrame.new(0, DOOR_H + 0.9, -D / 2 - 2.3) * CFrame.Angles(math.rad(-15), 0, 0),
		Color = accentColor,
		CanCollide = false, -- não serve de degrau para subir no telhado
	})
	local sign = makePart(shop, {
		Name = "Sign",
		Size = Vector3.new(W - 8, 5, 0.6),
		CFrame = base * CFrame.new(0, DOOR_H + 6, -D / 2 - 0.3),
		Color = Color3.new(1, 1, 1),
		CanCollide = false,
	})
	-- Fachada mais alta que o telhado (platibanda decorada na frente)
	wall("FrontCrown", Vector3.new(W + 1, 3, T + 0.4), Vector3.new(0, H + 1.5, -D / 2 + T / 2 - 0.2), accentColor)
	addSurfaceText(sign, name, accentColor, Color3.new(1, 1, 1))

	shop:SetAttribute("PlaceName", name)
	shop:SetAttribute("BaseCFrame", base) -- chão de dentro, olhando para a rua
	shop:SetAttribute("InteriorSize", Vector3.new(W - 2 * T, H, D - 2 * T))
	return shop
end

-- Placa de "em breve" no fim de uma rua
local function buildComingSoon(parent, cf, text)
	local sign = model("EmBreve", parent)
	for _, x in ipairs({ -5, 5 }) do
		makePart(sign, {
			Name = "Post",
			Size = Vector3.new(0.8, 9, 0.8),
			CFrame = cf * CFrame.new(x, 4.5, 0),
			Color = Color3.fromRGB(70, 70, 75),
			Material = Enum.Material.Metal,
		})
	end
	local board = makePart(sign, {
		Name = "Board",
		Size = Vector3.new(14, 4.5, 0.5),
		CFrame = cf * CFrame.new(0, 8, 0),
		Color = Color3.fromRGB(30, 80, 150),
	})
	addSurfaceText(board, text, Color3.new(1, 1, 1), Color3.fromRGB(30, 80, 150))
end

---------------------------------------------------------------------------
-- Árvores soltas e parques nos espaços livres
---------------------------------------------------------------------------

local function buildRandomTrees(parent)
	local half = M.GroundSize / 2 - 10
	local placed, attempts = 0, 0
	while placed &lt; M.RandomTrees and attempts &lt; 6000 do
		attempts += 1
		local p = Vector3.new(rng:NextNumber(-half, half), 0, rng:NextNumber(-half, half))
		local spot = rect(CFrame.new(p), 7, 7)
		if isFree(spot) then
			occupy(spot)
			buildTree(parent, p, rng:NextNumber(0.85, 1.4))
			placed += 1
		end
	end
end

local function setupLighting()
	Lighting.ClockTime = 14
	Lighting.Brightness = 2
	Lighting.GlobalShadows = true
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 150)
	Lighting.Ambient = Color3.fromRGB(105, 105, 110) -- deixa o interior das lojas claro
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atm = Instance.new("Atmosphere")
		atm.Density = 0.25
		atm.Color = Color3.fromRGB(200, 220, 240)
		atm.Decay = Color3.fromRGB(110, 140, 170)
		atm.Parent = Lighting
	end
end


---------------------------------------------------------------------------
-- Montagem completa
---------------------------------------------------------------------------

-- Preenche um lado de um trecho de rua com lotes (casas ou prédios) onde couber
local function fillSide(parent, a, b, tStart, tEnd, side, kind, gap, street)
	local t = tStart
	while t &lt;= tEnd do
		local isHouse = kind == "house" or (kind == "mix" and rng:NextNumber() &lt; 0.65)
		local variant = isHouse and rng:NextInteger(1, 3) or nil
		local lotW = isHouse and (variant == 3 and 46 or rng:NextInteger(34, 38)) or rng:NextInteger(32, 40)
		local lotD = isHouse and HOUSE_LOT_D or BUILDING_LOT_D
		local lot = lotBeside(a, b, t, side, lotD)
		local area = rect(lot, lotW + 2, lotD)
		if isFree(area) then
			occupy(area)
			local address = { street = street.name, number = takeNumber(street, side) }
			if isHouse then
				buildHouse(parent.houses, lot, lotW, variant, address)
			else
				local floors = math.clamp(3 + math.floor(t / 110) + rng:NextInteger(0, 2), 3, 10)
				buildBuilding(parent.buildings, lot, lotW, floors, address)
			end
			t += lotW / 2 + (gap or 6) + 20
		else
			t += 6
		end
	end
end

function MapBuilder.build()
	if Workspace:FindFirstChild("Map") then
		print("[MapBuilder] Pasta Map já existe; usando o mapa existente.")
		CivicBuilder.build(Workspace:FindFirstChild("Map"))
		return
	end

	-- Remove a Baseplate padrão do Studio, se houver
	local baseplate = Workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end

	local map = folder("Map", nil) -- monta fora do Workspace e coloca no fim (mais rápido)
	local groups = {
		houses = folder("Houses", map),
		buildings = folder("Buildings", map),
	}
	local shops = folder("JobLocations", map)
	local nature = folder("Nature", map)
	local props = folder("Props", map)

	buildGround(map)
	buildRoundabout(map)
	buildSpawn(map)

	-- 8 ruas saindo da rotatória. Índices ímpares = ruas comerciais, pares = residenciais.
	local dirs = {}
	for i = 0, 7 do
		table.insert(dirs, CFrame.Angles(0, i * math.pi / 4, 0).LookVector)
	end
	buildRoads(map, dirs)

	-- Estabelecimentos primeiro (lugar garantido), perto da praça
	local SHOP_LOT_D = SHOP_D + SHOP_YARD
	local function placeShop(i, side, name, mainColor, accentColor)
		local lot = lotBeside(dirs[i] * RADIAL_START, dirs[i] * RADIAL_END, 150, side, SHOP_LOT_D)
		local area = rect(lot, SHOP_W + 8, SHOP_LOT_D)
		if not isFree(area) then
			warn("[MapBuilder] Sem espaço livre para " .. name)
		end
		occupy(area)
		buildShop(shops, lot * CFrame.new(0, 0, SHOP_YARD / 2), name, mainColor, accentColor)
	end
	placeShop(1, 1, GameConfig.Places.Pizzaria, Color3.fromRGB(245, 225, 190), Color3.fromRGB(200, 50, 45))
	placeShop(1, -1, GameConfig.Places.Mercearia, Color3.fromRGB(235, 240, 220), Color3.fromRGB(40, 140, 70))
	placeShop(3, 1, GameConfig.Places.Entregas, Color3.fromRGB(230, 230, 235), Color3.fromRGB(240, 140, 30))
	placeShop(3, -1, GameConfig.Places.PetShop, Color3.fromRGB(240, 230, 245), Color3.fromRGB(130, 80, 200))

	-- Equipamentos públicos têm lote garantido antes das casas e das árvores.
	-- A delegacia e a LXR têm frente para avenidas e lotes livres; a prisão fica além do bairro.
	local stationArea = rect(CivicConfig.Station.CFrame, CivicConfig.Station.LotSize.X, CivicConfig.Station.LotSize.Z)
	assert(isFree(stationArea), "Lote da delegacia conflita com o mapa: reveja CivicConfig")
	occupy(stationArea)
	for _, site in ipairs({ CivicConfig.Taxi, CivicConfig.Fuel }) do
		assert(site and site.CFrame and site.LotSize, "Configuração de lote público incompleta")
		local area = rect(site.CFrame, site.LotSize.X, site.LotSize.Z)
		assert(isFree(area), "Lote público conflita com o mapa: " .. site.Name)
		occupy(area)
	end
	for _, stop in ipairs(CivicConfig.TaxiStops or {}) do
		occupy(rect(CFrame.new(stop.position), 8, 8))
	end
	occupy(rect(CivicConfig.Prison.CFrame, CivicConfig.Prison.LotSize.X, CivicConfig.Prison.LotSize.Z))
	for _, road in ipairs(CivicConfig.Roads) do
		local cf = CFrame.lookAt((road.a + road.b) / 2, road.b)
		occupy(rect(cf, road.width + 8, (road.b - road.a).Magnitude + 4))
	end
	CivicBuilder.build(map)

	-- Placas das áreas futuras
	for _, entry in ipairs({ { 5, "Centro e Banco: em breve" }, { 7, "Bombeiros: em breve" } }) do
		local lot = lotBeside(dirs[entry[1]] * RADIAL_START, dirs[entry[1]] * RADIAL_END, 60, 1, 6)
		occupy(rect(lot, 16, 6))
		buildComingSoon(props, lot, entry[2])
	end

	-- Ruas residenciais: casas dos dois lados (as 6 primeiras são "funcionais", com interior no Marco 6)
	local streets = {}
	for i = 1, 8 do
		streets[i] = newStreet(STREET_NAMES[i])
	end
	for i = 2, 8, 2 do
		for _, side in ipairs({ -1, 1 }) do
			fillSide(groups, dirs[i] * RADIAL_START, dirs[i] * RADIAL_END, 40, M.RoadLength - 20, side, "house", nil, streets[i])
		end
	end
	-- Ruas comerciais: prédios com lojinhas no térreo
	for i = 1, 7, 2 do
		for _, side in ipairs({ -1, 1 }) do
			fillSide(groups, dirs[i] * RADIAL_START, dirs[i] * RADIAL_END, 40, M.RoadLength - 20, side, "building", 8, streets[i])
		end
	end
	-- Anéis: anel do meio misturado; anel externo só casas, do lado de fora.
	-- Cada anel é UMA rua: a numeração continua de um trecho para o outro.
	local innerStreet, outerStreet = newStreet(INNER_RING_NAME), newStreet(OUTER_RING_NAME)
	for k, dir in ipairs(dirs) do
		local nextDir = dirs[(k % #dirs) + 1]
		local a, b = dir * M.InnerRingRadius, nextDir * M.InnerRingRadius
		local len = (b - a).Magnitude
		for _, side in ipairs({ -1, 1 }) do
			fillSide(groups, a, b, 20, len - 20, side, "mix", nil, innerStreet)
		end
		a, b = dir * RADIAL_END, nextDir * RADIAL_END
		local perp = Vector3.new(-(b - a).Unit.Z, 0, (b - a).Unit.X)
		local outward = perp:Dot((a + b) / 2) &gt; 0 and 1 or -1
		fillSide(groups, a, b, 20, (b - a).Magnitude - 20, outward, "house", 14, outerStreet)
	end

	-- Placas com o nome das ruas: no começo de cada rua (perto da praça), depois do anel do meio
	-- e no começo de cada trecho dos anéis
	local signLateral = M.RoadWidth / 2 + M.SidewalkWidth - 1
	for i, dir in ipairs(dirs) do
		local perp = Vector3.new(-dir.Z, 0, dir.X)
		for _, d in ipairs({ M.RoundaboutOuterRadius + 16, M.InnerRingRadius + CROSSING_GAP + 6 }) do
			local p = dir * d + perp * signLateral
			buildStreetSign(props, CFrame.lookAt(p, p - perp), STREET_NAMES[i])
		end
		local nextDir = dirs[(i % #dirs) + 1]
		for _, ringData in ipairs({ { M.InnerRingRadius, INNER_RING_NAME }, { RADIAL_END, OUTER_RING_NAME } }) do
			local a, b = dir * ringData[1], nextDir * ringData[1]
			local along = (b - a).Unit
			local rp = Vector3.new(-along.Z, 0, along.X)
			local inward = rp:Dot(a) &gt; 0 and -1 or 1 -- placa do lado de dentro do anel
			local p = a + along * (CROSSING_GAP + 6) + rp * inward * signLateral
			buildStreetSign(props, CFrame.lookAt(p, p - rp * inward), ringData[2])
		end
	end

	buildStreetLamps(props, dirs)
	buildRandomTrees(nature)
	setupLighting()

	map.Parent = Workspace
	print(("[MapBuilder] Cidade montada: %d casas, %d prédios, 4 estabelecimentos."):format(houseCount, #groups.buildings:GetChildren()))
end

return MapBuilder
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000001C"><Properties><string name="Name">MarketService</string><ProtectedString name="Source">-- MarketService (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; MarketService
-- Partes "vivas" do Minas Market, ligadas às etapas do Atendente (JobConfig) pelo MissionService:
--   * cliente NPC: entra pela porta, vai até o caixa do atendente, põe as compras na esteira,
--     recebe a sacola, paga, agradece e vai embora;
--   * prateleiras: ficam meio vazias no começo da reposição e enchem quando o atendente repõe.
-- Tudo roda no servidor (todos veem o mesmo cliente). Cada atendente tem o próprio caixa (lane).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local JobConfig = require(Shared:WaitForChild("JobConfig"))
local NPCKit = require(script.Parent:WaitForChild("NPCKit"))

local MarketService = {}

local market -- JobSiteBuilder.market
local sites -- JobSiteBuilder
local customers = {} -- customers[player] = { npc, humanoid, lane, arriveAt }
local rng = Random.new()

local WALK_SPEED = 12
local GREETINGS = { "Oi! Só isso hoje.", "Boa tarde!", "Olá! Tudo bem?", "Oi, vou levar esses." }
local BEEP = "rbxasset://sounds/electronicpingshort.wav" -- som que já vem com o Roblox
local pick = NPCKit.pick
local say = NPCKit.say

local function now()
	return Workspace:GetServerTimeNow()
end

-- Clientes do caixa são "importantes": sempre aparecem, mesmo com a cidade cheia de NPCs
local function newCustomer(startCf)
	local npc = NPCKit.spawn(startCf, { name = "Cliente", speed = WALK_SPEED, important = true })
	return npc, npc and npc:FindFirstChildOfClass("Humanoid")
end

local function walk(c, points, faceDir)
	if c.npc then
		NPCKit.walk(c.npc, points, faceDir)
	end
end

local function pathLength(points)
	local total = 0
	for i = 2, #points do
		total += (points[i].Position - points[i - 1].Position).Magnitude
	end
	return total
end

local function hideSlots(lane)
	local data = market and market.lanes[lane]
	if not data then
		return
	end
	for _, slot in ipairs(data.slots) do
		slot.Transparency = 1
		if slot:GetAttribute("Home") then
			slot.CFrame = slot:GetAttribute("Home")
		end
	end
end

local function removeCustomer(player)
	local c = customers[player]
	customers[player] = nil
	if c then
		if c.npc then
			c.npc:Destroy()
		end
		hideSlots(c.lane)
	end
end

---------------------------------------------------------------------------
-- Ações das etapas (nomes usados em JobConfig: onBegin / onDone / onCollect)
---------------------------------------------------------------------------

local Hooks = {}

-- Atendente chamou o próximo cliente: ele aparece na porta e anda até o caixa
function Hooks.customerCome(player, state)
	removeCustomer(player)
	local lane = market.lanes[state.lane or 1]
	if not lane then
		return
	end
	local route = { market.door[1], market.door[2], lane.customerSpot }
	local c = { lane = state.lane or 1, arriveAt = now() + 1 + pathLength(route) / WALK_SPEED }
	customers[player] = c
	task.spawn(function()
		local npc, humanoid = newCustomer(route[1])
		if not npc then
			return
		end
		if customers[player] ~= c then
			npc:Destroy() -- o trabalho parou enquanto o cliente era criado
			return
		end
		c.npc, c.humanoid = npc, humanoid
		walk(c, { route[2], route[3] }, -market.base.LookVector) -- de frente para o balcão
		if customers[player] == c then
			say(npc, pick(GREETINGS))
		end
	end)
end

-- Etapa de passar no leitor: as compras aparecem na esteira quando o cliente chega.
-- Devolve quantos segundos faltam para o cliente chegar (a etapa só libera depois disso).
function Hooks.customerArrive(player, state, step)
	local c = customers[player]
	local wait = c and math.max(0, c.arriveAt - now()) or 0
	local options = {}
	for pointName, station in pairs(state.options or {}) do
		table.insert(options, { point = pointName, station = station })
	end
	task.delay(wait, function()
		if customers[player] ~= c then
			return
		end
		for _, entry in ipairs(options) do
			local point = sites.points[entry.point]
			if point then
				local slot = point.part
				if not slot:GetAttribute("Home") then
					slot:SetAttribute("Home", slot.CFrame)
				end
				slot.CFrame = slot:GetAttribute("Home")
				local product = step.products and step.products[entry.station]
				slot.Color = product and product.color or pick(JobConfig.Categories).color
				slot.Transparency = 0
			end
		end
	end)
	return wait
end

-- Um produto passou no leitor: desliza pelo leitor, apita e vai para a ponta das sacolas
function Hooks.scanItem(player, state, step, pointName)
	local c = customers[player]
	local lane = market.lanes[(c and c.lane) or state.lane or 1]
	local point = sites.points[pointName]
	if not lane or not point then
		return
	end
	local slot = point.part
	local beep = Instance.new("Sound")
	beep.SoundId = BEEP
	beep.Volume = 0.5
	beep.Parent = lane.scanner
	beep:Play()
	game:GetService("Debris"):AddItem(beep, 2)
	local overScanner = lane.scanner.CFrame * CFrame.new(0, 0.4, 0)
	local atBag = lane.bag.CFrame * CFrame.new(rng:NextNumber(-0.4, 0.4), 0.45, rng:NextNumber(-0.3, 0.3))
	local t1 = TweenService:Create(slot, TweenInfo.new(0.25), { CFrame = overScanner })
	t1:Play()
	t1.Completed:Connect(function()
		TweenService:Create(slot, TweenInfo.new(0.3), { CFrame = atBag }):Play()
	end)
end

-- Compras embaladas: somem do balcão e o cliente segura a sacola
function Hooks.customerBag(player)
	local c = customers[player]
	if not c then
		return
	end
	hideSlots(c.lane)
	NPCKit.hold(c.npc, "Sacola", Vector3.new(1, 1.3, 0.6), Color3.fromRGB(240, 240, 235), Enum.Material.Fabric)
end

-- Pagou: agradece e vai embora pela porta
function Hooks.customerLeave(player)
	local c = customers[player]
	if not c then
		return
	end
	customers[player] = nil
	local npc = c.npc
	if not npc then
		return
	end
	say(npc, pick({ "Obrigado! Até mais!", "Valeu! Bom trabalho!", "Até a próxima!" }))
	NPCKit.react(npc, "😊")
	NPCKit.emote(npc, "wave")
	task.spawn(function()
		task.wait(1.2)
		walk(c, { market.door[2], market.door[1], market.door[1] * CFrame.new(0, 0, -12) })
		npc:Destroy()
	end)
end

-- Começo da reposição: as prateleiras do pedido ficam meio vazias
function Hooks.shelvesEmpty(player, state, step)
	for _, cat in ipairs(step.cats or {}) do
		for i, product in ipairs(market.shelves[cat] or {}) do
			if i % 2 == 0 or i % 3 == 0 then
				product.Transparency = 1
			end
		end
	end
end

-- Prateleira reposta: os produtos voltam
function Hooks.shelfFill(player, state, step)
	for _, product in ipairs(market.shelves[step.cat] or {}) do
		product.Transparency = 0
	end
end

function MarketService.init(missionService, jobSites)
	sites = jobSites
	market = jobSites.market
	if not market then
		warn("[MarketService] Minas Market não encontrado; clientes NPC desligados.")
		return
	end
	for name, fn in pairs(Hooks) do
		missionService.registerHook(name, fn)
	end
	missionService.onStop(function(player)
		removeCustomer(player)
		-- parou no meio da reposição: as prateleiras não ficam vazias para sempre
		for _, products in pairs(market.shelves) do
			for _, product in ipairs(products) do
				product.Transparency = 0
			end
		end
	end)
end

return MarketService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000001D"><Properties><string name="Name">MissionService</string><ProtectedString name="Source">-- MissionService (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; MissionService
-- Sistema central de pedidos e pagamentos (documento mestre, seção 7.1), usado por TODAS as profissões:
--   sortear pedido -&gt; mostrar etapa/destino -&gt; interagir -&gt; servidor valida -&gt; paga (+ gorjeta) -&gt; atualiza interface/bônus.
-- Cada profissão só descreve seus pedidos em JobConfig (makeOrder); aqui existe UM motor genérico,
-- com etapas simples, etapas de "coleta" (escolher os itens certos) e entregas em casas.
-- Quem começa e termina o trabalho é o JobService (vagas). Estado do pedido é só da sessão (não salva).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local JobConfig = require(Shared:WaitForChild("JobConfig"))
local SecurityService = require(script.Parent:WaitForChild("SecurityService"))
local EconomyService = require(script.Parent:WaitForChild("EconomyService"))
local DailyBonusService = require(script.Parent:WaitForChild("DailyBonusService"))

local MissionService = {}

local uiUpdate
local sites -- JobSiteBuilder (pontos de interação)
local active = {} -- active[player] = estado do trabalho atual
local rng = Random.new()
local hooks = {} -- ações especiais das etapas (onBegin/onDone/onCollect), registradas por outros serviços
local cleanups = {} -- funções chamadas quando o trabalho para (ex.: tirar o cliente NPC da loja)

local function now()
	return Workspace:GetServerTimeNow()
end

---------------------------------------------------------------------------
-- Objeto segurado nas mãos (visível para todos). As mãos vão até ele no cliente (BikeAnimator).
---------------------------------------------------------------------------

local CARDBOARD = Color3.fromRGB(200, 160, 110)
local CARRY = {
	Dough = { size = Vector3.new(1.1, 1.1, 1.1), color = Color3.fromRGB(245, 230, 200), shape = Enum.PartType.Ball },
	RawPizza = { size = Vector3.new(0.2, 2.4, 2.4), color = Color3.fromRGB(240, 215, 170), shape = Enum.PartType.Cylinder, flat = true },
	CookedPizza = { size = Vector3.new(0.25, 2.4, 2.4), color = Color3.fromRGB(215, 150, 70), shape = Enum.PartType.Cylinder, flat = true },
	BurntPizza = { size = Vector3.new(0.25, 2.4, 2.4), color = Color3.fromRGB(45, 35, 30), shape = Enum.PartType.Cylinder, flat = true },
	PizzaBox = { size = Vector3.new(2.4, 0.45, 2.4), color = Color3.fromRGB(245, 240, 230), stripe = Color3.fromRGB(200, 50, 45) },
	Crate = { size = Vector3.new(1.8, 1.3, 1.4), color = CARDBOARD, material = Enum.Material.Cardboard },
	EmptyBox = { size = Vector3.new(1.8, 0.3, 1.4), color = CARDBOARD, material = Enum.Material.Cardboard },
	Package = { size = Vector3.new(1.5, 1, 1.3), color = CARDBOARD, material = Enum.Material.Cardboard, stripe = Color3.fromRGB(240, 140, 30) },
	Mop = { size = Vector3.new(0.25, 4.2, 0.25), color = Color3.fromRGB(150, 110, 70), material = Enum.Material.Wood },
}

local function clearCarry(player)
	local character = player.Character
	local old = character and character:FindFirstChild("CarriedItem")
	if old then
		old:Destroy()
	end
end

local function weldedPart(parent, root, props)
	local p = Instance.new("Part")
	p.Name = props.name
	p.Size = props.size
	p.Color = props.color
	p.Material = props.material or Enum.Material.SmoothPlastic
	if props.shape then
		p.Shape = props.shape
	end
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CFrame = props.cframe
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = p
	weld.Parent = p
	p.Parent = parent
	return p
end

-- spec = "Dough" ou { kind = "Crate", color = ..., count = ... }; toppings = lista de cores
local function setCarry(player, spec, toppings)
	clearCarry(player)
	if not spec then
		return
	end
	local kind = type(spec) == "table" and spec.kind or spec
	local info = CARRY[kind]
	local character, _, root = SecurityService.getLivingCharacter(player)
	if not info or not root then
		return
	end
	-- Na frente da barriga, sem encostar no corpo
	local depth = info.flat and info.size.Y or info.size.Z
	local base = root.CFrame * CFrame.new(0, 0, -(0.75 + depth / 2))
	local cf = info.flat and base * CFrame.Angles(0, 0, math.rad(90)) or base
	local item = weldedPart(character, root, {
		name = "CarriedItem",
		size = info.size,
		color = type(spec) == "table" and spec.color or info.color,
		material = info.material,
		shape = info.shape,
		cframe = cf,
	})
	if info.stripe then
		weldedPart(item, root, {
			name = "Stripe",
			size = Vector3.new(info.size.X + 0.02, 0.22, 0.4),
			color = info.stripe,
			cframe = base * CFrame.new(0, info.size.Y / 2 - 0.1, 0),
		})
	end
	-- Pilha de pacotes
	local count = type(spec) == "table" and spec.count or 1
	for i = 2, math.min(count or 1, 3) do
		weldedPart(item, root, {
			name = "Extra",
			size = info.size * 0.9,
			color = info.color,
			material = info.material,
			cframe = base * CFrame.new(0, (i - 1) * info.size.Y, 0) * CFrame.Angles(0, 0.2 * i, 0),
		})
	end
	-- Esfregão: cabeça embaixo do cabo
	if kind == "Mop" then
		weldedPart(item, root, { name = "MopHead", size = Vector3.new(1.6, 0.35, 0.8), color = Color3.fromRGB(90, 160, 220), cframe = base * CFrame.new(0, -2, 0) })
	end
	-- Ingredientes por cima da pizza
	if info.flat and toppings and kind ~= "BurntPizza" then
		for i, color in ipairs(toppings) do
			for k = 1, 3 do
				local a = (k / 3) * math.pi * 2 + i
				local r = 0.35 + (i % 3) * 0.25
				weldedPart(item, root, {
					name = "Topping",
					size = Vector3.new(0.35, 0.12, 0.35),
					color = color,
					cframe = base * CFrame.new(math.cos(a) * r, info.size.X / 2 + 0.06 + i * 0.005, math.sin(a) * r),
				})
			end
		end
	end
end

---------------------------------------------------------------------------
-- Pontos de interação
---------------------------------------------------------------------------

local function pointPosition(name)
	local point = name and sites.points[name]
	return point and point.part.Position
end

local function pickPoint(state, jobId, station)
	-- Mesma estação da etapa anterior (ex.: forno) = mesmo ponto
	local current = state.point and sites.points[state.point]
	if current and current.job == jobId and current.station == station then
		return state.point
	end
	local group = sites.groups[jobId] and sites.groups[jobId][station]
	if not group or #group == 0 then
		return nil
	end
	return group[rng:NextInteger(1, #group)]
end

-- Mancha de sujeira só aparece enquanto precisa ser limpa
local function setRevealed(pointName, visible)
	local point = sites.points[pointName]
	if point then
		point.part.Transparency = visible and 0.15 or 1
	end
end

-- Contexto que as profissões recebem para montar o pedido
local function orderContext(jobId, state)
	return {
		lane = state.lane,
		origin = pointPosition(sites.groups[jobId] and sites.groups[jobId].BalcaoPacotes and sites.groups[jobId].BalcaoPacotes[1]) or Vector3.zero,
		pickHouses = function(n)
			local pool = table.clone(sites.houses)
			local picked = {}
			while #picked &lt; n and #pool &gt; 0 do
				local entry = table.remove(pool, rng:NextInteger(1, #pool))
				table.insert(picked, { point = entry.point, address = entry.address, position = pointPosition(entry.point) })
			end
			return picked
		end,
	}
end

local function runHook(name, player, state, step, extra)
	local fn = name and hooks[name]
	if not fn then
		return nil
	end
	local ok, result = pcall(fn, player, state, step, extra)
	if not ok then
		warn(("[MissionService] Erro na ação '%s': %s"):format(name, tostring(result)))
		return nil
	end
	return result
end

local function runCleanups(player)
	for _, fn in ipairs(cleanups) do
		pcall(fn, player)
	end
end

---------------------------------------------------------------------------
-- Pedido
---------------------------------------------------------------------------

local beginStep

local function collectText(step, state)
	if step.count then
		local got, total = 0, 0
		for station, amount in pairs(step.need) do
			total += amount
			got += math.min(state.got[station] or 0, amount)
		end
		return ("%s %d/%d %s"):format(step.text, got, total, step.count)
	end
	local parts = {}
	for station, amount in pairs(step.need) do
		local got = state.got[station] or 0
		if amount &gt; 1 then
			table.insert(parts, ("%s %d/%d"):format(JobConfig.shortLabel(station), got, amount))
		else
			table.insert(parts, (got &gt;= amount and "✓ " or "") .. JobConfig.shortLabel(station))
		end
	end
	table.sort(parts)
	return step.text .. " " .. table.concat(parts, ", ")
end

local function sendStep(player, state)
	local job = JobConfig.Jobs[state.job]
	local step = state.order.steps[state.step]
	local points = {}
	if step.kind == "collect" then
		for pointName, station in pairs(state.options) do
			-- em coletas com contagem (ex.: produtos do cliente), o que já foi feito some
			local done = step.count and (state.got[station] or 0) &gt;= (step.need[station] or 0)
			if not done then
				table.insert(points, { point = pointName, action = JobConfig.optionLabel(station) })
			end
		end
	else
		table.insert(points, { point = state.point, action = step.action })
	end
	local targetPos = step.point and pointPosition(step.point) or nil
	-- Comanda da pizza: desenho do sabor e ingredientes já colocados
	local card
	if state.order.card then
		-- comanda em lista (mercado): cada linha marca ✓ quando a etapa dela termina
		local c = state.order.card
		card = { kind = "list", title = c.title, footer = c.footer, rows = {} }
		for _, row in ipairs(c.rows) do
			local done, current
			if row.station then
				done = state.step &gt; row.step or (state.step == row.step and (state.got[row.station] or 0) &gt;= 1)
				current = state.step == row.step and not done
			else
				done = state.step &gt; row.to
				current = state.step &gt;= row.from and state.step &lt;= row.to
			end
			table.insert(card.rows, { label = row.label, color = row.color, done = done, now = current })
		end
	elseif state.order.flavor then
		card = { flavor = state.order.flavor, title = state.order.title, items = {} }
		for _, id in ipairs(state.order.ingredients) do
			table.insert(card.items, { id = id, done = state.added[id] == true })
		end
	end
	uiUpdate:FireClient(player, "JobStep", {
		job = state.job,
		title = state.order.title,
		step = state.step,
		total = #state.order.steps,
		text = step.kind == "collect" and collectText(step, state) or step.text,
		hold = step.hold or 0,
		points = points,
		place = job.Place,
		targetPos = targetPos,
		readyAt = state.readyAt,
		waitText = step.waitText,
		card = card,
	})
end

function beginStep(player, state)
	local step = state.order.steps[state.step]
	local previousPos = pointPosition(state.point)
	local t = now()
	state.options = nil
	state.got = {}
	if step.kind == "collect" then
		state.options = {}
		for _, station in ipairs(step.options) do
			local pointName = pickPoint({}, state.job, station)
			if pointName then
				state.options[pointName] = station
			end
		end
	else
		local pointName = step.point or pickPoint(state, state.job, step.station)
		if not pointName then
			warn(("[MissionService] Estação '%s' não existe para %s"):format(tostring(step.station), state.job))
			return
		end
		state.point = pointName
		if step.reveal then
			setRevealed(pointName, true)
			state.revealed = pointName
		end
	end
	state.stepStartedAt = t
	state.readyAt = t + (step.waitBefore or 0)
	local wait = runHook(step.onBegin, player, state, step)
	if type(wait) == "number" then
		state.readyAt = math.max(state.readyAt, t + wait)
	end
	state.arriveAt = t
	if step.travel and previousPos then
		-- Não dá para chegar mais rápido que isso sem teleporte
		state.arriveAt = t + (pointPosition(state.point) - previousPos).Magnitude / JobConfig.TravelSpeed
	end
	sendStep(player, state)
end

local function startOrder(player, state)
	local job = JobConfig.Jobs[state.job]
	state.order = job.makeOrder(rng, orderContext(state.job, state))
	state.step = 1
	state.orderStartedAt = now()
	state.tipLost = false
	state.toppings = {}
	state.added = {}
	beginStep(player, state)
end

local function finishOrder(player, state)
	local job = JobConfig.Jobs[state.job]
	local order = state.order
	-- Encerra o pedido ANTES de pagar: um segundo pedido não encontra etapa válida
	state.step = nil
	state.cycles += 1
	local fast = not state.tipLost and order.tip and (now() - state.orderStartedAt) &lt;= order.parTime
	local tip = fast and order.tip or 0
	local paid = EconomyService.add(player, order.pay + tip, ("Emprego: %s (%s)"):format(job.Name, order.title))
	local bonus = paid and DailyBonusService.tryClaim(player) or 0
	uiUpdate:FireClient(player, "JobPaid", {
		job = state.job,
		title = order.title,
		reward = paid and order.pay or 0,
		tip = paid and tip or 0,
		bonus = bonus,
	})

	task.delay(JobConfig.NextOrderDelay, function()
		if active[player] == state and not state.step then
			startOrder(player, state)
		end
	end)
end

local function advance(player, state, step)
	runHook(step.onDone, player, state, step)
	if step.carry ~= nil then
		setCarry(player, step.carry, state.toppings)
	end
	if state.revealed then
		setRevealed(state.revealed, false)
		state.revealed = nil
	end
	if state.step &gt;= #state.order.steps then
		finishOrder(player, state)
	else
		state.step += 1
		beginStep(player, state)
	end
end

-- A pizza passou do ponto: troca o resto do pedido por "jogar fora" + refazer
local function burn(player, state, step)
	local recovery = step.burn
	local steps = {}
	for _, s in ipairs(recovery.steps) do
		table.insert(steps, s)
	end
	for i = recovery.restartAt, #state.order.steps do
		table.insert(steps, state.order.steps[i])
	end
	local old = state.order
	state.order = { title = old.title, flavor = old.flavor, ingredients = old.ingredients, pay = old.pay, tip = old.tip, parTime = old.parTime, steps = steps }
	state.tipLost = true
	state.toppings = {}
	state.added = {}
	state.step = 1
	setCarry(player, recovery.carry)
	uiUpdate:FireClient(player, "JobHint", { text = recovery.text, bad = true })
	beginStep(player, state)
end

local function onPointTriggered(player, pointName)
	if not SecurityService.checkRate(player, "JobPoint", 0.25) then
		return
	end
	local state = active[player]
	if not state or not state.step then
		return
	end
	local step = state.order.steps[state.step]
	local isOption = step.kind == "collect" and state.options and state.options[pointName]
	if not isOption and state.point ~= pointName then
		return -- não é a etapa atual deste jogador
	end
	if step.kind == "collect" and not isOption then
		return
	end
	local _, _, root = SecurityService.getLivingCharacter(player)
	local point = sites.points[pointName]
	if not root or not point then
		return
	end
	if (root.Position - point.part.Position).Magnitude &gt; JobConfig.InteractDistance then
		return
	end
	local t = now()
	if t &lt; state.readyAt or t &lt; state.arriveAt then
		return -- cedo demais (forno ainda assando, ou chegou rápido demais para ser verdade)
	end
	if t - state.stepStartedAt &lt; math.max(JobConfig.MinStepSeconds, (step.hold or 0) * 0.7) then
		return
	end

	if step.kind == "collect" then
		local station = state.options[pointName]
		local need = step.need[station] or 0
		local got = state.got[station] or 0
		state.stepStartedAt = t
		if got &gt;= need then
			if not step.count then
				uiUpdate:FireClient(player, "JobHint", { text = "Esse não vai neste pedido!", bad = true })
			end
			return
		end
		state.got[station] = got + 1
		runHook(step.onCollect, player, state, step, pointName)
		if step.toppings then
			local ing = JobConfig.ingredientById(station:match("^Ing_(.+)$") or "")
			if ing then
				table.insert(state.toppings, ing.color)
				state.added[ing.id] = true
				setCarry(player, "RawPizza", state.toppings)
			end
		end
		for s, amount in pairs(step.need) do
			if (state.got[s] or 0) &lt; amount then
				sendStep(player, state) -- atualiza a lista do que falta
				return
			end
		end
		advance(player, state, step)
		return
	end

	if step.burnAfter and t &gt; state.readyAt + step.burnAfter then
		burn(player, state, step)
		return
	end
	advance(player, state, step)
end

local function watchCharacter(player)
	player.CharacterAdded:Connect(function()
		-- Morreu ou resetou no meio do pedido: começa um pedido novo (o item segurado sumiu junto)
		local state = active[player]
		if state and state.step then
			task.wait(1)
			if active[player] == state and state.step then
				if state.revealed then
					setRevealed(state.revealed, false)
					state.revealed = nil
				end
				runCleanups(player)
				startOrder(player, state)
			end
		end
	end)
end

---------------------------------------------------------------------------
-- API usada pelo JobService
---------------------------------------------------------------------------

function MissionService.startJob(player, jobId)
	MissionService.stopJob(player)
	local state = { job = jobId, cycles = 0 }
	-- Profissões com "Lanes": cada um fica com um posto só seu (ex.: caixa 1 ou caixa 2)
	if JobConfig.Jobs[jobId].Lanes then
		local used = {}
		for other, s in pairs(active) do
			if other ~= player and s.job == jobId and s.lane then
				used[s.lane] = true
			end
		end
		state.lane = 1
		while used[state.lane] do
			state.lane += 1
		end
	end
	active[player] = state
	startOrder(player, state)
end

-- Outros serviços registram ações especiais das etapas (ex.: MarketService cria os clientes NPC)
function MissionService.registerHook(name, fn)
	hooks[name] = fn
end

-- Quantos jogadores estão trabalhando nessa profissão agora
function MissionService.workers(jobId)
	local n = 0
	for _, s in pairs(active) do
		if s.job == jobId then
			n += 1
		end
	end
	return n
end

function MissionService.onStop(fn)
	table.insert(cleanups, fn)
end

function MissionService.stopJob(player)
	local state = active[player]
	if state then
		active[player] = nil
		if state.revealed then
			setRevealed(state.revealed, false)
		end
		clearCarry(player)
		runCleanups(player)
	end
end

function MissionService.init(remotes, jobSites)
	uiUpdate = remotes[GameConfig.Remotes.UIUpdate]
	sites = jobSites
	for name, point in pairs(sites.points) do
		point.prompt.Triggered:Connect(function(player)
			onPointTriggered(player, name)
		end)
	end
	Players.PlayerAdded:Connect(watchCharacter)
	for _, player in ipairs(Players:GetPlayers()) do
		watchCharacter(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		MissionService.stopJob(player)
	end)
end

return MissionService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000001E"><Properties><string name="Name">NPCKit</string><ProtectedString name="Source">-- NPCKit (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; NPCKit
-- Marco 5: "kit" reaproveitável para todos os NPCs da cidade (clientes, funcionários,
-- destinatários de entrega, pessoas passeando na praça e o Seu Bento).
--   * aparência aleatória (pele, camisa, calça);
--   * animações padrão do Roblox: parado, andando, acenar, comemorar, apontar;
--   * balão de fala e reação com emoji em cima da cabeça;
--   * andar por pontos (se travar, é colocado no ponto: nunca fica preso).
-- Desempenho: limite de NPCs ao mesmo tempo, estados do Humanoid que não usamos desligados
-- e NPCs parados ficam ancorados (não gastam física).

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local NPCKit = {}

NPCKit.MAX_NPCS = 30 -- limite de NPCs ao mesmo tempo (sem contar os importantes)

-- Animações padrão R15 do próprio Roblox
local ANIMS = {
	idle = "rbxassetid://507766388",
	walk = "rbxassetid://507777826",
	wave = "rbxassetid://507770239",
	cheer = "rbxassetid://507770677",
	point = "rbxassetid://507770453",
}

local SKINS = { Color3.fromRGB(255, 220, 190), Color3.fromRGB(230, 180, 140), Color3.fromRGB(190, 130, 90), Color3.fromRGB(140, 90, 60), Color3.fromRGB(100, 65, 45) }
local SHIRTS = { Color3.fromRGB(200, 60, 60), Color3.fromRGB(60, 120, 200), Color3.fromRGB(240, 200, 60), Color3.fromRGB(80, 170, 90), Color3.fromRGB(170, 90, 200), Color3.fromRGB(240, 240, 240), Color3.fromRGB(250, 140, 60) }
local PANTS = { Color3.fromRGB(40, 50, 80), Color3.fromRGB(60, 60, 65), Color3.fromRGB(120, 90, 60), Color3.fromRGB(30, 30, 35), Color3.fromRGB(90, 110, 140) }

-- Estados que NPC não usa (menos trabalho para o servidor)
local OFF_STATES = {
	Enum.HumanoidStateType.Climbing,
	Enum.HumanoidStateType.Swimming,
	Enum.HumanoidStateType.FallingDown,
	Enum.HumanoidStateType.Ragdoll,
	Enum.HumanoidStateType.Flying,
	Enum.HumanoidStateType.GettingUp,
	Enum.HumanoidStateType.Dead,
}

local rng = Random.new()
local data = {} -- data[npc] = { humanoid, root, tracks = {}, speed, important }
local count = 0

function NPCKit.pick(list)
	return list[rng:NextInteger(1, #list)]
end

function NPCKit.folder()
	local f = Workspace:FindFirstChild("NPCs")
	if not f then
		f = Instance.new("Folder")
		f.Name = "NPCs"
		f.Parent = Workspace
	end
	return f
end

function NPCKit.count()
	return count
end

local function track(npc, name)
	local d = data[npc]
	if not d or not ANIMS[name] then
		return nil
	end
	if not d.tracks[name] then
		local animator = d.humanoid:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = d.humanoid
		end
		local anim = Instance.new("Animation")
		anim.AnimationId = ANIMS[name]
		local ok, t = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if not ok then
			return nil
		end
		t.Looped = name == "idle" or name == "walk"
		t.Priority = (name == "idle" or name == "walk") and Enum.AnimationPriority.Core or Enum.AnimationPriority.Action
		d.tracks[name] = t
	end
	return d.tracks[name]
end

-- Liga as animações de parado/andando num NPC (serve para NPCs criados em outro lugar, como o Seu Bento)
function NPCKit.animate(npc, important)
	local humanoid = npc:FindFirstChildOfClass("Humanoid")
	local root = npc:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or data[npc] then
		return
	end
	for _, state in ipairs(OFF_STATES) do
		humanoid:SetStateEnabled(state, false)
	end
	-- o script "Animate" que vem no modelo não roda em NPC; as animações tocam pelo servidor
	local animate = npc:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	data[npc] = { humanoid = humanoid, root = root, tracks = {}, important = important }
	if not important then
		count += 1
	end
	local walking = false
	local idle = track(npc, "idle")
	if idle then
		idle:Play()
	end
	humanoid.Running:Connect(function(speed)
		local moving = speed &gt; 0.5
		if moving == walking then
			return
		end
		walking = moving
		local walk = track(npc, "walk")
		if walk then
			if moving then
				walk:Play(0.2)
				walk:AdjustSpeed(humanoid.WalkSpeed / 14)
			else
				walk:Stop(0.2)
			end
		end
	end)
	npc.AncestryChanged:Connect(function(_, parent)
		if not parent and data[npc] then
			if not data[npc].important then
				count -= 1
			end
			data[npc] = nil
		end
	end)
end

-- Cria um NPC em pé no chão em "cf" (a posição Y de cf = altura do chão).
-- opts: name, shirt, pants, skin, speed, anchored, important (não conta no limite)
-- Devolve nil se já houver NPCs demais.
function NPCKit.spawn(cf, opts)
	opts = opts or {}
	if not opts.important and count &gt;= NPCKit.MAX_NPCS then
		return nil
	end
	local desc = Instance.new("HumanoidDescription")
	local skin = opts.skin or NPCKit.pick(SKINS)
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = opts.shirt or NPCKit.pick(SHIRTS)
	local pants = opts.pants or NPCKit.pick(PANTS)
	desc.LeftLegColor = pants
	desc.RightLegColor = pants
	local ok, npc = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not npc then
		warn("[NPCKit] Não deu para criar NPC: " .. tostring(npc))
		return nil
	end
	npc.Name = opts.name or "Morador"
	local humanoid = npc:FindFirstChildOfClass("Humanoid")
	local root = npc:FindFirstChild("HumanoidRootPart")
	humanoid.DisplayDistanceType = opts.showName and Enum.HumanoidDisplayDistanceType.Viewer or Enum.HumanoidDisplayDistanceType.None
	humanoid.DisplayName = opts.name or ""
	humanoid.NameDisplayDistance = 40
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.WalkSpeed = opts.speed or 12
	for _, p in ipairs(npc:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CollisionGroup = "NPCs" -- não esbarra nos jogadores nem nos carros (ZoneService)
		end
	end
	local height = humanoid.HipHeight + root.Size.Y / 2
	npc:PivotTo(cf + Vector3.new(0, height + 0.1, 0))
	root.Anchored = opts.anchored == true
	npc.Parent = NPCKit.folder()
	if not root.Anchored then
		pcall(function()
			root:SetNetworkOwner(nil) -- o servidor controla o andar
		end)
	end
	NPCKit.animate(npc, opts.important)
	return npc
end

-- Toca uma animação curta: "wave" (acenar), "cheer" (comemorar), "point" (apontar)
function NPCKit.emote(npc, name)
	local t = npc and track(npc, name)
	if t then
		t:Play(0.15)
	end
end

-- Balão de fala em cima da cabeça
function NPCKit.say(npc, text, duration)
	local head = npc and npc:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("Fala")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Fala"
	gui.Size = UDim2.fromOffset(190, 46)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 45
	gui.Parent = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.new(1, 1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(30, 30, 40)
	label.Text = text
	label.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = label
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = label
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(60, 60, 80)
	stroke.Thickness = 1.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = label
	task.delay(duration or 3.5, function()
		if gui.Parent then
			gui:Destroy()
		end
	end)
end

-- Emoji que sobe e some em cima da cabeça (ex.: "😊", "❤️", "😕")
function NPCKit.react(npc, emoji)
	local head = npc and npc:FindFirstChild("Head")
	if not head then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Reacao"
	gui.Size = UDim2.fromOffset(50, 50)
	gui.StudsOffset = Vector3.new(1.6, 2, 0)
	gui.MaxDistance = 45
	gui.Parent = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Text = emoji
	label.Parent = gui
	TweenService:Create(gui, TweenInfo.new(1.8), { StudsOffset = Vector3.new(1.6, 4.5, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(1.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
	game:GetService("Debris"):AddItem(gui, 2)
end

-- Vira o NPC para uma direção (sem mexer na posição)
function NPCKit.face(npc, direction)
	local root = npc and npc:FindFirstChild("HumanoidRootPart")
	if root and direction.Magnitude &gt; 0 then
		local flat = Vector3.new(direction.X, 0, direction.Z)
		npc:PivotTo(CFrame.lookAt(root.Position, root.Position + flat))
	end
end

-- Anda pelos pontos (CFrame ou Vector3) em ordem. Se travar, é colocado no ponto.
-- Para no meio se "keepGoing()" devolver false.
function NPCKit.walk(npc, points, faceDir, keepGoing)
	local d = data[npc]
	if not d then
		return
	end
	if d.root.Anchored then
		d.root.Anchored = false
		pcall(function()
			d.root:SetNetworkOwner(nil)
		end)
	end
	for _, p in ipairs(points) do
		if not npc.Parent or (keepGoing and not keepGoing()) then
			return
		end
		local pos = typeof(p) == "CFrame" and p.Position or p
		local target = Vector3.new(pos.X, d.root.Position.Y, pos.Z)
		local timeout = (target - d.root.Position).Magnitude / math.max(d.humanoid.WalkSpeed, 1) + 1.5
		local reached = false
		local conn = d.humanoid.MoveToFinished:Connect(function(ok)
			reached = ok
		end)
		d.humanoid:MoveTo(target)
		local started = os.clock()
		while not reached and os.clock() - started &lt; timeout and npc.Parent do
			task.wait(0.1)
		end
		conn:Disconnect()
		if not reached and npc.Parent then
			npc:PivotTo(CFrame.new(target) * d.root.CFrame.Rotation)
		end
	end
	if npc.Parent and faceDir then
		NPCKit.face(npc, faceDir)
	end
end

-- Faz um objeto (ex.: sacola, caixa de pizza, pacote) aparecer na mão do NPC
function NPCKit.hold(npc, name, size, color, material)
	local hand = npc and (npc:FindFirstChild("RightHand") or npc:FindFirstChild("Right Arm"))
	if not hand then
		return nil
	end
	local item = Instance.new("Part")
	item.Name = name
	item.Size = size
	item.Color = color
	item.Material = material or Enum.Material.SmoothPlastic
	item.CanCollide = false
	item.CanQuery = false
	item.Massless = true
	item.CFrame = hand.CFrame * CFrame.new(0, -0.3 - size.Y / 2, 0)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hand
	weld.Part1 = item
	weld.Parent = item
	item.Parent = npc
	return item
end

-- Altura do chão em uma posição (só o mapa conta)
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
function NPCKit.groundAt(position)
	local include = {}
	for _, name in ipairs({ "Map", "JobStations" }) do
		local f = Workspace:FindFirstChild(name)
		if f then
			table.insert(include, f)
		end
	end
	groundParams.FilterDescendantsInstances = include
	local hit = Workspace:Raycast(Vector3.new(position.X, position.Y + 6, position.Z), Vector3.new(0, -40, 0), groundParams)
	return hit and hit.Position.Y or position.Y
end

-- true se algum jogador está a menos de "radius" studs (para só animar o que alguém vê)
function NPCKit.anyPlayerNear(position, radius)
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and (root.Position - position).Magnitude &lt;= radius then
			return true
		end
	end
	return false
end

return NPCKit
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000001F"><Properties><string name="Name">NPCService</string><ProtectedString name="Source">-- NPCService (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; NPCService
-- Marco 2: cria o NPC guia (Seu Bento) na praça.
-- A conversa usa ProximityPrompt: no PC aparece "E", no celular um botão para tocar.
-- O servidor confere distância e frequência antes de mandar o diálogo ao cliente.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local SecurityService = require(script.Parent:WaitForChild("SecurityService"))
local NPCKit = require(script.Parent:WaitForChild("NPCKit"))

local NPCService = {}

local GUIDE = GameConfig.Guide
local uiUpdate
local guideRoot -- HumanoidRootPart do Seu Bento

local function groundHeightAt(position)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local map = Workspace:FindFirstChild("Map")
	params.FilterDescendantsInstances = map and { map } or {}
	local result = Workspace:Raycast(position + Vector3.new(0, 50, 0), Vector3.new(0, -100, 0), params)
	return result and result.Position.Y or 0
end

local function createGuide()
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = GUIDE.SkinColor
	desc.LeftArmColor = GUIDE.SkinColor
	desc.RightArmColor = GUIDE.SkinColor
	desc.TorsoColor = GUIDE.ShirtColor
	desc.LeftLegColor = GUIDE.PantsColor
	desc.RightLegColor = GUIDE.PantsColor

	local npc = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	npc.Name = GUIDE.Name

	local humanoid = npc:FindFirstChildOfClass("Humanoid")
	local root = npc:FindFirstChild("HumanoidRootPart")
	humanoid.DisplayName = GUIDE.Name
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	humanoid.NameDisplayDistance = 60
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	root.Anchored = true
	guideRoot = root

	-- Em pé no chão, olhando para o spawn
	local ground = groundHeightAt(GUIDE.Position)
	local height = humanoid.HipHeight + root.Size.Y / 2
	local pos = Vector3.new(GUIDE.Position.X, ground + height, GUIDE.Position.Z)
	local lookAt = Vector3.new(0, pos.Y, 20)
	npc:PivotTo(CFrame.lookAt(pos, lookAt))

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Conversar"
	prompt.ObjectText = GUIDE.Name
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = root

	local npcFolder = Workspace:FindFirstChild("NPCs") or Instance.new("Folder")
	npcFolder.Name = "NPCs"
	npcFolder.Parent = Workspace
	npc.Parent = npcFolder
	NPCKit.animate(npc, true) -- respira parado e acena quando alguém conversa

	prompt.Triggered:Connect(function(player)
		if not SecurityService.checkRate(player, "TalkGuide", 1) then
			return
		end
		if not NPCService.isNearGuide(player) then
			return
		end
		NPCKit.emote(npc, "wave")
		uiUpdate:FireClient(player, "GuideDialog", {})
	end)
end

-- true se o jogador está perto o bastante do Seu Bento para conversar
function NPCService.isNearGuide(player)
	local _, _, playerRoot = SecurityService.getLivingCharacter(player)
	if not playerRoot or not guideRoot then
		return false
	end
	return (playerRoot.Position - guideRoot.Position).Magnitude &lt;= GUIDE.TalkDistance
end

function NPCService.init(remotes)
	uiUpdate = remotes[GameConfig.Remotes.UIUpdate]
	local ok, err = pcall(createGuide)
	if not ok then
		warn("[NPCService] Erro ao criar o Seu Bento: " .. tostring(err))
	end
end

return NPCService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000020"><Properties><string name="Name">PlayerDataService</string><ProtectedString name="Source">-- PlayerDataService (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; PlayerDataService
-- Carrega e salva os dados de cada jogador com DataStoreService.
--
-- Regras de segurança dos dados:
--   * Se o carregamento FALHAR, o jogador joga com dados padrão, mas NADA é salvo
--     nessa sessão. Assim nunca escrevemos dados vazios por cima de dados bons.
--   * Só o servidor muda os dados. O cliente nunca envia valores para salvar.
--
-- Para funcionar no Studio: publique o jogo e ligue
-- Configurações do jogo &gt; Segurança &gt; "Permitir acesso do Studio aos serviços de API".

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

local PlayerDataService = {}

local CFG = GameConfig.Data

-- Formato dos dados salvos. Campos novos entram aqui com valor padrão.
local DEFAULT_DATA = {
	version = 1,
	tutorialDone = false,
	money = GameConfig.Economy.StartingMoney,
	lastBonusClaim = 0, -- os.time() do último resgate do bônus diário (0 = nunca)
}

local store -- DataStore (nil se o serviço não estiver disponível)
local profiles = {} -- profiles[player] = { data = {...}, canSave = bool, dirty = bool }
local loadedCallbacks = {}

local function copyDefaults()
	local t = {}
	for k, v in pairs(DEFAULT_DATA) do
		t[k] = v
	end
	return t
end

local function keyFor(player)
	return "Player_" .. player.UserId
end

-- Tenta uma função várias vezes, esperando um pouco mais a cada falha
local function withRetries(fn)
	local lastErr
	for attempt = 1, CFG.Retries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		task.wait(attempt * 2)
	end
	return false, lastErr
end

local function loadPlayer(player)
	local profile = { data = copyDefaults(), canSave = false, dirty = false }

	if store then
		local ok, saved = withRetries(function()
			return store:GetAsync(keyFor(player))
		end)
		if ok then
			if type(saved) == "table" then
				for k, v in pairs(saved) do
					profile.data[k] = v
				end
			end
			profile.canSave = true
		else
			warn(("[PlayerDataService] Falha ao carregar %s: %s. Progresso desta sessão NÃO será salvo."):format(player.Name, tostring(saved)))
		end
	end

	if not player.Parent then
		return -- saiu enquanto carregava
	end
	profiles[player] = profile
	for _, callback in ipairs(loadedCallbacks) do
		task.spawn(callback, player, profile.data)
	end
end

function PlayerDataService.save(player)
	local profile = profiles[player]
	if not profile or not profile.canSave or not store then
		return false
	end
	local data = profile.data
	local ok, err = withRetries(function()
		store:UpdateAsync(keyFor(player), function()
			return data
		end)
	end)
	if ok then
		profile.dirty = false
	else
		warn(("[PlayerDataService] Falha ao salvar %s: %s"):format(player.Name, tostring(err)))
	end
	return ok
end

-- Dados do jogador (nil se ainda não carregou). Só use no servidor.
function PlayerDataService.get(player)
	local profile = profiles[player]
	return profile and profile.data
end

-- Muda um campo e marca para salvar
function PlayerDataService.set(player, key, value)
	local profile = profiles[player]
	if not profile then
		return false
	end
	profile.data[key] = value
	profile.dirty = true
	return true
end

-- Chama callback(player, data) quando os dados de um jogador terminarem de carregar
function PlayerDataService.onLoaded(callback)
	table.insert(loadedCallbacks, callback)
	for player, profile in pairs(profiles) do
		task.spawn(callback, player, profile.data)
	end
end

function PlayerDataService.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(CFG.StoreName)
	end)
	if ok then
		store = result
	else
		warn("[PlayerDataService] DataStore indisponível (jogo não publicado ou acesso de API desligado). Nada será salvo: " .. tostring(result))
	end

	Players.PlayerAdded:Connect(loadPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(loadPlayer, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		PlayerDataService.save(player)
		profiles[player] = nil
	end)

	-- Salvamento automático só de quem mudou algo
	task.spawn(function()
		while true do
			task.wait(CFG.AutosaveInterval)
			for player, profile in pairs(profiles) do
				if profile.dirty then
					task.spawn(PlayerDataService.save, player)
				end
			end
		end
	end)

	-- Servidor fechando: salva todo mundo antes
	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				PlayerDataService.save(player)
				pending -= 1
			end)
		end
		local start = os.clock()
		while pending &gt; 0 and os.clock() - start &lt; 25 do
			task.wait(0.2)
		end
	end)
end

return PlayerDataService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000021"><Properties><string name="Name">PoliceService</string><ProtectedString name="Source">-- Polícia não letal: vagas, equipamentos, registros, acessos, ronda e treinamento.
-- Captura depende de suspeita criada por outro serviço NO SERVIDOR e imobilização.
-- Não há remoto que crie suspeitos, altere dinheiro ou prenda um civil livremente.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("PoliceConfig"))
local Rules = require(Shared:WaitForChild("PoliceRules"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local Security = require(script.Parent:WaitForChild("SecurityService"))
local WorkRoleService = require(script.Parent:WaitForChild("WorkRoleService"))

local PoliceService = {}
local initialized = false
local sites, hooks, ui
local duty, suspects, stuns, training = {}, {}, {}, {}
local reports, reportId = {}, 0
local doors, count = {}, 0

local function now() return Workspace:GetServerTimeNow() end
local function notice(player, message)
	if player.Parent == Players then ui:FireClient(player, "Notice", { text = message }) end
end
local function rootOf(player)
	local _, _, root = Security.getLivingCharacter(player)
	return root
end
local function positionOf(prompt)
	local parent = prompt and prompt.Parent
	if parent and parent:IsA("BasePart") then return parent.Position end
	if parent and parent:IsA("Attachment") then return parent.WorldPosition end
end
local function near(player, prompt, reach)
	local root, target = rootOf(player), positionOf(prompt)
	return root and target and Rules.point(root.Position) and (root.Position - target).Magnitude &lt;= (reach or Config.InteractionDistance)
end
local function nearAny(player, prompts)
	for _, prompt in ipairs(prompts or {}) do if near(player, prompt) then return true end end
	return false
end
local function onDuty(player)
	return duty[player] ~= nil and WorkRoleService.hasRole(player, "Policial")
		and not player:GetAttribute("Detained") and rootOf(player) ~= nil
end
local function equipped(player, id)
	local character = player.Character
	if not character then return nil end
	for _, item in ipairs(character:GetChildren()) do
		if item:IsA("Tool") and item:GetAttribute("PoliceIssued") and item:GetAttribute("PoliceTool") == id then return item end
	end
	return nil
end
local function doorList()
	local list = {}
	for id, door in pairs(doors) do
		table.insert(list, { id = id, name = door.name or id, open = door.isOpen == true })
	end
	if hooks and hooks.prisonService and hooks.prisonService.getCellControls then
		for _, cell in ipairs(hooks.prisonService.getCellControls()) do
			table.insert(list,{id="Cell:"..tostring(cell.id),name=("CELA %s · %s"):format(tostring(cell.name or cell.id),cell.occupied and "OCUPADA" or "LIVRE"),
				open=cell.open==true,occupied=cell.occupied==true,lockedUntil=cell.lockedUntil})
		end
	end
	table.sort(list, function(a,b) return a.id &lt; b.id end)
	return list
end
local function sendState(player)
	if player.Parent ~= Players then return end
	local record = duty[player]
	ui:FireClient(player, "PoliceState", {
		onDuty = record ~= nil, count = count, slots = Config.Slots,
		equipped = record and record.equipped == true or false,
		patrolStep = record and record.patrol or 0, patrolTotal = #(sites.patrolPrompts or {}),
		training = training[player] ~= nil,
	})
end
local function broadcastState()
	for _, player in ipairs(Players:GetPlayers()) do sendState(player) end
end
local function teamReports()
	for player in pairs(duty) do
		if player.Parent == Players then ui:FireClient(player, "PoliceReports", { reports = reports }) end
	end
end
local function addReport(player, category, text, location)
	reportId += 1
	table.insert(reports, 1, {
		id = reportId, at = os.time(), officer = player.DisplayName or player.Name,
		category = category, text = text, location = location or "Centro de Reintegração Kinder",
	})
	while #reports &gt; Config.MaxReports do table.remove(reports) end
	teamReports()
end
local function stripGear(player)
	local containers = {}
	if player.Character then table.insert(containers,player.Character) end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then table.insert(containers,backpack) end
	for _, container in ipairs(containers) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") and item:GetAttribute("PoliceIssued") then item:Destroy() end
			end
		end
	end
end
local function removeTraining(player)
	local record = training[player]
	training[player] = nil
	if record and record.model then record.model:Destroy() end
end

function PoliceService.join(player)
	if not initialized or player.Parent ~= Players then return false end
	if duty[player] then sendState(player); return true end
	if suspects[player] then notice(player,"Resolva sua ocorrência antes de entrar em serviço.");return false end
	if not nearAny(player, sites.dutyPrompts) then notice(player, "Entre em serviço no balcão policial."); return false end
	if not Rules.canJoin(rootOf(player) ~= nil, player:GetAttribute("Detained"), count, Config.Slots) then
		notice(player, count &gt;= Config.Slots and "As três vagas policiais estão ocupadas." or "Você não pode entrar em serviço agora.")
		return false
	end
	-- Reserva a vaga antes de qualquer função externa que possa ceder execução.
	duty[player] = { patrol = 0, equipped = false }
	count += 1
	player:SetAttribute("PoliceDuty", true)
	if hooks.beforeDuty then
		local ok, err = pcall(hooks.beforeDuty, player)
		if not ok then
			PoliceService.leave(player)
			warn("[PoliceService] Falha ao iniciar serviço: " .. tostring(err))
			return false
		end
	end
	if not duty[player] or player.Parent ~= Players then return false end
	local assigned = WorkRoleService.assign(player, "Policial")
	if not assigned then
		PoliceService.leave(player)
		notice(player, "Encerre seu outro emprego antes de iniciar o plantão.")
		return false
	end
	-- O uniforme é retirado no vestiário e devolvido pelo WorkRoleService.

	broadcastState()
	notice(player, "Em serviço. Retire os equipamentos no arsenal e consulte os terminais.")
	return true
end

function PoliceService.leave(player, silent)
	local record = duty[player]
	if not record then return false end
	duty[player] = nil
	WorkRoleService.clear(player, "Policial")
	count = math.max(0, count - 1)
	player:SetAttribute("PoliceDuty", false)
	stripGear(player)
	removeTraining(player)
	local vest = player.Character and player.Character:FindFirstChild("ColetePolicial")
	if vest then vest:Destroy() end
	if player.Parent == Players and not silent then
		sendState(player); notice(player, "Serviço policial encerrado. Equipamentos devolvidos.")
	end
	broadcastState()
	return true
end

local function decorativePart(tool, handle, name, size, offset, color, shape)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Color = name, size, color
	p.CFrame = handle.CFrame * offset
	p.CanCollide, p.CanTouch, p.Massless = false, false, true
	if shape then p.Shape = shape end
	p.Parent = tool
	local weld = Instance.new("WeldConstraint"); weld.Part0, weld.Part1, weld.Parent = handle, p, p
	return p
end
local function makeTool(definition)
	local tool = Instance.new("Tool")
	tool.Name, tool.CanBeDropped, tool.RequiresHandle = definition.name, false, true
	tool:SetAttribute("PoliceIssued", true)
	tool:SetAttribute("PoliceTool", definition.id)
	local handle = Instance.new("Part")
	handle.Name, handle.Size, handle.Color = "Handle", Vector3.new(0.45, 1.1, 0.5), definition.color
	handle.CanCollide, handle.CanTouch, handle.Massless = false, false, true
	handle.Parent = tool
	if definition.id == "Spray" then
		tool.Grip = CFrame.new(0, -0.15, 0.1)
		decorativePart(tool, handle, "ReservatórioÁgua", Vector3.new(0.9, 0.8, 1.8), CFrame.new(0, 0.45, -0.45), Color3.fromRGB(35, 150, 220))
		decorativePart(tool, handle, "Bico", Vector3.new(0.5, 0.5, 1.1), CFrame.new(0, 0.45, -1.6), Color3.fromRGB(255, 175, 55))
	elseif definition.id == "Cuff" then
		handle.Size = Vector3.new(0.2, 0.45, 0.4)
		for _, side in ipairs({-1,1}) do
			local ring = decorativePart(tool, handle, "Aro", Vector3.new(0.14,0.85,0.85), CFrame.new(side * 0.45,0.2,0) * CFrame.Angles(0,0,math.pi/2), definition.color, Enum.PartType.Cylinder)
			ring.Material = Enum.Material.Metal
		end
	elseif definition.id == "Flashlight" then
		local head = decorativePart(tool, handle, "Lente", Vector3.new(0.65,0.65,0.2), CFrame.new(0,0.35,-0.4), Color3.fromRGB(245,238,195))
		local light = Instance.new("SpotLight")
		light.Name, light.Face, light.Range, light.Angle = "PoliceLight", Enum.NormalId.Front, 40, 65
		light.Brightness, light.Enabled, light.Parent = 2.5, false, head
	elseif definition.id == "Radio" then
		decorativePart(tool, handle, "Antena", Vector3.new(0.12,0.9,0.12), CFrame.new(0.12,0.95,0), Color3.fromRGB(15,20,28))
		decorativePart(tool, handle, "Tela", Vector3.new(0.32,0.4,0.06), CFrame.new(0,0.15,-0.28), Color3.fromRGB(110,220,180))
	end
	return tool
end
function PoliceService.requestGear(player)
	if not onDuty(player) or not nearAny(player, sites.armoryPrompts) then return false end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then return false end
	stripGear(player)
	for _, definition in ipairs(Config.Gear) do makeTool(definition).Parent = backpack end
	duty[player].equipped = true
	sendState(player)
	notice(player, "Kit recebido: lançador de água, algemas, lanterna e rádio.")
	return true
end

function PoliceService.clearSuspect(player)
	suspects[player] = nil
	player:SetAttribute("Wanted", false)
	player:SetAttribute("WantedReason", nil)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local prompt = root and root:FindFirstChild("PoliceCuffPrompt")
	if prompt then prompt:Destroy() end
end
local function cuffPrompt(root, action)
	local p = Instance.new("ProximityPrompt")
	p.Name, p.ActionText, p.ObjectText = "PoliceCuffPrompt", "Algemar", "Suspeito imobilizado"
	p.KeyboardKeyCode, p.HoldDuration, p.MaxActivationDistance = Enum.KeyCode.E, 0.8, 7
	-- O root fica dentro do torso; o servidor faz o raycast de visibilidade.
	p.RequiresLineOfSight, p.Parent = false, root
	p.Triggered:Connect(action)
	return p
end
function PoliceService.markSuspect(player, reason, duration)
	if not initialized or player.Parent ~= Players or not rootOf(player) or player:GetAttribute("Detained")
		or player:GetAttribute("InWorkZone") or duty[player] then return false end
	duration = Rules.finite(duration) and math.clamp(duration, 5, Config.SuspectSeconds) or Config.SuspectSeconds
	suspects[player] = { untilAt = now() + duration, reason = type(reason) == "string" and reason:sub(1,100) or "Ocorrência validada pelo servidor" }
	player:SetAttribute("Wanted", true)
	player:SetAttribute("WantedReason", suspects[player].reason)
	local root = rootOf(player)
	if not root:FindFirstChild("PoliceCuffPrompt") then cuffPrompt(root, function(officer) PoliceService.capture(officer, player.UserId) end) end
	for officer in pairs(duty) do notice(officer, "Alerta: suspeito identificado. Use água para imobilizar antes de algemar.") end
	return true
end

local function clearStun(player)
	local state = stuns[player]
	stuns[player] = nil
	player:SetAttribute("StunnedUntil", nil)
	if state and state.humanoid and state.humanoid.Parent then
		state.humanoid.JumpPower, state.humanoid.JumpHeight = state.jumpPower, state.jumpHeight
		if not player:GetAttribute("Detained") then state.humanoid.WalkSpeed = state.speed end
	end
end
local function stunPlayer(player)
	if hooks.beforeStun then
		local ok,err=pcall(hooks.beforeStun,player)
		if not ok then warn("[PoliceService] Falha ao preparar imobilização: "..tostring(err));return false end
	end
	local _, humanoid = Security.getLivingCharacter(player)
	if not humanoid then return false end
	local state = stuns[player]
	if not state or state.humanoid ~= humanoid then
		state = { humanoid = humanoid, speed = humanoid.WalkSpeed, jumpPower = humanoid.JumpPower, jumpHeight = humanoid.JumpHeight }
	end
	state.untilAt = now() + Config.StunSeconds
	stuns[player] = state
	humanoid.WalkSpeed, humanoid.JumpPower, humanoid.JumpHeight = 0, 0, 0
	player:SetAttribute("StunnedUntil", state.untilAt)
	notice(player, "Jato de água: você está imobilizado por alguns segundos.")
	return true
end
local function waterVisual(a, b)
	if (b-a).Magnitude &lt; 0.01 then return end
	local p = Instance.new("Part")
	p.Name, p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = "JatoDeÁgua", true, false, false, false
	p.Size, p.CFrame = Vector3.new(0.2,0.2,math.max(0.1,(b-a).Magnitude)), CFrame.lookAt((a+b)/2,b)
	p.Material, p.Color, p.Transparency = Enum.Material.Neon, Color3.fromRGB(95,200,245), 0.3
	p.Parent = Workspace
	Debris:AddItem(p, 0.15)
end
function PoliceService.spray(player, payload)
	if not onDuty(player) or not equipped(player,"Spray") or type(payload) ~= "table"
		or not Rules.validDirection(payload.direction) or not Security.checkRate(player,"PoliceSpray",Config.SprayCooldown) then return false end
	local character, _, root = Security.getLivingCharacter(player)
	local head = character:FindFirstChild("Head")
	local origin = head and head.Position or root.Position + Vector3.new(0,1.5,0)
	local direction = payload.direction.Unit
	local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = {character}; params.IgnoreWater = true
	local hit = Workspace:Raycast(origin, direction * Config.SprayRange, params)
	local hitPosition = hit and hit.Position or origin + direction * Config.SprayRange
	waterVisual(origin,hitPosition)
	if not hit then return true end
	local ancestor = hit.Instance
	while ancestor and ancestor ~= Workspace do
		if ancestor:IsA("Model") then
			local targetPlayer = Players:GetPlayerFromCharacter(ancestor)
			if targetPlayer then
				local suspect = suspects[targetPlayer]
				if suspect and now() &lt; suspect.untilAt and not targetPlayer:GetAttribute("Detained")
					and not targetPlayer:GetAttribute("InWorkZone") and targetPlayer ~= player then stunPlayer(targetPlayer) end
				return true
			end
			local record = training[player]
			if record and ancestor == record.model then
				record.stunnedUntil = now() + Config.StunSeconds
				record.model:SetAttribute("StunnedUntil",record.stunnedUntil)
				notice(player,"Alvo de treino imobilizado. Aproxime-se e equipe as algemas.")
				return true
			end
		end
		ancestor = ancestor.Parent
	end
	return true
end

local function targetPlayer(id)
	if type(id) ~= "number" or not Rules.finite(id) or id % 1 ~= 0 then return nil end
	return Players:GetPlayerByUserId(id)
end
function PoliceService.capture(officer, targetId)
	if not onDuty(officer) or not equipped(officer,"Cuff") or not Security.checkRate(officer,"PoliceCuff",0.5) then return false end
	local officerRoot = rootOf(officer)
	if targetId == "Training" then
		local record = training[officer]
		if not record or not record.model.Parent then return false end
		local targetRoot = record.model.PrimaryPart
		if not Rules.canCapture(true,true,(officerRoot.Position-targetRoot.Position).Magnitude,now(),record.stunnedUntil,true,false,false) then return false end
		local visibility=RaycastParams.new();visibility.FilterType=Enum.RaycastFilterType.Exclude;visibility.FilterDescendantsInstances={officer.Character,record.model}
		if Workspace:Raycast(officerRoot.Position,targetRoot.Position-officerRoot.Position,visibility) then return false end
		removeTraining(officer)
		addReport(officer,"Treinamento","Treinamento de abordagem concluído: água e algemas, sem dano.","Área de treinamento")
		sendState(officer)
		notice(officer,"Treinamento concluído. O registro foi enviado ao rádio da equipe.")
		return true
	end
	local target = targetPlayer(targetId)
	local targetRoot = target and rootOf(target)
	local suspect, stun = target and suspects[target], target and stuns[target]
	if not targetRoot or target == officer then return false end
	if not Rules.canCapture(true,true,(officerRoot.Position-targetRoot.Position).Magnitude,now(),stun and stun.untilAt,
		suspect ~= nil and now() &lt; suspect.untilAt,target:GetAttribute("Detained"),target:GetAttribute("InWorkZone")) then return false end
	-- Visibilidade entre os jogadores impede algemar através de parede/grade.
	local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = {officer.Character,target.Character}
	if Workspace:Raycast(officerRoot.Position,targetRoot.Position-officerRoot.Position,params) then return false end
	suspects[target] = nil -- trava a captura antes de callbacks que possam ceder execução
	local accepted = hooks.prisonService.detain(target,"police_capture")
	if not accepted then suspects[target] = suspect; return false end
	PoliceService.clearSuspect(target)
	clearStun(target)
	addReport(officer,"Captura","Suspeito imobilizado encaminhado à prisão.","Ocorrência em patrulha")
	return true
end

function PoliceService.submitReport(player, payload)
	if not onDuty(player) or not nearAny(player,sites.reportPrompts) or type(payload) ~= "table"
		or not Rules.validReport(payload.category) or not Security.checkRate(player,"PoliceReport",Config.ReportCooldown) then return false end
	addReport(player,payload.category,Config.ReportCategories[payload.category],"Terminal de ocorrências")
	notice(player,"Informe registrado e compartilhado com os policiais em serviço.")
	return true
end
local function doorwayOccupied(door)
	for _, player in ipairs(Players:GetPlayers()) do
		local root = rootOf(player)
		if root then
			local localPos = door.closed:PointToObjectSpace(root.Position)
			if math.abs(localPos.X) &lt;= door.part.Size.X/2+2 and math.abs(localPos.Y) &lt;= door.part.Size.Y/2+2
				and math.abs(localPos.Z) &lt;= door.part.Size.Z/2+3 then return true end
		end
	end
	return false
end
function PoliceService.toggleDoor(player, id)
	if type(id)=="string" and #id&lt;=64 and id:sub(1,5)=="Cell:" then
		if not onDuty(player) or not nearAny(player,sites.controlPrompts)
			or not hooks.prisonService.getCellControls or not hooks.prisonService.setCellDoor then return false end
		local cellId=id:sub(6)
		for _, cell in ipairs(hooks.prisonService.getCellControls()) do
			if tostring(cell.id)==cellId then
				local accepted,reason=hooks.prisonService.setCellDoor(cellId,not cell.open)
				if not accepted then
					notice(player,reason=="locked" and "A cela permanece lacrada nos primeiros 15 segundos da pena."
						or reason=="blocked" and "Afaste-se da porta antes de fechar a cela." or "Não foi possível operar essa cela agora.")
				end
				ui:FireClient(player,"PolicePanel",{panel="control",doors=doorList()})
				return accepted
			end
		end
		return false
	end
	local door = type(id) == "string" and #id &lt;= 64 and doors[id]
	if not door or not onDuty(player) or door.busy then return false end
	if not near(player,door.prompt) and not nearAny(player,sites.controlPrompts) then return false end
	if door.isOpen and doorwayOccupied(door) then notice(player,"Passagem ocupada. Aguarde antes de fechar."); return false end
	door.busy = true
	door.isOpen = not door.isOpen
	door.part:SetAttribute("Open",door.isOpen)
	local tween = TweenService:Create(door.part,TweenInfo.new(Config.DoorSeconds),{CFrame=door.isOpen and door.open or door.closed})
	tween:Play()
	task.delay(Config.DoorSeconds,function() door.busy=false end)
	ui:FireClient(player,"PolicePanel",{panel="control",doors=doorList()})
	return true
end

local function trainingModel(player, spawn)
	local model = Instance.new("Model"); model.Name = "Simulador de Abordagem"
	model:SetAttribute("PoliceTrainingOwner",player.UserId)
	local pieces = {
		{"HumanoidRootPart",Vector3.new(2,2,1),Vector3.zero,1},
		{"Torso",Vector3.new(2,2,1),Vector3.zero,0},
		{"Head",Vector3.new(1.6,1.2,1.2),Vector3.new(0,1.6,0),0},
		{"BraçoEsquerdo",Vector3.new(0.8,2,0.8),Vector3.new(-1.4,0,0),0},
		{"BraçoDireito",Vector3.new(0.8,2,0.8),Vector3.new(1.4,0,0),0},
		{"PernaEsquerda",Vector3.new(0.8,2,0.8),Vector3.new(-0.55,-2,0),0},
		{"PernaDireita",Vector3.new(0.8,2,0.8),Vector3.new(0.55,-2,0),0},
	}
	for _, data in ipairs(pieces) do
		local p=Instance.new("Part");p.Name,p.Size,p.CFrame=data[1],data[2],spawn*CFrame.new(data[3])
		p.Anchored,p.CanCollide,p.CanTouch,p.Transparency=true,false,false,data[4]
		p.CanQuery=data[4]==0;p.Color=Color3.fromRGB(235,163,65);p.Material=Enum.Material.SmoothPlastic;p.Parent=model
		if data[1]=="HumanoidRootPart" then model.PrimaryPart=p end
	end
	local humanoid=Instance.new("Humanoid");humanoid.DisplayName="Alvo de treinamento";humanoid.RequiresNeck=false;humanoid.BreakJointsOnDeath=false;humanoid.Parent=model
	model.Parent=Workspace
	cuffPrompt(model.PrimaryPart,function(officer) if officer==player then PoliceService.capture(officer,"Training") end end)
	return model
end
function PoliceService.startTraining(player)
	if not onDuty(player) or not near(player,sites.trainingPrompt) or not sites.trainingSpawn then return false end
	if not Security.checkRate(player,"PoliceTraining",Config.TrainingCooldown) then return false end
	if training[player] then notice(player,"Seu alvo já está na área de treinamento.");return false end
	local spawn=sites.trainingSpawn.CFrame
	-- Faixas individuais evitam um policial imobilizar o alvo de outro.
	local used={};for _,record in pairs(training) do used[record.lane]=true end
	local lane=0;while used[lane] do lane+=1 end
	spawn=spawn*CFrame.new(lane*5,0,0)
	local model=trainingModel(player,spawn)
	training[player]={model=model,base=spawn,lane=lane,untilAt=now()+Config.TrainingSeconds,stunnedUntil=0,startAt=now()}
	sendState(player);notice(player,"Treino iniciado: equipe água, acerte o alvo e use algemas de perto.")
	return true
end

local function showPanel(player, panel)
	if panel~="duty" and not onDuty(player) then notice(player,"Entre em serviço no balcão policial.");return end
	ui:FireClient(player,"PolicePanel",{panel=panel,count=count,slots=Config.Slots,onDuty=duty[player]~=nil,doors=doorList(),reports=reports,
		readOnly=panel=="reports" and not nearAny(player,sites.reportPrompts) or false})
end
local function onRequest(player, action, payload)
	if not Security.isShortString(action,16) or not Security.checkRate(player,"PoliceRequest",0.12) then return end
	if action=="Duty" then
		if payload==false then PoliceService.leave(player) elseif payload==true then PoliceService.join(player) end
	elseif action=="Gear" then PoliceService.requestGear(player)
	elseif action=="Spray" then PoliceService.spray(player,payload)
	elseif action=="Cuff" then PoliceService.capture(player,payload)
	elseif action=="Report" then PoliceService.submitReport(player,payload)
	elseif action=="Door" then PoliceService.toggleDoor(player,payload)
	elseif action=="Training" then PoliceService.startTraining(player)
	elseif action=="Radio" and onDuty(player) and equipped(player,"Radio") then showPanel(player,"reports")
	elseif action=="Flashlight" and onDuty(player) then
		local tool=equipped(player,"Flashlight")
		local light=tool and tool:FindFirstChild("PoliceLight",true)
		if light then light.Enabled=not light.Enabled end
	end
end

local function registerPromptList(prompts, callback)
	for _, prompt in ipairs(prompts or {}) do
		prompt.Enabled=true
		prompt.Triggered:Connect(function(player)
			if near(player,prompt) and Security.checkRate(player,"PolicePrompt",0.35) then callback(player,prompt) end
		end)
	end
end
function PoliceService.init(remotes,civicSites,options)
	if initialized then return end
	assert(civicSites and civicSites.police,"Pontos policiais ausentes")
	sites=civicSites.police;hooks=options or {};ui=assert(remotes[GameConfig.Remotes.UIUpdate],"UIUpdate ausente")
	assert(hooks.prisonService,"PrisonService ausente")
	initialized=true
	for _, door in ipairs(sites.doors or {}) do
		doors[door.id]=door;door.isOpen=false;door.busy=false;door.part:SetAttribute("Open",false)
		if door.prompt then registerPromptList({door.prompt},function(player) PoliceService.toggleDoor(player,door.id) end) end
	end
	registerPromptList(sites.dutyPrompts,function(player) showPanel(player,"duty") end)
	registerPromptList(sites.armoryPrompts,function(player) showPanel(player,"armory") end)
	registerPromptList(sites.reportPrompts,function(player) showPanel(player,"reports") end)
	registerPromptList(sites.controlPrompts,function(player) showPanel(player,"control") end)
	for index,prompt in ipairs(sites.patrolPrompts or {}) do
		registerPromptList({prompt},function(player)
			local record=duty[player]
			if not onDuty(player) or index~=(record.patrol or 0)+1 then return end
			record.patrol=index
			if index==#sites.patrolPrompts then
				addReport(player,"Patrulha","Ronda interna concluída com todos os pontos verificados.","Perímetro da prisão")
				record.patrol=0;notice(player,"Ronda concluída e registrada. Nenhuma ocorrência.")
			else notice(player,("Ponto %d/%d verificado."):format(index,#sites.patrolPrompts)) end
			sendState(player)
		end)
	end
	if sites.trainingPrompt then registerPromptList({sites.trainingPrompt},PoliceService.startTraining) end
	if sites.suspectTestPrompt then
		sites.suspectTestPrompt.Enabled=RunService:IsStudio()
		sites.suspectTestPrompt.Triggered:Connect(function(player)
			if RunService:IsStudio() and near(player,sites.suspectTestPrompt) and Security.checkRate(player,"PoliceSuspectTest",2) then
				if PoliceService.markSuspect(player,"Simulação voluntária no Studio",90) then notice(player,"Simulação iniciada. Outro jogador policial pode testar água e algemas por 90 segundos.") end
			end
		end)
	end
	assert(remotes[GameConfig.Remotes.PoliceRequest],"PoliceRequest ausente").OnServerEvent:Connect(onRequest)
	local function watchPlayer(player)
		player.CharacterAdded:Connect(function()
			-- Morrer/resetar devolve equipamentos e a vaga; não duplica o kit.
			PoliceService.leave(player,true);PoliceService.clearSuspect(player);clearStun(player)
			task.defer(function() if player.Parent==Players then sendState(player) end end)
		end)
		player:GetAttributeChangedSignal("Detained"):Connect(function()
			if player:GetAttribute("Detained") then PoliceService.leave(player,true) end
		end)
		task.defer(function() if player.Parent==Players then sendState(player) end end)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in ipairs(Players:GetPlayers()) do watchPlayer(player) end
	Players.PlayerRemoving:Connect(function(player)
		PoliceService.leave(player,true);PoliceService.clearSuspect(player);clearStun(player);removeTraining(player)
	end)
	task.spawn(function()
		while true do
			local time=now()
			for player,suspect in pairs(suspects) do if time&gt;=suspect.untilAt then PoliceService.clearSuspect(player) end end
			for player,stun in pairs(stuns) do
				if time&gt;=stun.untilAt or not rootOf(player) then clearStun(player)
				elseif not player:GetAttribute("Detained") then stun.humanoid.WalkSpeed=0;stun.humanoid.JumpPower=0;stun.humanoid.JumpHeight=0 end
			end
			for player,record in pairs(training) do
				if not duty[player] or time&gt;=record.untilAt or not record.model.Parent then removeTraining(player);if player.Parent==Players then sendState(player) end
				elseif time&gt;=record.stunnedUntil then record.model:PivotTo(record.base*CFrame.new(math.sin((time-record.startAt)*1.2)*4,0,0)) end
			end
			task.wait(0.15)
		end
	end)
end
return PoliceService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000022"><Properties><string name="Name">PrisonBuilder</string><ProtectedString name="Source">-- Complexo prisional inspirado na referência visual: blocos claros, faixas azuis,
-- coberturas laranja, muralha contínua e quatro torres. Toda autoridade é dos serviços.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("CivicConfig"))
local PrisonBuilder = {}
local cached
local V = Vector3.new
local WHITE = Color3.fromRGB(233, 230, 215)
local BLUE = Color3.fromRGB(31, 111, 165)
local DARK = Color3.fromRGB(40, 57, 67)
local ORANGE = Color3.fromRGB(233, 151, 74)
local STONE = Color3.fromRGB(165, 174, 172)
local WOOD = Color3.fromRGB(149, 112, 75)
local GREEN = Color3.fromRGB(102, 143, 95)

local function model(parent, name)
 local m = Instance.new("Model"); m.Name = name; m.Parent = parent; return m
end
local function part(parent, base, name, size, pos, color, material, collide)
 local p = Instance.new("Part")
 p.Name, p.Size = name, size
 p.CFrame = base * (typeof(pos) == "CFrame" and pos or CFrame.new(pos))
 p.Color, p.Material = color or WHITE, material or Enum.Material.SmoothPlastic
 p.Anchored, p.CanCollide = true, collide ~= false
 p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
 p.Parent = parent; return p
end
local function label(target, text, face, color)
 local gui = Instance.new("SurfaceGui"); gui.Name = "Identificação"
 gui.Face = face or Enum.NormalId.Front; gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
 gui.PixelsPerStud, gui.LightInfluence = 25, 0; gui.Parent = target
 local l = Instance.new("TextLabel"); l.Size = UDim2.fromScale(1,1)
 l.BackgroundTransparency, l.TextScaled, l.TextWrapped = 1,true,true
 l.Font, l.TextColor3, l.Text = Enum.Font.GothamBold,color or WHITE,text
 l.Parent = gui
end
local function sign(parent, base, text, pos, size, color)
 local p = part(parent,base,"Letreiro",size or V(22,3,0.25),pos,color or BLUE,nil,false)
 label(p,text); return p
end
local function lamp(parent, base, position, size)
 local p = part(parent,base,"Luminária",size or V(4,0.2,2),position,Color3.fromRGB(255,241,206),Enum.Material.Neon,false)
 local l=Instance.new("PointLight"); l.Brightness,l.Range,l.Shadows=1.2,25,false; l.Color=p.Color; l.Parent=p
 return p
end
local function marker(parent, base, name, position)
 local p=part(parent,base,name,V(1,1,1),position,WHITE,nil,false)
 p.Transparency,p.CanTouch,p.CanQuery=1,false,false; return p
end
local function seat(parent,base,position,color)
 local p=Instance.new("Seat"); p.Name="Banco";p.Anchored,p.CanTouch=true,false
 p.Size,p.CFrame=V(6,0.5,2),base*CFrame.new(position);p.Color,p.Material=color or WOOD,Enum.Material.SmoothPlastic;p.Parent=parent
 for _,x in ipairs({-2.3,2.3}) do part(parent,p.CFrame,"PéBanco",V(0.4,1.6,1.5),V(x,-0.8,0),DARK) end
 part(parent,p.CFrame,"Encosto",V(6,1.5,0.3),V(0,0.8,0.8),color or WOOD);return p
end
local function window(parent,base,pos,size)
 local f=part(parent,base,"MolduraJanela",size+V(0.6,0.6,0),pos,BLUE,nil,false)
 local glass=part(parent,base,"Vidro",size,pos+V(0,0,-0.18),Color3.fromRGB(149,190,208),Enum.Material.Glass,false)
 glass.Transparency=0.35;return f
end
local function prompt(parent,base,name,pos,action,object,kind,hold)
 local p=part(parent,base,name,V(2,2,0.4),pos,BLUE,Enum.Material.Metal,false)
 local q=Instance.new("ProximityPrompt");q.Name=name.."Prompt";q.ActionText,q.ObjectText=action,object
 q.KeyboardKeyCode,q.MaxActivationDistance,q.HoldDuration=Enum.KeyCode.E,9,hold or 0.5
 q.RequiresLineOfSight,q.Enabled=true,true;q.Parent=p
 if kind then q:SetAttribute("PoliceAction",kind);q:SetAttribute("Facility","Prison") end
 return q
end
local function door(parent,base,id,pos,size,delta,police,name)
 local leaf=part(parent,base,id,size,pos,BLUE,Enum.Material.DiamondPlate,true)
 local closed=leaf.CFrame;local open=base*CFrame.new(pos+delta)
 leaf:SetAttribute("DoorId",id);leaf:SetAttribute("DoorClosed",closed);leaf:SetAttribute("DoorOpen",open)
 label(leaf,name or "ACESSO CONTROLADO")
 local entry={id=id,part=leaf,closed=closed,open=open,restricted=true,name=name or id}
 if police then
  local q=prompt(parent,base,id.."Control",pos+V(0,0,-2),"Abrir / fechar",name or "Porta restrita","Door",0.5)
  q:SetAttribute("DoorId",id);entry.prompt=q;table.insert(police.doors,entry)
 end
 return entry
end
local function shell(parent,base,name,center,width,depth,height,roof,doorWidth)
 local m=model(parent,name);local b=base*CFrame.new(center)
 part(m,b,"Piso",V(width,0.3,depth),V(0,0.95,0),WHITE,Enum.Material.Concrete)
 part(m,b,"ParedeFundos",V(width,height,1),V(0,height/2+0.8,depth/2),WHITE)
 for _,x in ipairs({-width/2,width/2})do
  part(m,b,"ParedeLateral",V(1,height,depth),V(x,height/2+0.8,0),WHITE)
 end
 local gap=doorWidth or 10;local side=(width-gap)/2
 for _,s in ipairs({-1,1})do
  part(m,b,"Fachada",V(side,height,1),V(s*(gap/2+side/2),height/2+0.8,-depth/2),WHITE)
 end
 part(m,b,"Verga",V(gap,height-10,1),V(0,10.8+(height-10)/2,-depth/2),WHITE)
 part(m,b,"Cobertura",V(width+2,0.8,depth+2),V(0,height+1.2,0),roof)
 for _,z in ipairs({-depth/2-0.08,depth/2+0.08})do
  part(m,b,"FaixaAzul",V(width,2,0.2),V(0,4.2,z),BLUE,nil,false)
 end
 for _,x in ipairs({-width/4,width/4})do lamp(m,b,V(x,height+0.65,0))end
 return m,b
end
local function compoundTower(parent,base,x,z,index,police)
 local m=model(parent,"Torre "..index)
 -- A entrada das torres do sul aponta para o pátio, nunca para dentro da muralha.
 local b=base*CFrame.new(x,0,z)*CFrame.Angles(0,z&lt;0 and math.pi or 0,0)
 for _,side in ipairs({-1,1})do
  part(m,b,"Pilar",V(1,29,14),V(side*6.5,15.3,0),WHITE,Enum.Material.Concrete)
  part(m,b,"FaixaAzul",V(1.1,3,14.1),V(side*6.5,18,0),BLUE)
 end
 part(m,b,"ParedeTorre",V(12,29,1),V(0,15.3,6.5),WHITE)
 part(m,b,"BaseCabineEsquerda",V(9,0.8,17),V(-4,29.8,0),WHITE)
 -- A abertura da escada ocupa a metade direita da cabine; o patamar fica à esquerda.
 part(m,b,"BaseCabineDireita",V(8,0.8,3),V(4.5,29.8,7),WHITE)
 -- Quatro lances com degraus baixos: desnível de 0,62 stud por pisada.
 for i=1,48 do
  local flight=math.floor((i-1)/12)
  local step=(i-1)%12
  local forward=flight%2==0
  local zz=forward and (-5+step*0.9) or (4.9-step*0.9)
  local xx=forward and -3.2 or 3.2
  part(m,b,"Degrau",V(5.6,0.35,1.05),V(xx,1+(i-1)*0.62,zz),STONE,Enum.Material.Concrete)
  if i%12==0 and i&lt;48 then
   part(m,b,"Patamar",V(12,0.3,2.0),V(0,1+(i-1)*0.62+0.025,forward and 4.9 or -5),STONE)
  end
 end
 part(m,b,"GuardaEscada",V(0.25,2,10),V(0.65,31.3,1.5),DARK)
 -- Entrada de torre só pelo lado interior; não abre um buraco no muro.
 local inward=z&lt;0 and 1 or -1
 local d=door(m,b,"TowerDoor"..index,V(0,5.8,-6.5),V(6,10,0.5),V(6.8,0,0),police,"TORRE "..index)
 for _,side in ipairs({-1,1})do
  part(m,b,"FachadaTorre",V(3.5,10,1),V(side*4.75,5.8,-6.5),WHITE)
 end
 part(m,b,"VergaTorre",V(13,18,1),V(0,19.8,-6.5),WHITE)
 for _,side in ipairs({-1,1})do
  local g=part(m,b,"VidroCabine",V(0.3,7,14),V(side*7.1,34,0),Color3.fromRGB(164,201,210),Enum.Material.Glass,true);g.Transparency=0.45
  local f=part(m,b,"VidroCabine",V(14,7,0.3),V(0,34,side*7.1),Color3.fromRGB(164,201,210),Enum.Material.Glass,true);f.Transparency=0.45
  for _,zz in ipairs({-7.2,7.2})do part(m,b,"Caixilho",V(0.25,7.5,0.3),V(side*3.5,34,zz),DARK,nil,false)end
  part(m,b,"CaixilhoLateral",V(0.3,7.5,0.25),V(side*7.2,34,0),DARK,nil,false)
  part(m,b,"GuardaCorpo",V(14,0.25,0.25),V(0,33,side*7.3),DARK)
 end
 for _,side in ipairs({-1,1})do
  part(m,b,"FaixaCabineLateral",V(0.6,2,15),V(side*7.3,29,0),BLUE)
 end
 part(m,b,"FaixaCabineFundos",V(14,2,0.6),V(0,29,7.3),BLUE)
 part(m,b,"FaixaCabineFrente",V(7.5,2,0.6),V(-3.5,29,-7.3),BLUE)
 for _,s in ipairs({-1,1})do
  local wedge=Instance.new("WedgePart");wedge.Name="TelhadoInclinado";wedge.Anchored=true
  wedge.Size=V(19,6,9.5);wedge.Color,wedge.Material=DARK,Enum.Material.Slate
  wedge.CFrame=b*CFrame.new(0,40.2,s*4.75)*(s==1 and CFrame.Angles(0,math.pi,0)or CFrame.new());wedge.Parent=m
 end
 lamp(m,b,V(0,37.3,0));return m
end

-- Reúne referências de uma cena já construída sem duplicar nem substituir peças.
function PrisonBuilder.recover(parent)
 local m=parent.Name==Config.Prison.Name and parent or parent:FindFirstChild(Config.Prison.Name)
 assert(m and m:GetAttribute("ComplexVersion")==2,"Prisão existente precisa da arquitetura Marco 5.2 completa")
 if cached and cached.model==m then return cached end
 local base=Config.Prison.CFrame
 local police={dutyPrompts={},armoryPrompts={},reportPrompts={},controlPrompts={},patrolPrompts={},doors={}}
 local result={model=m,police=police,prisonCells={},escapeDoors={}}
 local lookup={Duty="dutyPrompts",Armory="armoryPrompts",Reports="reportPrompts",Control="controlPrompts",Patrol="patrolPrompts"}
 for _,object in ipairs(m:GetDescendants())do
  if object:IsA("ProximityPrompt")then
   local action=object:GetAttribute("PoliceAction")
   if lookup[action]then table.insert(police[lookup[action]],object)
   elseif action=="Training"then police.trainingPrompt=object
   elseif action=="SuspectTest"then police.suspectTestPrompt=object end
  elseif object:IsA("BasePart")then
   local id=object:GetAttribute("DoorId")
   if id and not object:GetAttribute("CellId")then
    local entry={id=id,part=object,closed=object:GetAttribute("DoorClosed"),open=object:GetAttribute("DoorOpen"),restricted=true,name=id}
    if id=="EscapeMaintenanceDoor"then result.escapeDoors[1]=entry
    else
     local terminal=m:FindFirstChild(id.."Control",true)
     entry.prompt=terminal and terminal:FindFirstChildOfClass("ProximityPrompt")
     assert(entry.prompt,"Terminal de porta ausente: "..id);table.insert(police.doors,entry)
    end
   end
  end
 end
 for row=1,2 do
  local cx=row==1 and -105 or -45;local face=row==1 and -90 or -60
  for i=0,7 do
   local id=(row==1 and "A"or"B")..string.format("%02d",i+1);local z=-46+i*18
   local spawn=m:FindFirstChild("CellSpawn_"..id,true)
   local leaf=m:FindFirstChild("CellDoor_"..id,true)
   assert(spawn and leaf,"Cela incompleta: "..id)
   table.insert(result.prisonCells,{id=id,spawn=spawn,door=leaf,closed=leaf:GetAttribute("DoorClosed"),open=leaf:GetAttribute("DoorOpen"),
    bounds={cf=base*CFrame.new(cx,9,z),half=V(14,8,8)},enclosure={cf=base*CFrame.new(cx,9,z),half=V(15,8,9)},
    exitPath={base*V(cx,4,z),base*V(face,4,z),base*V(-75,4,z)}})
  end
 end
 result.escapeSteps={}
 for _,name in ipairs({"EscapeHatch","EscapePassage","EscapeExit"})do
  local terminal=m:FindFirstChild(name,true)
  table.insert(result.escapeSteps,assert(terminal and terminal:FindFirstChildOfClass("ProximityPrompt"),"Passagem incompleta: "..name))
 end
 result.prisonSpawn=result.prisonCells[1].spawn
 result.prisonRelease=assert(m:FindFirstChild("PrisonRelease",true),"Saída da prisão ausente")
 result.prisonBounds={cf=base*CFrame.new(Config.Prison.BoundsCenter),half=Config.Prison.BoundsHalf}
 police.trainingSpawn=m:FindFirstChild("TrainingSpawn",true);police.trainingTarget=m:FindFirstChild("TrainingTarget",true)
 table.sort(police.patrolPrompts,function(a,b)return tonumber(a:GetAttribute("PatrolId"))&lt;tonumber(b:GetAttribute("PatrolId"))end)
 local container=parent.Name==Config.Prison.Name and parent.Parent or parent
 local fuel=container:FindFirstChild(Config.Fuel.Name)
 assert(fuel,"Posto afastado ausente")
 local personal=fuel:FindFirstChild("GaragemPessoal",true)
 result.personalGarage={prompt=assert(personal):FindFirstChildOfClass("ProximityPrompt"),spawns={assert(fuel:FindFirstChild("PersonalVehicleSpawn1",true)),assert(fuel:FindFirstChild("PersonalVehicleSpawn2",true))}}
 local uniform=m:FindFirstChild("UniformePrisão",true);local vehicle=m:FindFirstChild("ViaturaPrisão",true)
 local spawns={};for i=1,3 do spawns[i]=assert(m:FindFirstChild("PrisonPoliceVehicleSpawn"..i,true))end
 result.prisonWorkplace={uniformPrompts={assert(uniform):FindFirstChildOfClass("ProximityPrompt")},vehiclePrompts={assert(vehicle):FindFirstChildOfClass("ProximityPrompt")},vehicleSpawns=spawns}
 cached=result;return result
end

function PrisonBuilder.build(parent)
 if cached and cached.model.Parent==parent then return cached end
 if parent:FindFirstChild(Config.Prison.Name)then return PrisonBuilder.recover(parent)end
 local base=Config.Prison.CFrame
 local m=model(parent,Config.Prison.Name)
 m:SetAttribute("PlaceName",Config.Prison.Name);m:SetAttribute("MapLabel","Prisão");m:SetAttribute("Kind","Prison");m:SetAttribute("MapPosition",base.Position);m:SetAttribute("ComplexVersion",2)
 local police={dutyPrompts={},armoryPrompts={},reportPrompts={},controlPrompts={},patrolPrompts={},doors={}}
 local sites={police=police,prisonCells={},escapeDoors={}}
 local p=function(name,size,pos,color,material,collide)return part(m,base,name,size,pos,color,material,collide)end
 p("Esplanada",V(285,0.8,270),V(0,0.4,27.5),STONE,Enum.Material.Concrete)
 p("PátioRecepção",V(132,0.8,43),V(0,0.4,-127),STONE,Enum.Material.Concrete)
 p("PasseioVisitantes",V(10,0.8,20),V(0,0.4,-156),STONE,Enum.Material.Concrete)
 p("CaminhoPrincipal",V(21,0.05,150),V(0,0.85,10),Color3.fromRGB(191,194,186),Enum.Material.Concrete,false)
 -- Perímetro contínuo com só os portões controlados e a passagem técnica.
 for _,x in ipairs({-140,140})do
  if x&lt;0 then p("MuralhaOeste",V(2,23,265),V(x,12.3,27.5),WHITE,Enum.Material.Concrete)
  else
   p("MuralhaLesteSul",V(2,23,216),V(x,12.3,3),WHITE,Enum.Material.Concrete)
   p("MuralhaLesteNorte",V(2,23,31),V(x,12.3,144.5),WHITE,Enum.Material.Concrete)
   p("VergaPassagem",V(2,14,18),V(x,16.8,120),WHITE,Enum.Material.Concrete)
  end
  p("FaixaMuralha",V(2.12,3,265),V(x,17,27.5),BLUE,nil,false)
 end
 for _,z in ipairs({-105,160})do
  if z&gt;0 then p("MuralhaNorte",V(280,23,2),V(0,12.3,z),WHITE,Enum.Material.Concrete)
  else
   for _,s in ipairs({-1,1})do p("MuralhaSul",V(130,23,2),V(s*75,12.3,z),WHITE,Enum.Material.Concrete)end
   p("VergaPortão",V(20,11,2),V(0,18.3,z),WHITE)
  end
  for _,s in ipairs({-1,1})do
   p("FaixaMuralha",V(z&gt;0 and 140 or 130,3,2.1),V(s*(z&gt;0 and 70 or 75),17,z),BLUE,nil,false)
  end
 end
 -- Entradas consecutivas: visitantes no bloco público, equipe no interior seguro.
 door(m,base,"PrisonOuterGate",V(0,6.8,-105),V(20,12,1),V(21,0,0),police,"PORTÃO EXTERNO")
 door(m,base,"PrisonInnerGate",V(0,6.8,-57),V(20,12,0.6),V(21,0,0),police,"PORTÃO INTERNO")
 p("AntecâmaraOeste",V(1,13,48),V(-10.5,7.3,-81),WHITE)
 p("AntecâmaraLesteSul",V(1,13,21),V(10.5,7.3,-94.5),WHITE)
 p("AntecâmaraLesteNorte",V(1,13,19),V(10.5,7.3,-66.5),WHITE)
 p("AntecâmaraVerga",V(1,3,8),V(10.5,12.3,-80),WHITE)
 door(m,base,"PrisonSideAccess",V(10.5,5.8,-80),V(0.6,10,8),V(0,0,9.5),police,"ACESSO À ARMARIA")
 sign(m,base,"CENTRO DE REINTEGRAÇÃO KINDER",V(0,20.3,-106.2),V(105,4.3,0.3),BLUE)
 sign(m,base,"RECEPÇÃO / VISITAS     •     ACESSO CONTROLADO",V(0,9.5,-145.6),V(92,2.7,0.4))
 -- Administração branca/azul, com entrada pública e portas internas controladas.
 local admin,ab=shell(m,base,"Administração",V(0,0,-125),112,40,16,BLUE,16)
 admin:FindFirstChild("ParedeFundos"):Destroy()
 for _,side in ipairs({-1,1})do part(admin,ab,"ParedeFundos",V(46,16,1),V(side*33,8.8,20),WHITE)end
 part(admin,ab,"VergaAcessoSeguro",V(20,4,1),V(0,14.8,20),WHITE)
 p("ParedesSaguão",V(1,12,39),V(-16,6.8,-125),WHITE)
 p("DivisóriaApoio",V(1,12,39),V(38,6.8,-125),WHITE)
 sign(admin,ab,"RECEPÇÃO E INFORMAÇÕES",V(0,7,19.3),V(28,3,0.3))
 part(admin,ab,"Balcão",V(22,3.3,3),V(0,2.5,12),WOOD)
 part(admin,ab,"Tampo",V(23,0.3,3.4),V(0,4.3,12),BLUE)
 for _,x in ipairs({-10,10})do seat(admin,ab,V(x,2.5,-10),BLUE)end
 lamp(admin,ab,V(0,16.4,0),V(8,0.2,3))
 local duty=prompt(admin,ab,"PlantãoPrisão",V(8,4,8),"Entrar / sair do serviço","Plantão policial","Duty")
 table.insert(police.dutyPrompts,duty)
 police.suspectTestPrompt=prompt(admin,ab,"TesteSuspeitoStudio",V(-8,4,3),"Participar do teste","Simular suspeito (Studio)","SuspectTest")
 police.suspectTestPrompt.Enabled=false
 local report=prompt(admin,ab,"TerminalRelatórios",V(26,4,-4),"Registrar ocorrência","Central de informes","Reports")
 table.insert(police.reportPrompts,report)
 sign(admin,ab,"CENTRAL DE INFORMES",V(25,9.5,19.3),V(22,2.3,0.3))
 part(admin,ab,"MesaRelatórios",V(17,2.6,5),V(25,2.4,4),WOOD)
 for _,x in ipairs({21,29})do
  part(admin,ab,"Monitor",V(4,2.6,0.3),V(x,4.9,4.5),DARK)
  part(admin,ab,"Tela",V(3.4,2,0.1),V(x,4.9,4.3),Color3.fromRGB(76,143,165),Enum.Material.Neon,false)
 end
 -- A parte administrativa segura fica após o portão, evitando passagem pública pelo armamento.
 local armory,ar=shell(m,base,"Armaria",V(75,0,-76),76,42,16,BLUE,10)
 door(armory,ar,"PrisonArmory",V(0,5.8,-21),V(10,10,0.6),V(11,0,0),police,"ARMARIA")
 sign(armory,ar,"ARMARIA / EQUIPAMENTOS",V(0,13,-21.7),V(50,3,0.4))
 for _,x in ipairs({-29,-18,-7,4,15,26})do
  part(armory,ar,"ArmárioAzul",V(8,9,3),V(x,5.3,16),BLUE,Enum.Material.Metal)
  part(armory,ar,"Alça",V(0.2,1.2,0.15),V(x+2,5.2,14.4),STONE,nil,false)
 end
 local gear=prompt(armory,ar,"RetiradaEquipamento",V(0,4.8,7),"Retirar equipamento","Lançador de água, algemas e rádio","Armory")
 table.insert(police.armoryPrompts,gear)
 part(armory,ar,"BancadaEquipamentos",V(28,3,5),V(0,2.5,11),WOOD)
 sign(armory,ar,"EQUIPAMENTOS CARTUNESCOS\nUso autorizado em serviço",V(-25,7.5,20.3),V(20,5,0.3))
 for _,x in ipairs({-31,31})do window(armory,ar,V(x,8,-21.7),V(9,5,0.2))end
 -- Centro de controle junto ao pátio e à passagem entre os dois portões.
 local control,cb=shell(m,base,"Controle",V(38,0,-28),56,38,16,BLUE,10)
 door(control,cb,"PrisonControl",V(0,5.8,-19),V(10,10,0.6),V(11,0,0),police,"CONTROLE")
 sign(control,cb,"CENTRO DE CONTROLE",V(0,13,-19.7),V(43,3,0.3))
 part(control,cb,"Console",V(34,3,5),V(0,2.5,9),DARK)
 for _,x in ipairs({-12,0,12})do
  part(control,cb,"MonitorControle",V(9,4,0.3),V(x,5.7,11),BLUE)
  label(control:GetChildren()[#control:GetChildren()],"SETOR SEGURO",Enum.NormalId.Front)
 end
 local q=prompt(control,cb,"PainelControle",V(0,4,4),"Abrir painel","Portões e emergência","Control")
 table.insert(police.controlPrompts,q)
 -- Volume superior octagonal e heliponto decorativo como a referência.
 local hub=p("VolumeSuperior",V(15,36,36),CFrame.new(0,25.2,-125)*CFrame.Angles(0,0,math.pi/2),WHITE,Enum.Material.Concrete)
 hub.Shape=Enum.PartType.Cylinder
 local band=p("FaixaSuperior",V(4,36.3,36.3),CFrame.new(0,25.2,-125)*CFrame.Angles(0,0,math.pi/2),BLUE)
 band.Shape=Enum.PartType.Cylinder
 local heli=p("HelipontoCenográfico",V(0.7,47,47),CFrame.new(0,33.1,-125)*CFrame.Angles(0,0,math.pi/2),DARK)
 heli.Shape=Enum.PartType.Cylinder;label(heli,"H",Enum.NormalId.Right,WHITE);heli:SetAttribute("Decorative",true)
 -- Bloco de celas fechado: duas alas, oito celas individuais em cada lado.
 local wing=model(m,"Bloco de Celas A / B")
 part(wing,base,"PisoAlojamentos",V(92,0.3,146),V(-75,0.95,17),WHITE)
 part(wing,base,"ParedeOeste",V(1,17,146),V(-120,9.3,17),WHITE)
 part(wing,base,"ParedeLeste",V(1,17,146),V(-30,9.3,17),WHITE)
 part(wing,base,"ParedeFundos",V(90,17,1),V(-75,9.3,89),WHITE)
 for _,s in ipairs({-1,1})do part(wing,base,"ParedeFrontal",V(39,17,1),V(-75+s*25.5,9.3,-55),WHITE)end
 part(wing,base,"VergaCorredor",V(12,7,1),V(-75,14.3,-55),WHITE)
 part(wing,base,"CoberturaLaranja",V(94,0.8,148),V(-75,18.2,17),ORANGE)
 for _,x in ipairs({-97,-53})do
  part(wing,base,"Claraboia",V(10,0.2,80),V(x,18.75,17),Color3.fromRGB(190,220,223),Enum.Material.Glass,false)
 end
 sign(wing,base,"ALOJAMENTOS A — B",V(-75,14.2,-55.7),V(57,3,0.3))
 for row=1,2 do
  local cx=row==1 and -105 or -45;local face=row==1 and -90 or -60
  for i=0,7 do
   local z=-46+i*18;local id=(row==1 and "A"or"B")..string.format("%02d",i+1)
   local cell=model(wing,"Cela "..id)
   for _,zz in ipairs({z-9,z+9})do part(cell,base,"DivisóriaCela",V(30,17,0.5),V(cx,9.3,zz),WHITE,Enum.Material.Concrete)end
   for _,side in ipairs({-1,1})do
    -- Painéis de aço laterais e grades visíveis: intervalo inferior a um stud.
    part(cell,base,"PainelBaixo",V(0.65,2,6),V(face,1.8,z+side*6),BLUE,Enum.Material.Metal)
    for offset=-2.5,2.5,1 do part(cell,base,"GradeCela",V(0.25,8,0.25),V(face,6.8,z+side*6+offset),DARK,Enum.Material.Metal)end
    part(cell,base,"TravessaGrade",V(0.6,0.3,6),V(face,10.7,z+side*6),DARK,Enum.Material.Metal)
   end
   part(cell,base,"VergaCela",V(0.8,6.2,18),V(face,14.4,z),WHITE)
   local leaf=door(cell,base,"CellDoor_"..id,V(face,5.8,z),V(0.6,10,6),V(0,0,6.8),nil,"CELA "..id)
   -- Portas não participam do painel genérico: o serviço mantém a ocupação por cela.
   leaf.part:SetAttribute("CellId",id)
   local spawn=marker(cell,base,"CellSpawn_"..id,V(cx,4,z));spawn:SetAttribute("CellId",id)
   local outer=row==1 and -113 or -37
   part(cell,base,"EstruturaBeliche",V(6,1,8),V(outer,1.6,z-3.6),DARK,Enum.Material.Metal)
   part(cell,base,"Colchão",V(5.8,0.6,7.8),V(outer,2.4,z-3.6),Color3.fromRGB(80,134,166),Enum.Material.Fabric)
   part(cell,base,"Travesseiro",V(5,0.4,1.7),V(outer,2.9,z-5.8),WHITE,Enum.Material.Fabric,false)
   part(cell,base,"Vaso",V(2.3,1.8,2.8),V(outer,1.7,z+5.2),WHITE,Enum.Material.SmoothPlastic)
   part(cell,base,"CaixaDescarga",V(2.3,2.3,1.1),V(outer,2,z+7),WHITE)
   part(cell,base,"Pia",V(3,0.7,1.8),V(cx,3.1,z+7.5),WHITE)
   lamp(cell,base,V(cx,17.5,z),V(4,0.15,2))
   table.insert(sites.prisonCells,{id=id,spawn=spawn,door=leaf.part,closed=leaf.closed,open=leaf.open,bounds={cf=base*CFrame.new(cx,9,z),half=V(14,8,8)},enclosure={cf=base*CFrame.new(cx,9,z),half=V(15,8,9)},exitPath={base*V(cx,4,z),base*V(face,4,z),base*V(-75,4,z)}})
  end
 end
