</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000010"><Properties><string name="Name">WorkRoleRules</string><ProtectedString name="Source">-- Regras puras da autoridade de empregos e retirada de uniforme.
local WorkRoleRules = {}
local roles = { Policial = true, Taxista = true, Pizzaiolo = true, Atendente = true, Entregador = true }

function WorkRoleRules.finite(value)
	return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end

function WorkRoleRules.finitePoint(point)
	local kind = type(point)
	if kind ~= "table" and kind ~= "userdata" and kind ~= "vector" then return false end
	return WorkRoleRules.finite(point.X) and WorkRoleRules.finite(point.Y) and WorkRoleRules.finite(point.Z)
end

function WorkRoleRules.validRole(role)
	return type(role) == "string" and roles[role] == true
end

function WorkRoleRules.canAssign(currentRole, requestedRole, alive, detained)
	if not WorkRoleRules.validRole(requestedRole) then return false, "role" end
	if not alive or detained then return false, "character" end
	if currentRole ~= nil and currentRole ~= requestedRole then return false, "employed" end
	return true
end

function WorkRoleRules.canEquip(currentRole, requestedRole, distance, alive, detained, stunned)
	if not WorkRoleRules.validRole(requestedRole) or currentRole ~= requestedRole then return false, "role" end
	if not alive or detained or stunned then return false, "character" end
	if not WorkRoleRules.finite(distance) or distance &lt; 0 or distance &gt; 11 then return false, "distance" end
	return true
end

return WorkRoleRules
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000000000000000000000000000011"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000000000000000000000000000012"><Properties><string name="Name">ServerBootstrap</string><ProtectedString name="Source">-- ServerBootstrap (Script)
-- Caminho: ServerScriptService &gt; ServerBootstrap
-- Ponto de partida do servidor. Cria os RemoteEvents, monta o mapa
-- e liga os serviços na ordem certa.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local Services = script.Parent:WaitForChild("Services")

local MapBuilder = require(Services:WaitForChild("MapBuilder"))
local VehicleService = require(Services:WaitForChild("VehicleService"))
local PlayerDataService = require(Services:WaitForChild("PlayerDataService"))
local NPCService = require(Services:WaitForChild("NPCService"))
local TutorialService = require(Services:WaitForChild("TutorialService"))
local EconomyService = require(Services:WaitForChild("EconomyService"))
local DailyBonusService = require(Services:WaitForChild("DailyBonusService"))
local JobService = require(Services:WaitForChild("JobService")) -- liga também o MissionService
local ZoneService = require(Services:WaitForChild("ZoneService"))
local SeatService = require(Services:WaitForChild("SeatService"))
local CivicBuilder = require(Services:WaitForChild("CivicBuilder"))
local PrisonService = require(Services:WaitForChild("PrisonService"))
local PoliceService = require(Services:WaitForChild("PoliceService"))
local TaxiService = require(Services:WaitForChild("TaxiService"))
local WorkRoleService = require(Services:WaitForChild("WorkRoleService"))
local WorkplaceBuilder = require(Services:WaitForChild("WorkplaceBuilder"))
local StreetNPCService = require(Services:WaitForChild("StreetNPCService"))

-- Segura o nascimento dos jogadores até o mapa existir
Players.CharacterAutoLoads = false

-- 1. RemoteEvents (sempre criados pelo servidor, com nomes do GameConfig)
local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "Remotes"
	remotesFolder.Parent = ReplicatedStorage
end

local remotes = {}
for _, remoteName in pairs(GameConfig.Remotes) do
	local remote = remotesFolder:FindFirstChild(remoteName)
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = remotesFolder
	end
	remotes[remoteName] = remote
end

-- 2. Mapa
local ok, err = pcall(MapBuilder.build)
if not ok then
	warn("[ServerBootstrap] Erro ao montar o mapa: " .. tostring(err))
end

-- 3. Serviços (os dados primeiro, porque outros serviços dependem deles)
PlayerDataService.init()
EconomyService.init()
DailyBonusService.init()
TutorialService.init(remotes)
ZoneService.init() -- locais de trabalho protegidos (precisa do mapa pronto)
VehicleService.init(remotes)
NPCService.init(remotes)
JobService.init(remotes)
local workplaces = WorkplaceBuilder.build(CivicBuilder.sites.workplaces)
WorkRoleService.init(remotes, workplaces)
VehicleService.configureWorkplaces(workplaces, CivicBuilder.sites.personalGarage)
-- Prisão e polícia compartilham apenas APIs internas. O cliente não escolhe
-- quem fica preso; abordagem e algemamento são conferidos pelo servidor.
PrisonService.init(remotes, CivicBuilder.sites, {
	beforeDetain = function(player)
		TaxiService.leave(player)
		PoliceService.leave(player)
		JobService.leave(player)
		VehicleService.prepareForDetention(player)
	end,
})
PoliceService.init(remotes, CivicBuilder.sites, {
	beforeDuty = function(player)
		TaxiService.leave(player)
		JobService.leave(player)
		VehicleService.prepareForDetention(player)
	end,
	beforeStun = VehicleService.prepareForDetention,
	prisonService = PrisonService,
})
TaxiService.init(remotes, CivicBuilder.sites.taxi, {
	vehicleService = VehicleService,
	workRoleService = WorkRoleService,
	beforeDuty = function(player)
		PoliceService.leave(player)
		JobService.leave(player)
		VehicleService.prepareForDetention(player)
	end,
})
StreetNPCService.init(CivicBuilder.sites)
SeatService.init(VehicleService.dismount) -- bancos: sentar com E (depois que lojas e praça existem)

-- 4. Libera o nascimento dos jogadores
Players.CharacterAutoLoads = true
for _, player in ipairs(Players:GetPlayers()) do
	if not player.Character then
		player:LoadCharacter()
	end
end

print(("[ServerBootstrap] %s (%s) pronto."):format(GameConfig.GameName, GameConfig.Version))
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000000000000000000000000000013"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000014"><Properties><string name="Name">CarBuilder</string><ProtectedString name="Source">-- CarBuilder (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; CarBuilder
-- Monta um carro a partir dos dados de GameConfig.Cars (base para os próximos carros).
-- Estrutura:
--   * Chassis: caixa invisível que colide com paredes e calçadas; é ela que anda.
--     LinearVelocity (velocidade) + AlignOrientation (direção, sempre em pé) controlados por
--     quem dirige (CarController, no cliente do motorista).
--   * Carroceria, vidros, luzes, rodas: só visual (não colidem, não pesam), soldados no chassi.
--   * Rodas e portas presas por Motor6D: o cliente gira as rodas, esterça e abre as portas.
--   * VehicleSeat do motorista (esquerda) e Seat do carona (direita).
-- Frente do carro = -Z. Há sedãs de serviço e o esportivo pessoal, com portas que
-- abrem para cima, teto preto "flutuante", detalhes azuis e rodas vermelhas.

local CarBuilder = {}

local function part(parent, props)
	local p = Instance.new(props.ClassName or "Part")
	p.Name = props.Name
	p.Size = props.Size
	p.Color = props.Color or Color3.new(1, 1, 1)
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		p.Shape = props.Shape
	end
	p.Transparency = props.Transparency or 0
	p.Reflectance = props.Reflectance or 0
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.Anchored = false
	p.CFrame = props.CFrame
	p.Parent = parent
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

-- Peça que gira/abre presa ao chassi por Motor6D no ponto "pivot" (coordenadas do chassi)
local function hinged(chassis, p, pivot, motorName)
	local localCf = chassis.CFrame:ToObjectSpace(p.CFrame)
	local motor = Instance.new("Motor6D")
	motor.Name = motorName
	motor.Part0 = chassis
	motor.Part1 = p
	motor.C0 = CFrame.new(pivot)
	motor.C1 = (CFrame.new(pivot):Inverse() * localCf):Inverse()
	motor.Parent = p
	return motor
end

local function surfaceText(target, value, face, color, size)
	local gui = Instance.new("SurfaceGui")
	gui.Name, gui.Face, gui.LightInfluence = "Identificação", face or Enum.NormalId.Front, 0
	gui.SizingMode, gui.PixelsPerStud = Enum.SurfaceGuiSizingMode.PixelsPerStud, 40
	gui.Parent = target
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency, label.Size = 1, UDim2.fromScale(1, 1)
	label.Text, label.TextScaled, label.TextWrapped = value, true, true
	label.Font, label.TextColor3 = Enum.Font.GothamBold, color or Color3.new(1, 1, 1)
	label.Parent = gui
end

-- Sedã original de quatro portas: cabine alta e vazia, duas vagas utilizáveis,
-- banco traseiro visual e identificação própria da empresa/serviço.
local function buildSedan(spec, cf)
	local car = Instance.new("Model"); car.Name = spec.Name
	local V = Vector3.new
	local L, W, r, g = spec.Length, spec.Width, spec.WheelRadius, -spec.Hover
	local front, back = -L / 2, L / 2
	local dark, metal = spec.TrimColor, spec.RimColor
	local chassis = part(car, { Name = "Chassis", Size = V(W - 0.4, 2.4, L - 0.6), CFrame = cf, Transparency = 1 })
	chassis.CanCollide, chassis.CanQuery, chassis.Massless = true, true, false
	chassis.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 0, 100, 1)
	car.PrimaryPart = chassis
	local function at(x, y, z) return cf * CFrame.new(x, y, z) end
	local function body(name, size, x, y, z, color, extra, parent, base)
		extra = extra or {}
		local p = part(parent or car, { Name = name, Size = size, CFrame = at(x, y, z) * (extra.rot or CFrame.new()),
			Color = color, Material = extra.Material, Transparency = extra.Transparency, Shape = extra.Shape,
			ClassName = extra.ClassName, Reflectance = extra.Reflectance })
		weld(base or chassis, p); return p
	end
	local paint = { Reflectance = spec.Reflectance }
	body("Soleira", V(W - 0.6, 0.7, L - 1), 0, g + 1.35, 0, dark)
	body("Carroceria", V(W - 0.7, 1.8, L - 1), 0, g + 2.6, 0, spec.BodyColor, paint)
	body("Capô", V(W - 0.8, 0.55, 4.3), 0, g + 3.65, front + 2.7, spec.BodyColor, paint)
	body("PortaMalas", V(W - 0.8, 0.55, 3.1), 0, g + 3.7, back - 2, spec.BodyColor, paint)
	body("Teto", V(W - 1.1, 0.35, 8.6), 0, g + 7.1, 0.55, spec.BodyColor, paint)
	body("ParaBrisa", V(W - 1.3, 2.7, 0.16), 0, g + 5.5, -3.9, spec.GlassColor,
		{ Material = Enum.Material.Glass, Transparency = 0.42, rot = CFrame.Angles(math.rad(-17), 0, 0) })
	body("VidroTraseiro", V(W - 1.3, 2.5, 0.16), 0, g + 5.4, 4.85, spec.GlassColor,
		{ Material = Enum.Material.Glass, Transparency = 0.42, rot = CFrame.Angles(math.rad(18), 0, 0) })
	for _, side in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -3.9, 0.55, 4.85 }) do
			body("Coluna", V(0.35, 3.15, 0.35), side * (W / 2 - 0.6), g + 5.4, z, dark)
		end
		body("Retrovisor", V(0.8, 0.5, 0.8), side * (W / 2 + 0.05), g + 4.7, -3.2, dark)
		for index, z in ipairs({ -1.7, 2.6 }) do
			local isFront = index == 1
			local name = (isFront and "Door" or "RearDoor") .. (side &lt; 0 and "Left" or "Right")
			local color = spec.Role == "Policial" and Color3.fromRGB(238, 240, 243) or spec.BodyColor
			local leaf = part(car, { Name = name, Size = V(0.2, 2.0, 3.85), CFrame = at(side * (W / 2 - 0.2), g + 3.2, z), Color = color })
			body("VidroPorta", V(0.12, 2.0, 3.55), side * (W / 2 - 0.55), g + 5.3, z, spec.GlassColor,
				{ Material = Enum.Material.Glass, Transparency = 0.42 }, leaf, leaf)
			body("Maçaneta", V(0.1, 0.15, 0.8), side * (W / 2 - 0.05), g + 3.9, z + 1.1, metal, nil, leaf, leaf)
			local hinge = hinged(chassis, leaf, V(side * (W / 2 - 0.25), g + 3.2, z - 1.8), "DoorMotor")
			hinge:SetAttribute("Side", side)
			if isFront then
				surfaceText(leaf, spec.Role == "Taxista" and "LXR TÁXIS" or "POLÍCIA", side &lt; 0 and Enum.NormalId.Left or Enum.NormalId.Right,
					spec.Role == "Taxista" and Color3.fromRGB(26, 70, 139) or Color3.fromRGB(24, 66, 115))
			end
		end
		if spec.Role == "Taxista" then
			for i = 1, 16 do
				for row = 0, 1 do
					if (i + row) % 2 == 0 then body("XadrezLXR", V(0.08, 0.35, 0.65), side * (W / 2 - 0.04), g + 2.5 + row * 0.35, -5.5 + i * 0.65, dark) end
				end
			end
		else
			body("FaixaPolicial", V(0.1, 0.4, L - 3), side * (W / 2 - 0.05), g + 2.5, 0.4, Color3.fromRGB(37, 105, 175))
		end
		body("Farol", V(2.1, 0.8, 0.25), side * 2.1, g + 3.1, front + 0.4, Color3.fromRGB(235, 247, 255), { Material = Enum.Material.Neon })
		body("Lanterna", V(2.1, 0.7, 0.2), side * 2.1, g + 3.2, back - 0.4, Color3.fromRGB(211, 40, 44), { Material = Enum.Material.Neon })
	end
	body("Grade", V(2.7, 0.9, 0.25), 0, g + 2.9, front + 0.25, dark)
	for _, z in ipairs({ front + 0.2, back - 0.2 }) do body("ParaChoque", V(W - 0.3, 0.55, 0.5), 0, g + 1.9, z, dark) end
	local plate = body("Placa", V(2, 0.6, 0.1), 0, g + 2.5, back - 0.08, Color3.fromRGB(240, 241, 234))
	surfaceText(plate, spec.Role == "Taxista" and "LXR • CIDADE" or "KINDER • 01", Enum.NormalId.Back, Color3.fromRGB(32, 42, 52))
	body("Painel", V(W - 1.6, 0.65, 1), 0, g + 3.3, -3.1, dark)
	body("Volante", V(0.2, 1.0, 1.0), -1.6, g + 3.3, -2.55, dark, { Shape = Enum.PartType.Cylinder, rot = CFrame.Angles(0, math.pi / 2, 0) })
	local seatY = g + 1.2
	local driver = part(car, { ClassName = "VehicleSeat", Name = "DriverSeat", Size = V(1.9, 0.4, 1.8), CFrame = at(-1.65, seatY, -0.9), Color = spec.SeatColor })
	driver.CanTouch, driver.MaxSpeed, driver.Torque, driver.HeadsUpDisplay = false, 0, 0, false
	driver:SetAttribute("CarSeat", true); weld(chassis, driver)
	local passenger = part(car, { ClassName = "Seat", Name = "PassengerSeat", Size = V(1.9, 0.4, 1.8), CFrame = at(1.65, seatY, -0.9), Color = spec.SeatColor })
	weld(chassis, passenger)
	for _, x in ipairs({ -1.65, 1.65 }) do body("Encosto", V(1.9, 2.4, 0.45), x, seatY + 1.3, 0.15, spec.SeatColor) end
	body("BancoTraseiro", V(W - 2, 0.55, 2.1), 0, seatY + 0.05, 2.55, spec.SeatColor)
	body("EncostoTraseiro", V(W - 2, 2.5, 0.5), 0, seatY + 1.25, 3.65, spec.SeatColor)
	if spec.Role == "Taxista" then
		local sign = body("LetreiroTaxi", V(3.3, 0.9, 1.4), 0, g + 7.8, 0.2, Color3.fromRGB(255, 221, 88))
		surfaceText(sign, "TÁXI", Enum.NormalId.Front, Color3.fromRGB(25, 62, 104))
		surfaceText(sign, "TÁXI", Enum.NormalId.Back, Color3.fromRGB(25, 62, 104))
	else
		body("BaseGiroflex", V(4.8, 0.25, 1.3), 0, g + 7.5, 0.2, dark)
		for _, side in ipairs({ -1, 1 }) do
			local light = body(side &lt; 0 and "PoliceRed" or "PoliceBlue", V(2.1, 0.65, 1.1), side * 1.15, g + 7.9, 0.2,
				side &lt; 0 and Color3.fromRGB(224, 42, 54) or Color3.fromRGB(43, 123, 246), { Material = Enum.Material.Neon })
			local glow = Instance.new("PointLight"); glow.Name, glow.Range, glow.Brightness, glow.Shadows = "Flasher", 14, 0.6, false
			glow.Color, glow.Parent = light.Color, light
		end
		local badge = body("EmblemaPolicial", V(1.2, 0.1, 1.3), 0, g + 3.98, front + 2.8, Color3.fromRGB(235, 190, 68))
		surfaceText(badge, "★", Enum.NormalId.Top, Color3.fromRGB(32, 70, 120))
	end
	for _, wz in ipairs({ front + 3.3, back - 3.3 }) do
		for _, side in ipairs({ -1, 1 }) do
			local name = (wz &lt; 0 and "Front" or "Rear") .. (side &lt; 0 and "Left" or "Right")
			local center = V(side * (W / 2 - 0.3), g + r, wz)
			local hub = part(car, { Name = name, Size = V(0.4, 0.4, 0.4), CFrame = at(center.X, center.Y, center.Z), Transparency = 1 })
			local motor = Instance.new("Motor6D"); motor.Name, motor.Part0, motor.Part1, motor.C0, motor.Parent = "WheelMotor", chassis, hub, CFrame.new(center), hub
			local function rim(name2, size, offset, color)
				local p = part(car, { Name = name2, Size = size, CFrame = hub.CFrame * offset, Color = color, Shape = Enum.PartType.Cylinder })
				weld(hub, p); return p
			end
			rim("Pneu", V(1.1, r * 2, r * 2), CFrame.new(), Color3.fromRGB(21, 23, 27))
			rim("Roda", V(1.15, r * 1.5, r * 1.5), CFrame.new(), metal)
			rim("CentroRoda", V(1.22, r * 0.6, r * 0.6), CFrame.new(), dark)
			for k = 0, 5 do
				local spoke = part(car, { Name = "Raio", Size = V(1.21, r * 0.75, 0.18), CFrame = hub.CFrame * CFrame.Angles(k * math.pi / 3, 0, 0) * CFrame.new(0, r * 0.3, 0), Color = dark })
				weld(hub, spoke)
			end
		end
	end
	local attachment = Instance.new("Attachment"); attachment.Name, attachment.Parent = "DriveAttachment", chassis
	local lv = Instance.new("LinearVelocity"); lv.Name, lv.Attachment0, lv.RelativeTo = "Drive", attachment, Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode, lv.MaxForce, lv.VectorVelocity, lv.Parent = Enum.VelocityConstraintMode.Vector, 1e6, V(0, 0, 0), chassis
	local ao = Instance.new("AlignOrientation"); ao.Name, ao.Mode, ao.Attachment0 = "Upright", Enum.OrientationAlignmentMode.OneAttachment, attachment
	ao.MaxTorque, ao.Responsiveness, ao.CFrame, ao.Parent = 1e6, 30, cf.Rotation, chassis
	for _, p in ipairs(car:GetDescendants()) do if p:IsA("BasePart") then p.CollisionGroup = "Veiculos" end end
	car:SetAttribute("Spec", spec.Name); car:SetAttribute("DoorStyle", "Sedan")
	return car, driver, passenger
end

-- cf = posição e direção do centro do chassi no mundo
function CarBuilder.build(spec, cf)
	if spec.Style == "Sedan" then return buildSedan(spec, cf) end
	local car = Instance.new("Model")
	car.Name = spec.Name
	local L, W = spec.Length, spec.Width
	local r = spec.WheelRadius
	local g = -spec.Hover -- altura do chão, em coordenadas do chassi

	local chassis = part(car, { Name = "Chassis", Size = Vector3.new(W - 0.4, 2.4, L - 0.6), CFrame = cf, Transparency = 1 })
	chassis.CanCollide = true
	chassis.CanQuery = true
	chassis.Massless = false
	chassis.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 0, 100, 1) -- sem atrito: desliza sobre a calçada
	car.PrimaryPart = chassis

	local function at(x, y, z)
		return cf * CFrame.new(x, y, z)
	end
	-- peça soldada no chassi; extra = { ClassName, Material, Transparency, Reflectance, Shape, rot }
	local function body(name, size, x, y, z, color, extra)
		extra = extra or {}
		local p = part(car, {
			ClassName = extra.ClassName,
			Name = name,
			Size = size,
			CFrame = at(x, y, z) * (extra.rot or CFrame.new()),
			Color = color,
			Material = extra.Material,
			Transparency = extra.Transparency,
			Reflectance = extra.Reflectance,
			Shape = extra.Shape,
		})
		weld(chassis, p)
		return p
	end
	local paint = { Reflectance = spec.Reflectance or 0.08 }
	local neon = { Material = Enum.Material.Neon }
	local BODY, TRIM, ACCENT, GLASS = spec.BodyColor, spec.TrimColor, spec.AccentColor, spec.GlassColor
	local front, back = -L / 2, L / 2
	local cabinZ = 0.6

	-- Base e laterais (bem baixas)
	body("Sill", Vector3.new(W - 0.5, 0.7, L - 1.2), 0, g + 1.25, 0, TRIM)
	body("Body", Vector3.new(W - 0.6, 1.4, L - 0.8), 0, g + 2.3, 0, BODY, paint)
	-- Capô em cunha: alto perto do para-brisa, fino no bico
	body("Nose", Vector3.new(W - 0.8, 1.0, 5.4), 0, g + 3.5, front + 3.1, BODY, { ClassName = "WedgePart", Reflectance = paint.Reflectance })
	body("NoseTip", Vector3.new(W - 1.0, 0.5, 1.2), 0, g + 2.85, front + 0.55, BODY, paint)
	body("HoodStripe", Vector3.new(1.2, 0.08, 4.4), 0, g + 3.55, front + 3.3, TRIM, { rot = CFrame.Angles(math.rad(-10.5), 0, 0) })
	-- Traseira: tampa curta e aerofólio fino
	body("RearDeck", Vector3.new(W - 0.8, 0.5, 2.4), 0, g + 3.25, back - 1.4, BODY, paint)
	body("Spoiler", Vector3.new(W - 1.2, 0.12, 0.8), 0, g + 3.62, back - 0.55, TRIM)

	-- Cabine baixa: vidros escuros, teto preto "flutuante" e colunas pretas que descem até a traseira
	body("Cabin", Vector3.new(W - 2.0, 1.4, 3.6), 0, g + 3.9, cabinZ, GLASS, { Material = Enum.Material.Glass, Transparency = 0.3 })
	body("Roof", Vector3.new(W - 1.9, 0.25, 4.0), 0, g + 4.72, cabinZ, TRIM, { Reflectance = 0.15 })
	body("Windshield", Vector3.new(W - 2.0, 1.4, 3.6), 0, g + 3.9, cabinZ - 1.8 - 1.8, GLASS, { ClassName = "WedgePart", Material = Enum.Material.Glass, Transparency = 0.3 })
	body("RearGlass", Vector3.new(W - 2.0, 1.4, 4.2), 0, g + 3.9, cabinZ + 1.8 + 2.1, GLASS, {
		ClassName = "WedgePart",
		Material = Enum.Material.Glass,
		Transparency = 0.3,
		rot = CFrame.Angles(0, math.pi, 0),
	})
	for _, s in ipairs({ -1, 1 }) do
		-- "asa" preta que sai do teto e desce até a traseira
		body("Buttress", Vector3.new(0.4, 0.35, 5.2), s * (W / 2 - 1.05), g + 4.1, cabinZ + 4.1, TRIM, { rot = CFrame.Angles(math.rad(14), 0, 0) })
		-- faixa azul na lateral e entrada de ar atrás da porta
		body("SideAccent", Vector3.new(0.08, 0.22, L - 4.5), s * (W / 2 - 0.27), g + 1.85, 0.4, ACCENT, neon)
		body("SideIntake", Vector3.new(0.1, 0.9, 2.2), s * (W / 2 - 0.28), g + 2.45, cabinZ + 3.6, Color3.fromRGB(12, 12, 14))
		body("IntakeTrim", Vector3.new(0.11, 0.12, 2.2), s * (W / 2 - 0.27), g + 2.95, cabinZ + 3.6, ACCENT)
		body("Mirror", Vector3.new(0.7, 0.35, 0.55), s * (W / 2 - 0.05), g + 3.7, cabinZ - 2.2, TRIM)
	end

	-- Portas que abrem para cima (presas na dobradiça da frente, em cima)
	for _, s in ipairs({ -1, 1 }) do
		local door = part(car, { Name = s &lt; 0 and "DoorLeft" or "DoorRight", Size = Vector3.new(0.18, 1.3, 3.6), CFrame = at(s * (W / 2 - 0.22), g + 2.4, cabinZ - 0.3), Color = BODY, Reflectance = paint.Reflectance })
		local doorGlass = part(car, { Name = "DoorGlass", Size = Vector3.new(0.12, 1.2, 3.2), CFrame = at(s * (W / 2 - 0.95), g + 3.75, cabinZ - 0.2), Color = GLASS, Material = Enum.Material.Glass, Transparency = 0.3 })
		local handle = part(car, { Name = "Handle", Size = Vector3.new(0.06, 0.12, 0.6), CFrame = at(s * (W / 2 - 0.12), g + 2.75, cabinZ + 0.9), Color = Color3.fromRGB(190, 190, 195) })
		weld(door, doorGlass)
		weld(door, handle)
		local motor = hinged(chassis, door, Vector3.new(s * (W / 2 - 0.5), g + 4.4, cabinZ - 2.1), "DoorMotor")
		motor:SetAttribute("Side", s)
	end

	-- Frente: faróis finos e angulados, entradas de ar com moldura azul, grade fina no centro
	for _, s in ipairs({ -1, 1 }) do
		body("Headlight", Vector3.new(1.9, 0.22, 0.25), s * 2.3, g + 3.0, front + 0.75, Color3.fromRGB(230, 245, 255), {
			Material = Enum.Material.Neon,
			rot = CFrame.Angles(0, s * math.rad(-14), s * math.rad(6)),
		})
		body("HeadlightAccent", Vector3.new(1.6, 0.1, 0.25), s * 2.3, g + 2.8, front + 0.7, ACCENT, {
			Material = Enum.Material.Neon,
			rot = CFrame.Angles(0, s * math.rad(-14), 0),
		})
		body("Intake", Vector3.new(1.8, 0.75, 0.2), s * 2.4, g + 1.95, front + 0.42, Color3.fromRGB(12, 12, 14))
		body("IntakeFrame", Vector3.new(1.9, 0.12, 0.22), s * 2.4, g + 2.38, front + 0.42, ACCENT)
	end
	body("Grille", Vector3.new(2.4, 0.3, 0.2), 0, g + 2.6, front + 0.15, Color3.fromRGB(12, 12, 14))
	body("GrilleLine", Vector3.new(2.4, 0.06, 0.22), 0, g + 2.6, front + 0.14, Color3.fromRGB(170, 175, 185))
	body("Splitter", Vector3.new(W - 0.6, 0.15, 0.9), 0, g + 1.0, front + 0.6, TRIM)

	-- Traseira: lanternas em "U", difusor e 2 escapamentos
	for _, s in ipairs({ -1, 1 }) do
		body("Taillight", Vector3.new(2.1, 0.2, 0.15), s * 2.3, g + 3.05, back - 0.32, Color3.fromRGB(230, 30, 30), neon)
		body("TaillightSide", Vector3.new(0.2, 0.7, 0.15), s * 3.25, g + 2.8, back - 0.32, Color3.fromRGB(230, 30, 30), neon)
		body("Exhaust", Vector3.new(0.4, 0.5, 0.5), s * 1.2, g + 1.3, back - 0.15, Color3.fromRGB(150, 150, 155), {
			Shape = Enum.PartType.Cylinder,
			Material = Enum.Material.Metal,
			rot = CFrame.Angles(0, math.rad(90), 0),
		})
	end
	body("Diffuser", Vector3.new(W - 1, 0.6, 0.4), 0, g + 1.35, back - 0.3, TRIM)
	body("DiffuserAccent", Vector3.new(W - 1.2, 0.1, 0.42), 0, g + 1.7, back - 0.3, ACCENT)
	body("Plate", Vector3.new(1.9, 0.55, 0.1), 0, g + 2.3, back - 0.35, Color3.new(1, 1, 1))

	-- Interior: painel, volante, bancos
	body("Dashboard", Vector3.new(W - 2.0, 0.6, 1), 0, g + 3.15, cabinZ - 1.9, Color3.fromRGB(30, 30, 34))
	body("SteeringWheel", Vector3.new(0.12, 1.1, 1.1), -1.4, g + 3.0, cabinZ - 1.3, Color3.fromRGB(20, 20, 22), {
		Shape = Enum.PartType.Cylinder,
		rot = CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(25)),
	})
	local seatY = g + 0.95 -- baixo, para a cabeça não passar do teto
	local seatColor = spec.SeatColor or Color3.fromRGB(40, 40, 44)
	local driver = part(car, { ClassName = "VehicleSeat", Name = "DriverSeat", Size = Vector3.new(1.8, 0.4, 1.8), CFrame = at(-1.4, seatY, cabinZ + 0.3), Color = seatColor })
	driver.CanTouch = false -- só entra pelo botão "Carro" ou pelo E (dono)
	driver.MaxSpeed = 0 -- o VehicleSeat só lê o controle; quem move o carro é o CarController
	driver.Torque = 0
	driver.HeadsUpDisplay = false
	driver:SetAttribute("CarSeat", true)
	weld(chassis, driver)
	local passenger = part(car, { ClassName = "Seat", Name = "PassengerSeat", Size = Vector3.new(1.8, 0.4, 1.8), CFrame = at(1.4, seatY, cabinZ + 0.3), Color = seatColor })
	weld(chassis, passenger)
	for _, x in ipairs({ -1.4, 1.4 }) do
		body("SeatBack", Vector3.new(1.8, 2.2, 0.4), x, seatY + 1.2, cabinZ + 1.3, seatColor, { rot = CFrame.Angles(math.rad(-12), 0, 0) })
	end

	-- Rodas grandes: pneu, roda vermelha com raios duplos, pinça azul. Hub preso por Motor6D.
	local wheelY = g + r
	for _, wz in ipairs({ front + 3.3, back - 3.1 }) do
		for _, s in ipairs({ -1, 1 }) do
			local isFront = wz &lt; 0
			local name = (isFront and "Front" or "Rear") .. (s &lt; 0 and "Left" or "Right")
			local center = Vector3.new(s * (W / 2 - 0.3), wheelY, wz)
			local hub = part(car, { Name = name, Size = Vector3.new(0.4, 0.4, 0.4), CFrame = at(center.X, center.Y, center.Z), Transparency = 1 })
			local motor = Instance.new("Motor6D")
			motor.Name = "WheelMotor"
			motor.Part0 = chassis
			motor.Part1 = hub
			motor.C0 = CFrame.new(center)
			motor.Parent = hub
			local function onHub(pname, size, offset, color, extra)
				local p = part(car, {
					Name = pname,
					Size = size,
					CFrame = hub.CFrame * offset,
					Color = color,
					Shape = extra and extra.Shape,
					Material = extra and extra.Material,
				})
				weld(hub, p)
				return p
			end
			onHub("Tire", Vector3.new(1.2, r * 2, r * 2), CFrame.new(), Color3.fromRGB(22, 22, 24), { Shape = Enum.PartType.Cylinder })
			onHub("Rim", Vector3.new(1.25, r * 1.5, r * 1.5), CFrame.new(), Color3.fromRGB(30, 30, 32), { Shape = Enum.PartType.Cylinder })
			for k = 0, 9 do
				local a = k * math.pi / 5 + (k % 2) * 0.12 -- raios em pares
				onHub("Spoke", Vector3.new(1.3, r * 0.68, 0.14), CFrame.Angles(a, 0, 0) * CFrame.new(0, r * 0.36, 0), spec.RimColor, { Material = Enum.Material.Metal })
			end
			onHub("RimLip", Vector3.new(1.28, r * 0.42, r * 0.42), CFrame.new(), spec.RimColor, { Shape = Enum.PartType.Cylinder, Material = Enum.Material.Metal })
			-- pinça fica parada (presa no chassi, não gira)
			body("Caliper", Vector3.new(0.3, 0.7, 0.9), center.X - s * 0.3, center.Y + 0.4, center.Z + 0.45, spec.CaliperColor)
		end
	end

	-- Física: velocidade e direção (o motorista controla; parado fica no lugar)
	local att = Instance.new("Attachment")
	att.Name = "DriveAttachment"
	att.Parent = chassis
	local lv = Instance.new("LinearVelocity")
	lv.Name = "Drive"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.MaxForce = 1e6
	lv.VectorVelocity = Vector3.zero
	lv.Parent = chassis
	local ao = Instance.new("AlignOrientation")
	ao.Name = "Upright"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.MaxTorque = 1e6
	ao.Responsiveness = 30
	ao.CFrame = cf.Rotation
	ao.Parent = chassis

	for _, p in ipairs(car:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CollisionGroup = "Veiculos"
		end
	end
	car:SetAttribute("Spec", spec.Name)
	return car, driver, passenger
end

return CarBuilder
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000015"><Properties><string name="Name">CityNPCService</string><ProtectedString name="Source">-- CityNPCService (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; CityNPCService
-- Marco 5: os NPCs que dão vida à cidade (todos usam o NPCKit).
--   * Funcionários: um em cada loja, atrás do balcão, quando NENHUM jogador está nessa profissão.
--     Cumprimentam quem chega perto e explicam o emprego (E para conversar).
--   * Cliente da pizzaria: entra quando o pizzaiolo pega a comanda, espera no balcão,
--     reclama se demorar, recebe a caixa de pizza, reage (feliz ou nem tanto) e vai embora.
--   * Destinatário da entrega: abre a porta, pega o pacote, agradece, acena e entra.
--   * Pessoas passeando na praça (poucas, para não pesar).
-- As ações do cliente e do destinatário estão ligadas às etapas em JobConfig (onDone).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local JobConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("JobConfig"))
local NPCKit = require(script.Parent:WaitForChild("NPCKit"))
local SecurityService = require(script.Parent:WaitForChild("SecurityService"))

local CityNPCService = {}

local mission -- MissionService
local sites -- JobSiteBuilder
local pick = NPCKit.pick
local rng = Random.new()

local function now()
	return Workspace:GetServerTimeNow()
end

-- Chão de uma posição (cf com a altura do chão de verdade)
local function onGround(cf)
	local y = NPCKit.groundAt(cf.Position)
	return CFrame.new(cf.X, y, cf.Z) * cf.Rotation
end

---------------------------------------------------------------------------
-- Funcionários das lojas
---------------------------------------------------------------------------

local STAFF = {
	Pizzaiolo = {
		name = "Giovanni",
		shirt = Color3.fromRGB(245, 245, 240),
		hello = { "Buonasera! Bem-vindo à La Paulistana!", "Oi! Hoje tem pizza quentinha!" },
		talk = { "Quer ser pizzaiolo? Pegue o emprego no quadro da praça!", "Molho e queijo vão em todas. O resto, veja na comanda!" },
	},
	Atendente = {
		name = "Dona Lúcia",
		shirt = Color3.fromRGB(40, 140, 70),
		hello = { "Bom dia! Tudo fresquinho hoje!", "Olá! Bem-vindo ao Minas Market!" },
		talk = { "Precisamos de gente no caixa! Veja o quadro de empregos.", "Repor prateleira é fácil: caixa certa, prateleira, reciclagem." },
	},
	Entregador = {
		name = "Rafa",
		shirt = Color3.fromRGB(240, 140, 30),
		hello = { "E aí! Sherlex Entregas, rapidinho!", "Opa! Tem muito pacote hoje!" },
		talk = { "Quer entregar pacotes? Pegue o emprego no quadro da praça!", "Dica: o mapa mostra a rua e o número da casa." },
	},
	PetShop = {
		name = "Bia",
		shirt = Color3.fromRGB(130, 80, 200),
		hello = { "Oi! Que bom te ver aqui!", "Bem-vindo ao Duto Pet Shop!" },
		talk = { "O banho e tosa vai abrir em breve. Volte depois!", "Logo logo vamos contratar ajudantes!" },
	},
}

local staffNpc = {} -- staffNpc[jobId] = npc
local greeted = {} -- greeted[jobId][player] = true enquanto o jogador está perto

local function spawnStaff(jobId)
	local shop = sites.shops[jobId]
	local info = STAFF[jobId]
	if not shop or not shop.staff or not info then
		return
	end
	local npc = NPCKit.spawn(onGround(shop.staff), { name = info.name, shirt = info.shirt, anchored = true, important = true, showName = true })
	if not npc then
		return
	end
	staffNpc[jobId] = npc
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Conversar"
	prompt.ObjectText = info.name
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = npc:FindFirstChild("HumanoidRootPart")
	prompt.Triggered:Connect(function(player)
		if not SecurityService.checkRate(player, "TalkStaff", 1) then
			return
		end
		NPCKit.say(npc, pick(info.talk), 4.5)
		NPCKit.emote(npc, "point")
	end)
end

local function updateStaff()
	for jobId in pairs(STAFF) do
		local hasJob = JobConfig.Jobs[jobId] ~= nil
		local wanted = not hasJob or mission.workers(jobId) == 0
		local npc = staffNpc[jobId]
		if wanted and not (npc and npc.Parent) then
			spawnStaff(jobId)
		elseif not wanted and npc then
			npc:Destroy() -- um jogador assumiu o balcão
			staffNpc[jobId] = nil
		end
		npc = staffNpc[jobId]
		-- cumprimenta quem chega perto (uma vez por visita)
		local root = npc and npc:FindFirstChild("HumanoidRootPart")
		if root then
			greeted[jobId] = greeted[jobId] or {}
			for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
				local character = player.Character
				local proot = character and character:FindFirstChild("HumanoidRootPart")
				local near = proot and (proot.Position - root.Position).Magnitude &lt; 14
				if near and not greeted[jobId][player] then
					greeted[jobId][player] = true
					NPCKit.say(npc, pick(STAFF[jobId].hello))
					NPCKit.emote(npc, "wave")
				elseif not near and greeted[jobId][player] and proot and (proot.Position - root.Position).Magnitude &gt; 22 then
					greeted[jobId][player] = nil
				end
			end
		end
	end
end

---------------------------------------------------------------------------
-- Cliente da pizzaria
---------------------------------------------------------------------------

local pizzaCustomers = {} -- [player] = { npc, spot, warned }

local function removePizzaCustomer(player)
	local c = pizzaCustomers[player]
	pizzaCustomers[player] = nil
	if c and c.npc then
		c.npc:Destroy()
	end
end

local function freeSpot(shop)
	local used = {}
	for _, c in pairs(pizzaCustomers) do
		used[c.spot] = true
	end
	for i = 1, #shop.customers do
		if not used[i] then
			return i
		end
	end
	return 1
end

local Hooks = {}

function Hooks.pizzaCustomerCome(player, state)
	removePizzaCustomer(player)
	local shop = sites.shops.Pizzaiolo
	if not shop or #shop.customers == 0 then
		return
	end
	local c = { spot = freeSpot(shop) }
	pizzaCustomers[player] = c
	local title = state.order and state.order.title or "pizza"
	task.spawn(function()
		local npc = NPCKit.spawn(onGround(shop.door[1]), { name = "Cliente", speed = 11, important = true })
		if not npc then
			return
		end
		if pizzaCustomers[player] ~= c then
			npc:Destroy()
			return
		end
		c.npc = npc
		local target = shop.customers[c.spot]
		NPCKit.walk(npc, { shop.door[2], target }, target.LookVector, function()
			return pizzaCustomers[player] == c
		end)
		if pizzaCustomers[player] ~= c then
			return
		end
		NPCKit.say(npc, pick({ "Uma %s, por favor!", "Oi! Queria uma %s.", "Boa noite! Me vê uma %s?" }):format((title:gsub("^Pizza ", ""))))
		-- esperando: reclama uma vez se passar do tempo ou se a pizza queimar
		while pizzaCustomers[player] == c and npc.Parent do
			task.wait(2)
			local late = state.order and state.orderStartedAt and now() - state.orderStartedAt &gt; (state.order.parTime or 90)
			if (late or state.tipLost) and not c.warned and pizzaCustomers[player] == c then
				c.warned = true
				NPCKit.say(npc, state.tipLost and "Queimou?! Tudo bem, eu espero..." or "Tá demorando, hein...")
				NPCKit.react(npc, "😕")
			end
		end
	end)
end

function Hooks.pizzaCustomerReceive(player, state)
	local c = pizzaCustomers[player]
	pizzaCustomers[player] = nil
	local npc = c and c.npc
	if not npc or not npc.Parent then
		return
	end
	local order = state.order
	local fast = order and not state.tipLost and order.tip and (now() - state.orderStartedAt) &lt;= order.parTime
	NPCKit.hold(npc, "CaixaPizza", Vector3.new(2.2, 0.4, 2.2), Color3.fromRGB(205, 160, 105), Enum.Material.Cardboard)
	if fast then
		NPCKit.say(npc, pick({ "Que cheiro bom! Toma a gorjeta!", "Rapidinho! Obrigado!", "Perfeita! Volto amanhã!" }))
		NPCKit.react(npc, "😍")
		NPCKit.emote(npc, "cheer")
	else
		NPCKit.say(npc, pick({ "Finalmente! Obrigado.", "Demorou, mas chegou." }))
		NPCKit.react(npc, "😐")
	end
	local shop = sites.shops.Pizzaiolo
	task.spawn(function()
		task.wait(1.6)
		if npc.Parent and shop then
			NPCKit.walk(npc, { shop.door[2], shop.door[1], shop.door[1] * CFrame.new(0, 0, -10) })
		end
		npc:Destroy()
	end)
end

---------------------------------------------------------------------------
-- Destinatário da entrega
---------------------------------------------------------------------------

local busyDoors = {}

function Hooks.deliveryThanks(player, state, step)
	local point = step.point and sites.points[step.point]
	local door = point and point.visual
	if not door or not door:IsA("BasePart") or busyDoors[door] then
		return
	end
	busyDoors[door] = true
	task.spawn(function()
		-- porta "abre" (some um instante) e o morador aparece na porta
		local oldT = door.Transparency
		door.Transparency = 0.85
		local groundY = door.Position.Y - door.Size.Y / 2
		local outward = door.CFrame.LookVector
		local startPos = Vector3.new(door.Position.X, groundY, door.Position.Z) + outward * 0.6
		local npc = NPCKit.spawn(CFrame.lookAt(startPos, startPos + outward), { name = "Morador", speed = 8 })
		if npc then
			NPCKit.walk(npc, { startPos + outward * 1.8 }, outward)
			NPCKit.hold(npc, "Pacote", Vector3.new(1.4, 1.2, 1.4), Color3.fromRGB(190, 145, 95), Enum.Material.Cardboard)
			NPCKit.say(npc, pick({ "Chegou! Muito obrigado!", "Oba, meu pacote! Valeu!", "Que rapidez! Obrigada!" }))
			NPCKit.react(npc, pick({ "😊", "🥳", "❤️" }))
			NPCKit.emote(npc, "wave")
			task.wait(2.8)
			if npc.Parent then
				NPCKit.walk(npc, { startPos }, -outward)
			end
			npc:Destroy()
		end
		door.Transparency = oldT
		busyDoors[door] = nil
	end)
end

---------------------------------------------------------------------------
-- Pessoas passeando na praça
---------------------------------------------------------------------------

local WALKERS = 4
local WALK_RING = 18 -- caminho em volta do chafariz (entre as flores e os bancos)
local PLAZA_Y = 0.95
local LINES = { "Que dia lindo!", "Adoro essa praça!", "Já tomou sorvete hoje?", "Olha o chafariz!", "Bom dia!", "Vou ali na pizzaria..." }

local function ringPoint(angleDeg)
	local a = math.rad(angleDeg)
	return Vector3.new(math.cos(a) * WALK_RING, PLAZA_Y, math.sin(a) * WALK_RING)
end

local function walker()
	local angle = rng:NextInteger(0, 15) * 22.5
	local npc = NPCKit.spawn(CFrame.new(ringPoint(angle)), { name = "Morador", speed = rng:NextNumber(6, 9) })
	if not npc then
		return
	end
	local dir = rng:NextInteger(0, 1) == 0 and -1 or 1
	while npc.Parent do
		-- ninguém perto da praça: o NPC fica parado (economiza servidor)
		if not NPCKit.anyPlayerNear(Vector3.zero, 160) then
			task.wait(3)
		else
			local points = {}
			for _ = 1, rng:NextInteger(2, 5) do
				angle += 22.5 * dir
				table.insert(points, ringPoint(angle))
			end
			NPCKit.walk(npc, points)
			local roll = rng:NextNumber()
			if roll &lt; 0.25 then
				NPCKit.say(npc, pick(LINES))
			elseif roll &lt; 0.35 then
				NPCKit.emote(npc, "wave")
			elseif roll &lt; 0.45 then
				NPCKit.face(npc, -npc:GetPivot().Position) -- para e olha o chafariz
			end
			if rng:NextNumber() &lt; 0.3 then
				dir = -dir
			end
			task.wait(rng:NextNumber(2, 6))
		end
	end
end

function CityNPCService.init(missionService, jobSites)
	mission = missionService
	sites = jobSites
	for name, fn in pairs(Hooks) do
		mission.registerHook(name, fn)
	end
	mission.onStop(removePizzaCustomer)
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		for _, list in pairs(greeted) do
			list[player] = nil
		end
	end)

	task.spawn(function()
		while true do
			local ok, err = pcall(updateStaff)
			if not ok then
				warn("[CityNPCService] " .. tostring(err))
			end
			task.wait(1)
		end
	end)
	for i = 1, WALKERS do
		task.delay(i * 0.7, walker)
	end
end

return CityNPCService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000016"><Properties><string name="Name">CivicBuilder</string><ProtectedString name="Source">-- Delegacia urbana e prisão afastada; geometria sem autoridade de jogo.
-- PrisonService controla os prompts, a pena, a fuga e a entrada de teste no Studio.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("CivicConfig"))

local PrisonBuilder = require(script.Parent:WaitForChild("PrisonBuilder"))
local TaxiSiteBuilder = require(script.Parent:WaitForChild("TaxiSiteBuilder"))

local CivicBuilder = { sites = nil }
local WHITE = Color3.fromRGB(235, 235, 224)
local BLUE = Color3.fromRGB(31, 69, 107)
local STEEL = Color3.fromRGB(82, 96, 104)
local STONE = Color3.fromRGB(173, 176, 163)
local WOOD = Color3.fromRGB(141, 104, 69)
local AMBER = Color3.fromRGB(235, 174, 70)

local function folder(parent, name)
	local f = Instance.new("Folder")
	f.Name, f.Parent = name, parent
	return f
end

local function part(parent, name, size, cf, color, material, collide)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame = name, size, cf
	p.Anchored = true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Color, p.Material = color or WHITE, material or Enum.Material.SmoothPlastic
	p.CanCollide = collide ~= false
	p.Parent = parent
	return p
end

local function localPart(parent, base, name, size, position, color, material, collide)
	return part(parent, name, size, base * CFrame.new(position), color, material, collide)
end

local function label(target, text, color, face)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Letreiro"
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud, gui.LightInfluence = 35, 0
	gui.Parent = target
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextColor3 = color or WHITE
	t.TextScaled, t.TextWrapped = true, true
	t.Font, t.Text = Enum.Font.GothamBold, text
	t.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 5), UDim.new(0, 5)
	pad.Parent = t
end

local function sign(parent, base, text, pos, size, color)
	local p = localPart(parent, base, "Placa", size or Vector3.new(16, 3, 0.3), pos, color or BLUE, nil, false)
	label(p, text)
	return p
end

local function lamp(parent, base, pos)
	local lightPart = localPart(parent, base, "Luminária", Vector3.new(4, 0.2, 2), pos, Color3.fromRGB(255, 241, 205), Enum.Material.Neon, false)
	local light = Instance.new("PointLight")
	light.Brightness, light.Range, light.Shadows = 1.15, 23, false
	light.Color, light.Parent = lightPart.Color, lightPart
end

local function bench(parent, base, pos, color)
	local p = Instance.new("Seat")
	p.Name, p.Size, p.CFrame = "Banco", Vector3.new(7, 0.5, 2), base * CFrame.new(pos)
	p.Anchored, p.CanTouch = true, false
	p.Color, p.Material = color or WOOD, Enum.Material.SmoothPlastic
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent
	for _, x in ipairs({ -2.6, 2.6 }) do
		part(parent, "PéBanco", Vector3.new(0.5, 1.7, 1.6), p.CFrame * CFrame.new(x, -1, 0), STEEL)
	end
	part(parent, "Encosto", Vector3.new(7, 1.9, 0.3), p.CFrame * CFrame.new(0, 0.9, 0.9), color or WOOD)
	-- SeatService acrescenta o prompt E sem sentar automaticamente ao encostar.
end

local function plant(parent, base, pos)
	localPart(parent, base, "Floreira", Vector3.new(5, 1.8, 3), pos + Vector3.new(0, 0.9, 0), STONE, Enum.Material.Concrete)
	local foliage = localPart(parent, base, "Arbusto", Vector3.new(4.7, 2.6, 2.8), pos + Vector3.new(0, 2.3, 0), Color3.fromRGB(77, 125, 71), Enum.Material.Grass, false)
	foliage.Shape = Enum.PartType.Ball
end

local function marker(parent, base, name, position)
	local p = localPart(parent, base, name, Vector3.new(1, 1, 1), position, WHITE, nil, false)
	p.Transparency, p.CanTouch, p.CanQuery = 1, false, false
	return p
end

local function newSite(parent, name, mapLabel, kind, base)
	local m = Instance.new("Model")
	m.Name = name
	m:SetAttribute("PlaceName", name)
	m:SetAttribute("MapLabel", mapLabel)
	m:SetAttribute("Kind", kind)
	m:SetAttribute("MapPosition", base.Position)
	m.Parent = parent
	return m
end

local function point(parent, base, name, pos, action, object, hold)
	local p = localPart(parent, base, name, Vector3.new(2.5, 2.5, 0.5), pos, AMBER, Enum.Material.Metal, false)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name .. "Prompt"
	prompt.ActionText, prompt.ObjectText = action, object
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration, prompt.MaxActivationDistance = hold or 1, 9
	prompt.RequiresLineOfSight, prompt.Enabled = true, false
	prompt.Parent = p
	return prompt
end

local function street(parent, road)
	local length = (road.b - road.a).Magnitude
	local cf = CFrame.lookAt((road.a + road.b) / 2, road.b)
	local p = part(parent, road.name, Vector3.new(road.width, 0.5, length), cf * CFrame.new(0, 0.25, 0), Color3.fromRGB(67, 70, 73), Enum.Material.Asphalt)
	p:SetAttribute("RoadStart", road.a)
	p:SetAttribute("RoadEnd", road.b)
	for _, side in ipairs({ -1, 1 }) do
		part(parent, "Calçada", Vector3.new(3, 0.6, length), cf * CFrame.new(side * (road.width / 2 + 1.5), 0.4, 0), STONE, Enum.Material.Concrete)
	end
	if road.width &gt; 15 then
		for z = -length / 2 + 7, length / 2 - 4, 16 do
			part(parent, "Faixa", Vector3.new(0.25, 0.03, 7), cf * CFrame.new(0, 0.52, z), AMBER, nil, false)
		end
		for z = -length / 2 + 20, length / 2 - 10, 65 do
			local poleCf = cf * CFrame.new(road.width / 2 + 3, 0, z)
			localPart(parent, poleCf, "Poste", Vector3.new(0.5, 11, 0.5), Vector3.new(0, 5.5, 0), STEEL, Enum.Material.Metal)
			lamp(parent, poleCf, Vector3.new(-1, 11, 0))
		end
	end
end

