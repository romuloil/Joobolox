	},
}

return StreetNPCConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000D"><Properties><string name="Name">TaxiConfig</string><ProtectedString name="Source">-- Protótipo LXR Táxis. Valores de remuneração ajustáveis após teste no Studio.
