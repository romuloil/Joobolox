return PrisonBuilder
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000023"><Properties><string name="Name">PrisonService</string><ProtectedString name="Source">-- Prisão autoritativa de 60 segundos, com celas individuais e rota fixa de fuga.
-- Não recebe comandos remotos de detenção. PoliceService deve validar
-- papel, evento, imobilização e proximidade ANTES de chamar detain no servidor.
-- Esta etapa não altera dinheiro nem inventa recompensas de assalto.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local CivicConfig = require(Shared:WaitForChild("CivicConfig"))
local Rules = require(Shared:WaitForChild("PrisonRules"))
local SecurityService = require(script.Parent:WaitForChild("SecurityService"))

local PrisonService = {}
local sessions = {}
local cellOwners = {}
local doorTokens = {}
local initialized = false
local sites, hooks, uiUpdate
local WALK_SPEED = GameConfig.WalkSpeed

local function now()
	return Workspace:GetServerTimeNow()
end

local function promptPosition(prompt)
	local parent = prompt and prompt.Parent
	if parent and parent:IsA("BasePart") then
		return parent.Position
	elseif parent and parent:IsA("Attachment") then
		return parent.WorldPosition
	end
	return nil
end

local function descriptorPart(descriptor)
	return descriptor and (descriptor.part or descriptor.door)
end

local function setDoorFrame(descriptor, open)
	local door = descriptorPart(descriptor)
	if not door then return end
	door.CFrame = open and descriptor.open or descriptor.closed
	door.CanCollide = true -- porta física desliza para fora da passagem
	door:SetAttribute("Open", open == true)
	door:SetAttribute("CellDoorOpen", open == true)
end

local function doorwayClear(descriptor)
	if not descriptor or not descriptor.closed then return true end
	for _, player in ipairs(Players:GetPlayers()) do
		local _, _, root = SecurityService.getLivingCharacter(player)
		if root and Rules.isFinitePoint(root.Position)
			and (root.Position - descriptor.closed.Position).Magnitude &lt; 5 then
			return false
		end
	end
	return true
end

-- Nunca fecha a folha em cima de um personagem. Um novo uso cancela a tentativa
-- anterior pelo token; portas livres são verificadas novamente em meio segundo.
local function closeWhenClear(descriptor, permitted)
	local part = descriptorPart(descriptor)
	if not part then return end
	local token = (doorTokens[part] or 0) + 1
	doorTokens[part] = token
	local function attempt()
		if doorTokens[part] ~= token or not part.Parent or (permitted and not permitted()) then
			return
		end
		if doorwayClear(descriptor) then
			setDoorFrame(descriptor, false)
		else
			task.delay(0.5, attempt)
		end
	end
	attempt()
end

local function openDoor(descriptor, closeAfter)
	local part = descriptorPart(descriptor)
	if not part then return end
	local token = (doorTokens[part] or 0) + 1
	doorTokens[part] = token
	setDoorFrame(descriptor, true)
	if closeAfter then
		task.delay(closeAfter, function()
			if doorTokens[part] == token then closeWhenClear(descriptor) end
		end)
	end
end

local function freeCell(player, session)
	local cell = session and session.cell
	if cell and cellOwners[cell] == player then
		cellOwners[cell] = nil
		closeWhenClear(cell, function() return cellOwners[cell] == nil end)
	end
end

local function insideBounds(position, bounds)
	if not bounds then return true end
	local p = bounds.cf:PointToObjectSpace(position)
	local half = bounds.half
	return math.abs(p.X) &lt;= half.X and math.abs(p.Y) &lt;= half.Y and math.abs(p.Z) &lt;= half.Z
end

local function nextHint(session)
	if session.cell and not session.cellOpened then
		return ("Cela %s: aguarde a abertura para o pátio."):format(session.cell.id)
	end
	local prompt = sites.escapeSteps[session.completed + 1]
	if prompt and prompt.ObjectText ~= "" then
		return prompt.ObjectText
	end
	return "Siga a passagem de manutenção para tentar fugir."
end

local function sendState(player, session, customHint)
	local hint = customHint or nextHint(session)
	player:SetAttribute("Detained", true)
	player:SetAttribute("PrisonEndsAt", session.endsAt)
	player:SetAttribute("PrisonStep", session.completed)
	player:SetAttribute("PrisonSteps", #sites.escapeSteps)
	player:SetAttribute("PrisonHint", hint)
	player:SetAttribute("PrisonCell", session.cell and session.cell.id or nil)
	player:SetAttribute("PrisonCellOpensAt", session.cellOpensAt)
	uiUpdate:FireClient(player, "PrisonState", {
		active = true,
		endsAt = session.endsAt,
		step = session.completed,
		steps = #sites.escapeSteps,
		hint = hint,
		cellId = session.cell and session.cell.id or nil,
		cellOpensAt = session.cellOpensAt,
	})
end

local function clearAttributes(player)
	player:SetAttribute("Detained", false)
	player:SetAttribute("PrisonEndsAt", nil)
	player:SetAttribute("PrisonStep", nil)
	player:SetAttribute("PrisonSteps", nil)
	player:SetAttribute("PrisonHint", nil)
	player:SetAttribute("PrisonCell", nil)
	player:SetAttribute("PrisonCellOpensAt", nil)
end

local function moveCharacter(character, humanoid, root, target)
	-- Sit=false pode deixar SeatWeld vivo até o próximo passo de física. Solta
	-- apenas a junta deste personagem antes de mover, sem arrastar banco/carro.
	local seat = humanoid.SeatPart
	local seatWeld = seat and seat:FindFirstChild("SeatWeld")
	if seatWeld and seatWeld:IsA("Weld") then
		local p0, p1 = seatWeld.Part0, seatWeld.Part1
		if (p0 and p0:IsDescendantOf(character)) or (p1 and p1:IsDescendantOf(character)) then
			seatWeld:Destroy()
		end
	end
	humanoid.Sit = false
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	character:PivotTo(target.CFrame)
end

local function placeInPrison(player, session)
	local character, humanoid, root = SecurityService.getLivingCharacter(player)
	if not character then
		return
	end
	if session.humanoid ~= humanoid then
		session.humanoid = humanoid
		-- Uma captura pode chegar com o Humanoid imobilizado pelo jato de água.
		-- Velocidade temporária zero não deve voltar depois de cumprir a pena.
		session.previousWalkSpeed = Rules.isFinite(humanoid.WalkSpeed) and humanoid.WalkSpeed &gt; 0
			and humanoid.WalkSpeed or WALK_SPEED
	end
	humanoid.WalkSpeed = WALK_SPEED
	moveCharacter(character, humanoid, root, session.cell and session.cell.spawn or sites.prisonSpawn)
	session.completed = 0
	session.lastStepAt = now()
	session.lastStepPosition = root.Position
	session.lastMotionAt = session.lastStepAt
	session.lastMotionPosition = root.Position
	sendState(player, session)
end

function PrisonService.isDetained(player)
	return sessions[player] ~= nil
end

-- Somente para outros serviços do servidor. PoliceService confere profissão e
-- proximidade do terminal antes de chamar estas operações; não há remote aqui.
function PrisonService.getCellControls()
	local result = {}
	local time = now()
	for _, cell in ipairs(sites and sites.prisonCells or {}) do
		local owner = cellOwners[cell]
		local session = owner and sessions[owner]
		local door = descriptorPart(cell)
		table.insert(result, {
			id = cell.id,
			name = "Cela " .. cell.id,
			open = door and door:GetAttribute("Open") == true or false,
			occupied = session ~= nil,
			lockedUntil = session and time &lt; session.cellOpensAt and session.cellOpensAt or 0,
		})
	end
	return result
end

function PrisonService.setCellDoor(cellId, open)
	if not initialized or type(cellId) ~= "string" or #cellId == 0 or #cellId &gt; 16
		or type(open) ~= "boolean" then
		return false, "argument"
	end
	local cell
	for _, candidate in ipairs(sites.prisonCells or {}) do
		if candidate.id == cellId then cell = candidate; break end
	end
	if not cell then return false, "cell" end
	local owner = cellOwners[cell]
	local session = owner and sessions[owner]
	if open and session and now() &lt; session.cellOpensAt then
		return false, "locked"
	end
	if session and not session.cellOpened and now() &gt;= session.cellOpensAt then
		-- Resolve também a pequena janela antes do próximo tick: uma ordem
		-- manual após os 15 s não deve ser desfeita pela abertura automática.
		session.cellOpened = true
		sendState(owner, session)
	end
	local part = descriptorPart(cell)
	if (part:GetAttribute("Open") == true) == open then return true end
	if open then
		openDoor(cell)
	else
		if not doorwayClear(cell) then return false, "blocked" end
		-- Um fechamento manual cancela apenas ações antigas desta porta. O prazo
		-- da pena e a soltura automática do ocupante permanecem os mesmos.
		doorTokens[part] = (doorTokens[part] or 0) + 1
		setDoorFrame(cell, false)
	end
	return true
end

function PrisonService.release(player, escaped)
	escaped = escaped == true
	local session = sessions[player]
	if not session then
		return false
	end
	-- Retira primeiro: timeout e último prompt no mesmo frame só resolvem uma vez.
	sessions[player] = nil
	clearAttributes(player)
	local character, humanoid, root = SecurityService.getLivingCharacter(player)
	if humanoid then
		if session.humanoid == humanoid and Rules.isFinite(session.previousWalkSpeed) then
			humanoid.WalkSpeed = session.previousWalkSpeed
		else
			humanoid.WalkSpeed = WALK_SPEED
		end
		if not escaped then
			moveCharacter(character, humanoid, root, sites.prisonRelease)
		end
	end
	freeCell(player, session)
	if player.Parent == Players then
		uiUpdate:FireClient(player, "PrisonState", { active = false, escaped = escaped == true })
		uiUpdate:FireClient(player, "Notice", {
			text = escaped and "Você concluiu a rota de fuga e está livre!"
				or "Tempo cumprido. Você está livre!",
		})
	end
	return true
end

function PrisonService.detain(player, reason)
	if not initialized or player.Parent ~= Players then
		return false, "unavailable"
	end
	if sessions[player] then
		return false, "already_detained"
	end
	local character = SecurityService.getLivingCharacter(player)
	if not character then
		return false, "character"
	end
	local cell
	if sites.prisonCells then
		for _, candidate in ipairs(sites.prisonCells) do
			if not cellOwners[candidate] and doorwayClear(candidate) then
				cell = candidate
				break
			end
		end
		if not cell then return false, "capacity" end
	end
	local time = now()
	local duration = CivicConfig.SentenceSeconds or 60
	local deadline = Rules.deadline(time, duration)
	if not deadline then
		return false, "duration"
	end
	local session = {
		endsAt = deadline, completed = 0, reason = reason, cell = cell,
		cellOpensAt = cell and time + math.min(CivicConfig.CellLockSeconds or 15, duration - 1) or nil,
		cellOpened = cell == nil,
	}
	if cell then
		cellOwners[cell] = player
		local part = descriptorPart(cell)
		doorTokens[part] = (doorTokens[part] or 0) + 1
		setDoorFrame(cell, false)
	end
	sessions[player] = session
	-- Bloqueia novas ações antes de remover o veículo e encerrar a profissão.
	player:SetAttribute("Detained", true)
	if hooks.beforeDetain then
		local ok, err = pcall(hooks.beforeDetain, player)
		if not ok then
			sessions[player] = nil
			clearAttributes(player)
			freeCell(player, session)
			warn("[PrisonService] Falha ao preparar detenção: " .. tostring(err))
			return false, "prepare"
		end
	end
	if sessions[player] ~= session or player.Parent ~= Players then
		freeCell(player, session)
		return false, "cancelled"
	end
	placeInPrison(player, session)
	return true
end

local function positionAllowed(root, session, time)
	local position = root.Position
	if not Rules.isFinitePoint(position) then
		return false
	end
	if not insideBounds(position, sites.prisonBounds) then
		return false
	end
	if session.cell and time &lt; session.cellOpensAt and not insideBounds(position, session.cell.bounds) then
		return false
	end
	return not session.lastMotionPosition or Rules.movementAllowed(
		(position - session.lastMotionPosition).Magnitude, time - session.lastMotionAt, WALK_SPEED)
end

local function tryStep(player, index, prompt)
	local session = sessions[player]
	if not session or not SecurityService.checkRate(player, "PrisonStep", 0.35) then
		return
	end
	local time = now()
	if Rules.remaining(session.endsAt, time) &lt;= 0 then
		PrisonService.release(player, false)
		return
	end
	if session.cell and time &lt; session.cellOpensAt then return end
	local _, _, root = SecurityService.getLivingCharacter(player)
	local target = promptPosition(prompt)
	if not root or not Rules.isFinitePoint(root.Position) or not Rules.isFinitePoint(target)
		or not session.lastStepPosition then
		return
	end
	-- Verifica também no próprio evento: um teleporte seguido de Triggered não
	-- pode aproveitar a janela entre duas amostras do monitor periódico.
	if not positionAllowed(root, session, time) then
		placeInPrison(player, session)
		return
	end
	local allowed = Rules.canAdvance(session.completed + 1, index,
		(root.Position - target).Magnitude, time - session.lastStepAt,
		(session.lastStepPosition - target).Magnitude, WALK_SPEED, true)
	if not allowed then
		return
	end
	session.completed = index
	session.lastStepAt = time
	session.lastStepPosition = root.Position
	local routeDoor = sites.escapeDoors and sites.escapeDoors[index]
	-- A passagem permanece aberta por uma pena inteira, para não prender quem
	-- já validou o acesso antes de atravessar. Cada preso valida sua própria rota.
	if routeDoor then openDoor(routeDoor, CivicConfig.SentenceSeconds or 60) end
	if index == #sites.escapeSteps then
		PrisonService.release(player, true)
	else
		sendState(player, session)
	end
end

local function watchPlayer(player)
	player.CharacterAdded:Connect(function(character)
		-- Pena e prazo pertencem ao Player: resetar o personagem não libera o preso.
		task.spawn(function()
			local humanoid = character:WaitForChild("Humanoid", 10)
			local root = character:WaitForChild("HumanoidRootPart", 10)
			local session = sessions[player]
			if not humanoid or not root or not session or player.Character ~= character then
				return
			end
			if Rules.remaining(session.endsAt, now()) &lt;= 0 then
				PrisonService.release(player, false)
			else
				placeInPrison(player, session)
			end
		end)
	end)
end

local function updateSession(player, session, time)
	if Rules.remaining(session.endsAt, time) &lt;= 0 then
		PrisonService.release(player, false)
		return
	end
	if session.cell and not session.cellOpened and time &gt;= session.cellOpensAt then
		session.cellOpened = true
		openDoor(session.cell)
		sendState(player, session)
	end
	local _, humanoid, root = SecurityService.getLivingCharacter(player)
	if not root then
		session.lastMotionPosition = nil
		return
	end
	humanoid.WalkSpeed = WALK_SPEED
	if not positionAllowed(root, session, time) then
		-- Recomeça só a rota, nunca reinicia nem acrescenta tempo à pena original.
		placeInPrison(player, session)
		return
	end
	session.lastMotionPosition = root.Position
	session.lastMotionAt = time
end

function PrisonService.init(remotes, civicSites, options)
	if initialized then
		return
	end
	assert(civicSites and civicSites.prisonSpawn and civicSites.prisonRelease
		and civicSites.intakePrompt and civicSites.prisonBounds
		and #civicSites.escapeSteps &gt; 0, "[PrisonService] Pontos da prisão incompletos")
	sites = civicSites
	hooks = options or {}
	uiUpdate = assert(remotes[GameConfig.Remotes.UIUpdate], "UIUpdate ausente")
	for _, cell in ipairs(sites.prisonCells or {}) do
		assert(cell.spawn and cell.door and cell.closed and cell.open and cell.id and cell.bounds,
			"[PrisonService] Cela incompleta")
		setDoorFrame(cell, false)
	end
	for _, door in pairs(sites.escapeDoors or {}) do setDoorFrame(door, false) end
	initialized = true
	for index, prompt in ipairs(sites.escapeSteps) do
		prompt.Enabled = true -- o construtor entrega prompts desligados até os serviços estarem prontos
		prompt.Triggered:Connect(function(player)
			tryStep(player, index, prompt)
		end)
	end
	-- Entrada voluntária de validação; não existe como ferramenta de prisão no jogo publicado.
	sites.intakePrompt.Enabled = RunService:IsStudio()
	sites.intakePrompt.Triggered:Connect(function(player)
		if not RunService:IsStudio() or not SecurityService.checkRate(player, "PrisonIntake", 1) then
			return
		end
		local _, _, root = SecurityService.getLivingCharacter(player)
		local position = promptPosition(sites.intakePrompt)
		if root and position and Rules.isFinitePoint(root.Position)
			and (root.Position - position).Magnitude &lt;= 10 then
			PrisonService.detain(player, "studio_test")
		end
	end)
	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		watchPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		freeCell(player, sessions[player])
		sessions[player] = nil -- prisão é estado da sessão, não é gravada no DataStore
	end)
	task.spawn(function()
		while true do
			local time = now()
			for player, session in pairs(sessions) do
				updateSession(player, session, time)
			end
			task.wait(0.2)
		end
	end)
end

return PrisonService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000024"><Properties><string name="Name">SeatService</string><ProtectedString name="Source">-- SeatService (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; SeatService
-- Bancos e banquinhos: o jogador só senta quando QUER, apertando E (ou tocando no botão no celular).
-- O "sentar sozinho ao encostar" do Roblox é desligado (CanTouch = false no assento).
-- Para levantar: pular (Espaço ou botão de pulo).

local Workspace = game:GetService("Workspace")

local SecurityService = require(script.Parent:WaitForChild("SecurityService"))

local SeatService = {}

local SIT_DISTANCE = 9
local beforeSit -- função chamada antes de sentar (ex.: descer da bicicleta)

function SeatService.setup(seat, objectText)
	if not seat:IsA("Seat") or seat:FindFirstChild("SeatPrompt") then
		return
	end
	seat.CanTouch = false -- não senta sozinho ao encostar
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "SeatPrompt"
	prompt.ActionText = "Sentar"
	prompt.ObjectText = objectText or "Banco"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.Parent = seat

	local function refresh()
		prompt.Enabled = seat.Occupant == nil and not seat:GetAttribute("TaxiPassengerReserved")
	end
	seat:GetPropertyChangedSignal("Occupant"):Connect(refresh)
	seat:GetAttributeChangedSignal("TaxiPassengerReserved"):Connect(refresh)
	refresh()

	prompt.Triggered:Connect(function(player)
		if seat:GetAttribute("TaxiPassengerReserved") then return end
		local stunnedUntil = player:GetAttribute("StunnedUntil")
		if type(stunnedUntil) == "number" and stunnedUntil &gt; Workspace:GetServerTimeNow() then
			return
		end
		local vehicles = Workspace:FindFirstChild("Vehicles")
		if player:GetAttribute("Detained") and vehicles and seat:IsDescendantOf(vehicles) then
			return -- bancos da prisão continuam usáveis; carona não contorna a detenção
		end
		if not SecurityService.checkRate(player, "Sit", 0.5) then
			return
		end
		local _, humanoid, root = SecurityService.getLivingCharacter(player)
		if not humanoid or seat.Occupant or humanoid.SeatPart then
			return
		end
		if (root.Position - seat.Position).Magnitude &gt; SIT_DISTANCE then
			return
		end
		if beforeSit then
			beforeSit(player)
		end
		seat:Sit(humanoid)
	end)
end

function SeatService.init(onBeforeSit)
	beforeSit = onBeforeSit
	for _, container in ipairs({ Workspace:FindFirstChild("Map"), Workspace:FindFirstChild("JobStations") }) do
		for _, d in ipairs(container and container:GetDescendants() or {}) do
			if d:IsA("Seat") then
				SeatService.setup(d)
			end
		end
	end
end

return SeatService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000025"><Properties><string name="Name">SecurityService</string><ProtectedString name="Source">-- SecurityService (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; SecurityService
-- Ferramentas de segurança usadas por todos os serviços:
-- limite de frequência (rate limit) por jogador e checagem do personagem.
-- Regra do projeto: o cliente só pede; o servidor decide.

local Players = game:GetService("Players")

local SecurityService = {}

-- lastCall[player][chave] = horário do último pedido aceito
local lastCall = {}

-- Retorna true se o jogador pode fazer a ação "key" agora.
-- interval = segundos mínimos entre dois pedidos aceitos.
function SecurityService.checkRate(player, key, interval)
	local now = workspace:GetServerTimeNow()
	local calls = lastCall[player]
	if not calls then
		calls = {}
		lastCall[player] = calls
	end
	local last = calls[key]
	if last and now - last &lt; interval then
		return false
	end
	calls[key] = now
	return true
end

-- Retorna character, humanoid e rootPart se o personagem estiver vivo; senão nil.
function SecurityService.getLivingCharacter(player)
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health &lt;= 0 then
		return nil
	end
	return character, humanoid, root
end

-- Texto curto e de tamanho limitado (para argumentos vindos do cliente)
function SecurityService.isShortString(value, maxLength)
	return type(value) == "string" and #value &gt; 0 and #value &lt;= (maxLength or 32)
end

Players.PlayerRemoving:Connect(function(player)
	lastCall[player] = nil
end)

return SecurityService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000026"><Properties><string name="Name">StreetNPCService</string><ProtectedString name="Source">-- Moradores fixos nas calçadas, construídos com o NPCKit já usado pelo jogo.
-- Conversas são textos preparados; nenhum remoto cria NPC, missão ou pagamento.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("StreetNPCConfig"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local CivicConfig = require(Shared:WaitForChild("CivicConfig"))
local NPCKit = require(script.Parent:WaitForChild("NPCKit"))
local Security = require(script.Parent:WaitForChild("SecurityService"))

local StreetNPCService = {}
local initialized = false
local residents = {}
local conversations = {}
local nextSpeech = {}

local function flat(point)
	return Vector3.new(point.X, 0, point.Z)
end

local function finitePoint(point)
	return point.X == point.X and point.Y == point.Y and point.Z == point.Z
		and math.abs(point.X) &lt; math.huge and math.abs(point.Y) &lt; math.huge
		and math.abs(point.Z) &lt; math.huge
end

local function flatNear(a, b, radius)
	return (flat(a) - flat(b)).Magnitude &lt; radius
end

local function template(text, streetName)
	local names = {
		street = streetName,
		pizza = GameConfig.Places.Pizzaria,
		market = GameConfig.Places.Mercearia,
		delivery = GameConfig.Places.Entregas,
		taxi = CivicConfig.Taxi and CivicConfig.Taxi.Name or "LXR Táxis",
	}
	return text:gsub("{([%w_]+)}", function(key) return names[key] or key end)
end

-- Nomes e posições dos prédios não decidem a calçada: usamos as peças que o
-- MapBuilder realmente construiu. Assim cada morador continua junto de sua rua.
local function streetSidewalks(map, index)
	local roads = map:FindFirstChild("Roads")
	if not roads then return {} end
	local direction = CFrame.Angles(0, (index - 1) * math.pi / 4, 0).LookVector
	local sidewalks = {}
	for _, road in ipairs(roads:GetChildren()) do
		if road.Name == "Road" then
			local surface = road:FindFirstChild("Asphalt")
			if surface and surface:IsA("BasePart") and surface.CFrame.LookVector:Dot(direction) &gt; 0.99 then
				for _, piece in ipairs(road:GetChildren()) do
					if piece:IsA("BasePart") and piece.Name == "Sidewalk" then
						table.insert(sidewalks, piece)
					end
				end
			end
		end
	end
	return sidewalks, direction
end

local function findRegions(map)
	local regions = {}
	for _, part in ipairs(map:GetDescendants()) do
		if part:IsA("BasePart") then
			local road = part:GetAttribute("RoadStart") ~= nil
			if part.Name == "Door" or part.Name == "Driveway" or road then
				table.insert(regions, { part = part, door = part.Name == "Door" })
			end
		end
	end
	return regions
end

local function passageClear(position, regions)
	for _, region in ipairs(regions) do
		local part = region.part
		if region.door then
			if flatNear(position, part.Position, 7) then return false end
		else
			local p = part.CFrame:PointToObjectSpace(position)
			if math.abs(p.X) &lt;= part.Size.X / 2 + 1.5 and math.abs(p.Z) &lt;= part.Size.Z / 2 + 1.5 then
				return false
			end
		end
	end
	return true
end

local function bodyClear(map, position)
	local ray = RaycastParams.new()
	ray.FilterType = Enum.RaycastFilterType.Include
	ray.FilterDescendantsInstances = { map }
	local hit = Workspace:Raycast(position + Vector3.new(0, 5, 0), Vector3.new(0, -12, 0), ray)
	if not hit or hit.Normal.Y &lt; 0.95 or hit.Instance.Name ~= "Sidewalk" then return nil end
	local ground = Vector3.new(position.X, hit.Position.Y, position.Z)
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then table.insert(ignore, player.Character) end
	end
	overlap.FilterDescendantsInstances = ignore
	local center = CFrame.new(ground + Vector3.new(0, 3.05, 0))
	for _, obstacle in ipairs(Workspace:GetPartBoundsInBox(center, Config.Clearance, overlap)) do
		if obstacle.CanCollide then return nil end
		-- NPCs do not collide with players, but should not share their standing spot.
		local owner = obstacle:FindFirstAncestorOfClass("Model")
		if owner and owner:FindFirstChildOfClass("Humanoid") then return nil end
	end
	return ground
end

local function findSpot(map, definition, regions, used)
	local sidewalks, direction = streetSidewalks(map, definition.street)
	if not direction then return nil end
	local perpendicular = Vector3.new(-direction.Z, 0, direction.X)
	for _, side in ipairs({ definition.side, -definition.side }) do
		for _, offset in ipairs(Config.DistanceOffsets) do
			local distance = definition.distance + offset
			local roadPoint = direction * distance
			for _, sidewalk in ipairs(sidewalks) do
				local actualSide = sidewalk.Position:Dot(perpendicular) &gt;= 0 and 1 or -1
				local along = sidewalk.CFrame:PointToObjectSpace(roadPoint).Z
				if actualSide == side and math.abs(along) &lt; sidewalk.Size.Z / 2 - 6 then
					local outerSign = sidewalk.CFrame.RightVector:Dot(perpendicular * side) &gt;= 0 and 1 or -1
					-- Stand on the outer edge; leave over three studs of pavement free.
					local lateral = outerSign * (sidewalk.Size.X / 2 - 1.4)
					local position = (sidewalk.CFrame * CFrame.new(lateral, sidewalk.Size.Y / 2, along)).Position
					local spaced = true
					for _, previous in ipairs(used) do
						if flatNear(position, previous, Config.MinSpacing) then spaced = false; break end
					end
					if spaced and passageClear(position, regions) then
						local ground = bodyClear(map, position)
						if ground then
							local facing = flat(roadPoint - ground)
							return CFrame.lookAt(ground, ground + facing), ground
						end
					end
				end
			end
		end
	end
	return nil
end

local function connectConversation(npc, definition)
	local root = npc:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local prompt = root:FindFirstChild("StreetTalkPrompt")
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = "StreetTalkPrompt"
		prompt.ActionText, prompt.ObjectText = "Conversar", definition.name
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.MaxActivationDistance, prompt.RequiresLineOfSight = 9, true
		prompt.Parent = root
	end
	local street = GameConfig.Map.StreetNames[definition.street] or "Bairro central"
	prompt.Triggered:Connect(function(player)
		if not npc.Parent then return end
		local _, _, playerRoot = Security.getLivingCharacter(player)
		if not playerRoot or not finitePoint(playerRoot.Position)
			or (playerRoot.Position - root.Position).Magnitude &gt; Config.TalkDistance then return end
		if not Security.checkRate(player, "StreetConversation", Config.TalkCooldown) then return end
		local now = Workspace:GetServerTimeNow()
		if now &lt; (nextSpeech[npc] or 0) then return end
		nextSpeech[npc] = now + Config.NPCSpeechCooldown
		local lines = Config.Lines[definition.topic] or Config.Lines.city
		local history = conversations[player]
		if not history then history = {}; conversations[player] = history end
		local index = (history[definition.id] or 0) % #lines + 1
		history[definition.id] = index
		NPCKit.say(npc, template(lines[index], street), 5.5)
		NPCKit.emote(npc, index == 1 and "wave" or "point")
	end)
end

function StreetNPCService.init(_sites)
	if initialized then return end
	initialized = true
	Players.PlayerRemoving:Connect(function(player) conversations[player] = nil end)
	-- A fábrica de avatares pode ceder execução; não atrasa o nascimento dos jogadores.
	task.spawn(function()
	local map = Workspace:FindFirstChild("Map")
	if not map then warn("[StreetNPCService] Mapa ausente; moradores não foram criados."); return end
	local regions, used = findRegions(map), {}
	local existing = {}
	for _, npc in ipairs(NPCKit.folder():GetChildren()) do
		local id = npc:GetAttribute("StreetResidentId")
		if id and npc:FindFirstChild("HumanoidRootPart") then existing[id] = npc end
	end
	for _, definition in ipairs(Config.Residents) do
		local npc = existing[definition.id]
		local point = npc and npc:FindFirstChild("HumanoidRootPart").Position
		if not npc then
			if NPCKit.count() &gt;= NPCKit.MAX_NPCS then
				warn("[StreetNPCService] Limite de NPCs atingido; preservando espaço dos moradores existentes.")
				break
			end
			local cf, ground = findSpot(map, definition, regions, used)
			if cf then
				npc = NPCKit.spawn(cf, { name = definition.name, anchored = true, important = false, showName = true })
				point = ground
			end
		end
		if npc then
			residents[definition.id] = npc
			npc:SetAttribute("StreetResident", true)
			npc:SetAttribute("StreetResidentId", definition.id)
			npc:SetAttribute("StreetName", GameConfig.Map.StreetNames[definition.street])
			npc:SetAttribute("District", "Bairro central")
			local root = npc:FindFirstChild("HumanoidRootPart")
			root.Anchored = true
			local humanoid = npc:FindFirstChildOfClass("Humanoid")
			if humanoid then humanoid.WalkSpeed = 0 end
			if point then table.insert(used, point) end
			connectConversation(npc, definition)
		else
			warn("[StreetNPCService] Sem ponto seguro ou modelo disponível para " .. definition.name)
		end
	end
	end)
end

function StreetNPCService.count()
	local count = 0
	for _, npc in pairs(residents) do if npc.Parent then count += 1 end end
	return count
end

return StreetNPCService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000027"><Properties><string name="Name">TaxiService</string><ProtectedString name="Source">-- LXR Táxis: emprego, despacho, passageiro e corrida pagos apenas pelo servidor.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Workspace=game:GetService("Workspace")
local Shared=ReplicatedStorage:WaitForChild("Shared")
local GameConfig=require(Shared:WaitForChild("GameConfig"))
local Config=require(Shared:WaitForChild("TaxiConfig"))
local Rules=require(Shared:WaitForChild("TaxiRules"))
local Security=require(script.Parent:WaitForChild("SecurityService"))
local NPCKit=require(script.Parent:WaitForChild("NPCKit"))
local Economy=require(script.Parent:WaitForChild("EconomyService"))
local DailyBonus=require(script.Parent:WaitForChild("DailyBonusService"))
local TaxiService={}
local initialized=false
local sites,hooks,ui,request
local duty,trips={},{}
local count,sequence=0,0
local rng=Random.new(5317)
local function now()return Workspace:GetServerTimeNow()end
local function rootOf(player)local _,_,root=Security.getLivingCharacter(player);return root end
local function restricted(player)
 local untilAt=player:GetAttribute("StunnedUntil")
 return player:GetAttribute("Detained")==true or (type(untilAt)=="number" and untilAt&gt;now())
end
local function location(point)
 if point.position then return point.position end
 if point.cf then return point.cf.Position end
 return point.marker and point.marker.Position
end
local function promptPosition(prompt)
 local p=prompt and prompt.Parent
 if p and p:IsA("BasePart")then return p.Position end
 if p and p:IsA("Attachment")then return p.WorldPosition end
end
local function near(player,prompt)
 local root=rootOf(player);local p=promptPosition(prompt)
 return root and p and Rules.point(root.Position) and (root.Position-p).Magnitude&lt;=Config.InteractionDistance
end
local function notice(player,message)
 if player.Parent==Players then ui:FireClient(player,"Notice",{text=message})end
end
local function hasRole(player)
 return duty[player]~=nil and hooks.workRoleService.hasRole(player,"Taxista") and not restricted(player)
end
local function carOf(player)
 local c=hooks.vehicleService.getCar(player)
 return c and c.role=="Taxista" and c.model and c.model.Parent and c.model.PrimaryPart and c or nil
end
local function state(player)
 local trip=trips[player]
 local active=duty[player]~=nil
 local target=trip and (trip.stage=="pickup" and location(trip.pickup)or location(trip.destination))
  or (active and promptPosition(sites.dispatchPrompt) or nil)
 player:SetAttribute("TaxiDuty",active)
 player:SetAttribute("TaxiStage",trip and trip.stage or "idle")
 player:SetAttribute("TaxiTargetPosition",target)
 player:SetAttribute("TaxiPickupName",trip and trip.pickup.name or nil)
 player:SetAttribute("TaxiDestinationName",trip and trip.destination.name or nil)
 player:SetAttribute("TaxiTripId",trip and trip.id or nil)
 if player.Parent==Players then
  ui:FireClient(player,"TaxiState",{onDuty=active,count=count,slots=Config.Slots,stage=trip and trip.stage or "idle",
   target=target,pickupName=trip and trip.pickup.name,destinationName=trip and trip.destination.name,
   tripId=trip and trip.id,fare=trip and trip.fare})
 end
end
local function broadcast()for _,player in ipairs(Players:GetPlayers())do state(player)end end
local function releaseSeat(trip)
 if trip.passengerSeat and trip.passengerSeat.Parent then trip.passengerSeat:SetAttribute("TaxiPassengerReserved",false)end
 trip.passengerSeat=nil
end
local function destroyTrip(trip)
 releaseSeat(trip)
 if trip.folder then trip.folder:Destroy()end
 if trip.npc then trip.npc:Destroy()end
end
function TaxiService.cancel(player,message)
 local trip=trips[player]
 trips[player]=nil
 if trip then destroyTrip(trip)end
 if initialized then state(player)end
 if message and trip then notice(player,message)end
 return trip~=nil
end
function TaxiService.isOnDuty(player)return duty[player]~=nil end
function TaxiService.leave(player,silent)
 if not duty[player]then return false end
 duty[player]=nil;count=math.max(0,count-1)
 TaxiService.cancel(player)
 hooks.workRoleService.clear(player,"Taxista")
 hooks.vehicleService.destroyWorkVehicle(player,"Taxista")
 broadcast()
 if not silent then notice(player,"Turno encerrado. Táxi e uniforme devolvidos à empresa.")end
 return true
end
function TaxiService.join(player)
 if not initialized or player.Parent~=Players or restricted(player)or not rootOf(player)then return false end
 if duty[player]then state(player);return true end
 if not near(player,sites.dutyPrompt)then notice(player,"Entre em serviço no balcão da LXR Táxis.");return false end
 if count&gt;=Config.Slots then notice(player,"As vagas de taxista estão ocupadas.");return false end
 duty[player]={joining=true};count+=1
 if hooks.beforeDuty then
  local ok,err=pcall(hooks.beforeDuty,player)
  if not ok then TaxiService.leave(player,true);warn("[TaxiService] Falha ao preparar turno: "..tostring(err));return false end
 end
 if player.Parent~=Players or not duty[player]or restricted(player)or not rootOf(player)then
  TaxiService.leave(player,true);return false
 end
 local accepted=hooks.workRoleService.assign(player,"Taxista")
 if not accepted then TaxiService.leave(player,true);notice(player,"Encerre seu outro emprego antes de entrar na LXR.");return false end
 if not duty[player]then return false end
 duty[player].joining=false
 broadcast()
 notice(player,"Bem-vindo à LXR! Retire uniforme e táxi na empresa e pegue uma corrida no despacho.")
 return true
end
local function missionFolder()
 local parent=Workspace:FindFirstChild("TaxiMissions")
 if not parent then parent=Instance.new("Folder");parent.Name="TaxiMissions";parent.Parent=Workspace end
 local f=Instance.new("Folder");f.Name="Corrida"..sequence;f.Parent=parent;return f
end
local function tripPrompt(folder,trip,point,stage)
 local p=Instance.new("Part");p.Name="Taxi"..stage.."Point";p.Anchored=true;p.Size=Vector3.new(1,1,1)
 p.CFrame=CFrame.new(location(point)+Vector3.new(0,2,0));p.Transparency=1;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=folder
 local prompt=Instance.new("ProximityPrompt");prompt.Name=stage=="pickup" and "TaxiPickupPrompt"or"TaxiDropoffPrompt"
 prompt.ActionText=stage=="pickup" and "Embarcar passageiro"or"Concluir corrida";prompt.ObjectText=point.name
 prompt.MaxActivationDistance=Config.ServiceRadius;prompt.RequiresLineOfSight=false;prompt.HoldDuration=0.5;prompt.KeyboardKeyCode=Enum.KeyCode.E
 prompt:SetAttribute("TaxiOwnerUserId",trip.player.UserId);prompt:SetAttribute("TaxiTripId",trip.id);prompt:SetAttribute("TaxiStage",stage)
 prompt.Parent=p
 prompt.Triggered:Connect(function(player)
  if player~=trip.player then return end
  if stage=="pickup"then TaxiService.pickup(player)else TaxiService.dropoff(player)end
 end)
 return prompt
end
function TaxiService.accept(player)
 if not hasRole(player)or not near(player,sites.dispatchPrompt)or not Security.checkRate(player,"TaxiAccept",1)then return false end
 if trips[player]then notice(player,"Você já tem uma corrida em andamento.");return false end
 if Economy.getMoney(player)==nil then notice(player,"Aguarde seus dados carregarem para iniciar uma corrida.");return false end
 local c=carOf(player)
 if not c then notice(player,"Retire o táxi da LXR na garagem antes de aceitar uma corrida.");return false end
 local pickups=sites.pickupPoints or {};local destinations=sites.destinations or pickups
 if #pickups&lt;2 or #destinations&lt;2 then return false end
 local pickup=pickups[rng:NextInteger(1,#pickups)]
 local valid={}
 for _,point in ipairs(destinations)do
  if Rules.point(location(point))and (location(point)-location(pickup)).Magnitude&gt;=100 then table.insert(valid,point)end
 end
 if #valid==0 then return false end
 local destination=valid[rng:NextInteger(1,#valid)]
 local distance=(location(destination)-location(pickup)).Magnitude
 local fare=Rules.fare(distance,Config.BaseFare,Config.FarePerStud)
 if not fare then return false end
 -- Reserva a corrida antes de criar um avatar, pois a criação pode ceder execução.
 sequence+=1
 local trip={player=player,id=sequence,stage="pickup",pickup=pickup,destination=destination,fare=fare,
  car=c.model,acceptedAt=now(),lastPosition=c.model.PrimaryPart.Position,lastAt=now(),covered=0,preparing=true}
 trips[player]=trip
 local npc=NPCKit.spawn(pickup.cf or CFrame.new(location(pickup)),{name="Passageiro LXR",anchored=true,showName=true})
 if trips[player]~=trip or not hasRole(player)then if npc then npc:Destroy()end;return false end
 if not npc then TaxiService.cancel(player,"Não foi possível chamar o passageiro agora. Tente novamente no despacho.");return false end
 trip.npc=npc;trip.preparing=false;npc:SetAttribute("TaxiPassengerOwner",player.UserId)
 for _,p in ipairs(npc:GetDescendants())do if p:IsA("BasePart")then p.CanCollide=false;p.CanTouch=false;p.Massless=true end end
 trip.folder=missionFolder();trip.pickupPrompt=tripPrompt(trip.folder,trip,pickup,"pickup");trip.dropoffPrompt=tripPrompt(trip.folder,trip,destination,"dropoff")
 NPCKit.say(npc,"Aguardando meu táxi da LXR!",4)
 state(player);notice(player,"Corrida recebida. Busque o passageiro em "..pickup.name..".")
 return true
end
local function serviceCheck(player,trip,point)
 if not hasRole(player)then return nil end
 local driving,c=hooks.vehicleService.isDrivingWorkVehicle(player,"Taxista")
 if not c then c=carOf(player)end
 if not c or c.model~=trip.car or not c.model.PrimaryPart then return nil end
 local chassis=c.model.PrimaryPart
 if not Rules.point(chassis.Position)or not Rules.point(chassis.AssemblyLinearVelocity)then return nil end
 if not Rules.canServe(true,driving,(chassis.Position-location(point)).Magnitude,chassis.AssemblyLinearVelocity.Magnitude,Config.ServiceRadius)then return nil end
 return c
end
local function seatPassenger(trip,c)
 local npc=trip.npc;local humanoid=npc and npc:FindFirstChildOfClass("Humanoid");local root=npc and npc:FindFirstChild("HumanoidRootPart")
 if not root or not humanoid or not c.passenger or c.passenger.Occupant then return false end
 -- O avatar acompanha o banco como decoração ancorada: nunca solda/ancora o carro.
 local animator=humanoid:FindFirstChildOfClass("Animator")
 if animator then for _,track in ipairs(animator:GetPlayingAnimationTracks())do track:Stop(0)end end
 humanoid.AutoRotate=false;humanoid.PlatformStand=true;root.Anchored=true
 trip.seatedJoints={}
 for _,joint in ipairs(npc:GetDescendants())do
  if joint:IsA("Motor6D")then
   if joint.Name=="LeftHip"or joint.Name=="RightHip"then
    table.insert(trip.seatedJoints,{joint=joint,c0=joint.C0});joint.C0=joint.C0*CFrame.Angles(-math.pi/2,0,0)
   elseif joint.Name=="LeftKnee"or joint.Name=="RightKnee"then
    table.insert(trip.seatedJoints,{joint=joint,c0=joint.C0});joint.C0=joint.C0*CFrame.Angles(math.pi/2,0,0)
   end
  end
 end
 npc:PivotTo(c.passenger.CFrame*CFrame.new(0,1.35,0))
 trip.passengerSeat=c.passenger;c.passenger:SetAttribute("TaxiPassengerReserved",true)
 return true
end
function TaxiService.pickup(player)
 local trip=trips[player]
 if not trip or trip.stage~="pickup"or not Security.checkRate(player,"TaxiPickup",0.5)then return false end
 local c=serviceCheck(player,trip,trip.pickup)
 if not c then notice(player,"Pare o seu táxi perto do passageiro, sentado ao volante.");return false end
 if not trip.npc or not trip.npc.Parent or (trip.npc:GetPivot().Position-location(trip.pickup)).Magnitude&gt;12 then return false end
 if not seatPassenger(trip,c)then notice(player,"O banco do passageiro precisa estar livre.");return false end
 trip.stage="dropoff";trip.boardedAt=now();trip.lastAt=now();trip.lastPosition=c.model.PrimaryPart.Position
 trip.straight=(location(trip.destination)-trip.lastPosition).Magnitude;trip.covered=0;trip.driverMissingAt=nil
 state(player);NPCKit.say(trip.npc,"Pode seguir para "..trip.destination.name..", por favor!",4)
 return true
end
function TaxiService.dropoff(player)
 local trip=trips[player]
 if not trip or trip.stage~="dropoff"or not Security.checkRate(player,"TaxiDropoff",0.5)then return false end
 if not trip.npc or not trip.npc.Parent then TaxiService.cancel(player,"Corrida cancelada: passageiro indisponível.");return false end
 local c=serviceCheck(player,trip,trip.destination)
 if not c then notice(player,"Pare no destino com o seu táxi para concluir a corrida.");return false end
 if not c.passenger or c.passenger.Occupant or not trip.passengerSeat or not trip.passengerSeat.Parent then return false end
 local time=now();local moved=(c.model.PrimaryPart.Position-trip.lastPosition).Magnitude
 local speed=math.min(c.spec and c.spec.MaxSpeed or Config.MaxSpeed,120)
 if not Rules.plausible(moved,time-trip.lastAt,speed)then TaxiService.cancel(player,"Corrida cancelada por deslocamento inválido.");return false end
 if not Rules.canFinish(trip.stage,time-trip.boardedAt,trip.straight,trip.covered+moved,speed,Config.ServiceRadius)then
  notice(player,"A viagem ainda não foi validada. Percorra o trajeto até o destino.");return false
 end
 -- Resolve antes de pagar, impedindo pagamento duplicado por prompt e botão juntos.
 trips[player]=nil
 releaseSeat(trip)
 if trip.folder then trip.folder:Destroy()end
 local npc=trip.npc
 if npc and npc.Parent then
  for _,record in ipairs(trip.seatedJoints or {})do if record.joint.Parent then record.joint.C0=record.c0 end end
  local h=npc:FindFirstChildOfClass("Humanoid");if h then h.PlatformStand=false end
  local point=location(trip.destination)
  npc:PivotTo((trip.destination.cf or CFrame.new(point))+Vector3.new(0,3.1,0))
  NPCKit.say(npc,"Obrigado pela corrida! Até a próxima.",3);NPCKit.emote(npc,"wave")
  task.delay(3,function()if npc.Parent then npc:Destroy()end end)
 end
 local paid=Economy.add(player,trip.fare,"Corrida LXR #"..trip.id)
 local bonus=paid and DailyBonus.tryClaim(player) or 0
 state(player)
 notice(player,paid and ("Corrida concluída: $"..trip.fare..(bonus&gt;0 and (" + bônus diário $"..bonus) or "")..". Volte ao despacho da LXR para outra.")or "Corrida concluída, mas o pagamento não pôde ser registrado. Confira o Output.")
 return paid
end
local function panel(player,kind)
 ui:FireClient(player,"TaxiPanel",{panel=kind,onDuty=duty[player]~=nil,count=count,slots=Config.Slots,stage=trips[player]and trips[player].stage or"idle"})
end
function TaxiService.init(remotes,taxiSites,options)
 if initialized then return end
 sites=assert(taxiSites,"Sede LXR ausente");hooks=options or {}
 assert(hooks.vehicleService and hooks.workRoleService,"Integrações LXR ausentes")
 ui=assert(remotes[GameConfig.Remotes.UIUpdate],"UIUpdate ausente")
 request=assert(remotes[GameConfig.Remotes.TaxiRequest or"TaxiRequest"],"TaxiRequest ausente")
 initialized=true
 sites.dutyPrompt.Enabled=true;sites.dispatchPrompt.Enabled=true
 sites.dutyPrompt.Triggered:Connect(function(player)if near(player,sites.dutyPrompt)then panel(player,"duty")end end)
 sites.dispatchPrompt.Triggered:Connect(function(player)if near(player,sites.dispatchPrompt)and hasRole(player)then panel(player,"dispatch")end end)
 request.OnServerEvent:Connect(function(player,action,payload)
  if not Security.isShortString(action,16)or not Security.checkRate(player,"TaxiRequest",0.2)then return end
  if action=="Duty"then if payload==true then TaxiService.join(player)elseif payload==false then TaxiService.leave(player)end
  elseif action=="Accept"then TaxiService.accept(player)
  elseif action=="Pickup"then TaxiService.pickup(player)
  elseif action=="Dropoff"then TaxiService.dropoff(player)
  elseif action=="Cancel"then TaxiService.cancel(player,"Corrida cancelada. Volte ao despacho para outra.")end
 end)
 local function watchPlayer(player)
  player.CharacterAdded:Connect(function()TaxiService.leave(player,true)end)
  player:GetAttributeChangedSignal("Detained"):Connect(function()if player:GetAttribute("Detained")then TaxiService.leave(player,true)end end)
  task.defer(function()if player.Parent==Players then state(player)end end)
 end
 Players.PlayerAdded:Connect(watchPlayer);for _,player in ipairs(Players:GetPlayers())do watchPlayer(player)end
 Players.PlayerRemoving:Connect(function(player)TaxiService.leave(player,true);TaxiService.cancel(player)end)
 hooks.workRoleService.onChanged(function(player,newRole)if duty[player]and not duty[player].joining and newRole~="Taxista"then TaxiService.leave(player,true)end end)
 task.spawn(function()
  while true do
   local time=now()
   for player,trip in pairs(trips)do
    local c=carOf(player)
    if trip.preparing then
     if not hasRole(player)or not c or c.model~=trip.car or time-trip.acceptedAt&gt;30 then TaxiService.cancel(player,"Não foi possível confirmar o passageiro. Tente novamente no despacho.")
     else
      local position=c.model.PrimaryPart.Position
      local speed=math.min(c.spec and c.spec.MaxSpeed or Config.MaxSpeed,120)
      if not Rules.point(position)or not Rules.plausible((position-trip.lastPosition).Magnitude,time-trip.lastAt,speed)then
       TaxiService.cancel(player,"Corrida cancelada por deslocamento inválido.")
      else trip.lastPosition=position;trip.lastAt=time end
     end
    elseif not hasRole(player)or not c or c.model~=trip.car or not trip.npc or not trip.npc.Parent then
     TaxiService.cancel(player,"Corrida cancelada: o táxi ou o emprego não está mais disponível.")
    elseif time-trip.acceptedAt&gt;Config.TripTimeout then TaxiService.cancel(player,"O passageiro cancelou a corrida por demora.")
    else
     local position=c.model.PrimaryPart.Position;local elapsed=time-trip.lastAt
     local speed=math.min(c.spec and c.spec.MaxSpeed or Config.MaxSpeed,120)
     if not Rules.point(position)or not Rules.plausible((position-trip.lastPosition).Magnitude,elapsed,speed)then
      TaxiService.cancel(player,"Corrida cancelada por deslocamento inválido.")
     else
      if trip.stage=="dropoff"then
       trip.covered+=(position-trip.lastPosition).Magnitude
       local driving=hooks.vehicleService.isDrivingWorkVehicle(player,"Taxista")
       if not driving then trip.driverMissingAt=trip.driverMissingAt or time else trip.driverMissingAt=nil end
       if trip.driverMissingAt and time-trip.driverMissingAt&gt;Config.DriverGrace then TaxiService.cancel(player,"Corrida cancelada: motorista fora do táxi.")
       elseif c.passenger and c.passenger.Occupant then TaxiService.cancel(player,"Corrida cancelada: o banco reservado foi ocupado.")
       elseif c.passenger and trip.npc.Parent then trip.npc:PivotTo(c.passenger.CFrame*CFrame.new(0,1.35,0))end
      end
      trip.lastPosition=position;trip.lastAt=time
     end
    end
   end
   task.wait(Config.SampleInterval)
  end
 end)
end
return TaxiService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000028"><Properties><string name="Name">TaxiSiteBuilder</string><ProtectedString name="Source">-- Sede LXR: fachada amarela, identificação azul e pátio de retirada aberto.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("CivicConfig"))
local TaxiSiteBuilder = {}
local cached
local V = Vector3.new
local YELLOW = Color3.fromRGB(245, 190, 43)
local BLUE = Color3.fromRGB(24, 74, 135)
local WHITE = Color3.fromRGB(242, 241, 226)
local STEEL = Color3.fromRGB(65, 76, 84)
local function part(parent, base, name, size, position, color, collide)
 local p = Instance.new("Part")
 p.Name, p.Size, p.CFrame = name, size, base * CFrame.new(position)
 p.Anchored, p.CanCollide = true, collide ~= false
 p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
 p.Color, p.Material = color or WHITE, Enum.Material.SmoothPlastic
 p.Parent = parent
 return p
end
local function label(p, text, color)
 local g = Instance.new("SurfaceGui"); g.Face = Enum.NormalId.Front
 g.SizingMode, g.PixelsPerStud, g.LightInfluence = Enum.SurfaceGuiSizingMode.PixelsPerStud, 30, 0
 g.Parent = p
 local t = Instance.new("TextLabel"); t.Size = UDim2.fromScale(1, 1)
 t.BackgroundTransparency, t.TextScaled, t.TextWrapped = 1, true, true
 t.Font, t.TextColor3, t.Text, t.Parent = Enum.Font.GothamBold, color or BLUE, text, g
end
local function prompt(parent, base, name, pos, action)
 local p = part(parent, base, name, V(2.2, 2.2, 0.35), pos, BLUE, false)
 local q = Instance.new("ProximityPrompt"); q.Name = name .. "Prompt"
 q.ActionText, q.ObjectText = action, "LXR Táxis"
 q.MaxActivationDistance, q.HoldDuration = 9, 0.5
 q.KeyboardKeyCode, q.RequiresLineOfSight, q.Enabled = Enum.KeyCode.E, true, false
 q:SetAttribute("Role", "Taxista"); q.Parent = p
 return q
end
local function marker(parent, base, name, pos)
 local p = part(parent, base, name, V(1, 1, 1), pos, WHITE, false)
 p.Transparency, p.CanTouch, p.CanQuery = 1, false, false
 return p
end
function TaxiSiteBuilder.build(map)
 if cached then return cached end
 local locations = map:FindFirstChild("CivicLocations")
 assert(locations, "CivicLocations ausente")
 local old = locations:FindFirstChild(Config.Taxi.Name)
 if old then
  local function q(n) return assert(old:FindFirstChild(n)):FindFirstChildOfClass("ProximityPrompt") end
  local spawns = {}; for i=1,3 do spawns[i]=assert(old:FindFirstChild("TaxiVehicleSpawn"..i)) end
  local stops = {}
  for i,stop in ipairs(Config.TaxiStops)do
   local m = assert(old:FindFirstChild("TaxiStop"..i))
   table.insert(stops,{name=stop.name,position=stop.position,cf=CFrame.new(stop.position),marker=m})
  end
  cached={model=old,dutyPrompt=q("TaxiDuty"),dispatchPrompt=q("TaxiDispatch"),uniformPrompt=q("TaxiUniform"),vehiclePrompt=q("TaxiVehicle"),vehicleSpawns=spawns,pickupPoints=stops,destinations=stops}
  return cached
 end
 local base = Config.Taxi.CFrame
 local m = Instance.new("Model"); m.Name = Config.Taxi.Name; m.Parent = locations
 for k,v in pairs({PlaceName=Config.Taxi.Name,MapLabel="LXR Táxis",Kind="Taxi",MapPosition=base.Position,Role="Taxista"})do m:SetAttribute(k,v)end
 local p=function(n,size,pos,col,collide)return part(m,base,n,size,pos,col,collide)end
 p("Pátio LXR",V(124,0.8,148),V(0,0.4,0),Color3.fromRGB(175,180,178))
 p("Piso",V(74,0.3,48),V(0,0.95,24),WHITE)
 p("ParedeFundos",V(74,15,1),V(0,8.3,48),YELLOW)
 for _,x in ipairs({-37,37})do p("ParedeLateral",V(1,15,48),V(x,8.3,24),YELLOW)end
 for _,side in ipairs({-1,1})do
  p("MuretaFachada",V(31,2.2,1),V(side*21.5,1.9,0),YELLOW)
  local g=p("VidroRecepção",V(29,8.4,0.3),V(side*21.5,7.2,-0.15),Color3.fromRGB(145,199,226));g.Material=Enum.Material.Glass;g.Transparency=0.32
  p("FaixaFachada",V(31,3.6,1),V(side*21.5,13.2,0),YELLOW)
  p("ColunaEntrada",V(0.8,12,1.1),V(side*6.2,6.8,-0.1),BLUE)
 end
 p("VergaEntrada",V(12,4,1),V(0,13.8,0),BLUE)
 p("Cobertura",V(77,0.7,51),V(0,16.1,24),BLUE)
 p("Marquise",V(20,0.5,6),V(0,11.8,-2.5),YELLOW,false)
 local brand=p("LetreiroLXR",V(57,6,0.5),V(0,20,-0.6),YELLOW,false);label(brand,"LXR TÁXIS",BLUE)
 local sub=p("Atendimento",V(25,2.2,0.25),V(0,9.3,-0.7),BLUE,false);label(sub,"CENTRAL DE CORRIDAS",WHITE)
 p("BalcãoDespacho",V(23,3,4),V(0,2.5,16),YELLOW)
 p("TampoBalcão",V(24,0.35,4.7),V(0,4.2,16),BLUE)
 p("Computador",V(4,3,0.4),V(0,5.9,16.7),STEEL,false)
 for _,x in ipairs({-29,-20})do
  p("ArmárioUniforme",V(7,9,3),V(x,5.3,43),BLUE)
  p("AlçaArmário",V(0.2,1.2,0.2),V(x+2,5.3,41.4),WHITE,false)
 end
 local u=p("PlacaUniforme",V(20,2.2,0.2),V(-24,11.5,41.3),YELLOW,false);label(u,"UNIFORMES LXR")
 for _,x in ipairs({-13,13})do
  local s=Instance.new("Seat");s.Name="Banco";s.Anchored=true;s.CanTouch=false
  s.Size,s.CFrame=V(7,0.5,2),base*CFrame.new(x,2.4,7);s.Color,s.Parent=BLUE,m
 end
 for _,x in ipairs({-21,21})do
  local light=p("Luminária",V(7,0.2,2),V(x,15.6,22),WHITE,false);light.Material=Enum.Material.Neon
  local l=Instance.new("PointLight");l.Range,l.Brightness,l.Shadows=26,1.3,false;l.Parent=light
 end
 local spawns={}
 for i,x in ipairs({-38,0,38})do
  spawns[i]=marker(m,base,"TaxiVehicleSpawn"..i,V(x,0.8,-43))
  for _,side in ipairs({-1,1})do p("MarcaVaga",V(0.15,0.03,26),V(x+side*7,0.83,-43),WHITE,false)end
 end
 local stops={}
 for i,stop in ipairs(Config.TaxiStops)do
  local s=marker(m,CFrame.new(),"TaxiStop"..i,stop.position)
  s:SetAttribute("StopName",stop.name)
  table.insert(stops,{name=stop.name,position=stop.position,cf=CFrame.new(stop.position),marker=s})
 end
 cached={model=m,dutyPrompt=prompt(m,base,"TaxiDuty",V(24,4.5,15),"Trabalhar como taxista"),dispatchPrompt=prompt(m,base,"TaxiDispatch",V(0,5,13.3),"Central de corridas"),uniformPrompt=prompt(m,base,"TaxiUniform",V(-24,5,40.8),"Retirar uniforme"),vehiclePrompt=prompt(m,base,"TaxiVehicle",V(-53,4,-26),"Retirar táxi LXR"),vehicleSpawns=spawns,pickupPoints=stops,destinations=stops}
 local function worldPath(points)
  local result={};for _,p in ipairs(points)do table.insert(result,base*p)end;return result
 end
 cached.validationRoutes={
  {name="LXR / recepção",points=worldPath({V(0,4,-74),V(0,4,6),V(0,4,11.3)})},
  {name="LXR / vestiário",points=worldPath({V(0,4,6),V(-24,4,17),V(-24,4,38)})},
  {name="LXR / retirada de táxi",points=worldPath({V(0,4,6),V(0,4,-20),V(-53,4,-26)})},
 }
 return cached
end
return TaxiSiteBuilder
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000029"><Properties><string name="Name">TutorialService</string><ProtectedString name="Source">-- TutorialService (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; TutorialService
-- Decide quem vê o tutorial: só quem ainda não concluiu (ou pulou).
-- O tutorial começa quando DUAS coisas aconteceram: os dados carregaram
-- e o cliente avisou que está pronto. Isso evita mandar o aviso cedo demais.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local SecurityService = require(script.Parent:WaitForChild("SecurityService"))
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))

local TutorialService = {}

local uiUpdate
local clientReady = {} -- clientReady[player] = true depois do "Ready"
local started = {} -- started[player] = true quando o tutorial foi enviado

local function tryStart(player)
	if started[player] or not clientReady[player] then
		return
	end
	local data = PlayerDataService.get(player)
	if not data then
		return -- ainda carregando; tenta de novo quando carregar
	end
	if data.tutorialDone then
		return
	end
	started[player] = true
	uiUpdate:FireClient(player, "StartTutorial", {})
end

local function onTutorialRequest(player, action)
	if not SecurityService.checkRate(player, "TutorialRequest", 1) then
		return
	end
	if not SecurityService.isShortString(action, 16) then
		return
	end

	if action == "Ready" then
		clientReady[player] = true
		tryStart(player)
	elseif action == "Finish" then
		-- Só vale se o servidor realmente começou o tutorial para esse jogador
		if not started[player] then
			return
		end
		local data = PlayerDataService.get(player)
		if data and not data.tutorialDone then
			PlayerDataService.set(player, "tutorialDone", true)
			task.spawn(PlayerDataService.save, player)
		end
	end
end

function TutorialService.init(remotes)
	uiUpdate = remotes[GameConfig.Remotes.UIUpdate]
	remotes[GameConfig.Remotes.TutorialRequest].OnServerEvent:Connect(onTutorialRequest)

	PlayerDataService.onLoaded(function(player)
		tryStart(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		clientReady[player] = nil
		started[player] = nil
	end)
end

return TutorialService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000002A"><Properties><string name="Name">VehicleService</string><ProtectedString name="Source">-- VehicleService (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; VehicleService
-- Bicicleta inicial gratuita e carro (Marco 4.3: um modelo, para andar rápido pela cidade).
-- Dentro dos locais de trabalho (ZoneService) não dá para usar bike nem carro.
-- O jogador "monta" a bicicleta: um modelo é preso ao personagem e a velocidade
-- de caminhada aumenta. Funciona igual no PC e no celular, porque usa o próprio
-- controle de movimento do Roblox. A bike é montada do tamanho do boneco
-- (RigMeasure) e o BikeAnimator, no cliente, faz a pedalada e gira rodas e pedais.
-- O servidor decide tudo: quem pode montar, a velocidade e o cooldown.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local RigMeasure = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RigMeasure"))
local SecurityService = require(script.Parent:WaitForChild("SecurityService"))
local ZoneService = require(script.Parent:WaitForChild("ZoneService"))
local CarBuilder = require(script.Parent:WaitForChild("CarBuilder"))
local SeatService = require(script.Parent:WaitForChild("SeatService"))
local WorkRoleService = require(script.Parent:WaitForChild("WorkRoleService"))

local VehicleService = {}

local BIKE = GameConfig.Bike
local uiUpdate -- RemoteEvent para avisar a interface

-- bikes[player] = Model da bicicleta montada (só existe enquanto montado)
local bikes = {}
-- cars[player] = { model, driver } (o carro fica parado onde o jogador saiu)
local cars = {}

local function notice(player, text)
	uiUpdate:FireClient(player, "Notice", { text = text })
end

local function isStunned(player)
	local untilAt = player:GetAttribute("StunnedUntil")
	return type(untilAt) == "number" and untilAt &gt; Workspace:GetServerTimeNow()
end

local function newBikePart(bike, name, size, color, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	-- A bicicleta é só visual: não colide, não pesa e não atrapalha o personagem
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.Anchored = false
	p.Parent = bike
	return p
end

-- Distância do centro do HumanoidRootPart até o chão
local function rootHeightAboveGround(humanoid, root)
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		return 3
	end
	return humanoid.HipHeight + root.Size.Y / 2
end

local function weldTo(base, part)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = base
	weld.Part1 = part
	weld.Parent = part
end

local function buildBike(character, humanoid, root)
	local bike = Instance.new("Model")
	bike.Name = "StarterBike"

	-- Medidas do boneco (com valores padrão se o avatar for diferente)
	local m = RigMeasure.measure(character)
	local hip = m and (m.hip.Left + m.hip.Right) / 2 or Vector3.new(0, -1, 0)
	local legLen = m and (m.legL1 + m.legL2) or 2
	local shoulder = m and (m.shoulder.Left + m.shoulder.Right) / 2 or Vector3.new(0, 0.5, 0)
	local armLen = m and (m.armL1 + m.armL2) or 1.8

	-- Pontos principais, em coordenadas do HumanoidRootPart (frente = -Z, esquerda = -X)
	local r = BIKE.WheelRadius
	local ground = -rootHeightAboveGround(humanoid, root)
	local axleY = ground + r
	local crankR = 0.22 * legLen
	local bb = Vector3.new(0, math.max(hip.Y - 0.62 * legLen, ground + 0.15 + crankR), hip.Z - 0.2 * legLen)
	local rearAxle = Vector3.new(0, axleY, bb.Z + 1.7)
	local frontAxle = Vector3.new(0, axleY, bb.Z - 1.9)
	local seatPos = Vector3.new(0, hip.Y - 0.25 + BIKE.SeatOffsetY, hip.Z + 0.3)
	local seatPostTop = seatPos - Vector3.new(0, 0.2, 0)
	local barCenter = Vector3.new(0, shoulder.Y - 0.6 * armLen, shoulder.Z - 0.7 * armLen)
	local headTop = Vector3.new(0, barCenter.Y - 0.35, frontAxle.Z + 0.45)
	local function onFork(t)
		return frontAxle:Lerp(headTop, t)
	end

	local function attach(base, part, localCf)
		part.CFrame = base.CFrame * localCf
		weldTo(base, part)
		return part
	end
	local function piece(name, size, color, cf, shape)
		return attach(root, newBikePart(bike, name, size, color, shape), cf)
	end
	local function tube(name, a, b, thickness, color)
		return piece(name, Vector3.new(thickness, thickness, (b - a).Magnitude + thickness * 0.5), color or BIKE.FrameColor, CFrame.lookAt((a + b) / 2, b))
	end
	-- Peça que gira (roda ou pedivela): presa por Motor6D, que o cliente anima
	local function spinner(name, center, size)
		local hub = newBikePart(bike, name, size, BIKE.MetalColor, Enum.PartType.Cylinder)
		hub.CFrame = root.CFrame * CFrame.new(center)
		local motor = Instance.new("Motor6D")
		motor.Name = name .. "Motor"
		motor.Part0 = root
		motor.Part1 = hub
		motor.C0 = CFrame.new(center)
		motor.Parent = hub
		return hub
	end

	-- Rodas: pneu em anel (segmentos), raios e cubo
	local function wheel(name, center)
		local hub = spinner(name, center, Vector3.new(0.35, 0.3, 0.3))
		local segments = 14
		local segLen = 2 * math.pi * r / segments * 1.1
		for i = 1, segments do
			local phi = i * 2 * math.pi / segments
			attach(hub, newBikePart(bike, "Tire", Vector3.new(0.26, 0.2, segLen), BIKE.WheelColor), CFrame.Angles(phi, 0, 0) * CFrame.new(0, r - 0.1, 0))
		end
		for i = 0, 2 do
			attach(hub, newBikePart(bike, "Spoke", Vector3.new(0.05, (r - 0.15) * 2, 0.05), BIKE.MetalColor), CFrame.Angles(i * math.pi / 3, 0, 0))
		end
		return hub
	end
	wheel("FrontWheel", frontAxle)
	local rearHub = wheel("RearWheel", rearAxle)
	attach(rearHub, newBikePart(bike, "Sprocket", Vector3.new(0.08, 0.36, 0.36), BIKE.MetalColor, Enum.PartType.Cylinder), CFrame.new(0.28, 0, 0))

	-- Quadro
	local side = 0.2
	tube("SeatTube", bb, seatPostTop, 0.18)
	tube("TopTube", seatPostTop, onFork(0.85), 0.18)
	tube("DownTube", bb, onFork(0.55), 0.2)
	for _, x in ipairs({ -side, side }) do
		local offset = Vector3.new(x, 0, 0)
		tube("ChainStay", bb + offset * 0.5, rearAxle + offset, 0.12)
		tube("SeatStay", seatPostTop, rearAxle + offset, 0.1)
		tube("ForkBlade", frontAxle + offset, onFork(0.75), 0.12)
	end
	tube("HeadTube", onFork(0.7), headTop, 0.22)
	tube("Stem", headTop, barCenter, 0.14, BIKE.MetalColor)

	-- Guidão e manoplas (as mãos vão nas manoplas)
	local gripX = 0.85
	tube("Handlebar", barCenter - Vector3.new(gripX, 0, 0), barCenter + Vector3.new(gripX, 0, 0), 0.12, BIKE.MetalColor)
	piece("GripLeft", Vector3.new(0.4, 0.18, 0.18), BIKE.AccentColor, CFrame.new(barCenter - Vector3.new(gripX, 0, 0)))
	piece("GripRight", Vector3.new(0.4, 0.18, 0.18), BIKE.AccentColor, CFrame.new(barCenter + Vector3.new(gripX, 0, 0)))

	-- Selim
	piece("Seat", Vector3.new(0.7, 0.22, 0.9), BIKE.AccentColor, CFrame.new(seatPos))
	piece("SeatNose", Vector3.new(0.32, 0.18, 0.6), BIKE.AccentColor, CFrame.new(seatPos + Vector3.new(0, -0.02, -0.65)))

	-- Farol e refletor
	local light = piece("Headlight", Vector3.new(0.3, 0.3, 0.2), Color3.fromRGB(255, 240, 180), CFrame.new(headTop + Vector3.new(0, -0.1, -0.2)))
	light.Material = Enum.Material.Neon
	local reflector = piece("Reflector", Vector3.new(0.25, 0.15, 0.08), Color3.fromRGB(220, 40, 40), CFrame.new(seatPostTop + Vector3.new(0, -0.1, 0.25)))
	reflector.Material = Enum.Material.Neon

	-- Pedivela: coroa, braços e pedais (giram juntos)
	local crank = spinner("Crank", bb, Vector3.new(0.5, 0.26, 0.26))
	attach(crank, newBikePart(bike, "Chainring", Vector3.new(0.08, 0.7, 0.7), Color3.fromRGB(70, 70, 75), Enum.PartType.Cylinder), CFrame.new(0.28, 0, 0))
	attach(crank, newBikePart(bike, "CrankArmRight", Vector3.new(0.1, crankR, 0.14), BIKE.MetalColor), CFrame.new(0.36, -crankR / 2, 0))
	attach(crank, newBikePart(bike, "CrankArmLeft", Vector3.new(0.1, crankR, 0.14), BIKE.MetalColor), CFrame.new(-0.36, crankR / 2, 0))
	attach(crank, newBikePart(bike, "PedalRight", Vector3.new(0.36, 0.1, 0.28), BIKE.WheelColor), CFrame.new(0.52, -crankR, 0))
	attach(crank, newBikePart(bike, "PedalLeft", Vector3.new(0.36, 0.1, 0.28), BIKE.WheelColor), CFrame.new(-0.52, crankR, 0))

	-- Corrente (parada; só visual)
	local chainX = Vector3.new(0.28, 0, 0)
	tube("ChainTop", bb + chainX + Vector3.new(0, 0.35, 0), rearAxle + chainX + Vector3.new(0, 0.18, 0), 0.06, Color3.fromRGB(40, 40, 45))
	tube("ChainBottom", bb + chainX - Vector3.new(0, 0.35, 0), rearAxle + chainX - Vector3.new(0, 0.18, 0), 0.06, Color3.fromRGB(40, 40, 45))

	bike:SetAttribute("WheelRadius", r)
	bike:SetAttribute("CrankRadius", crankR)
	bike.Parent = character
	return bike
end

local function sendState(player, mounted)
	uiUpdate:FireClient(player, "BikeState", { mounted = mounted })
end

local function dismount(player)
	local bike = bikes[player]
	bikes[player] = nil
	if bike then
		bike:Destroy()
	end
	local _, humanoid = SecurityService.getLivingCharacter(player)
	if humanoid then
		humanoid.WalkSpeed = GameConfig.WalkSpeed
	end
	sendState(player, false)
end

local function mount(player)
	if player:GetAttribute("Detained") or isStunned(player) then
		return
	end
	local character, humanoid, root = SecurityService.getLivingCharacter(player)
	if not character then
		return
	end
	if humanoid.Sit or humanoid.SeatPart then
		return -- não monta sentado em banco ou veículo
	end
	if ZoneService.isInside(player) then
		notice(player, "Aqui dentro não dá para usar a bike.")
		return
	end
	bikes[player] = buildBike(character, humanoid, root)
	humanoid.WalkSpeed = BIKE.Speed
	sendState(player, true)
end

---------------------------------------------------------------------------
-- Carro
---------------------------------------------------------------------------

local PERSONAL_CAR = GameConfig.Cars[GameConfig.CarModel]
local workplaces, personalGarage = {}, nil
local configuredPrompts = {}

local function blocked(player)
	return player:GetAttribute("Detained") or isStunned(player)
end

local function vehiclesFolder()
	local f = Workspace:FindFirstChild("Vehicles")
	if not f then f = Instance.new("Folder"); f.Name, f.Parent = "Vehicles", Workspace end
	return f
end

local function carState(player, record, driving)
	if uiUpdate and player.Parent == Players then
		uiUpdate:FireClient(player, "CarState", {
			driving = driving == true, workRole = record and record.role or nil,
			name = record and record.spec.Name or nil,
		})
	end
end

local function destroyCar(player)
	local c = cars[player]
	cars[player] = nil
	if c then
		for _, seat in ipairs({ c.driver, c.passenger }) do
			local occupant = seat and seat.Occupant
			if occupant then occupant.Sit = false end
		end
		if c.model then c.model:Destroy() end
	end
	carState(player, nil, false)
end

local function validRole(player, record)
	return not record.role or WorkRoleService.hasRole(player, record.role)
end

function VehicleService.getCar(player)
	local record = cars[player]
	if record and record.model and record.model.Parent then return record end
	return nil
end

function VehicleService.isDrivingWorkVehicle(player, role)
	local record = VehicleService.getCar(player)
	local _, humanoid = SecurityService.getLivingCharacter(player)
	local accepted = record ~= nil and record.role == role and validRole(player, record)
		and not blocked(player) and humanoid ~= nil and humanoid.SeatPart == record.driver
	return accepted == true, record
end

function VehicleService.destroyWorkVehicle(player, role)
	local record = VehicleService.getCar(player)
	if record and record.role and (role == nil or record.role == role) then
		destroyCar(player)
		return true
	end
	return false
end

local function charactersList(player)
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(list, p.Character) end end
	local npcs = Workspace:FindFirstChild("NPCs")
	if npcs then table.insert(list, npcs) end
	local own = cars[player]
	if own and own.model then table.insert(list, own.model) end
	return list
end

local function clearSpot(player, markerCf, spec)
	local ignore = charactersList(player)
	local ray = RaycastParams.new()
	ray.FilterType, ray.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, ignore
	local p = markerCf.Position
	local hit = Workspace:Raycast(p + Vector3.new(0, 12, 0), Vector3.new(0, -60, 0), ray)
	if not hit then return nil end
	local center = Vector3.new(p.X, hit.Position.Y + spec.Hover, p.Z)
	local cf = CFrame.new(center) * markerCf.Rotation
	local overlap = OverlapParams.new()
	overlap.FilterType, overlap.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, ignore
	overlap.RespectCanCollide = true
	-- Inclui o teto do sedã, além do chassi. As placas do chão ficam abaixo da caixa.
	local parts = Workspace:GetPartBoundsInBox(cf * CFrame.new(0, 2.3, 0),
		Vector3.new(spec.Width + 1, 7, spec.Length + 1), overlap)
	if #parts &gt; 0 or ZoneService.zoneAt(center) then return nil end
	return cf
end

local function findCarSpot(player, root, spec)
	local look = root.CFrame.LookVector
	local rotation = CFrame.Angles(0, math.atan2(-look.X, -look.Z), 0)
	local right, forward = rotation.RightVector, rotation.LookVector
	for _, offset in ipairs({ right * 9, -right * 9, forward * 12, -forward * 12, right * 18, -right * 18 }) do
		local found = clearSpot(player, CFrame.new(root.Position + offset) * rotation, spec)
		if found then return found end
	end
	return nil
end

local function nearPrompt(player, prompt)
	local _, _, root = SecurityService.getLivingCharacter(player)
	local parent = prompt and prompt.Parent
	local target = parent and (parent:IsA("BasePart") and parent.Position or parent:IsA("Attachment") and parent.WorldPosition)
	return root and target and (root.Position - target).Magnitude &lt;= 11
end

local function nearAny(player, prompts)
	for _, prompt in ipairs(prompts or {}) do if nearPrompt(player, prompt) then return true end end
	return false
end

local function padSpot(player, pads, spec)
	for _, pad in ipairs(pads or {}) do
		if pad and pad:IsA("BasePart") and pad.Parent then
			local found = clearSpot(player, pad.CFrame, spec)
			if found then return found end
		end
	end
	return nil
end

local function sitInCar(player, humanoid)
	if blocked(player) then return false end
	local c = VehicleService.getCar(player)
	if not c or not validRole(player, c) or not c.driver.Parent or c.driver.Occupant then return false end
	if bikes[player] then dismount(player) end
	c.driver:Sit(humanoid)
	return true
end

local function spawnCar(player, humanoid, spec, spot, role)
	if blocked(player) or (role and not WorkRoleService.hasRole(player, role)) then return false end
	local ok, model, driver, passenger = pcall(CarBuilder.build, spec, spot)
	if not ok then warn("[VehicleService] Falha ao construir veículo: " .. tostring(model)); return false end
	if blocked(player) or (role and not WorkRoleService.hasRole(player, role)) then model:Destroy(); return false end
	destroyCar(player)
	model.Name = player.Name .. "_" .. spec.Name
	model:SetAttribute("Owner", player.UserId)
	model:SetAttribute("WorkRole", role)
	model:SetAttribute("Spec", spec.Name)
	model.Parent = vehiclesFolder()
	SeatService.setup(passenger, "Carona")
	local record = { model = model, driver = driver, passenger = passenger, spec = spec, role = role }
	cars[player] = record
	local chassis = model.PrimaryPart
	local doorToken = 0
	local function flashDoors()
		doorToken += 1
		local token = doorToken
		model:SetAttribute("DoorsOpen", true)
		task.delay(1.6, function() if token == doorToken and model.Parent then model:SetAttribute("DoorsOpen", false) end end)
	end
	driver:GetPropertyChangedSignal("Occupant"):Connect(function()
		if cars[player] ~= record or not model.Parent then return end
		flashDoors()
		local occupant = driver.Occupant
		local who = occupant and Players:GetPlayerFromCharacter(occupant.Parent)
		if occupant and (who ~= player or blocked(player) or not validRole(player, record)) then occupant.Sit = false; return end
		if who then
			pcall(function() chassis:SetNetworkOwner(who) end)
			carState(player, record, true)
		else
			local velocity = chassis:FindFirstChildOfClass("LinearVelocity")
			local upright = chassis:FindFirstChildOfClass("AlignOrientation")
			if velocity then velocity.VectorVelocity = Vector3.zero end
			if upright then local look = chassis.CFrame.LookVector; upright.CFrame = CFrame.Angles(0, math.atan2(-look.X, -look.Z), 0) end
			pcall(function() chassis:SetNetworkOwner(nil) end)
			carState(player, record, false)
		end
	end)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name, prompt.ActionText, prompt.ObjectText = "DrivePrompt", "Dirigir", spec.Name
	prompt.KeyboardKeyCode, prompt.MaxActivationDistance, prompt.RequiresLineOfSight = Enum.KeyCode.E, 9, false
	prompt.Parent = driver
	prompt.Triggered:Connect(function(who)
		if who ~= player then notice(who, "Esse veículo pertence a " .. player.DisplayName .. "."); return end
		if not nearPrompt(player, prompt) or not SecurityService.checkRate(player, "DrivePrompt", 0.5) then return end
		local _, hum = SecurityService.getLivingCharacter(player)
		if hum and not hum.SeatPart then sitInCar(player, hum) end
	end)
	if bikes[player] then dismount(player) end
	sitInCar(player, humanoid)
	carState(player, record, humanoid.SeatPart == driver)
	return true, record
end

local function exitCar(player, humanoid)
	local c = VehicleService.getCar(player)
	if not c then return end
	local seatWeld = c.driver:FindFirstChild("SeatWeld")
	if seatWeld then seatWeld:Destroy() end
	humanoid.Sit = false
	task.wait()
	local character = player.Character
	local chassis = c.model and c.model.PrimaryPart
	if character and chassis and c.model.Parent then character:PivotTo(chassis.CFrame * CFrame.new(-(c.spec.Width / 2 + 2.5), 1, 0)) end
end

function VehicleService.requestWorkVehicle(player, role)
	if type(role) ~= "string" or blocked(player) then return false end
	local entry = workplaces[role]
	local specId = GameConfig.WorkCars and GameConfig.WorkCars[role]
	local spec = specId and GameConfig.Cars[specId]
	if not entry or not spec or not WorkRoleService.hasRole(player, role) or not nearAny(player, entry.vehiclePrompts) then
		notice(player, "Retire o veículo na garagem do seu emprego, enquanto estiver em serviço.")
		return false
	end
	if not SecurityService.checkRate(player, "WorkVehiclePickup", 1) then return false end
	local _, humanoid = SecurityService.getLivingCharacter(player)
	if not humanoid then return false end
	if humanoid.SeatPart then notice(player, "Saia do veículo antes de retirar outro na garagem."); return false end
	local spot = padSpot(player, entry.vehicleSpawns, spec)
	if not spot then notice(player, "As vagas estão ocupadas. Libere uma vaga antes de retirar o veículo."); return false end
	return spawnCar(player, humanoid, spec, spot, role)
end

function VehicleService.requestPersonalAtGarage(player)
	if blocked(player) or not personalGarage or not nearPrompt(player, personalGarage.prompt) then return false end
	if not SecurityService.checkRate(player, "PersonalGarage", 1) then return false end
	local _, humanoid = SecurityService.getLivingCharacter(player)
	if not humanoid then return false end
	if humanoid.SeatPart then notice(player, "Saia do veículo antes de retirar outro na garagem."); return false end
	-- O Vortex é o único veículo pessoal já concedido no protótipo. O posto nunca
	-- entrega um táxi/viatura e não concede outros modelos ou compras.
	local spot = padSpot(player, personalGarage.spawns, PERSONAL_CAR)
	if not spot then notice(player, "A garagem está ocupada. Aguarde uma vaga livre."); return false end
	return spawnCar(player, humanoid, PERSONAL_CAR, spot, nil)
end

function VehicleService.configureWorkplaces(entries, garage)
	workplaces, personalGarage = entries or {}, garage
	for role, entry in pairs(workplaces) do
		for _, prompt in ipairs(entry.vehiclePrompts or {}) do
			if not configuredPrompts[prompt] then
				configuredPrompts[prompt] = true; prompt.Enabled = true
				prompt.Triggered:Connect(function(player) VehicleService.requestWorkVehicle(player, role) end)
			end
		end
	end
	if garage and garage.prompt and not configuredPrompts[garage.prompt] then
		configuredPrompts[garage.prompt] = true; garage.prompt.Enabled = true
		garage.prompt.Triggered:Connect(VehicleService.requestPersonalAtGarage)
	end
end

local function toggleCar(player)
	if blocked(player) then return end
	local character, humanoid, root = SecurityService.getLivingCharacter(player)
	if not character then return end
	local c = VehicleService.getCar(player)
	if c and not validRole(player, c) then destroyCar(player); c = nil end
	if c and humanoid.SeatPart == c.driver then exitCar(player, humanoid); return end
	if humanoid.SeatPart then return end
	if ZoneService.isInside(player) then notice(player, "Aqui dentro não dá para usar o carro."); return end
	local chassis = c and c.model.PrimaryPart
	if chassis and (chassis.Position - root.Position).Magnitude &lt; 18 and sitInCar(player, humanoid) then return end
	if c and c.role then
		notice(player, "Seu veículo de trabalho fica onde foi estacionado. Busque-o ou retire outro na garagem do emprego.")
		return
	end
	local spot = findCarSpot(player, root, PERSONAL_CAR)
	if not spot then notice(player, "Sem espaço para o carro aqui. Vá para a rua!"); return end
	spawnCar(player, humanoid, PERSONAL_CAR, spot, nil)
end

local function watchCarSpeed()
	while true do
		task.wait(1)
		for player, c in pairs(cars) do
			if not c.model.Parent or not validRole(player, c) then destroyCar(player)
			else
				local chassis = c.model.PrimaryPart
				local speed = chassis and chassis.AssemblyLinearVelocity.Magnitude
				if speed and (speed ~= speed or speed &gt; c.spec.MaxSpeed * 1.6) then
					local _, humanoid = SecurityService.getLivingCharacter(player)
					if humanoid and humanoid.SeatPart == c.driver then exitCar(player, humanoid) end
					if chassis.Parent then chassis.AssemblyLinearVelocity = Vector3.zero end
				end
			end
		end
	end
end

local function onVehicleRequest(player, action)
	if not SecurityService.checkRate(player, "VehicleRequest", BIKE.ToggleCooldown) or not SecurityService.isShortString(action, 16) then return end
	if blocked(player) then notice(player, "Você não pode usar veículos durante a detenção ou imobilização."); return end
	if action == "ToggleBike" then
		if bikes[player] and bikes[player].Parent then dismount(player) else mount(player) end
	elseif action == "ToggleCar" and SecurityService.checkRate(player, "Car", GameConfig.CarCooldown) then toggleCar(player) end
end

function VehicleService.dismount(player)
	if bikes[player] then dismount(player) end
end

function VehicleService.prepareForDetention(player)
	local character, humanoid = SecurityService.getLivingCharacter(player)
	local seat = humanoid and humanoid.SeatPart
	local weld = seat and seat:FindFirstChild("SeatWeld")
	if weld and weld:IsA("Weld") then
		if (weld.Part0 and weld.Part0:IsDescendantOf(character)) or (weld.Part1 and weld.Part1:IsDescendantOf(character)) then weld:Destroy() end
	end
	if humanoid then humanoid.Sit = false; humanoid.WalkSpeed = GameConfig.WalkSpeed end
	if bikes[player] then dismount(player) end
	destroyCar(player)
end

function VehicleService.init(remotes)
	uiUpdate = remotes[GameConfig.Remotes.UIUpdate]
	remotes[GameConfig.Remotes.VehicleRequest].OnServerEvent:Connect(onVehicleRequest)
	local function onPlayerAdded(player)
		local function watchCharacter(character)
			bikes[player] = nil; destroyCar(player); sendState(player, false)
			local function watchDeath(humanoid)
				if humanoid and humanoid.Died then
					humanoid.Died:Connect(function()
						if player.Character == character then bikes[player] = nil; destroyCar(player); sendState(player, false) end
					end)
				end
			end
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then watchDeath(humanoid)
			else task.spawn(function() watchDeath(character:WaitForChild("Humanoid", 10)) end) end
		end
		player.CharacterAdded:Connect(watchCharacter)
		if player.Character then watchCharacter(player.Character) end
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in ipairs(Players:GetPlayers()) do onPlayerAdded(player) end
	Players.PlayerRemoving:Connect(function(player) bikes[player] = nil; destroyCar(player) end)
	ZoneService.onChange(function(player, inside)
		if inside and bikes[player] then dismount(player); notice(player, "Bike guardada: aqui é local de trabalho.") end
	end)
	WorkRoleService.onChanged(function(player, newRole)
		local c = VehicleService.getCar(player)
		if c and c.role and c.role ~= newRole then destroyCar(player) end
	end)
	task.spawn(watchCarSpeed)
end

return VehicleService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000002B"><Properties><string name="Name">WorkRoleService</string><ProtectedString name="Source">-- Uma única profissão por jogador e uniforme retirado apenas no próprio trabalho.
-- Não há remoto que escolha uma profissão ou permita equipar roupa em qualquer lugar.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("WorkRoleConfig"))
local Rules = require(Shared:WaitForChild("WorkRoleRules"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local Security = require(script.Parent:WaitForChild("SecurityService"))

local WorkRoleService = {}
local roles, uniforms, listeners = {}, {}, {}
local watched = {}
local workplaces, uiUpdate
local initialized = false

local function notice(player, message)
	if uiUpdate and player.Parent == Players then
		uiUpdate:FireClient(player, "Notice", { text = message })
	end
end

local function notifyRole(player, newRole, oldRole)
	for _, callback in ipairs(listeners) do
		local ok, err = pcall(callback, player, newRole, oldRole)
		if not ok then warn("[WorkRoleService] Falha ao atualizar equipamento: " .. tostring(err)) end
	end
end

local function restoreUniform(player)
	local lease = uniforms[player]
	uniforms[player] = nil
	if not lease then
		player:SetAttribute("WorkUniformRole", nil)
		return
	end
	for _, connection in ipairs(lease.connections) do connection:Disconnect() end
	if lease.model then lease.model:Destroy() end
	for object, snapshot in pairs(lease.clothing) do
		if object.Parent then
			pcall(function() object[snapshot.property] = snapshot.value end)
		end
	end
	for object, transparency in pairs(lease.hats) do
		if object.Parent then pcall(function() object.Transparency = transparency end) end
	end
	player:SetAttribute("WorkUniformRole", nil)
end

function WorkRoleService.getRole(player)
	return roles[player]
end

function WorkRoleService.hasRole(player, role)
	return roles[player] ~= nil and roles[player] == role
end

function WorkRoleService.onChanged(callback)
	assert(type(callback) == "function", "Callback de emprego inválido")
	table.insert(listeners, callback)
	local active = true
	return {
		Disconnect = function()
			if not active then return end
			active = false
			local index = table.find(listeners, callback)
			if index then table.remove(listeners, index) end
		end,
	}
end

function WorkRoleService.assign(player, role)
	if not initialized or player.Parent ~= Players then return false, "unavailable" end
	local character = Security.getLivingCharacter(player)
	local accepted, reason = Rules.canAssign(roles[player], role, character ~= nil, player:GetAttribute("Detained"))
	if not accepted then return false, reason end
	if roles[player] == role then return true end
	local oldRole = roles[player]
	roles[player] = role
	player:SetAttribute("WorkRole", role)
	notifyRole(player, role, oldRole)
	return true
end

function WorkRoleService.clear(player, expectedRole)
	local oldRole = roles[player]
	if expectedRole ~= nil and oldRole ~= expectedRole then return false end
	roles[player] = nil
	restoreUniform(player)
	player:SetAttribute("WorkRole", nil)
	if oldRole ~= nil then notifyRole(player, nil, oldRole) end
	return oldRole ~= nil
end

local function promptPosition(prompt)
	local parent = prompt and prompt.Parent
	if parent and parent:IsA("BasePart") then return parent.Position end
	if parent and parent:IsA("Attachment") then return parent.WorldPosition end
	return nil
end

local function workplaceDistance(role, root)
	local site = workplaces and workplaces[role]
	local closest = math.huge
	for _, prompt in ipairs(site and site.uniformPrompts or {}) do
		local position = promptPosition(prompt)
		if Rules.finitePoint(position) then closest = math.min(closest, (root.Position - position).Magnitude) end
	end
	return closest
end

local function preserveClothing(lease, object)
	local property
	if object:IsA("Shirt") then property = "ShirtTemplate"
	elseif object:IsA("Pants") then property = "PantsTemplate"
	elseif object:IsA("ShirtGraphic") then property = "Graphic" end
	if property and not lease.clothing[object] then
		lease.clothing[object] = { property = property, value = object[property] }
		object[property] = ""
	end
	-- O boné é original do emprego. Só os chapéus/cabelos são ocultados; os
	-- acessórios continuam no personagem e voltam exatamente como estavam.
	local accessory = object:IsA("Accessory") and object or object:FindFirstAncestorOfClass("Accessory")
	if not accessory then return end
	if accessory.AccessoryType ~= Enum.AccessoryType.Hat and accessory.AccessoryType ~= Enum.AccessoryType.Hair then return end
	local handle = accessory:FindFirstChild("Handle")
	if handle and handle:IsA("BasePart") and lease.hats[handle] == nil then
		lease.hats[handle] = handle.Transparency
		handle.Transparency = 1
	end
end

local function piece(lease, limb, name, size, offset, color, shape, material)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Color = name, size, color
	p.Material = material or Enum.Material.Fabric
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = false, false, false, false, true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	if shape then p.Shape = shape end
	p.CFrame = limb.CFrame * offset
	p:SetAttribute("WorkUniform", true)
	p.Parent = lease.model
	local weld = Instance.new("WeldConstraint")
	weld.Name, weld.Part0, weld.Part1, weld.Parent = "CosturaUniforme", limb, p, p
	return p
end

local function emblem(part, value, color)
	local gui = Instance.new("SurfaceGui")
	gui.Name, gui.Face = "Identificação", Enum.NormalId.Front
	gui.LightInfluence, gui.PixelsPerStud, gui.SizingMode = 0, 100, Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.Parent = part
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency, text.Size = 1, UDim2.fromScale(1, 1)
	text.Text, text.Font, text.TextScaled, text.TextColor3 = value, Enum.Font.GothamBold, true, color
	text.Parent = gui
end

local function buildUniform(lease, character, definition)
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local lower = character:FindFirstChild("LowerTorso")
	local head = character:FindFirstChild("Head")
	if not torso or not head then error("O personagem ainda não tem tronco/cabeça.") end
	local dark = Color3.fromRGB(24, 29, 37)
	piece(lease, torso, "CamisaUniforme", torso.Size + Vector3.new(0.12, 0.05, 0.14), CFrame.new(), definition.shirt)
	if lower then piece(lease, lower, "CinturaUniforme", lower.Size + Vector3.new(0.08, 0.02, 0.1), CFrame.new(), definition.pants) end
	for _, name in ipairs({"LeftUpperArm", "RightUpperArm", "Left Arm", "Right Arm"}) do
		local limb = character:FindFirstChild(name)
		if limb then
			local r6 = name == "Left Arm" or name == "Right Arm"
			local height = limb.Size.Y * (r6 and 0.48 or 0.82)
			piece(lease, limb, "MangaUniforme", Vector3.new(limb.Size.X + 0.1, height, limb.Size.Z + 0.1),
				CFrame.new(0, (limb.Size.Y - height) / 2, 0), definition.shirt)
		end
	end
	for _, name in ipairs({"LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg", "Left Leg", "Right Leg"}) do
		local limb = character:FindFirstChild(name)
		if limb then piece(lease, limb, "CalçaUniforme", limb.Size + Vector3.new(0.08, 0.015, 0.08), CFrame.new(), definition.pants) end
	end
	for _, name in ipairs({"LeftFoot", "RightFoot"}) do
		local foot = character:FindFirstChild(name)
		if foot then piece(lease, foot, "SapatoUniforme", foot.Size + Vector3.new(0.08, 0.04, 0.08), CFrame.new(), dark, nil, Enum.Material.SmoothPlastic) end
	end
	local front = -torso.Size.Z / 2 - 0.12
	local patchColor = definition.style == "Taxi" and definition.trim or definition.shirt
	local overApron = definition.style == "Chef" or definition.style == "Apron"
	local patch = piece(lease, torso, "NomeEmprego", Vector3.new(torso.Size.X * 0.45, torso.Size.Y * 0.18, 0.06),
		CFrame.new(torso.Size.X * 0.18, torso.Size.Y * 0.15, front - (overApron and 0.1 or 0)), patchColor, nil, Enum.Material.SmoothPlastic)
	emblem(patch, definition.label, definition.style == "Taxi" and Color3.fromRGB(27, 65, 116) or Color3.fromRGB(247, 241, 215))
	piece(lease, torso, "CintoUniforme", Vector3.new(torso.Size.X + 0.14, torso.Size.Y * 0.12, torso.Size.Z + 0.17),
		CFrame.new(0, -torso.Size.Y * 0.38, 0), dark, nil, Enum.Material.SmoothPlastic)
	if definition.style == "Police" then
		local badge = piece(lease, torso, "DistintivoPolicial", Vector3.new(0.3, 0.4, 0.08),
			CFrame.new(-torso.Size.X * 0.25, torso.Size.Y * 0.2, front - 0.02), definition.trim, nil, Enum.Material.Metal)
		emblem(badge, "★", Color3.fromRGB(52, 68, 90))
		for _, side in ipairs({-1, 1}) do
			piece(lease, torso, "OmbreiraPolicial", Vector3.new(torso.Size.X * 0.28, 0.05, torso.Size.Z * 0.6),
				CFrame.new(side * torso.Size.X * 0.32, torso.Size.Y / 2 + 0.035, 0), definition.trim)
		end
	elseif definition.style == "Chef" or definition.style == "Apron" then
		piece(lease, torso, "Avental", Vector3.new(torso.Size.X * 0.7, torso.Size.Y * 0.86, 0.07),
			CFrame.new(0, -torso.Size.Y * 0.08, front - 0.04), definition.trim)
		if lower then
			piece(lease, lower, "BarraAvental", Vector3.new(lower.Size.X * 0.8, lower.Size.Y * 0.9, 0.08),
				CFrame.new(0, 0, -lower.Size.Z / 2 - 0.15), definition.trim)
		end
	elseif definition.style == "Courier" then
		for _, side in ipairs({-1, 1}) do
			piece(lease, torso, "FaixaRefletora", Vector3.new(0.13, torso.Size.Y * 0.8, 0.035),
				CFrame.new(side * torso.Size.X * 0.3, 0, front - 0.02), definition.trim)
		end
	end
	local crownHeight = definition.style == "Chef" and 0.7 or 0.38
	piece(lease, head, "ChapéuProfissional", Vector3.new(crownHeight, head.Size.X * 1.04, head.Size.Z * 1.1),
		CFrame.new(0, head.Size.Y / 2 + crownHeight / 2, 0) * CFrame.Angles(0, 0, math.pi / 2),
		definition.cap, Enum.PartType.Cylinder)
	if definition.style == "Chef" then
		for _, x in ipairs({-0.4, 0, 0.4}) do
			piece(lease, head, "TopoChapéuChef", Vector3.new(0.8, 0.55, 0.85),
				CFrame.new(x * head.Size.X / 2, head.Size.Y / 2 + 0.85, 0), definition.cap, Enum.PartType.Ball)
		end
	else
		piece(lease, head, "AbaBoné", Vector3.new(head.Size.X * 0.95, 0.09, head.Size.Z * 0.7),
			CFrame.new(0, head.Size.Y / 2 + 0.02, -head.Size.Z * 0.48), dark)
		local insignia = piece(lease, head, "InsígniaBoné", Vector3.new(head.Size.X * 0.35, 0.25, 0.06),
			CFrame.new(0, head.Size.Y / 2 + 0.19, -head.Size.Z * 0.56), definition.trim)
		emblem(insignia, definition.style == "Police" and "★" or definition.style == "Taxi" and "LXR" or "LLK", dark)
	end
end

function WorkRoleService.equipUniform(player, requestedRole)
	local role = requestedRole or roles[player]
	if not initialized or player.Parent ~= Players or not Config.Roles[role] then return false, "role" end
	local character, _, root = Security.getLivingCharacter(player)
	local stunnedUntil = player:GetAttribute("StunnedUntil")
	local stunned = Rules.finite(stunnedUntil) and stunnedUntil &gt; Workspace:GetServerTimeNow()
	local distance = root and Rules.finitePoint(root.Position) and workplaceDistance(role, root) or math.huge
	local allowed, reason = Rules.canEquip(roles[player], role, distance, character ~= nil, player:GetAttribute("Detained"), stunned)
	if not allowed then return false, reason end
	if not Security.checkRate(player, "WorkUniform", Config.UniformCooldown) then return false, "rate" end
	local existing = uniforms[player]
	if existing and existing.character == character and existing.role == role then return true end
	restoreUniform(player)
	local model = Instance.new("Model")
	model.Name = "UniformeDeTrabalho"
	model:SetAttribute("WorkUniform", true)
	model:SetAttribute("Role", role)
	local lease = { character = character, role = role, model = model, clothing = {}, hats = {}, connections = {} }
	uniforms[player] = lease
	local ok, err = pcall(function()
		for _, object in ipairs(character:GetDescendants()) do preserveClothing(lease, object) end
		buildUniform(lease, character, Config.Roles[role])
		model.Parent = character
		table.insert(lease.connections, character.DescendantAdded:Connect(function(object)
			if uniforms[player] == lease then preserveClothing(lease, object) end
		end))
	end)
	if not ok then
		restoreUniform(player)
		warn("[WorkRoleService] Não foi possível vestir uniforme: " .. tostring(err))
		return false, "avatar"
	end
	player:SetAttribute("WorkUniformRole", role)
	notice(player, "Uniforme de " .. Config.Roles[role].name .. " retirado. Ele será devolvido ao sair do emprego.")
	return true
end

local function watchPlayer(player)
	if watched[player] then return end
	watched[player] = true
	local function onCharacter(character)
		restoreUniform(player)
		local function watchHumanoid(humanoid)
			if humanoid and humanoid:IsA("Humanoid") then
				humanoid.Died:Connect(function()
					if uniforms[player] and uniforms[player].character == character then restoreUniform(player) end
				end)
			end
		end
		watchHumanoid(character:FindFirstChildOfClass("Humanoid"))
		character.ChildAdded:Connect(function(object)
			if object:IsA("Humanoid") then watchHumanoid(object) end
		end)
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then onCharacter(player.Character) end
	player:GetAttributeChangedSignal("Detained"):Connect(function()
		if player:GetAttribute("Detained") then WorkRoleService.clear(player) end
	end)
end

function WorkRoleService.init(remotes, registeredWorkplaces)
	if initialized then return end
	workplaces = registeredWorkplaces or {}
	uiUpdate = remotes and remotes[GameConfig.Remotes.UIUpdate]
	initialized = true
	for role, site in pairs(workplaces) do
		if Config.Roles[role] then
			for _, prompt in ipairs(site.uniformPrompts or {}) do
				prompt.Enabled = true
				prompt.ActionText, prompt.ObjectText = "Retirar uniforme", Config.Roles[role].name
				prompt:SetAttribute("WorkRole", role)
				prompt.Triggered:Connect(function(player)
					local ok, reason = WorkRoleService.equipUniform(player, role)
					if not ok and reason ~= "rate" then
						notice(player, reason == "role" and "Você precisa estar empregado nesta profissão para retirar o uniforme."
							or "Retire o uniforme perto do armário do seu trabalho, com o personagem disponível.")
					end
				end)
			end
		end
	end
	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in ipairs(Players:GetPlayers()) do watchPlayer(player) end
	Players.PlayerRemoving:Connect(function(player)
		WorkRoleService.clear(player)
		watched[player] = nil
	end)
end

return WorkRoleService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000002C"><Properties><string name="Name">WorkplaceBuilder</string><ProtectedString name="Source">-- Vestiários das profissões já existentes. O servidor valida cargo e proximidade.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

local WorkplaceBuilder = {}

function WorkplaceBuilder.build(workplaces)
	local locations = Workspace:WaitForChild("Map"):WaitForChild("JobLocations")
	for _, definition in ipairs({
		{ role = "Pizzaiolo", place = GameConfig.Places.Pizzaria, color = Color3.fromRGB(185, 59, 49) },
		{ role = "Atendente", place = GameConfig.Places.Mercearia, color = Color3.fromRGB(45, 135, 75) },
		{ role = "Entregador", place = GameConfig.Places.Entregas, color = Color3.fromRGB(225, 136, 43) },
	}) do
		local shop
		for _, candidate in ipairs(locations:GetChildren()) do
			if candidate:GetAttribute("PlaceName") == definition.place then shop = candidate; break end
		end
		assert(shop, "Local de trabalho ausente: " .. definition.place)
		local locker = shop:FindFirstChild("VestiarioProfissional")
		if not locker then
			locker = Instance.new("Part")
			locker.Name = "VestiarioProfissional"
			locker.Size = Vector3.new(0.45, 5, 3)
			locker.CFrame = shop:GetAttribute("BaseCFrame") * CFrame.new(20.4, 3.5, -12)
			locker.Anchored, locker.CanCollide, locker.CanTouch = true, false, false
			locker.Material, locker.Color = Enum.Material.Metal, definition.color
			locker:SetAttribute("WorkRole", definition.role)
			locker.Parent = shop
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "UniformeProfissional"
			prompt.ActionText = "Retirar uniforme"
			prompt.ObjectText = "Vestiário • " .. definition.role
			prompt.MaxActivationDistance, prompt.HoldDuration = 9, 0.5
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt.RequiresLineOfSight = false
			prompt.Parent = locker
		end
		local entry = workplaces[definition.role] or { vehiclePrompts = {}, vehicleSpawns = {} }
		entry.uniformPrompts = { assert(locker:FindFirstChildOfClass("ProximityPrompt")) }
		workplaces[definition.role] = entry
	end
	return workplaces
end

return WorkplaceBuilder
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000002D"><Properties><string name="Name">ZoneService</string><ProtectedString name="Source">-- ZoneService (ModuleScript)
-- Caminho: ServerScriptService &gt; Services &gt; ZoneService
-- Zonas de trabalho = interior das lojas (La Paulistana, Minas Market, Sherlex, Duto Pet Shop).
-- Dentro delas:
--   * não dá para usar bicicleta nem carro (o VehicleService desce o jogador da bike ao entrar);
--   * o jogador fica protegido: escudo invisível (ForceField) contra qualquer dano futuro
--     e não esbarra/empurra outros jogadores.
-- Também cria os grupos de colisão usados pelo jogo (jogadores, NPCs e veículos).

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local Workspace = game:GetService("Workspace")

local SecurityService = require(script.Parent:WaitForChild("SecurityService"))

local ZoneService = {}

local zones = {} -- { name, cf, half }
local insideOf = {} -- insideOf[player] = nome da zona (ou nil)
local listeners = {}

local GROUP_PLAYERS = "Jogadores"
local GROUP_SAFE = "ZonaSegura"
local GROUP_NPCS = "NPCs"
local GROUP_VEHICLES = "Veiculos"

local function setupGroups()
	for _, name in ipairs({ GROUP_PLAYERS, GROUP_SAFE, GROUP_NPCS, GROUP_VEHICLES }) do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(name)
		end)
	end
	local function off(a, b)
		PhysicsService:CollisionGroupSetCollidable(a, b, false)
	end
	off(GROUP_SAFE, GROUP_SAFE) -- dentro do trabalho ninguém empurra ninguém
	off(GROUP_SAFE, GROUP_PLAYERS)
	off(GROUP_NPCS, GROUP_PLAYERS) -- clientes NPC não ficam presos nos jogadores
	off(GROUP_NPCS, GROUP_SAFE)
	off(GROUP_NPCS, GROUP_NPCS)
	off(GROUP_VEHICLES, GROUP_PLAYERS) -- carro não atropela nem arremessa jogadores
	off(GROUP_VEHICLES, GROUP_SAFE)
	off(GROUP_VEHICLES, GROUP_NPCS)
end

local function setGroup(character, group)
	for _, p in ipairs(character:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CollisionGroup = group
		end
	end
end

-- Nome da zona onde está a posição (nil = fora)
function ZoneService.zoneAt(position)
	for _, z in ipairs(zones) do
		local p = z.cf:PointToObjectSpace(position)
		if math.abs(p.X) &lt;= z.half.X and math.abs(p.Z) &lt;= z.half.Z and p.Y &gt; -4 and p.Y &lt; z.half.Y * 2 + 4 then
			return z.name
		end
	end
	return nil
end

function ZoneService.isInside(player)
	return insideOf[player] ~= nil
end

-- fn(player, inside, zoneName) é chamada quando alguém entra ou sai de uma zona
function ZoneService.onChange(fn)
	table.insert(listeners, fn)
end

local function apply(player, zone)
	local character = player.Character
	if not character then
		return
	end
	setGroup(character, zone and GROUP_SAFE or GROUP_PLAYERS)
	local shield = character:FindFirstChild("ProtecaoTrabalho")
	if zone and not shield then
		shield = Instance.new("ForceField")
		shield.Name = "ProtecaoTrabalho"
		shield.Visible = false
		shield.Parent = character
	elseif not zone and shield then
		shield:Destroy()
	end
end

local function update(player)
	local _, _, root = SecurityService.getLivingCharacter(player)
	local zone = root and ZoneService.zoneAt(root.Position) or nil
	if zone == insideOf[player] then
		return
	end
	insideOf[player] = zone
	player:SetAttribute("InWorkZone", zone)
	apply(player, zone)
	for _, fn in ipairs(listeners) do
		task.spawn(fn, player, zone ~= nil, zone)
	end
end

function ZoneService.init()
	setupGroups()
	local shops = Workspace:WaitForChild("Map"):WaitForChild("JobLocations")
	for _, shop in ipairs(shops:GetChildren()) do
		local cf = shop:GetAttribute("BaseCFrame")
		local size = shop:GetAttribute("InteriorSize")
		if cf and size then
			table.insert(zones, { name = shop:GetAttribute("PlaceName") or shop.Name, cf = cf, half = size / 2 + Vector3.new(0.5, 0, 0.5) })
		end
	end

	local function onPlayer(player)
		player.CharacterAdded:Connect(function(character)
			insideOf[player] = nil
			player:SetAttribute("InWorkZone", nil)
			setGroup(character, GROUP_PLAYERS)
			-- peças que chegam depois (acessórios, bike, itens) entram no grupo certo
			character.DescendantAdded:Connect(function(d)
				if d:IsA("BasePart") then
					d.CollisionGroup = insideOf[player] and GROUP_SAFE or GROUP_PLAYERS
				end
			end)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		insideOf[player] = nil
	end)

	task.spawn(function()
		while true do
			for _, player in ipairs(Players:GetPlayers()) do
				update(player)
			end
			task.wait(0.25)
		end
	end)
end

ZoneService.Groups = { Players = GROUP_PLAYERS, Safe = GROUP_SAFE, NPCs = GROUP_NPCS, Vehicles = GROUP_VEHICLES }

return ZoneService
</ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000000000000000000000000000002E"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000000000000000000000000000002F"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000000000000000000000000000030"><Properties><string name="Name">ClientBootstrap</string><ProtectedString name="Source">-- ClientBootstrap (LocalScript)
-- Caminho: StarterPlayer &gt; StarterPlayerScripts &gt; ClientBootstrap
-- Interface básica:
--   * mensagem de boas-vindas
--   * botão grande da bicicleta (toque no celular, clique ou tecla B no PC)
--   * botão do carro (tecla V): chama o carro, entra e sai (CarController dirige)
--   * animação da bicicleta (BikeAnimator)
--   * tutorial e conversa com o Seu Bento, empregos (Controllers)
-- O cliente só PEDE para montar; quem decide é o servidor.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local vehicleRequest = remotes:WaitForChild(GameConfig.Remotes.VehicleRequest)
local uiUpdate = remotes:WaitForChild(GameConfig.Remotes.UIUpdate)
local tutorialRequest = remotes:WaitForChild(GameConfig.Remotes.TutorialRequest)

local Controllers = script.Parent:WaitForChild("Controllers")
local TutorialController = require(Controllers:WaitForChild("TutorialController"))
local HudController = require(Controllers:WaitForChild("HudController"))
local BikeAnimator = require(Controllers:WaitForChild("BikeAnimator"))
local JobController = require(Controllers:WaitForChild("JobController"))
local CarController = require(Controllers:WaitForChild("CarController"))
local UIScaler = require(Controllers:WaitForChild("UIScaler"))
local PrisonController = require(Controllers:WaitForChild("PrisonController"))
local PoliceController = require(Controllers:WaitForChild("PoliceController"))
local TaxiController = require(Controllers:WaitForChild("TaxiController"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local BLUE = Color3.fromRGB(20, 45, 90)
local GREEN = Color3.fromRGB(60, 170, 80)

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

-- Tela principal
local gui = Instance.new("ScreenGui")
gui.Name = "GameUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.Parent = playerGui

-- Botão da bicicleta (canto inferior direito, grande para o polegar)
local bikeButton = Instance.new("TextButton")
bikeButton.Name = "BikeButton"
bikeButton.AnchorPoint = Vector2.new(1, 1)
bikeButton.Size = UDim2.fromOffset(150, 64)
bikeButton.Position = UDim2.new(1, -16, 1, -150) -- acima do botão de pulo no celular
bikeButton.BackgroundColor3 = GREEN
bikeButton.Font = Enum.Font.GothamBold
bikeButton.TextScaled = true
bikeButton.TextColor3 = Color3.new(1, 1, 1)
bikeButton.AutoButtonColor = true
bikeButton.Parent = gui
corner(bikeButton, 14)
UIScaler.attach(bikeButton)

local pad = Instance.new("UIPadding")
pad.PaddingLeft = UDim.new(0, 10)
pad.PaddingRight = UDim.new(0, 10)
pad.PaddingTop = UDim.new(0, 8)
pad.PaddingBottom = UDim.new(0, 8)
pad.Parent = bikeButton

local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local function setBikeText(mounted)
	local suffix = touch and "" or " [B]"
	if mounted then
		bikeButton.Text = "Descer da bike" .. suffix
		bikeButton.BackgroundColor3 = Color3.fromRGB(200, 90, 60)
	else
		bikeButton.Text = "Bicicleta" .. suffix
		bikeButton.BackgroundColor3 = GREEN
	end
end
setBikeText(false)

local function requestBike()
	vehicleRequest:FireServer("ToggleBike")
end

bikeButton.Activated:Connect(requestBike)

-- Botão do carro, logo acima do da bike
local carButton = bikeButton:Clone()
carButton.Name = "CarButton"
carButton.Position = UDim2.new(1, -16, 1, -222)
local copiedScale = carButton:FindFirstChildOfClass("UIScale")
if copiedScale then
	copiedScale:Destroy() -- a cópia ganha a sua própria escala logo abaixo
end
carButton.Parent = gui
UIScaler.attach(carButton)

local function setCarText(driving, workRole)
	local suffix = touch and "" or " [V]"
	local name = workRole == "Taxista" and "Táxi LXR" or workRole == "Policial" and "Viatura" or "Carro"
	if driving then
		carButton.Text = (workRole == "Taxista" and "Sair do táxi" or workRole == "Policial" and "Sair da viatura" or "Sair do carro") .. suffix
		carButton.BackgroundColor3 = Color3.fromRGB(200, 90, 60)
	else
		carButton.Text = name .. suffix
		carButton.BackgroundColor3 = Color3.fromRGB(40, 90, 170)
	end
end
setCarText(false)

local function requestCar()
	vehicleRequest:FireServer("ToggleCar")
end
carButton.Activated:Connect(requestCar)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return -- o jogador está digitando no chat, por exemplo
	end
	if input.KeyCode == Enum.KeyCode.B then
		requestBike()
	elseif input.KeyCode == Enum.KeyCode.V then
		requestCar()
	end
end)

HudController.init()
BikeAnimator.init()
JobController.init()
CarController.init()
PrisonController.init()
PoliceController.init()
TaxiController.init()

-- Respostas do servidor
uiUpdate.OnClientEvent:Connect(function(kind, data)
	if type(data) ~= "table" then
		return
	end
	if kind == "BikeState" then
		setBikeText(data.mounted == true)
	elseif kind == "CarState" then
		setCarText(data.driving == true, data.workRole)
	elseif kind == "Notice" then
		HudController.toast(tostring(data.text or ""), Color3.fromRGB(200, 90, 60))
	elseif kind == "StartTutorial" then
		task.spawn(TutorialController.run, true)
	elseif kind == "GuideDialog" then
		task.spawn(TutorialController.run, false)
	elseif kind == "PrisonState" then
		PrisonController.handle(data)
	elseif kind == "PoliceState" or kind == "PolicePanel" or kind == "PoliceReports" then
		PoliceController.handle(kind, data)
	elseif kind == "TaxiState" or kind == "TaxiPanel" then
		TaxiController.handle(kind, data)
	elseif kind:sub(1, 3) == "Job" then
		JobController.handle(kind, data)
	end
end)

-- Mensagem de boas-vindas que some sozinha
local welcome = Instance.new("TextLabel")
welcome.Name = "Welcome"
welcome.AnchorPoint = Vector2.new(0.5, 0)
welcome.Size = UDim2.new(0.8, 0, 0, 70)
welcome.Position = UDim2.new(0.5, 0, 0, 90)
welcome.BackgroundColor3 = BLUE
welcome.BackgroundTransparency = 0.1
welcome.Font = Enum.Font.GothamBold
welcome.TextScaled = true
welcome.TextColor3 = Color3.new(1, 1, 1)
welcome.Text = "Bem-vindo a " .. GameConfig.CityName .. "! Pegue sua bicicleta e explore o bairro."
welcome.Parent = gui
corner(welcome, 14)
UIScaler.attach(welcome)

local sizeLimit = Instance.new("UISizeConstraint")
sizeLimit.MaxSize = Vector2.new(640, 70)
sizeLimit.Parent = welcome

-- Avisa o servidor que a interface está pronta (ele decide se mostra o tutorial)
task.spawn(function()
	if not player.Character then
		player.CharacterAdded:Wait()
	end
	task.wait(1)
	tutorialRequest:FireServer("Ready")
end)

task.delay(6, function()
	local fade = TweenInfo.new(1)
	TweenService:Create(welcome, fade, { BackgroundTransparency = 1, TextTransparency = 1 }):Play()
	task.wait(1.1)
	welcome:Destroy()
end)
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000000000000000000000000000031"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000032"><Properties><string name="Name">BikeAnimator</string><ProtectedString name="Source">-- BikeAnimator (ModuleScript)
-- Caminho: StarterPlayer &gt; StarterPlayerScripts &gt; Controllers &gt; BikeAnimator
-- Anima TODAS as bicicletas que este jogador vê (a dele e a dos outros) e
-- a pose de segurar objetos dos empregos:
--   * rodas e pedivela giram de acordo com a velocidade;
--   * pernas seguem os pedais e mãos ficam no guidão (cinemática inversa simples).
-- Tudo é só visual e roda em cada cliente; o servidor não participa.
-- Funciona mexendo em Motor6D.Transform logo depois das animações do Roblox
-- (RunService.Stepped), então sobrepõe a animação de andar nas pernas e braços.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local RigMeasure = require(Shared:WaitForChild("RigMeasure"))

local BikeAnimator = {}

local PEDAL_SPEED = GameConfig.Bike.PedalSpeed
local riders = {} -- riders[character] = estado da animação

-- Gira uma junta para frente (+) ou para trás (-) no plano lateral do corpo.
-- R15: juntas alinhadas ao corpo, gira no eixo X.
-- R6: as juntas são viradas 90°, então gira no eixo Z (sinal invertido na esquerda).
local function swing(rig, joint, side, angle)
	if rig.rigType == "R15" then
		joint.Transform = CFrame.Angles(angle, 0, 0)
	else
		joint.Transform = CFrame.Angles(0, 0, side == "Right" and angle or -angle)
	end
end

-- Dois ossos (coxa+canela ou braço+antebraço) alcançando um alvo no plano Y/Z.
-- Retorna o ângulo do primeiro osso (0 = para baixo, + = para frente) e a dobra do segundo.
local function solve(l1, l2, pivot, target, bendForward)
	local dy, dz = target.Y - pivot.Y, target.Z - pivot.Z
	local base = math.atan2(-dz, -dy)
	if l2 &lt;= 0 then
		return base, 0
	end
	local d = math.clamp(math.sqrt(dy * dy + dz * dz), math.abs(l1 - l2) + 0.05, l1 + l2 - 0.01)
	local a1 = math.acos(math.clamp((l1 * l1 + d * d - l2 * l2) / (2 * l1 * d), -1, 1))
	local inner = math.acos(math.clamp((l1 * l1 + l2 * l2 - d * d) / (2 * l1 * l2), -1, 1))
	local bend = math.pi - inner
	if bendForward then
		return base + a1, -bend -- joelho vai para frente, canela volta
	end
	return base - a1, bend -- cotovelo fica para baixo, antebraço sobe
end

local function startRider(character, bike)
	local rig = RigMeasure.measure(character)
	local crankHub = bike:FindFirstChild("Crank")
	local front = bike:FindFirstChild("FrontWheel")
	local rear = bike:FindFirstChild("RearWheel")
	-- Juntas do tronco/cabeça que ficam paradas enquanto pedala
	local still = {}
	local function add(part, name)
		local p = character:FindFirstChild(part)
		local j = p and p:FindFirstChild(name)
		if j and j:IsA("Motor6D") then
			table.insert(still, j)
		end
	end
	add("LowerTorso", "Root")
	add("UpperTorso", "Waist")
	add("Head", "Neck")
	add("HumanoidRootPart", "RootJoint") -- R6
	add("Torso", "Neck") -- R6
	riders[character] = {
		bike = bike,
		still = still,
		rig = rig,
		crankMotor = crankHub and crankHub:FindFirstChild("CrankMotor"),
		frontMotor = front and front:FindFirstChild("FrontWheelMotor"),
		rearMotor = rear and rear:FindFirstChild("RearWheelMotor"),
		gripLeft = bike:FindFirstChild("GripLeft"),
		gripRight = bike:FindFirstChild("GripRight"),
		wheelAngle = 0,
		crankAngle = 0,
	}
end

local function stopRider(character)
	local state = riders[character]
	riders[character] = nil
	-- Juntas que a animação de andar não controla (tornozelo, punho) voltam ao normal
	if state and state.rig and state.rig.rigType == "R15" then
		for _, name in ipairs({ "LeftAnkle", "RightAnkle", "LeftWrist", "RightWrist" }) do
			local joint = state.rig.joints[name]
			if joint then
				joint.Transform = CFrame.new()
			end
		end
	end
end

local function animate(character, state, dt)
	local rig = state.rig
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not state.bike.Parent then
		return
	end

	-- Rodas e pedais giram conforme a velocidade no chão
	local v = root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	local wheelRadius = state.bike:GetAttribute("WheelRadius") or 0.85
	local spin = speed / wheelRadius * dt
	state.wheelAngle = (state.wheelAngle - spin) % (2 * math.pi)
	state.crankAngle = (state.crankAngle - spin * PEDAL_SPEED) % (2 * math.pi)
	local wheelCf = CFrame.Angles(state.wheelAngle, 0, 0)
	if state.frontMotor then
		state.frontMotor.Transform = wheelCf
	end
	if state.rearMotor then
		state.rearMotor.Transform = wheelCf
	end
	if state.crankMotor then
		state.crankMotor.Transform = CFrame.Angles(state.crankAngle, 0, 0)
	end

	if not rig or not state.crankMotor then
		return
	end

	-- Tronco e cabeça parados: a animação de andar balança o tronco, o que levava
	-- os ombros (e as mãos) junto. Com o tronco fixo, as mãos ficam no guidão.
	for _, joint in ipairs(state.still) do
		joint.Transform = CFrame.new()
	end

	-- Pernas: cada pé vai até o seu pedal
	local bb = state.crankMotor.C0.Position
	local crankR = state.bike:GetAttribute("CrankRadius") or 0.45
	for _, side in ipairs({ "Right", "Left" }) do
		local a = state.crankAngle + (side == "Left" and math.pi or 0)
		local pedal = Vector3.new(0, bb.Y - crankR * math.cos(a), bb.Z - crankR * math.sin(a))
		local thigh, knee = solve(rig.legL1, rig.legL2, rig.hip[side], pedal, true)
		swing(rig, rig.joints[side .. "Hip"], side, thigh)
		if rig.rigType == "R15" then
			rig.joints[side .. "Knee"].Transform = CFrame.Angles(knee, 0, 0)
			rig.joints[side .. "Ankle"].Transform = CFrame.Angles(-(thigh + knee), 0, 0) -- pé reto
		end
	end

	-- Braços: mãos nas manoplas
	for _, side in ipairs({ "Right", "Left" }) do
		local grip = side == "Left" and state.gripLeft or state.gripRight
		if grip then
			local target = root.CFrame:PointToObjectSpace(grip.Position)
			local upper, elbow = solve(rig.armL1, rig.armL2, rig.shoulder[side], target, false)
			swing(rig, rig.joints[side .. "Shoulder"], side, upper)
			if rig.rigType == "R15" then
				rig.joints[side .. "Elbow"].Transform = CFrame.Angles(elbow, 0, 0)
				rig.joints[side .. "Wrist"].Transform = CFrame.new() -- mão alinhada ao antebraço, firme na manopla
			end
		end
	end
end

-- Segurar objeto (emprego): as duas mãos vão até o objeto na frente do corpo.
-- Só a pé; na bike as mãos ficam no guidão.
local carriers = setmetatable({}, { __mode = "k" }) -- carriers[character] = medida do boneco

local function holdItem(character, item)
	local rig = carriers[character]
	if not rig then
		rig = RigMeasure.measure(character)
		if not rig then
			return
		end
		carriers[character] = rig
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local target = root.CFrame:PointToObjectSpace(item.Position)
	for _, side in ipairs({ "Right", "Left" }) do
		local upper, elbow = solve(rig.armL1, rig.armL2, rig.shoulder[side], target, false)
		swing(rig, rig.joints[side .. "Shoulder"], side, upper)
		if rig.rigType == "R15" then
			rig.joints[side .. "Elbow"].Transform = CFrame.Angles(elbow, 0, 0)
			rig.joints[side .. "Wrist"].Transform = CFrame.new()
		end
	end
end

local function releaseItem(character)
	local rig = carriers[character]
	carriers[character] = nil
	if rig and rig.rigType == "R15" then
		for _, name in ipairs({ "LeftWrist", "RightWrist" }) do
			rig.joints[name].Transform = CFrame.new()
		end
	end
end

local function onStepped(_, dt)
	-- Procura bicicletas novas e remove as que sumiram
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local bike = character and character:FindFirstChild("StarterBike")
		local state = character and riders[character]
		-- (também refaz se as peças ainda não tinham chegado do servidor)
		if bike and (not state or state.bike ~= bike or not state.crankMotor) then
			startRider(character, bike)
		elseif not bike and state then
			stopRider(character)
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local item = character and character:FindFirstChild("CarriedItem")
		if item and item:IsA("BasePart") and not riders[character] then
			holdItem(character, item)
		elseif character and carriers[character] then
			releaseItem(character)
		end
	end
	for character, state in pairs(riders) do
		if not character.Parent or not state.bike.Parent then
			stopRider(character)
		else
			animate(character, state, dt)
		end
	end
end

function BikeAnimator.init()
	RunService.Stepped:Connect(onStepped)
end

return BikeAnimator
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000033"><Properties><string name="Name">CarController</string><ProtectedString name="Source">-- CarController (ModuleScript)
-- Caminho: StarterPlayer &gt; StarterPlayerScripts &gt; Controllers &gt; CarController
-- Direção do carro, no cliente de quem dirige (o servidor passa a física do carro para o motorista).
-- Lê o controle do VehicleSeat (WASD/setas no PC, analógico no celular, gatilhos no controle)
-- e move o chassi: acelera, freia, dá ré, faz curva e acompanha a altura do chão.
-- Também gira as rodas (e esterça as da frente) e abre as portas de todos os carros que este jogador vê.
-- Valores do carro (velocidade, aceleração...) vêm de GameConfig.Cars.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

local CarController = {}

local player = Players.LocalPlayer
local drive = nil -- estado de quem dirige: { car, chassis, lv, ao, spec, speed, yaw }
local spin = {} -- spin[car] = ângulo das rodas
local doorOpen = {} -- doorOpen[car] = 0 (fechada) a 1 (aberta)
local steerAngle = 0

local function specOf(car)
	for _, spec in pairs(GameConfig.Cars) do
		if spec.Name == car:GetAttribute("Spec") then
			return spec
		end
	end
	return GameConfig.Cars[GameConfig.CarModel]
end

local function yawOf(cf)
	local look = cf.LookVector
	return math.atan2(-look.X, -look.Z)
end

local function currentSeat()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	if seat and seat:IsA("VehicleSeat") and seat:GetAttribute("CarSeat") then
		return seat
	end
	return nil
end

local function approach(value, target, step)
	if value &lt; target then
		return math.min(value + step, target)
	end
	return math.max(value - step, target)
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundY(chassis, car)
	local ignore = { car }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	local npcs = Workspace:FindFirstChild("NPCs")
	if npcs then
		table.insert(ignore, npcs)
	end
	rayParams.FilterDescendantsInstances = ignore
	local hit = Workspace:Raycast(chassis.Position + Vector3.new(0, 4, 0), Vector3.new(0, -30, 0), rayParams)
	return hit and hit.Position.Y
end

local function stepDrive(dt)
	local seat = currentSeat()
	if not seat then
		drive = nil
		return
	end
	local car = seat.Parent
	local chassis = car and car:FindFirstChild("Chassis")
	if not chassis then
		return
	end
	if not drive or drive.car ~= car then
		local spec = specOf(car)
		drive = {
			car = car,
			chassis = chassis,
			lv = chassis:FindFirstChildOfClass("LinearVelocity"),
			ao = chassis:FindFirstChildOfClass("AlignOrientation"),
			spec = spec,
			speed = 0,
			yaw = yawOf(chassis.CFrame),
		}
	end
	local d, spec = drive, drive.spec
	if not d.lv or not d.ao then
		return
	end
	local throttle = seat.ThrottleFloat
	local steer = seat.SteerFloat

	-- Velocidade: acelera, freia (tecla para trás andando para frente), dá ré e perde velocidade solto
	if throttle &gt; 0.05 then
		if d.speed &lt; 0 then
			d.speed = approach(d.speed, 0, spec.Brake * dt)
		else
			d.speed = approach(d.speed, spec.MaxSpeed * throttle, spec.Acceleration * dt)
		end
	elseif throttle &lt; -0.05 then
		if d.speed &gt; 0 then
			d.speed = approach(d.speed, 0, spec.Brake * dt)
		else
			d.speed = approach(d.speed, -spec.ReverseSpeed * -throttle, spec.Acceleration * 0.6 * dt)
		end
	else
		d.speed = approach(d.speed, 0, spec.Drag * dt)
	end

	-- Bateu em algo: a velocidade cai para a velocidade real
	local forward = CFrame.Angles(0, d.yaw, 0).LookVector
	local real = chassis.AssemblyLinearVelocity:Dot(forward)
	if math.abs(d.speed - real) &gt; 12 then
		d.speed = d.speed + (real - d.speed) * math.min(1, dt * 4)
	end

	-- Curva: só vira andando; em ré o volante inverte, como num carro de verdade
	local grip = math.clamp(math.abs(d.speed) / 18, 0, 1)
	local direction = d.speed &gt;= 0 and 1 or -1
	-- em alta velocidade vira um pouco menos (mais estável)
	local turn = spec.TurnRate * (1 - 0.35 * math.clamp(math.abs(d.speed) / spec.MaxSpeed, 0, 1))
	d.yaw -= steer * turn * grip * direction * dt
	steerAngle = steer

	-- Altura: flutua na altura certa acima do chão (calçada e meio-fio não travam)
	local vy = -25
	local gy = groundY(chassis, car)
	if gy then
		vy = math.clamp((gy + spec.Hover - chassis.Position.Y) * 10, -40, 40)
	end
	forward = CFrame.Angles(0, d.yaw, 0).LookVector
	d.lv.VectorVelocity = forward * d.speed + Vector3.new(0, vy, 0)
	d.ao.CFrame = CFrame.Angles(0, d.yaw, 0)
end

-- Rodas girando de todos os carros visíveis (só visual)
local function stepWheels(dt)
	local folder = Workspace:FindFirstChild("Vehicles")
	if not folder then
		return
	end
	for _, car in ipairs(folder:GetChildren()) do
		local chassis = car:FindFirstChild("Chassis")
		if chassis then
			local spec = specOf(car)
			local speed = chassis.AssemblyLinearVelocity:Dot(chassis.CFrame.LookVector)
			-- rodando para frente, o topo da roda vai para a frente (-Z): ângulo negativo em X
			spin[car] = ((spin[car] or 0) - speed * dt / spec.WheelRadius) % (math.pi * 2)
			-- portas abrem para cima e um pouco para fora
			local target = car:GetAttribute("DoorsOpen") and 1 or 0
			doorOpen[car] = (doorOpen[car] or 0) + (target - (doorOpen[car] or 0)) * math.min(1, dt * 6)
			for _, doorName in ipairs({ "DoorLeft", "DoorRight", "RearDoorLeft", "RearDoorRight" }) do
				local door = car:FindFirstChild(doorName)
				local motor = door and door:FindFirstChild("DoorMotor")
				if motor then
					local side = motor:GetAttribute("Side") or 1
					local k = doorOpen[car]
					if car:GetAttribute("DoorStyle") == "Sedan" then
						motor.Transform = CFrame.Angles(0, side * math.rad(65) * k, 0)
					else
						motor.Transform = CFrame.Angles(-math.rad(70) * k, 0, -side * math.rad(18) * k)
					end
				end
			end
			-- Giroflex visual original, sem depender de áudio ou assets externos.
			for _, name in ipairs({ "PoliceRed", "PoliceBlue" }) do
				local light = car:FindFirstChild(name)
				if light then
					local on = math.floor(Workspace:GetServerTimeNow() * 5) % 2 == (name == "PoliceRed" and 0 or 1)
					light.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
					local glow = light:FindFirstChild("Flasher")
					if glow then glow.Enabled = on end
				end
			end
			local mine = drive and drive.car == car
			for _, name in ipairs({ "FrontLeft", "FrontRight", "RearLeft", "RearRight" }) do
				local hub = car:FindFirstChild(name)
				local motor = hub and hub:FindFirstChild("WheelMotor")
				if motor then
					local steerY = (mine and name:sub(1, 5) == "Front") and -steerAngle * math.rad(25) or 0
					motor.Transform = CFrame.Angles(0, steerY, 0) * CFrame.Angles(spin[car], 0, 0)
				end
			end
		end
	end
	for car in pairs(spin) do
		if not car.Parent then
			spin[car] = nil
			doorOpen[car] = nil
		end
	end
end

function CarController.init()
	RunService.Heartbeat:Connect(stepDrive)
	RunService.Stepped:Connect(function(_, dt)
		stepWheels(dt)
	end)
end

return CarController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000034"><Properties><string name="Name">DialogController</string><ProtectedString name="Source">-- DialogController (ModuleScript)
-- Caminho: StarterPlayer &gt; StarterPlayerScripts &gt; Controllers &gt; DialogController
-- Caixa de diálogo na parte de baixo da tela, com botões grandes (bons para celular).
--
-- Uso:
--   local escolha = DialogController.show("Seu Bento", {"fala 1", "fala 2"},
--       { {id = "sim", text = "Sim"}, {id = "nao", text = "Não"} }, true)
-- A função espera o jogador e devolve o id do botão escolhido,
-- ou "skip" se ele apertou "Pular" (quando allowSkip = true).

local Players = game:GetService("Players")

local UIScaler = require(script.Parent:WaitForChild("UIScaler"))

local DialogController = {}

local BLUE = Color3.fromRGB(20, 45, 90)
local GREEN = Color3.fromRGB(60, 170, 80)

local player = Players.LocalPlayer
local gui, panel, nameLabel, textLabel, buttonRow, skipButton
local activeEvent -- BindableEvent do diálogo aberto (nil se nenhum)

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function build()
	gui = Instance.new("ScreenGui")
	gui.Name = "DialogUI"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 10
	gui.Parent = player:WaitForChild("PlayerGui")

	panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 1)
	panel.Position = UDim2.new(0.5, 0, 1, -20)
	panel.Size = UDim2.new(0.92, 0, 0, 190)
	panel.BackgroundColor3 = BLUE
	panel.BackgroundTransparency = 0.05
	panel.Visible = false
	panel.Parent = gui
	corner(panel, 16)

	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(760, 190)
	limit.Parent = panel
	UIScaler.attach(panel)

	nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, -24, 0, 30)
	nameLabel.Position = UDim2.fromOffset(12, 8)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBlack
	nameLabel.TextSize = 22
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextColor3 = Color3.fromRGB(255, 210, 90)
	nameLabel.Parent = panel

	textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, -24, 0, 80)
	textLabel.Position = UDim2.fromOffset(12, 40)
	textLabel.BackgroundTransparency = 1
	textLabel.Font = Enum.Font.Gotham
	textLabel.TextSize = 20
	textLabel.TextWrapped = true
	textLabel.TextXAlignment = Enum.TextXAlignment.Left
	textLabel.TextYAlignment = Enum.TextYAlignment.Top
	textLabel.TextColor3 = Color3.new(1, 1, 1)
	textLabel.Parent = panel

	buttonRow = Instance.new("Frame")
	buttonRow.Size = UDim2.new(1, -24, 0, 50)
	buttonRow.Position = UDim2.new(0, 12, 1, -60)
	buttonRow.BackgroundTransparency = 1
	buttonRow.Parent = panel

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	layout.Padding = UDim.new(0, 10)
	layout.Parent = buttonRow

	skipButton = Instance.new("TextButton")
	skipButton.Name = "Skip"
	skipButton.AnchorPoint = Vector2.new(1, 0)
	skipButton.Position = UDim2.new(1, -16, 0, 16)
	skipButton.Size = UDim2.fromOffset(110, 44)
	skipButton.BackgroundColor3 = Color3.fromRGB(90, 90, 100)
	skipButton.Font = Enum.Font.GothamBold
	skipButton.TextSize = 18
	skipButton.TextColor3 = Color3.new(1, 1, 1)
	skipButton.Text = "Pular"
	skipButton.Visible = false
	skipButton.Parent = gui
	corner(skipButton, 12)
	UIScaler.attach(skipButton)

	skipButton.Activated:Connect(function()
		if activeEvent then
			activeEvent:Fire("skip")
		end
	end)
end

local function setButtons(options)
	for _, child in ipairs(buttonRow:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	for i, option in ipairs(options) do
		local b = Instance.new("TextButton")
		b.Name = option.id
		b.LayoutOrder = i
		b.Size = UDim2.fromOffset(#options &gt;= 3 and 150 or 170, 50)
		b.BackgroundColor3 = (i == 1) and GREEN or Color3.fromRGB(70, 90, 140)
		b.Font = Enum.Font.GothamBold
		b.TextSize = 20
		b.TextColor3 = Color3.new(1, 1, 1)
		b.Text = option.text
		b.Parent = buttonRow
		corner(b, 12)
		b.Activated:Connect(function()
			if activeEvent then
				activeEvent:Fire(option.id)
			end
		end)
	end
end

function DialogController.isOpen()
	return activeEvent ~= nil
end

function DialogController.show(speaker, lines, options, allowSkip)
	if not gui then
		build()
	end
	if activeEvent then
		return nil -- já existe um diálogo aberto
	end
	local event = Instance.new("BindableEvent")
	activeEvent = event
	panel.Visible = true
	skipButton.Visible = allowSkip == true
	nameLabel.Text = speaker

	local result = "next"
	for i, line in ipairs(lines) do
		textLabel.Text = line
		local isLast = (i == #lines)
		if isLast and options and #options &gt; 0 then
			setButtons(options)
		else
			setButtons({ { id = "next", text = "Continuar" } })
		end
		local choice = event.Event:Wait()
		if choice == "skip" or isLast then
			result = choice
			break
		end
	end

	activeEvent = nil
	event:Destroy()
	panel.Visible = false
	skipButton.Visible = false
	return result
end

return DialogController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000035"><Properties><string name="Name">HudController</string><ProtectedString name="Source">-- HudController (ModuleScript)
-- Caminho: StarterPlayer &gt; StarterPlayerScripts &gt; Controllers &gt; HudController
-- Mostra saldo, estado do bônus diário, a etapa do emprego e avisos de pagamento.
-- Só MOSTRA o que o servidor mandou; nunca decide valores.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local JobConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("JobConfig"))
local PizzaArt = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PizzaArt"))
local UIScaler = require(script.Parent:WaitForChild("UIScaler"))
local MapController = require(script.Parent:WaitForChild("MapController"))

local HudController = {}

local player = Players.LocalPlayer
local BLUE = Color3.fromRGB(20, 45, 90)
local SYMBOL = GameConfig.Economy.CurrencySymbol

local gui, moneyLabel, bonusLabel, missionFrame, missionLabel, toastHolder, cardFrame
local cardFlavor -- sabor desenhado na comanda agora
local buildCard -- definida mais abaixo
local leaveCallback

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function label(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = props.Font or Enum.Font.GothamBold
	l.TextColor3 = props.Color or Color3.new(1, 1, 1)
	l.TextScaled = true
	l.TextXAlignment = props.Align or Enum.TextXAlignment.Left
	l.Size = props.Size
	l.Position = props.Position or UDim2.new()
	l.Text = props.Text or ""
	l.Parent = parent
	return l
end

local function formatMoney(n)
	local s = tostring(math.floor(n))
	-- separador de milhar: 1234567 -&gt; 1.234.567
	local formatted = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	if formatted:sub(1, 1) == "." then
		formatted = formatted:sub(2)
	end
	return SYMBOL .. " " .. formatted
end

local function formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	if h &gt; 0 then
		return ("%dh %02dmin"):format(h, m)
	end
	return ("%dmin %02ds"):format(m, seconds % 60)
end

local function updateMoney()
	local money = player:GetAttribute("Money")
	moneyLabel.Text = money and formatMoney(money) or (SYMBOL .. " ...")
end

local function updateBonus()
	local readyAt = player:GetAttribute("BonusReadyAt")
	if not readyAt then
		bonusLabel.Text = "Bônus diário: carregando..."
		return
	end
	local left = readyAt - Workspace:GetServerTimeNow()
	if left &lt;= 0 then
		bonusLabel.Text = ("Bônus diário (%s %d): trabalhe e conclua um pedido!"):format(SYMBOL, GameConfig.DailyBonus.Amount)
		bonusLabel.TextColor3 = Color3.fromRGB(255, 220, 90)
	else
		bonusLabel.Text = "Próximo bônus em " .. formatTime(left)
		bonusLabel.TextColor3 = Color3.fromRGB(200, 220, 255)
	end
end

local function build()
	gui = Instance.new("ScreenGui")
	gui.Name = "HudUI"
	gui.ResetOnSpawn = false
	gui.Parent = player:WaitForChild("PlayerGui")

	-- Saldo e bônus (canto superior esquerdo)
	local wallet = Instance.new("Frame")
	wallet.Name = "Wallet"
	wallet.Size = UDim2.fromOffset(260, 58)
	wallet.Position = UDim2.fromOffset(12, 12)
	wallet.BackgroundColor3 = BLUE
	wallet.BackgroundTransparency = 0.15
	wallet.Parent = gui
	corner(wallet, 12)
	UIScaler.attach(wallet)

	moneyLabel = label(wallet, {
		Size = UDim2.new(1, -16, 0, 30),
		Position = UDim2.fromOffset(8, 4),
		Font = Enum.Font.GothamBlack,
		Color = Color3.fromRGB(140, 230, 140),
	})
	bonusLabel = label(wallet, {
		Size = UDim2.new(1, -16, 0, 18),
		Position = UDim2.fromOffset(8, 36),
		Font = Enum.Font.Gotham,
	})

	-- Tarefa do emprego (topo, centro), com botão para sair do emprego
	missionFrame = Instance.new("Frame")
	missionFrame.Name = "Mission"
	missionFrame.AnchorPoint = Vector2.new(0.5, 0)
	missionFrame.Position = UDim2.new(0.5, 0, 0, 6) -- logo abaixo da faixa do topo (onde fica o botão do mapa)
	missionFrame.Size = UDim2.fromOffset(460, 70)
	missionFrame.BackgroundColor3 = Color3.fromRGB(240, 140, 30)
	missionFrame.Visible = false
	missionFrame.Parent = gui
	corner(missionFrame, 12)
	UIScaler.attach(missionFrame)
	missionLabel = label(missionFrame, {
		Size = UDim2.new(1, -86, 1, -8),
		Position = UDim2.fromOffset(10, 4),
		Align = Enum.TextXAlignment.Left,
	})
	local leave = Instance.new("TextButton")
	leave.Name = "Leave"
	leave.AnchorPoint = Vector2.new(1, 0.5)
	leave.Position = UDim2.new(1, -8, 0.5, 0)
	leave.Size = UDim2.fromOffset(66, 40)
	leave.BackgroundColor3 = Color3.fromRGB(160, 60, 40)
	leave.Font = Enum.Font.GothamBold
	leave.TextSize = 15
	leave.TextColor3 = Color3.new(1, 1, 1)
	leave.Text = "Sair"
	leave.Parent = missionFrame
	corner(leave, 10)
	leave.Activated:Connect(function()
		if leaveCallback then
			leaveCallback()
		end
	end)

	-- Avisos de pagamento (meio da tela)
	toastHolder = Instance.new("Frame")
	toastHolder.Name = "Toasts"
	toastHolder.AnchorPoint = Vector2.new(0.5, 0)
	toastHolder.Position = UDim2.new(0.5, 0, 0, 120)
	toastHolder.Size = UDim2.fromOffset(360, 200)
	toastHolder.BackgroundTransparency = 1
	toastHolder.Parent = gui
	UIScaler.attach(toastHolder)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = toastHolder

	buildCard()

	player:GetAttributeChangedSignal("Money"):Connect(updateMoney)
	player:GetAttributeChangedSignal("BonusReadyAt"):Connect(updateBonus)
	updateMoney()
	updateBonus()
	task.spawn(function()
		while true do
			task.wait(1)
			updateBonus()
		end
	end)
end

---------------------------------------------------------------------------
-- Comanda da pizza (canto direito, abaixo do topo): desenho do sabor + ingredientes com ✓
---------------------------------------------------------------------------

function buildCard()
	cardFrame = Instance.new("Frame")
	cardFrame.Name = "Comanda"
	cardFrame.AnchorPoint = Vector2.new(1, 0)
	cardFrame.Position = UDim2.new(1, -12, 0, 90) -- canto direito (o chat do Roblox fica à esquerda)
	cardFrame.Size = UDim2.fromOffset(180, 250)
	cardFrame.BackgroundColor3 = Color3.fromRGB(255, 250, 235)
	cardFrame.Visible = false
	cardFrame.Parent = gui
	corner(cardFrame, 12)
	UIScaler.attach(cardFrame)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(200, 50, 45)
	stroke.Thickness = 3
	stroke.Parent = cardFrame
	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.Size = UDim2.fromScale(1, 1)
	content.Parent = cardFrame
end

-- Comanda em lista (mercado): quadradinho colorido, texto, ✓ quando feito e destaque no que é agora
local function showListCard(card)
	cardFlavor = nil
	local content = cardFrame.Content
	content:ClearAllChildren()
	local green = Color3.fromRGB(40, 140, 70)
	label(content, { Text = tostring(card.title or "Tarefa"):upper(), Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 6), Color = green, Font = Enum.Font.GothamBlack, Align = Enum.TextXAlignment.Center })
	local y = 30
	for _, row in ipairs(card.rows) do
		local f = Instance.new("Frame")
		f.Position = UDim2.fromOffset(6, y)
		f.Size = UDim2.new(1, -12, 0, 24)
		f.BackgroundColor3 = Color3.fromRGB(255, 230, 150)
		f.BackgroundTransparency = row.now and 0 or 1
		f.Parent = content
		corner(f, 6)
		local chip = Instance.new("Frame")
		chip.Position = UDim2.fromOffset(4, 3)
		chip.Size = UDim2.fromOffset(18, 18)
		chip.BackgroundColor3 = typeof(row.color) == "Color3" and row.color or Color3.fromRGB(200, 200, 200)
		chip.Parent = f
		corner(chip, 5)
		local chipStroke = Instance.new("UIStroke")
		chipStroke.Color = Color3.fromRGB(60, 60, 60)
		chipStroke.Transparency = 0.6
		chipStroke.Parent = chip
		local text = label(f, { Text = tostring(row.label or ""), Size = UDim2.new(1, -56, 1, -6), Position = UDim2.fromOffset(28, 3), Color = row.done and Color3.fromRGB(130, 130, 130) or Color3.fromRGB(40, 35, 30) })
		text.Font = row.now and Enum.Font.GothamBlack or Enum.Font.GothamBold
		label(f, { Text = row.done and "✓" or (row.now and "•" or ""), Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -24, 0, 1), Color = row.done and Color3.fromRGB(40, 150, 60) or Color3.fromRGB(230, 120, 30), Font = Enum.Font.GothamBlack, Align = Enum.TextXAlignment.Center })
		y += 26
	end
	if card.footer then
		label(content, { Text = tostring(card.footer), Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, y + 4), Color = green, Align = Enum.TextXAlignment.Center })
		y += 24
	end
	cardFrame.Size = UDim2.fromOffset(190, y + 8)
	local stroke = cardFrame:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = green
	end
	cardFrame.Visible = true
end

function HudController.showCard(card)
	if not cardFrame then
		return
	end
	if type(card) == "table" and card.kind == "list" and type(card.rows) == "table" then
		showListCard(card)
		return
	end
	if type(card) ~= "table" or type(card.items) ~= "table" then
		cardFrame.Visible = false
		cardFlavor = nil
		return
	end
	local key = tostring(card.flavor)
	if cardFlavor ~= key then
		-- sabor novo: redesenha tudo
		cardFlavor = key
		local content = cardFrame.Content
		content:ClearAllChildren()
		label(content, { Text = "COMANDA", Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 6), Color = Color3.fromRGB(200, 50, 45), Font = Enum.Font.GothamBlack, Align = Enum.TextXAlignment.Center })
		label(content, { Text = tostring(card.title or ""), Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 24), Color = Color3.fromRGB(40, 35, 30), Align = Enum.TextXAlignment.Center })
		local art = Instance.new("Frame")
		art.BackgroundTransparency = 1
		art.Position = UDim2.fromOffset(50, 46)
		art.Size = UDim2.fromOffset(80, 80)
		art.Parent = content
		local ids = {}
		for _, item in ipairs(card.items) do
			table.insert(ids, item.id)
		end
		PizzaArt.pizza(art, ids)
		local list = Instance.new("Frame")
		list.Name = "Lista"
		list.BackgroundTransparency = 1
		list.Position = UDim2.fromOffset(10, 132)
		list.Size = UDim2.new(1, -20, 0, 112)
		list.Parent = content
		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, 2)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = list
		for i, item in ipairs(card.items) do
			local row = Instance.new("Frame")
			row.Name = tostring(item.id)
			row.LayoutOrder = i
			row.BackgroundTransparency = 1
			row.Size = UDim2.new(1, 0, 0, 24)
			row.Parent = list
			local icon = Instance.new("Frame")
			icon.BackgroundTransparency = 1
			icon.Size = UDim2.fromOffset(22, 22)
			icon.Parent = row
			PizzaArt.ingredient(icon, item.id)
			local ing = JobConfig.ingredientById(item.id)
			label(row, { Text = ing and ing.label or tostring(item.id), Size = UDim2.new(1, -56, 1, -4), Position = UDim2.fromOffset(28, 2), Color = Color3.fromRGB(40, 35, 30) })
			local check = label(row, { Text = "", Size = UDim2.fromOffset(24, 22), Position = UDim2.new(1, -24, 0, 1), Color = Color3.fromRGB(40, 150, 60), Font = Enum.Font.GothamBlack, Align = Enum.TextXAlignment.Center })
			check.Name = "Check"
		end
		cardFrame.Size = UDim2.fromOffset(180, 140 + #card.items * 26)
		local stroke = cardFrame:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = Color3.fromRGB(200, 50, 45)
		end
	end
	-- marca o que já foi colocado
	local list = cardFrame.Content:FindFirstChild("Lista")
	for _, item in ipairs(card.items) do
		local row = list and list:FindFirstChild(tostring(item.id))
		local check = row and row:FindFirstChild("Check")
		if check then
			check.Text = item.done and "✓" or ""
		end
	end
	cardFrame.Visible = true
end

function HudController.toast(text, color)
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromOffset(340, 44)
	t.BackgroundColor3 = color or Color3.fromRGB(60, 170, 80)
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Text = text
	t.Parent = toastHolder
	corner(t, 12)
	task.delay(3, function()
		TweenService:Create(t, TweenInfo.new(0.6), { BackgroundTransparency = 1, TextTransparency = 1 }):Play()
		task.wait(0.7)
		t:Destroy()
	end)
end

-- Mostra o texto da tarefa no topo (nil esconde)
function HudController.setTask(text)
	missionFrame.Visible = text ~= nil
	missionLabel.Text = text or ""
end

-- fn é chamada quando o jogador toca em "Sair" na faixa da tarefa
function HudController.onLeaveJob(fn)
	leaveCallback = fn
end

function HudController.init()
	build()
	MapController.init()
end

return HudController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000036"><Properties><string name="Name">JobController</string><ProtectedString name="Source">-- JobController (ModuleScript)
-- Caminho: StarterPlayer &gt; StarterPlayerScripts &gt; Controllers &gt; JobController
-- Lado do cliente dos empregos:
--   * painel do quadro de empregos (vagas, pagamento, botão Trabalhar);
--   * etapa atual: liga o botão de interação SÓ da estação certa e destaca o objeto;
--   * faixa da tarefa no topo, destino no mapa e avisos de pagamento.
-- O cliente só mostra e pede; vagas, etapas e pagamentos são decididos pelo servidor.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local JobConfig = require(Shared:WaitForChild("JobConfig"))
local UIScaler = require(script.Parent:WaitForChild("UIScaler"))
local HudController = require(script.Parent:WaitForChild("HudController"))
local MapController = require(script.Parent:WaitForChild("MapController"))

local JobController = {}

local player = Players.LocalPlayer
local jobRequest = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild(GameConfig.Remotes.JobRequest)

local BLUE = Color3.fromRGB(20, 45, 90)
local GREEN = Color3.fromRGB(60, 170, 80)
local GRAY = Color3.fromRGB(110, 110, 120)
local RED = Color3.fromRGB(200, 90, 60)
local SYMBOL = GameConfig.Economy.CurrencySymbol

local gui, panel, rows, leaveButton
local counts = {}
local currentJob
local currentStep -- dados da etapa atual vindos do servidor
local activePrompts, activeHighlights = {}, {}
local stepToken = 0 -- muda a cada etapa (cancela contagens antigas)

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function text(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = props.Font or Enum.Font.GothamBold
	l.TextColor3 = props.Color or Color3.new(1, 1, 1)
	l.TextSize = props.TextSize or 16
	l.TextWrapped = true
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = props.YAlign or Enum.TextYAlignment.Center
	l.Size = props.Size
	l.Position = props.Position or UDim2.new()
	l.Text = props.Text or ""
	l.Parent = parent
	return l
end

---------------------------------------------------------------------------
-- Painel do quadro de empregos
---------------------------------------------------------------------------

local function refreshBoard()
	if not panel then
		return
	end
	for id, row in pairs(rows) do
		local job = JobConfig.Jobs[id]
		local used = counts[id] or 0
		row.slots.Text = ("Vagas: %d/%d"):format(used, job.Slots)
		local button = row.button
		if currentJob == id then
			button.Text = "Seu emprego"
			button.BackgroundColor3 = BLUE
			button.AutoButtonColor = false
		elseif used &gt;= job.Slots then
			button.Text = "Lotado"
			button.BackgroundColor3 = GRAY
			button.AutoButtonColor = false
		else
			button.Text = currentJob and "Trocar" or "Trabalhar"
			button.BackgroundColor3 = GREEN
			button.AutoButtonColor = true
		end
	end
	leaveButton.Visible = currentJob ~= nil
end

local function buildBoard()
	gui = Instance.new("ScreenGui")
	gui.Name = "JobBoardUI"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 6
	gui.Parent = player:WaitForChild("PlayerGui")

	local rowHeight, padding = 84, 8
	local height = 52 + #JobConfig.Order * (rowHeight + padding) + 56
	panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(440, height)
	panel.BackgroundColor3 = Color3.fromRGB(20, 30, 50)
	panel.Visible = false
	panel.Parent = gui
	corner(panel, 16)
	UIScaler.attach(panel)

	text(panel, { Text = "Quadro de empregos", Font = Enum.Font.GothamBlack, TextSize = 20, Size = UDim2.new(1, -70, 0, 30), Position = UDim2.fromOffset(14, 10) })

	local close = Instance.new("TextButton")
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -8, 0, 8)
	close.Size = UDim2.fromOffset(36, 32)
	close.BackgroundColor3 = RED
	close.Font = Enum.Font.GothamBold
	close.TextSize = 18
	close.TextColor3 = Color3.new(1, 1, 1)
	close.Text = "X"
	close.Parent = panel
	corner(close, 8)
	close.Activated:Connect(function()
		panel.Visible = false
	end)

	rows = {}
	for i, id in ipairs(JobConfig.Order) do
		local job = JobConfig.Jobs[id]
		local row = Instance.new("Frame")
		row.Position = UDim2.fromOffset(10, 52 + (i - 1) * (rowHeight + padding))
		row.Size = UDim2.new(1, -20, 0, rowHeight)
		row.BackgroundColor3 = Color3.fromRGB(35, 50, 80)
		row.Parent = panel
		corner(row, 12)

		local stripe = Instance.new("Frame")
		stripe.Size = UDim2.new(0, 8, 1, 0)
		stripe.BackgroundColor3 = job.Color
		stripe.BorderSizePixel = 0
		stripe.Parent = row
		corner(stripe, 4)

		text(row, { Text = job.Name, Font = Enum.Font.GothamBlack, TextSize = 18, Size = UDim2.new(1, -150, 0, 22), Position = UDim2.fromOffset(18, 6) })
		text(row, { Text = job.Description, Font = Enum.Font.Gotham, TextSize = 13, Color = Color3.fromRGB(200, 215, 240), Size = UDim2.new(1, -150, 0, 34), Position = UDim2.fromOffset(18, 28), YAlign = Enum.TextYAlignment.Top })
		local info = text(row, { Font = Enum.Font.GothamBold, TextSize = 13, Color = Color3.fromRGB(140, 230, 140), Size = UDim2.new(1, -150, 0, 16), Position = UDim2.fromOffset(18, 64) })
		info.Text = ("%s · %s"):format(job.PayText, job.Place)

		local slots = text(row, { TextSize = 13, Color = Color3.fromRGB(255, 220, 150), Size = UDim2.fromOffset(120, 18), Position = UDim2.new(1, -128, 0, 8) })
		slots.TextXAlignment = Enum.TextXAlignment.Center

		local button = Instance.new("TextButton")
		button.AnchorPoint = Vector2.new(1, 1)
		button.Position = UDim2.new(1, -8, 1, -8)
		button.Size = UDim2.fromOffset(120, 44)
		button.Font = Enum.Font.GothamBold
		button.TextSize = 17
		button.TextColor3 = Color3.new(1, 1, 1)
		button.Parent = row
		corner(button, 10)
		button.Activated:Connect(function()
			if currentJob ~= id and (counts[id] or 0) &lt; job.Slots then
				jobRequest:FireServer("Join", id)
			end
		end)
		rows[id] = { slots = slots, button = button }
	end

	leaveButton = Instance.new("TextButton")
	leaveButton.AnchorPoint = Vector2.new(0.5, 1)
	leaveButton.Position = UDim2.new(0.5, 0, 1, -10)
	leaveButton.Size = UDim2.fromOffset(200, 40)
	leaveButton.BackgroundColor3 = RED
	leaveButton.Font = Enum.Font.GothamBold
	leaveButton.TextSize = 17
	leaveButton.TextColor3 = Color3.new(1, 1, 1)
	leaveButton.Text = "Sair do emprego"
	leaveButton.Parent = panel
	corner(leaveButton, 10)
	leaveButton.Activated:Connect(function()
		jobRequest:FireServer("Leave")
	end)
end

---------------------------------------------------------------------------
-- Etapa atual
---------------------------------------------------------------------------

local function clearStep()
	stepToken += 1
	for _, prompt in ipairs(activePrompts) do
		prompt.Enabled = false -- só na tela deste jogador
	end
	for _, h in ipairs(activeHighlights) do
		h:Destroy()
	end
	activePrompts, activeHighlights = {}, {}
	currentStep = nil
end

local function findPoint(name)
	local stations = Workspace:FindFirstChild("JobStations")
	return stations and stations:FindFirstChild(name, true)
end

local function bannerText(data, extra)
	local job = JobConfig.Jobs[data.job]
	local header = ("%s · %s · %d/%d"):format(job and job.Name or data.job, data.title or "", data.step, data.total)
	return header .. "\n" .. data.text .. (extra or "")
end

-- Contorno discreto só nos objetos desta etapa
local function highlight(visual)
	local h = Instance.new("Highlight")
	h.Name = "JobHighlight"
	h.FillColor = Color3.fromRGB(255, 170, 60)
	h.FillTransparency = 0.85
	h.OutlineColor = Color3.fromRGB(255, 170, 60)
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Adornee = visual
	h.Parent = visual
	table.insert(activeHighlights, h)
end

local function showStep(data)
	clearStep()
	currentStep = data
	local token = stepToken
	local prompts = {}
	local isHouse = false
	for _, entry in ipairs(type(data.points) == "table" and data.points or {}) do
		local point = type(entry.point) == "string" and findPoint(entry.point)
		local prompt = point and point:FindFirstChild("JobPrompt")
		local visualRef = point and point:FindFirstChild("Visual")
		if visualRef and visualRef.Value then
			highlight(visualRef.Value)
		end
		if prompt then
			prompt.ActionText = tostring(entry.action or "Usar")
			prompt.HoldDuration = data.hold or 0
			table.insert(prompts, prompt)
		end
		if type(entry.point) == "string" and entry.point:find("_Casa_") then
			isHouse = true
		end
	end
	activePrompts = prompts
	HudController.showCard(data.card) -- comanda da pizza (só aparece no Pizzaiolo)

	-- Entrega em casa: destino no mapa é a casa; senão, a loja
	MapController.setTarget(not isHouse and data.place or nil, isHouse and data.targetPos or nil)

	-- Espera (ex.: pizza assando) com contagem na faixa
	task.spawn(function()
		while token == stepToken do
			local left = (data.readyAt or 0) - Workspace:GetServerTimeNow()
			if left &lt;= 0 then
				break
			end
			local waitText = type(data.waitText) == "string" and data.waitText or "pronto em"
			HudController.setTask(bannerText(data, ("  (%s %ds)"):format(waitText, math.ceil(left))))
			task.wait(0.25)
		end
		if token == stepToken then
			HudController.setTask(bannerText(data))
			for _, prompt in ipairs(prompts) do
				prompt.Enabled = true
			end
		end
	end)
end

---------------------------------------------------------------------------
-- Mensagens do servidor (chamado pelo ClientBootstrap)
---------------------------------------------------------------------------

function JobController.handle(kind, data)
	if kind == "JobBoard" then
		counts = type(data.counts) == "table" and data.counts or counts
		currentJob = data.current
		refreshBoard()
		panel.Visible = true
	elseif kind == "JobSlots" then
		counts = type(data.counts) == "table" and data.counts or counts
		refreshBoard()
	elseif kind == "JobChanged" then
		currentJob = data.job
		refreshBoard()
		if currentJob then
			panel.Visible = false
			local job = JobConfig.Jobs[currentJob]
			HudController.toast("Você agora é " .. (job and job.Name or currentJob) .. "!", BLUE)
		else
			clearStep()
			HudController.setTask(nil)
			HudController.showCard(nil)
			MapController.setTarget(nil)
			HudController.toast("Você saiu do emprego.", GRAY)
		end
	elseif kind == "JobStep" then
		showStep(data)
	elseif kind == "JobPaid" then
		clearStep()
		HudController.showCard(nil)
		HudController.setTask("Pedido concluído! Próximo pedido chegando...")
		if type(data.reward) == "number" and data.reward &gt; 0 then
			HudController.toast(("+%s %d  %s concluído!"):format(SYMBOL, data.reward, tostring(data.title or "Pedido")))
		end
		if type(data.tip) == "number" and data.tip &gt; 0 then
			HudController.toast(("+%s %d  Gorjeta pela rapidez!"):format(SYMBOL, data.tip), Color3.fromRGB(40, 150, 200))
		end
		if type(data.bonus) == "number" and data.bonus &gt; 0 then
			HudController.toast(("+%s %d  Bônus diário!"):format(SYMBOL, data.bonus), Color3.fromRGB(230, 170, 30))
		end
	elseif kind == "JobHint" then
		HudController.toast(tostring(data.text or ""), data.bad and RED or BLUE)
	elseif kind == "JobRefused" then
		if data.reason == "full" then
			HudController.toast("Essa vaga lotou. Escolha outra profissão!", RED)
		elseif data.reason == "far" then
			HudController.toast("Chegue mais perto do quadro de empregos.", RED)
		end
	end
end

function JobController.init()
	buildBoard()
	refreshBoard()
	HudController.onLeaveJob(function()
		jobRequest:FireServer("Leave")
	end)
end

return JobController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000037"><Properties><string name="Name">MapController</string><ProtectedString name="Source">-- MapController (ModuleScript)
-- Caminho: StarterPlayer &gt; StarterPlayerScripts &gt; Controllers &gt; MapController
-- Mapa do bairro visto de cima, aberto pelo botão redondo do topo (ícone de mapa) ou pela tecla M.
-- Mostra ruas, casas, estabelecimentos, onde o jogador está e,
-- quando há etapa de emprego, o destino em laranja (loja ou casa da entrega). É desenhado a partir do próprio mapa do jogo.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local UIScaler = require(script.Parent:WaitForChild("UIScaler"))

local MapController = {}

local player = Players.LocalPlayer
local M = GameConfig.Map
local MAP_PX = 420 -- tamanho do desenho do mapa em pixels
local WORLD = M.GroundSize -- studs representados pelo mapa
local RADIAL_START, RADIAL_END = 50, 50 + M.RoadLength

local COLORS = {
	Background = Color3.fromRGB(106, 170, 74),
	Road = Color3.fromRGB(70, 72, 78),
	House = Color3.fromRGB(235, 225, 205),
	Building = Color3.fromRGB(170, 175, 195),
	Shop = Color3.fromRGB(30, 80, 150),
	Target = Color3.fromRGB(240, 140, 30),
	Player = Color3.fromRGB(255, 255, 255),
}

local gui, panel, canvas, playerMarker, playerPointer, playerHalo
local civicRoadLayer, civicMarkerLayer
local shopDots = {} -- shopDots[nome] = { dot, label }
local targetPlace, targetPos, targetDot
local isOpen = false

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = radius
	c.Parent = parent
end

-- Converte posição do mundo (X, Z) para pixels dentro do canvas
local function toMap(pos)
	return Vector2.new((pos.X / WORLD + 0.5) * MAP_PX, (pos.Z / WORLD + 0.5) * MAP_PX)
end

local function drawLine(a, b, width, color, parent)
	local pa, pb = toMap(a), toMap(b)
	local delta = pb - pa
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Size = UDim2.fromOffset(delta.Magnitude + width, width)
	f.Position = UDim2.fromOffset((pa.X + pb.X) / 2, (pa.Y + pb.Y) / 2)
	f.Rotation = math.deg(math.atan2(delta.Y, delta.X))
	f.Parent = parent or canvas
	return f
end

local function drawDot(pos, size, color, round, parent)
	local p = toMap(pos)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Size = UDim2.fromOffset(size, size)
	f.Position = UDim2.fromOffset(p.X, p.Y)
	f.Parent = parent or canvas
	if round then
		corner(f, UDim.new(1, 0))
	end
	return f
end

local function drawStreets()
	local roadPx = math.max(3, M.RoadWidth / WORLD * MAP_PX)
	local angles = {}
	for i = 0, 7 do
		local dir = CFrame.Angles(0, i * math.pi / 4, 0).LookVector
		table.insert(angles, dir)
		drawLine(dir * RADIAL_START, dir * RADIAL_END, roadPx, COLORS.Road)
	end
	for _, radius in ipairs({ M.InnerRingRadius, RADIAL_END }) do
		for i, dir in ipairs(angles) do
			local nextDir = angles[(i % #angles) + 1]
			drawLine(dir * radius, nextDir * radius, roadPx, COLORS.Road)
		end
	end
	-- Rotatória e praça
	drawDot(Vector3.zero, M.RoundaboutOuterRadius * 2 / WORLD * MAP_PX, COLORS.Road, true)
	drawDot(Vector3.zero, M.RoundaboutIslandRadius * 2 / WORLD * MAP_PX, COLORS.Background, true)

	-- Nomes das ruas (abreviados), escritos ao longo da rua
	local function short(name)
		return (name:gsub("^Avenida", "Av."):gsub("^Rua", "R."))
	end
	local function streetLabel(a, b, name)
		local pa, pb = toMap(a), toMap(b)
		local mid = (pa + pb) / 2
		local angle = math.deg(math.atan2(pb.Y - pa.Y, pb.X - pa.X))
		if angle &gt; 90 then
			angle -= 180
		elseif angle &lt; -90 then
			angle += 180
		end
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Position = UDim2.fromOffset(mid.X, mid.Y)
		l.Size = UDim2.fromOffset(120, 12)
		l.Rotation = angle
		l.Font = Enum.Font.GothamBold
		l.TextSize = 10
		l.TextColor3 = Color3.fromRGB(255, 255, 255)
		l.TextStrokeTransparency = 0.5
		l.Text = short(name)
		l.ZIndex = 2
		l.Parent = canvas
	end
	for i, dir in ipairs(angles) do
		streetLabel(dir * M.InnerRingRadius, dir * RADIAL_END, M.StreetNames[i])
	end
	streetLabel(angles[2] * M.InnerRingRadius, angles[3] * M.InnerRingRadius, M.InnerRingName)
	streetLabel(angles[6] * RADIAL_END, angles[7] * RADIAL_END, M.OuterRingName)
end

local function drawBuildings(map)
	local houses = map:FindFirstChild("Houses")
	if houses then
		for _, house in ipairs(houses:GetChildren()) do
			drawDot(house:GetPivot().Position, 4, COLORS.House, false)
		end
	end
	local buildings = map:FindFirstChild("Buildings")
	if buildings then
		for _, building in ipairs(buildings:GetChildren()) do
			drawDot(building:GetPivot().Position, 5, COLORS.Building, false)
		end
	end
	local shops = map:FindFirstChild("JobLocations")
	if shops then
		for _, shop in ipairs(shops:GetChildren()) do
			local name = shop:GetAttribute("PlaceName")
			if name then
				local dot = drawDot(shop:GetPivot().Position, 12, COLORS.Shop, true)
				local stroke = Instance.new("UIStroke")
				stroke.Color = Color3.new(1, 1, 1)
				stroke.Thickness = 2
				stroke.Parent = dot

				-- O nome fica do lado de FORA da rua (longe da loja vizinha do outro lado),
				-- assim duas lojas frente a frente não sobrepõem os nomes.
				local pos = shop:GetPivot().Position
				local flatPos = Vector3.new(pos.X, 0, pos.Z)
				local roadAngle = math.floor(math.atan2(flatPos.X, -flatPos.Z) / (math.pi / 4) + 0.5) * (math.pi / 4)
				local roadDir = Vector3.new(math.sin(roadAngle), 0, -math.cos(roadAngle))
				local side = flatPos - roadDir * flatPos:Dot(roadDir) -- deslocamento lateral em relação à rua
				local label = Instance.new("TextLabel")
				label.BackgroundTransparency = 1
				label.Size = UDim2.fromOffset(110, 14)
				if math.abs(side.X) &gt;= math.abs(side.Z) then
					-- rua vertical no mapa: nome à esquerda ou à direita
					label.TextXAlignment = side.X &lt; 0 and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
					label.AnchorPoint = Vector2.new(side.X &lt; 0 and 1 or 0, 0.5)
					label.Position = UDim2.new(side.X &lt; 0 and 0 or 1, side.X &lt; 0 and -4 or 4, 0.5, 0)
				else
					-- rua horizontal no mapa: nome acima ou abaixo
					label.AnchorPoint = Vector2.new(0.5, side.Z &lt; 0 and 1 or 0)
					label.Position = UDim2.new(0.5, 0, side.Z &lt; 0 and 0 or 1, side.Z &lt; 0 and -2 or 2)
				end
				label.Font = Enum.Font.GothamBold
				label.TextSize = 12
				label.TextColor3 = Color3.new(1, 1, 1)
				label.TextStrokeTransparency = 0.4
				label.Text = name
				label.Parent = dot
				shopDots[name] = { dot = dot, label = label }
			end
		end
	end
end

-- A estrada e os pontos públicos vêm do mapa construído no servidor.
-- Camadas próprias permitem atualizar a replicação sem refazer o mapa ou o jogador.
local function drawCivic(map)
	if not civicRoadLayer or not civicMarkerLayer then
		return
	end
	civicRoadLayer:ClearAllChildren()
	civicMarkerLayer:ClearAllChildren()
	local roads = map:FindFirstChild("CivicRoads")
	if roads then
		for _, road in ipairs(roads:GetDescendants()) do
			local a, b = road:GetAttribute("RoadStart"), road:GetAttribute("RoadEnd")
			if typeof(a) == "Vector3" and typeof(b) == "Vector3" then
				local line = drawLine(a, b, math.max(3, M.RoadWidth / WORLD * MAP_PX), COLORS.Road, civicRoadLayer)
				line.Name = "CivicRoad"
			end
		end
	end
	local locations = map:FindFirstChild("CivicLocations")
	if not locations then
		return
	end
	for _, location in ipairs(locations:GetChildren()) do
		local pos = location:GetAttribute("MapPosition")
		local name = location:GetAttribute("PlaceName")
		if typeof(pos) == "Vector3" and type(name) == "string" then
			local kind = location:GetAttribute("Kind")
			local color = kind == "Prison" and Color3.fromRGB(178, 103, 45)
				or kind == "Fuel" and Color3.fromRGB(48, 118, 95)
				or kind == "Taxi" and Color3.fromRGB(232, 180, 43)
				or Color3.fromRGB(32, 93, 168)
			local dot = drawDot(pos, kind == "Fuel" and 8 or 12, color, true, civicMarkerLayer)
			dot.Name = name
			dot.ZIndex = 3
			local ring = Instance.new("UIStroke")
			ring.Color = Color3.fromRGB(255, 255, 255)
			ring.Thickness = 2
			ring.Parent = dot

			-- Etiqueta ancorada em pixels para não cortar junto às bordas.
			local p = toMap(pos)
			local label = Instance.new("TextLabel")
			label.Name = "CivicLabel"
			label.AnchorPoint = Vector2.new(0.5, 0.5)
			local labelX = math.clamp(p.X, 65, MAP_PX - 65)
			local labelY = p.Y + (kind == "Prison" and -17 or kind == "Fuel" and 17 or -17)
			label.Position = UDim2.fromOffset(labelX, math.clamp(labelY, 10, MAP_PX - 10))
			label.Size = UDim2.fromOffset(126, 18)
			label.BackgroundColor3 = Color3.fromRGB(20, 30, 50)
			label.BackgroundTransparency = 0.12
			label.BorderSizePixel = 0
			label.Font = Enum.Font.GothamBold
			label.TextSize = 11
			label.TextColor3 = Color3.fromRGB(255, 255, 255)
			label.Text = location:GetAttribute("MapLabel") or name
			label.ZIndex = 4
			label.Parent = civicMarkerLayer
			corner(label, UDim.new(0, 5))
		end
	end
end

local function watchCivic(map)
	local queued = false
	local watched = {}
	local function refreshSoon()
		if queued then
			return
		end
		queued = true
		task.delay(0.15, function()
			queued = false
			if canvas and canvas.Parent then
				drawCivic(map)
			end
		end)
	end
	local function watch(item)
		if watched[item] then
			return
		end
		local parent = item.Parent
		local locations, roads = map:FindFirstChild("CivicLocations"), map:FindFirstChild("CivicRoads")
		if locations and parent == locations then
			watched[item] = true
			for _, attr in ipairs({ "PlaceName", "MapPosition", "MapLabel", "Kind" }) do
				item:GetAttributeChangedSignal(attr):Connect(refreshSoon)
			end
			refreshSoon()
		elseif roads and item:IsA("BasePart") and item:IsDescendantOf(roads) then
			watched[item] = true
			item:GetAttributeChangedSignal("RoadStart"):Connect(refreshSoon)
			item:GetAttributeChangedSignal("RoadEnd"):Connect(refreshSoon)
			refreshSoon()
		end
	end
	map.DescendantAdded:Connect(watch)
	map.DescendantRemoving:Connect(function(item)
		if watched[item] then
			watched[item] = nil
			refreshSoon()
		end
	end)
	map:GetAttributeChangedSignal("CivicReady"):Connect(refreshSoon)
	for _, item in ipairs(map:GetDescendants()) do
		watch(item)
	end
	drawCivic(map)
end

local function refreshTarget()
	if targetDot then
		targetDot.Visible = targetPos ~= nil
		if targetPos then
			local p = toMap(targetPos)
			targetDot.Position = UDim2.fromOffset(p.X, p.Y)
		end
	end
	for name, entry in pairs(shopDots) do
		local isTarget = (name == targetPlace)
		entry.dot.BackgroundColor3 = isTarget and COLORS.Target or COLORS.Shop
		entry.dot.Size = UDim2.fromOffset(isTarget and 16 or 12, isTarget and 16 or 12)
		entry.label.TextColor3 = isTarget and Color3.fromRGB(255, 220, 150) or Color3.new(1, 1, 1)
	end
end

local function updatePlayer()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		playerMarker.Visible = false
		return
	end
	playerMarker.Visible = true
	local p = toMap(root.Position)
	playerMarker.Position = UDim2.fromOffset(p.X, p.Y)
	local look = root.CFrame.LookVector
	-- A seta aponta para cima; gira para a direção em que o personagem olha
	playerPointer.Rotation = math.deg(math.atan2(look.Z, look.X)) + 90
end

-- Marcador do jogador: bolinha azul com borda branca, seta da direção, onda pulsando e "VOCÊ"
local function buildPlayerMarker()
	playerMarker = Instance.new("Frame")
	playerMarker.Name = "Voce"
	playerMarker.BackgroundTransparency = 1
	playerMarker.AnchorPoint = Vector2.new(0.5, 0.5)
	playerMarker.Size = UDim2.fromOffset(44, 44)
	playerMarker.ZIndex = 6
	playerMarker.Parent = canvas

	playerHalo = Instance.new("Frame")
	playerHalo.AnchorPoint = Vector2.new(0.5, 0.5)
	playerHalo.Position = UDim2.fromScale(0.5, 0.5)
	playerHalo.Size = UDim2.fromOffset(26, 26)
	playerHalo.BackgroundColor3 = Color3.fromRGB(40, 140, 255)
	playerHalo.BackgroundTransparency = 0.55
	playerHalo.ZIndex = 6
	playerHalo.Parent = playerMarker
	corner(playerHalo, UDim.new(1, 0))

	playerPointer = Instance.new("Frame")
	playerPointer.AnchorPoint = Vector2.new(0.5, 0.5)
	playerPointer.Position = UDim2.fromScale(0.5, 0.5)
	playerPointer.Size = UDim2.fromOffset(40, 40)
	playerPointer.BackgroundTransparency = 1
	playerPointer.ZIndex = 7
	playerPointer.Parent = playerMarker
	-- seta branca na frente da bolinha (fica girando com o jogador)
	local tip = Instance.new("TextLabel")
	tip.BackgroundTransparency = 1
	tip.AnchorPoint = Vector2.new(0.5, 0.5)
	tip.Position = UDim2.new(0.5, 0, 0, 6)
	tip.Size = UDim2.fromOffset(16, 12)
	tip.Font = Enum.Font.GothamBlack
	tip.TextSize = 14
	tip.TextColor3 = Color3.new(1, 1, 1)
	tip.TextStrokeColor3 = Color3.fromRGB(20, 60, 140)
	tip.TextStrokeTransparency = 0
	tip.Text = "▲"
	tip.ZIndex = 8
	tip.Parent = playerPointer

	local dot = Instance.new("Frame")
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromOffset(18, 18)
	dot.BackgroundColor3 = Color3.fromRGB(30, 120, 255)
	dot.ZIndex = 9
	dot.Parent = playerMarker
	corner(dot, UDim.new(1, 0))
	local ring = Instance.new("UIStroke")
	ring.Color = Color3.new(1, 1, 1)
	ring.Thickness = 3
	ring.Parent = dot

	local tag = Instance.new("TextLabel")
	tag.BackgroundColor3 = Color3.fromRGB(30, 120, 255)
	tag.AnchorPoint = Vector2.new(0.5, 0)
	tag.Position = UDim2.new(0.5, 0, 1, -4)
	tag.Size = UDim2.fromOffset(40, 15)
	tag.Font = Enum.Font.GothamBlack
	tag.TextSize = 10
	tag.TextColor3 = Color3.new(1, 1, 1)
	tag.Text = "VOCÊ"
	tag.ZIndex = 9
	tag.Parent = playerMarker
	corner(tag, UDim.new(0, 6))

	-- onda pulsando para achar o marcador rápido
	task.spawn(function()
		local t = 0
		while playerMarker.Parent do
			t += 0.05
			local k = (t % 1.2) / 1.2
			playerHalo.Size = UDim2.fromOffset(20 + 22 * k, 20 + 22 * k)
			playerHalo.BackgroundTransparency = 0.4 + 0.6 * k
			task.wait(0.05)
		end
	end)
end

local function build(map)
	gui = Instance.new("ScreenGui")
	gui.Name = "MapUI"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 5
	gui.Parent = player:WaitForChild("PlayerGui")

	panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(MAP_PX + 20, MAP_PX + 56)
	panel.BackgroundColor3 = Color3.fromRGB(20, 30, 50)
	panel.Visible = false
	panel.Parent = gui
	corner(panel, UDim.new(0, 16))
	UIScaler.attach(panel)

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(14, 8)
	title.Size = UDim2.new(1, -70, 0, 28)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 18
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Color3.new(1, 1, 1)
	title.Text = GameConfig.CityName
	title.Parent = panel

	local close = Instance.new("TextButton")
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -8, 0, 6)
	close.Size = UDim2.fromOffset(36, 32)
	close.BackgroundColor3 = Color3.fromRGB(200, 90, 60)
	close.Font = Enum.Font.GothamBold
	close.TextSize = 18
	close.TextColor3 = Color3.new(1, 1, 1)
	close.Text = "X"
	close.Parent = panel
	corner(close, UDim.new(0, 8))
	close.Activated:Connect(function()
		MapController.toggle(false)
	end)

	canvas = Instance.new("Frame")
	canvas.Name = "Canvas"
	canvas.Position = UDim2.fromOffset(10, 46)
	canvas.Size = UDim2.fromOffset(MAP_PX, MAP_PX)
	canvas.BackgroundColor3 = COLORS.Background
	canvas.ClipsDescendants = true
	canvas.Parent = panel
	corner(canvas, UDim.new(0, 10))

	drawStreets()
	drawBuildings(map)
	civicRoadLayer = Instance.new("Folder")
	civicRoadLayer.Name = "CivicRoads"
	civicRoadLayer.Parent = canvas
	civicMarkerLayer = Instance.new("Folder")
	civicMarkerLayer.Name = "CivicMarkers"
	civicMarkerLayer.Parent = canvas
	watchCivic(map)

	targetDot = drawDot(Vector3.zero, 14, COLORS.Target, true)
	targetDot.ZIndex = 4
	local ring = Instance.new("UIStroke")
	ring.Color = Color3.new(1, 1, 1)
	ring.Thickness = 2
	ring.Parent = targetDot
	targetDot.Visible = false

	buildPlayerMarker()

	refreshTarget()
end

function MapController.toggle(open)
	if not panel then
		return
	end
	if open == nil then
		open = not isOpen
	end
	isOpen = open
	panel.Visible = open
	if open then
		updatePlayer()
	end
end

-- Destino da etapa atual: placeName (loja fica laranja) e/ou worldPos (bolinha laranja,
-- usada nas entregas em casas). Passe nil para limpar.
function MapController.setTarget(placeName, worldPos)
	targetPlace = placeName
	targetPos = typeof(worldPos) == "Vector3" and worldPos or nil
	if panel then
		refreshTarget()
	end
end

-- Botão "Mapa" pequeno no topo, no centro da tela
-- Ícone de mapa dobrado (3 faixas) com um alfinete laranja, feito só de Frames
local function drawMapIcon(parent)
	local holder = Instance.new("Frame")
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.Size = UDim2.fromOffset(22, 18)
	holder.BackgroundTransparency = 1
	holder.Parent = parent
	local shades = { Color3.fromRGB(235, 235, 225), Color3.fromRGB(190, 215, 170), Color3.fromRGB(235, 235, 225) }
	for i = 1, 3 do
		local strip = Instance.new("Frame")
		strip.Size = UDim2.new(1 / 3, 0, 1, 0)
		strip.Position = UDim2.new((i - 1) / 3, 0, 0, i == 2 and 2 or 0)
		strip.BackgroundColor3 = shades[i]
		strip.BorderSizePixel = 0
		strip.Parent = holder
	end
	local pin = Instance.new("Frame")
	pin.AnchorPoint = Vector2.new(0.5, 0.5)
	pin.Position = UDim2.fromScale(0.5, 0.45)
	pin.Size = UDim2.fromOffset(8, 8)
	pin.BackgroundColor3 = Color3.fromRGB(240, 120, 30)
	pin.BorderSizePixel = 0
	pin.Parent = holder
	corner(pin, UDim.new(1, 0))
end

-- Botão redondo pequeno no limite de cima da tela, na mesma faixa dos botões do Roblox
local function buildButton()
	local buttonGui = Instance.new("ScreenGui")
	buttonGui.Name = "MapButtonUI"
	buttonGui.ResetOnSpawn = false
	buttonGui.IgnoreGuiInset = true -- permite usar a faixa do topo
	buttonGui.DisplayOrder = 4
	buttonGui.Parent = player:WaitForChild("PlayerGui")

	local size = 40
	local topbar = GuiService:GetGuiInset().Y
	local button = Instance.new("ImageButton")
	button.Name = "MapButton"
	button.AnchorPoint = Vector2.new(0.5, 0)
	button.Position = UDim2.new(0.5, 0, 0, math.max(4, (topbar - size) / 2))
	button.Size = UDim2.fromOffset(size, size)
	button.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	button.BackgroundTransparency = 0.35
	button.Image = ""
	button.Parent = buttonGui
	corner(button, UDim.new(1, 0))
	drawMapIcon(button)
	button.Activated:Connect(function()
		MapController.toggle()
	end)
end

function MapController.init()
	task.spawn(function()
		local map = Workspace:WaitForChild("Map")
		task.wait(1) -- dá tempo das peças do mapa chegarem ao cliente
		build(map)
		buildButton()

		UserInputService.InputBegan:Connect(function(input, processed)
			if not processed and input.KeyCode == Enum.KeyCode.M then
				MapController.toggle()
			end
		end)

		while true do
			if isOpen then
				updatePlayer()
			end
			task.wait(0.1)
		end
	end)
end

return MapController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000038"><Properties><string name="Name">PoliceController</string><ProtectedString name="Source">-- Interface e ferramentas do policial. O cliente aponta e pede; o servidor
-- decide vagas, equipamento, relatórios, acesso, imobilização e captura.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local UIScaler = require(script.Parent:WaitForChild("UIScaler"))

local PoliceController = {}
local player = Players.LocalPlayer
local initialized = false
local request, gui, panel, panelTitle, panelSubtitle, content, banner, dutyText, patrolText
local crosshair, aimHint, statusLabel, mobileAction
local currentPanel, panelData = nil, {}
local state = { onDuty = false, count = 0, slots = 3, equipped = false, patrolStep = 0, patrolTotal = 4 }
local reports = {}
local activeTool
local toolConnections, characterConnections, cuffPrompts = {}, {}, {}
local lastActivation = 0
local noticeUntil = 0
local lastPromptRefresh = 0

local BLUE = Color3.fromRGB(27, 71, 119)
local INK = Color3.fromRGB(25, 42, 60)
local PAPER = Color3.fromRGB(244, 241, 230)
local ORANGE = Color3.fromRGB(223, 139, 62)
local MUTED = Color3.fromRGB(96, 112, 125)

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function text(parent, name, value, size, position, color, font, pixels)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size, label.Position = size, position or UDim2.new()
	label.Text, label.Font = value, font or Enum.Font.GothamMedium
	label.TextSize, label.TextColor3 = pixels or 14, color or INK
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextWrapped = true
	label.Parent = parent
	return label
end

local function send(action, payload)
	if request then
		request:FireServer(action, payload)
	end
end

local function toolKind()
	return activeTool and activeTool.Parent == player.Character and activeTool:GetAttribute("PoliceTool") or nil
end

local function targetOwner(prompt)
	local item = prompt.Parent
	while item and item ~= Workspace do
		if item:IsA("Model") then
			local owner = item:GetAttribute("PoliceTrainingOwner")
			if owner then
				return nil, owner, item
			end
			local target = Players:GetPlayerFromCharacter(item)
			if target then
				return target, nil
			end
		end
		item = item.Parent
	end
	return nil, nil
end

local function refreshCuffPrompts()
	local holdingCuffs = state.onDuty and toolKind() == "Cuff"
	local time = Workspace:GetServerTimeNow()
	for prompt in pairs(cuffPrompts) do
		if not prompt.Parent then
			cuffPrompts[prompt] = nil
		else
			local target, trainingOwner, trainingModel = targetOwner(prompt)
			local trainingStun = trainingModel and trainingModel:GetAttribute("StunnedUntil")
			local valid = trainingOwner == player.UserId and type(trainingStun) == "number" and trainingStun &gt; time
			if target then
				local stunned = target:GetAttribute("StunnedUntil")
				valid = target ~= player and target:GetAttribute("Wanted") == true
					and type(stunned) == "number" and stunned &gt; time
			end
			prompt.Enabled = holdingCuffs and valid
		end
	end
end

local function watchCuffPrompt(item)
	if item:IsA("ProximityPrompt") and item.Name == "PoliceCuffPrompt" then
		cuffPrompts[item] = true
		refreshCuffPrompts()
	end
end

local function notice(value)
	if statusLabel then
		statusLabel.Text = value
		noticeUntil = os.clock() + 3
	end
end

local function refreshAim()
	if not crosshair then return end
	local kind = toolKind()
	crosshair.Visible = state.onDuty and (kind == "Spray" or kind == "Cuff") and not panel.Visible
	if kind == "Spray" then
		aimHint.Text = "LANÇADOR DE ÁGUA\nMire e use a ferramenta para imobilizar."
	elseif kind == "Cuff" then
		aimHint.Text = "ALGEMAS\nAproxime-se do suspeito imobilizado e interaja."
	end
	if mobileAction then
		mobileAction.Visible = state.onDuty and kind ~= nil and not panel.Visible
			and UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		local names = { Spray = "ÁGUA", Cuff = "ALGEMAR", Flashlight = "LUZ", Radio = "RÁDIO" }
		mobileAction.Text = names[kind] or "USAR"
	end
	refreshCuffPrompts()
end

local function aimRay()
	local camera = Workspace.CurrentCamera
	if not camera then return nil end
	local mobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	if mobile then
		return camera:ViewportPointToRay(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
	end
	return player:GetMouse().UnitRay
end

local function aimResult()
	local ray = aimRay()
	if not ray then return nil end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = player.Character and { player.Character } or {}
	params.IgnoreWater = true
	local hit = Workspace:Raycast(ray.Origin, ray.Direction * 90, params)
	return hit, hit and hit.Position or ray.Origin + ray.Direction * 90
end

local function activate(tool)
	if tool ~= activeTool or not state.onDuty or tool.Parent ~= player.Character or panel.Visible then return end
	local time = os.clock()
	if time - lastActivation &lt; 0.15 then return end
	lastActivation = time
	local kind = tool:GetAttribute("PoliceTool")
	if kind == "Flashlight" then
		send("Flashlight")
	elseif kind == "Radio" then
		send("Radio")
	elseif kind == "Spray" then
		local _, point = aimResult()
		local character = player.Character
		local head = character and (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart"))
		if head and point then
			local direction = point - head.Position
			if direction.Magnitude &gt; 0.01 then
				send("Spray", { direction = direction.Unit })
			end
		end
	elseif kind == "Cuff" then
		local hit = aimResult()
		local item = hit and hit.Instance
		while item and item ~= Workspace do
			if item:IsA("Model") then
				if item:GetAttribute("PoliceTrainingOwner") == player.UserId then
					send("Cuff", "Training")
					return
				end
				local target = Players:GetPlayerFromCharacter(item)
				if target and target ~= player then
					send("Cuff", target.UserId)
					return
				end
			end
			item = item.Parent
		end
		notice("Mire no alvo ou use o botão de algemar perto dele.")
	end
end

local function disconnectTools()
	for _, connection in ipairs(characterConnections) do connection:Disconnect() end
	table.clear(characterConnections)
	for _, connections in pairs(toolConnections) do
		for _, connection in ipairs(connections) do connection:Disconnect() end
	end
	table.clear(toolConnections)
	activeTool = nil
end

local function watchTool(tool)
	if not tool:IsA("Tool") or not tool:GetAttribute("PoliceTool") or toolConnections[tool] then return end
	toolConnections[tool] = {
		tool.Activated:Connect(function() activate(tool) end),
		tool.Equipped:Connect(function()
			activeTool = tool
			refreshAim()
		end),
		tool.Unequipped:Connect(function()
			if activeTool == tool then activeTool = nil end
			refreshAim()
		end),
		tool.Destroying:Connect(function()
			local connections = toolConnections[tool]
			if connections then
				for _, connection in ipairs(connections) do connection:Disconnect() end
				toolConnections[tool] = nil
			end
			if activeTool == tool then activeTool = nil; refreshAim() end
		end),
	}
	if tool.Parent == player.Character then
		activeTool = tool
		refreshAim()
	end
end

local function watchCharacter(character)
	disconnectTools()
	table.insert(characterConnections, character.ChildAdded:Connect(watchTool))
	table.insert(characterConnections, character.ChildRemoved:Connect(function(tool)
		if activeTool == tool then activeTool = nil; refreshAim() end
	end))
	for _, item in ipairs(character:GetChildren()) do watchTool(item) end
	refreshAim()
end

local function button(parent, value, callback, color)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 43)
	b.BackgroundColor3 = color or BLUE
	b.BorderSizePixel = 0
	b.Font = Enum.Font.GothamBold
	b.TextSize = 14
	b.TextColor3 = Color3.new(1, 1, 1)
	b.TextWrapped = true
	b.Text = value
	b.Parent = parent
	corner(b, 8)
	b.Activated:Connect(callback)
	return b
end

local function paragraph(value, height, color)
	return text(content, "Info", value, UDim2.new(1, -4, 0, height or 45), nil, color or MUTED, nil, 13)
end

local function refreshBanner()
	if not banner then return end
	banner.Visible = state.onDuty
	dutyText.Text = ("EM SERVIÇO  ·  %d/%d policiais"):format(state.count, state.slots)
	local step = math.clamp(state.patrolStep, 0, state.patrolTotal)
	patrolText.Text = ("Ronda: %d/%d  ·  %s"):format(step, state.patrolTotal,
		state.equipped and "kit retirado" or "retire seu kit no arsenal")
	refreshAim()
end

local function closePanel()
	lastActivation = os.clock() -- fechar uma janela não dispara a ferramenta no mesmo toque
	panel.Visible = false
	currentPanel = nil
	refreshAim()
end

local function renderReports()
	paragraph(panelData.readOnly and "CONSULTA PELO RÁDIO\nPara registrar uma ocorrência, vá ao terminal da equipe."
		or "Registre uma ocorrência no terminal. Os informes ficam disponíveis no rádio da equipe.", 48)
	if not panelData.readOnly then
		for _, category in ipairs({
			{ "Seguranca", "Registrar inspeção de segurança" },
			{ "Patrulha", "Registrar informe de patrulha" },
			{ "Manutencao", "Solicitar manutenção" },
		}) do
			button(content, category[2], function() send("Report", { category = category[1] }) end)
		end
	end
	paragraph("ÚLTIMOS INFORMES", 24, BLUE)
	if #reports == 0 then
		paragraph("Nenhum informe registrado nesta sessão.", 36)
	end
	for index = 1, math.min(#reports, 10) do
		local report = reports[index]
		if type(report) == "table" then
			local time = type(report.at) == "number" and DateTime.fromUnixTimestamp(report.at):FormatLocalTime("HH:mm", "pt-br") or ""
			paragraph(("%s  ·  %s\n%s\n%s"):format(time, tostring(report.officer or "Equipe"),
				tostring(report.text or report.category or "Informe"), tostring(report.location or "")), 75, INK)
		end
	end
end

local function renderPanel()
	if not content or not currentPanel then return end
	for _, child in ipairs(content:GetChildren()) do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	local titles = { duty = "Central de serviço", armory = "Arsenal e equipamentos", reports = "Registro de ocorrências", control = "Controle de acesso", training = "Treinamento policial" }
	panelTitle.Text = titles[currentPanel] or "Centro policial"
	panelSubtitle.Text = "CENTRO POLICIAL  /  LITTLE LITTLE KINDER"
	if currentPanel == "duty" then
		paragraph(("Equipe em serviço: %d de %d vagas ocupadas.\nEntre em serviço para patrulhar e operar a prisão."):format(state.count, state.slots), 58)
		button(content, state.onDuty and "Encerrar meu turno" or "Entrar em serviço", function()
			send("Duty", not state.onDuty)
		end, state.onDuty and ORANGE or BLUE)
		paragraph("Retire o kit no arsenal. O lançador de água imobiliza suspeitos válidos; as algemas exigem aproximação. O policial não pode prender cidadãos inocentes.", 82)
		paragraph("Na prisão: faça a ronda, consulte ocorrências, opere acessos e pratique no setor de treinamento.", 60)
		paragraph("Retire o uniforme no vestiário e a viatura na garagem policial. Ambos são devolvidos ao encerrar o plantão.", 62)
	elseif currentPanel == "armory" then
		paragraph("Kit de serviço: lançador de água, algemas, lanterna e rádio. O equipamento é temporário e só funciona em serviço.", 62)
		button(content, "Retirar / repor meu kit", function() send("Gear") end)
		paragraph("Selecione as ferramentas pela mochila do Roblox. No computador, também use as teclas numéricas. No celular, toque na ferramenta e mire pelo centro da tela.", 78)
		paragraph("Lançador: imobilize o alvo. Algemas: aproxime-se e use a interação. Rádio: consulte a equipe. Lanterna: acenda ou apague ao usar.", 76)
	elseif currentPanel == "reports" then
		renderReports()
	elseif currentPanel == "control" then
		paragraph("Operação local dos portões e portas de serviço. Acesso restrito à equipe em serviço. Mantenha a passagem livre ao fechar.", 58)
		local doors = type(panelData.doors) == "table" and panelData.doors or {}
		for _, door in ipairs(doors) do
			if type(door) == "table" and type(door.id) == "string" then
				local id = door.id
				button(content, (door.open and "Fechar  ·  " or "Abrir  ·  ") .. tostring(door.name or id), function() send("Door", id) end,
					door.open and ORANGE or BLUE)
			end
		end
		if #doors == 0 then paragraph("Nenhum acesso disponível neste terminal.", 40) end
		paragraph("As portas das celas seguem o horário de acesso ao pátio. A pena e a liberação continuam sob controle do servidor.", 60)
	elseif currentPanel == "training" then
		paragraph("Pratique a sequência: lançador de água → aproximação → algemas. O alvo de treinamento é individual e não altera o dinheiro de ninguém.", 76)
		button(content, "Iniciar treinamento", function() send("Training") end)
	end
	content.CanvasPosition = Vector2.zero
	refreshAim()
end

function PoliceController.handle(kind, data)
	if type(data) ~= "table" then return end
	if kind == "PoliceState" then
		state.onDuty = data.onDuty == true
		for _, key in ipairs({ "count", "slots", "patrolStep", "patrolTotal" }) do
			if type(data[key]) == "number" then state[key] = math.max(0, math.floor(data[key])) end
		end
		state.equipped = data.equipped == true
		state.training = data.training == true
		if state.patrolTotal &lt; 1 then state.patrolTotal = 4 end
		refreshBanner()
		if currentPanel == "duty" or currentPanel == "armory" then renderPanel() end
		if not state.onDuty and currentPanel ~= "duty" then closePanel() end
	elseif kind == "PolicePanel" then
		panelData = data
		currentPanel = type(data.panel) == "string" and data.panel or "duty"
		if type(data.reports) == "table" then reports = data.reports end
		if type(data.count) == "number" then state.count = data.count end
		if type(data.slots) == "number" then state.slots = data.slots end
		panel.Visible = true
		renderPanel()
	elseif kind == "PoliceReports" then
		if type(data.reports) == "table" then reports = data.reports end
		if currentPanel == "reports" then renderPanel() end
	end
end

function PoliceController.init()
	if initialized then return end
	initialized = true
	request = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild(GameConfig.Remotes.PoliceRequest or "PoliceRequest")
	gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn, gui.DisplayOrder = "PoliceUI", false, 7
	gui.Parent = player:WaitForChild("PlayerGui")

	banner = Instance.new("Frame")
	banner.Name = "DutyCard"
	banner.Size, banner.Position = UDim2.fromOffset(342, 78), UDim2.fromOffset(16, 112)
	banner.BackgroundColor3, banner.BorderSizePixel, banner.Visible = BLUE, 0, false
	banner.Parent = gui
	corner(banner, 10)
	UIScaler.attach(banner)
	dutyText = text(banner, "Duty", "", UDim2.fromOffset(258, 22), UDim2.fromOffset(12, 8), PAPER, Enum.Font.GothamBold, 12)
	patrolText = text(banner, "Patrol", "", UDim2.fromOffset(318, 32), UDim2.fromOffset(12, 33), PAPER, nil, 12)
	local leave = Instance.new("TextButton")
	leave.Size, leave.Position = UDim2.fromOffset(54, 25), UDim2.new(1, -64, 0, 7)
	leave.Text, leave.TextColor3, leave.Font, leave.TextSize = "Sair", PAPER, Enum.Font.GothamBold, 12
	leave.BackgroundColor3, leave.BorderSizePixel = Color3.fromRGB(53, 95, 139), 0
	leave.Parent = banner
	corner(leave, 6)
	leave.Activated:Connect(function() send("Duty", false) end)

	panel = Instance.new("Frame")
	panel.Name = "PolicePanel"
	panel.AnchorPoint, panel.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(424, 448)
	panel.BackgroundColor3, panel.BorderSizePixel, panel.Visible = PAPER, 0, false
	panel.Parent = gui
	corner(panel, 14)
	UIScaler.attach(panel)
	panelTitle = text(panel, "Title", "Centro policial", UDim2.new(1, -65, 0, 28), UDim2.fromOffset(18, 15), BLUE, Enum.Font.GothamBold, 21)
	panelSubtitle = text(panel, "Subtitle", "", UDim2.new(1, -36, 0, 22), UDim2.fromOffset(18, 46), MUTED, Enum.Font.GothamBold, 9)
	local close = Instance.new("TextButton")
	close.Size, close.Position = UDim2.fromOffset(32, 32), UDim2.new(1, -45, 0, 13)
	close.Text, close.Font, close.TextSize, close.TextColor3 = "×", Enum.Font.GothamBold, 25, INK
	close.BackgroundColor3, close.BorderSizePixel, close.Modal = Color3.fromRGB(225, 225, 215), 0, true
	close.Parent = panel
	corner(close, 8)
	close.Activated:Connect(closePanel)
	content = Instance.new("ScrollingFrame")
	content.Name = "Content"
	content.Position, content.Size = UDim2.fromOffset(18, 78), UDim2.new(1, -36, 1, -96)
	content.BackgroundTransparency, content.BorderSizePixel, content.ScrollBarThickness = 1, 0, 4
	content.CanvasSize, content.AutomaticCanvasSize = UDim2.new(), Enum.AutomaticSize.Y
	content.ScrollingDirection = Enum.ScrollingDirection.Y
	content.ScrollBarImageColor3 = BLUE
	content.Parent = panel
	local layout = Instance.new("UIListLayout")
	layout.Padding, layout.SortOrder, layout.Parent = UDim.new(0, 9), Enum.SortOrder.LayoutOrder, content
	local padding = Instance.new("UIPadding")
	padding.PaddingRight, padding.PaddingBottom, padding.Parent = UDim.new(0, 6), UDim.new(0, 8), content

	crosshair = Instance.new("Frame")
	crosshair.Name = "ToolAim"
	crosshair.AnchorPoint, crosshair.Position, crosshair.Size = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(24, 24)
	crosshair.BackgroundTransparency, crosshair.Visible, crosshair.Parent = 1, false, gui
	local dot = text(crosshair, "Reticle", "+", UDim2.fromScale(1, 1), nil, Color3.new(1, 1, 1), Enum.Font.GothamBold, 25)
	dot.TextXAlignment, dot.TextStrokeTransparency = Enum.TextXAlignment.Center, 0.25
	aimHint = text(crosshair, "ToolHint", "", UDim2.fromOffset(280, 48), UDim2.fromOffset(-128, 40), PAPER, Enum.Font.GothamBold, 12)
	aimHint.TextXAlignment, aimHint.TextStrokeTransparency = Enum.TextXAlignment.Center, 0.25
	statusLabel = text(gui, "ToolNotice", "", UDim2.fromOffset(320, 36), UDim2.new(0.5, -160, 0.5, 110), PAPER, Enum.Font.GothamBold, 13)
	statusLabel.TextXAlignment, statusLabel.TextStrokeTransparency = Enum.TextXAlignment.Center, 0.25
	mobileAction = Instance.new("TextButton")
	mobileAction.Name = "UsePoliceTool"
	mobileAction.AnchorPoint, mobileAction.Position = Vector2.new(1, 0.5), UDim2.new(1, -20, 0.5, -25)
	mobileAction.Size = UDim2.fromOffset(80, 66)
	mobileAction.BackgroundColor3, mobileAction.BorderSizePixel = BLUE, 0
	mobileAction.Font, mobileAction.TextSize, mobileAction.TextColor3 = Enum.Font.GothamBold, 13, PAPER
	mobileAction.Visible, mobileAction.Parent = false, gui
	corner(mobileAction, 18)
	UIScaler.attach(mobileAction)
	mobileAction.Activated:Connect(function() if activeTool then activate(activeTool) end end)

	player:GetAttributeChangedSignal("PoliceDuty"):Connect(function()
		state.onDuty = player:GetAttribute("PoliceDuty") == true
		refreshBanner()
		if not state.onDuty then closePanel() end
	end)
	state.onDuty = player:GetAttribute("PoliceDuty") == true
	player.CharacterAdded:Connect(watchCharacter)
	if player.Character then watchCharacter(player.Character) end
	local backpack = player:WaitForChild("Backpack")
	backpack.ChildAdded:Connect(watchTool)
	for _, tool in ipairs(backpack:GetChildren()) do watchTool(tool) end
	Workspace.DescendantAdded:Connect(watchCuffPrompt)
	for _, item in ipairs(Workspace:GetDescendants()) do watchCuffPrompt(item) end
	RunService.Heartbeat:Connect(function()
		if crosshair.Visible then
			if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
				crosshair.Position = UDim2.fromScale(0.5, 0.5)
			else
				local mouse = UserInputService:GetMouseLocation()
				local inset = GuiService:GetGuiInset()
				crosshair.Position = UDim2.fromOffset(mouse.X - inset.X, mouse.Y - inset.Y)
			end
		end
		if os.clock() - lastPromptRefresh &gt; 0.2 then
			lastPromptRefresh = os.clock()
			refreshCuffPrompts()
			if statusLabel.Text ~= "" and os.clock() &gt; noticeUntil then statusLabel.Text = "" end
		end
	end)
	refreshBanner()
end

return PoliceController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000039"><Properties><string name="Name">PrisonController</string><ProtectedString name="Source">-- PrisonController (ModuleScript)
-- Apenas apresenta o estado enviado pelo servidor. Não solicita soltura nem decide fuga.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local UIScaler = require(script.Parent:WaitForChild("UIScaler"))

local PrisonController = {}
local player = Players.LocalPlayer
local initialized = false
local card, timerLabel, progressLabel, hintLabel
local deadline, cellOpensAt = 0, 0
local cellId, serverHint = "", ""
local detained, completed, totalSteps = false, 0, 3
local escapePrompts = {}
local escapeOrder = { EscapeHatchPrompt = 1, EscapePassagePrompt = 2, EscapeExitPrompt = 3 }

local function refreshPrompts()
	for prompt, index in pairs(escapePrompts) do
		if prompt.Parent then
			-- Somente a próxima interação fica visível neste cliente.
			-- O servidor continua validando estado, distância e ordem das etapas.
			prompt.Enabled = detained and Workspace:GetServerTimeNow() &gt;= cellOpensAt and index == completed + 1
		else
			escapePrompts[prompt] = nil
		end
	end
end

local function watchPrompt(item)
	if not item:IsA("ProximityPrompt") or not escapeOrder[item.Name] then
		return
	end
	local map = Workspace:FindFirstChild("Map")
	local locations = map and map:FindFirstChild("CivicLocations")
	if locations and item:IsDescendantOf(locations) then
		escapePrompts[item] = escapeOrder[item.Name]
		refreshPrompts()
	end
end

local function text(parent, name, value, position, size, color, font, textSize)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Position = position
	label.Size = size
	label.Font = font or Enum.Font.GothamMedium
	label.TextSize = textSize or 13
	label.TextColor3 = color
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextWrapped = true
	label.Text = value
	label.Parent = parent
	return label
end

local function updateTimer()
	local time = Workspace:GetServerTimeNow()
	local remaining = math.max(0, math.ceil(deadline - time))
	timerLabel.Text = remaining &gt; 0 and ("%02ds"):format(remaining) or "Liberando..."
	local lockRemaining = math.max(0, math.ceil(cellOpensAt - time))
	if lockRemaining &gt; 0 then
		progressLabel.Text = cellId ~= "" and ("CELA " .. cellId .. "  ·  ACESSO AO PÁTIO") or "ACESSO AO PÁTIO"
		hintLabel.Text = ("Porta fechada. Acesso ao pátio em %ds."):format(lockRemaining)
	else
		progressLabel.Text = ("ROTA DE FUGA  ·  %d/%d"):format(completed, totalSteps)
		hintLabel.Text = serverHint
	end
	refreshPrompts()
end

function PrisonController.handle(data)
	if not card or type(data) ~= "table" then
		return
	end
	detained = data.active == true
	completed = type(data.step) == "number" and math.max(0, math.floor(data.step)) or 0
	cellOpensAt = type(data.cellOpensAt) == "number" and data.cellOpensAt or 0
	cellId = type(data.cellId) == "string" and data.cellId or ""
	refreshPrompts()
	card.Visible = detained
	if not card.Visible then
		return
	end
	deadline = type(data.endsAt) == "number" and data.endsAt or 0
	local steps = type(data.steps) == "number" and math.max(0, math.floor(data.steps)) or 0
	totalSteps = math.max(completed, steps)
	local step = type(data.step) == "number" and math.clamp(math.floor(data.step), 0, steps) or 0
	progressLabel.Text = ("ROTA DE FUGA  ·  %d/%d"):format(step, steps)
	serverHint = type(data.hint) == "string" and data.hint or "Siga as placas da passagem de manutenção."
	hintLabel.Text = serverHint
	updateTimer()
end

local function readAttributes()
	PrisonController.handle({
		active = player:GetAttribute("Detained") == true,
		endsAt = player:GetAttribute("PrisonEndsAt"),
		step = player:GetAttribute("PrisonStep"),
		steps = player:GetAttribute("PrisonSteps"),
		hint = player:GetAttribute("PrisonHint"),
		cellId = player:GetAttribute("PrisonCell"),
		cellOpensAt = player:GetAttribute("PrisonCellOpensAt"),
	})
end

function PrisonController.init()
	if initialized then
		return
	end
	initialized = true

	local gui = Instance.new("ScreenGui")
	gui.Name = "PrisonUI"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 3
	gui.Parent = player:WaitForChild("PlayerGui")

	card = Instance.new("Frame")
	card.Name = "DetentionCard"
	card.AnchorPoint = Vector2.new(0.5, 1)
	card.Position = UDim2.new(0.5, 0, 1, -28)
	card.Size = UDim2.fromOffset(360, 146)
	card.BackgroundColor3 = Color3.fromRGB(20, 31, 46)
	card.BackgroundTransparency = 0.08
	card.BorderSizePixel = 0
	card.Visible = false
	card.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = card
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(96, 132, 162)
	stroke.Transparency = 0.35
	stroke.Thickness = 1
	stroke.Parent = card
	UIScaler.attach(card)

	text(card, "Title", "PRISÃO", UDim2.fromOffset(16, 10), UDim2.fromOffset(210, 25),
		Color3.fromRGB(235, 242, 248), Enum.Font.GothamBold, 17)
	timerLabel = text(card, "Time", "", UDim2.fromOffset(240, 10), UDim2.fromOffset(104, 25),
		Color3.fromRGB(255, 204, 118), Enum.Font.GothamBold, 18)
	timerLabel.TextXAlignment = Enum.TextXAlignment.Right
	text(card, "Explanation", "Aguarde a liberação ou siga a passagem de manutenção.",
		UDim2.fromOffset(16, 39), UDim2.fromOffset(328, 34), Color3.fromRGB(201, 215, 229))
	progressLabel = text(card, "Progress", "", UDim2.fromOffset(16, 81), UDim2.fromOffset(328, 18),
		Color3.fromRGB(255, 204, 118), Enum.Font.GothamBold, 11)
	hintLabel = text(card, "Hint", "", UDim2.fromOffset(16, 102), UDim2.fromOffset(328, 34),
		Color3.fromRGB(235, 242, 248), Enum.Font.GothamMedium, 13)

	for _, attribute in ipairs({ "Detained", "PrisonEndsAt", "PrisonStep", "PrisonSteps", "PrisonHint", "PrisonCell", "PrisonCellOpensAt" }) do
		player:GetAttributeChangedSignal(attribute):Connect(readAttributes)
	end
	Workspace.DescendantAdded:Connect(watchPrompt)
	for _, item in ipairs(Workspace:GetDescendants()) do
		watchPrompt(item)
	end
	readAttributes()
	task.spawn(function()
		while gui.Parent do
			if card.Visible then
				updateTimer()
			end
			task.wait(0.2)
		end
	end)
end

return PrisonController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000003A"><Properties><string name="Name">TaxiController</string><ProtectedString name="Source">-- Interface do taxista. Apenas apresenta o despacho e envia intenções ao servidor.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Workspace=game:GetService("Workspace")
local GameConfig=require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local UIScaler=require(script.Parent:WaitForChild("UIScaler"))
local MapController=require(script.Parent:WaitForChild("MapController"))
local TaxiController={}
local player=Players.LocalPlayer
local initialized=false
local request,card,title,route,instruction,actionButton,panel,panelTitle,panelInfo,panelAction
local state={onDuty=false,stage="idle",count=0,slots=2}
local prompts={}
local panelKind="duty"
local BLUE=Color3.fromRGB(24,76,147)
local YELLOW=Color3.fromRGB(245,195,49)
local INK=Color3.fromRGB(35,44,58)
local function corner(parent,radius)local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,radius);c.Parent=parent end
local function text(parent,value,pos,size,pixels,bold)
 local t=Instance.new("TextLabel");t.BackgroundTransparency=1;t.Position=pos;t.Size=size
 t.Font=bold and Enum.Font.GothamBold or Enum.Font.GothamMedium;t.TextSize=pixels or 14
 t.TextColor3=INK;t.TextXAlignment=Enum.TextXAlignment.Left;t.TextYAlignment=Enum.TextYAlignment.Center;t.TextWrapped=true;t.Text=value;t.Parent=parent;return t
end
local function button(parent,value,pos,size,callback)
 local b=Instance.new("TextButton");b.Text=value;b.Position=pos;b.Size=size;b.BackgroundColor3=BLUE
 b.BorderSizePixel=0;b.Font=Enum.Font.GothamBold;b.TextSize=13;b.TextColor3=Color3.new(1,1,1);b.Parent=parent;corner(b,8);b.Activated:Connect(callback);return b
end
local function send(action,payload)if request then request:FireServer(action,payload)end end
local function refreshPrompts()
 for prompt in pairs(prompts)do
  if not prompt.Parent then prompts[prompt]=nil
  else prompt.Enabled=state.onDuty and prompt:GetAttribute("TaxiOwnerUserId")==player.UserId
   and prompt:GetAttribute("TaxiTripId")==state.tripId and prompt:GetAttribute("TaxiStage")==state.stage end
 end
end
local function watchPrompt(item)
 if item:IsA("ProximityPrompt")and(item.Name=="TaxiPickupPrompt"or item.Name=="TaxiDropoffPrompt")then
  prompts[item]=true
  for _,attr in ipairs({"TaxiOwnerUserId","TaxiTripId","TaxiStage"})do item:GetAttributeChangedSignal(attr):Connect(refreshPrompts)end
  refreshPrompts()
 end
end
local function refreshPanel()
 if not panel or not panel.Visible then return end
 if panelKind=="dispatch"then
  panelTitle.Text="Despacho LXR Táxis"
  panelInfo.Text=state.stage=="idle" and "Retire seu uniforme e o táxi da empresa. O despacho enviará o ponto de embarque e o destino do passageiro.\n\nA corrida será paga ao chegar ao destino, com o táxi parado e você ao volante."
   or "Você já tem uma corrida em andamento. Confira o destino no mapa. Para receber outra, conclua ou cancele a atual."
  panelAction.Text=state.stage=="idle"and"Receber uma corrida"or"Cancelar corrida atual"
 else
  panelTitle.Text="LXR Táxis · Central de serviço"
  panelInfo.Text=("Vagas de taxista: %d/%d\n\nEntre em serviço, retire o uniforme no vestiário e o carro na garagem da LXR. Uniforme e táxi ficam vinculados a este emprego."):format(state.count,state.slots)
  panelAction.Text=state.onDuty and"Encerrar meu turno"or"Entrar como taxista"
 end
end
local function refresh()
 if not card then return end
 card.Visible=state.onDuty
 title.Text=("LXR TÁXIS · %d/%d em serviço"):format(state.count,state.slots)
 if state.stage=="pickup"then
  route.Text="BUSCAR · "..tostring(state.pickupName or"Passageiro")
  instruction.Text="Siga o marcador no mapa. Pare perto do passageiro e fique ao volante."
  actionButton.Visible=true;actionButton.Text="Embarcar passageiro"
 elseif state.stage=="dropoff"then
  route.Text="DESTINO · "..tostring(state.destinationName or"Destino da corrida")
  instruction.Text="Leve o passageiro com segurança. Pare no destino para concluir."
  actionButton.Visible=true;actionButton.Text="Concluir corrida"
 else
  route.Text="AGUARDANDO DESPACHO"
  instruction.Text="Retire seu uniforme e táxi na LXR. Busque uma corrida no balcão de despacho."
  actionButton.Visible=false
 end
 if state.onDuty then MapController.setTarget("LXR Táxis",typeof(state.target)=="Vector3"and state.target or nil)
 elseif state.hadDuty then MapController.setTarget(nil,nil)end
 state.hadDuty=state.onDuty
 refreshPrompts();refreshPanel()
end
function TaxiController.handle(kind,data)
 if type(data)~="table"then return end
 if kind=="TaxiState"then
  state.onDuty=data.onDuty==true;state.stage=type(data.stage)=="string"and data.stage or"idle"
  state.tripId=data.tripId;state.target=data.target;state.pickupName=data.pickupName;state.destinationName=data.destinationName
  if type(data.count)=="number"then state.count=math.max(0,math.floor(data.count))end
  if type(data.slots)=="number"then state.slots=math.max(1,math.floor(data.slots))end
  if not state.onDuty and panel then panel.Visible=false end
  refresh()
 elseif kind=="TaxiPanel"and panel then
  panelKind=data.panel=="dispatch"and"dispatch"or"duty"
  if type(data.onDuty)=="boolean"then state.onDuty=data.onDuty end
  if type(data.stage)=="string"then state.stage=data.stage end
  if type(data.count)=="number"then state.count=data.count end
  if type(data.slots)=="number"then state.slots=data.slots end
  panel.Visible=true;refreshPanel()
 end
end
local function readAttributes()
 state.onDuty=player:GetAttribute("TaxiDuty")==true
 state.stage=player:GetAttribute("TaxiStage")or"idle";state.tripId=player:GetAttribute("TaxiTripId")
 state.target=player:GetAttribute("TaxiTargetPosition");state.pickupName=player:GetAttribute("TaxiPickupName")
 state.destinationName=player:GetAttribute("TaxiDestinationName")
 refresh()
end
function TaxiController.init()
 if initialized then return end
 initialized=true
 request=ReplicatedStorage:WaitForChild("Remotes"):WaitForChild(GameConfig.Remotes.TaxiRequest or"TaxiRequest")
 local gui=Instance.new("ScreenGui");gui.Name="TaxiUI";gui.ResetOnSpawn=false;gui.DisplayOrder=6;gui.Parent=player:WaitForChild("PlayerGui")
 card=Instance.new("Frame");card.Name="LXRTripCard";card.Size=UDim2.fromOffset(350,154);card.Position=UDim2.fromOffset(16,112)
 card.BackgroundColor3=Color3.fromRGB(255,246,209);card.BorderSizePixel=0;card.Visible=false;card.Parent=gui;corner(card,12);UIScaler.attach(card)
 local stripe=Instance.new("Frame");stripe.Size=UDim2.new(1,0,0,7);stripe.BackgroundColor3=YELLOW;stripe.BorderSizePixel=0;stripe.Parent=card;corner(stripe,6)
 title=text(card,"",UDim2.fromOffset(12,14),UDim2.fromOffset(262,20),12,true);title.TextColor3=BLUE
 button(card,"Sair",UDim2.fromOffset(286,13),UDim2.fromOffset(52,25),function()send("Duty",false)end)
 route=text(card,"",UDim2.fromOffset(12,42),UDim2.fromOffset(326,29),14,true)
 instruction=text(card,"",UDim2.fromOffset(12,72),UDim2.fromOffset(326,37),12,false)
 actionButton=button(card,"",UDim2.fromOffset(12,115),UDim2.fromOffset(326,29),function()
  if state.stage=="pickup"then send("Pickup")elseif state.stage=="dropoff"then send("Dropoff")end
 end)
 panel=Instance.new("Frame");panel.Name="LXRDispatchPanel";panel.AnchorPoint=Vector2.new(0.5,0.5);panel.Position=UDim2.fromScale(0.5,0.5)
 panel.Size=UDim2.fromOffset(390,300);panel.BackgroundColor3=Color3.fromRGB(255,248,220);panel.BorderSizePixel=0;panel.Visible=false;panel.Parent=gui;corner(panel,14);UIScaler.attach(panel)
 panelTitle=text(panel,"",UDim2.fromOffset(18,14),UDim2.fromOffset(315,35),20,true);panelTitle.TextColor3=BLUE
 button(panel,"×",UDim2.new(1,-45,0,14),UDim2.fromOffset(30,30),function()panel.Visible=false end)
 panelInfo=text(panel,"",UDim2.fromOffset(18,58),UDim2.new(1,-36,0,159),14,false)
 panelAction=button(panel,"",UDim2.fromOffset(18,236),UDim2.new(1,-36,0,44),function()
  if panelKind=="dispatch"then send(state.stage=="idle"and"Accept"or"Cancel")else send("Duty",not state.onDuty)end
  panel.Visible=false
 end)
 for _,attr in ipairs({"TaxiDuty","TaxiStage","TaxiTargetPosition","TaxiPickupName","TaxiDestinationName","TaxiTripId"})do
  player:GetAttributeChangedSignal(attr):Connect(readAttributes)
 end
 Workspace.DescendantAdded:Connect(watchPrompt)
 for _,item in ipairs(Workspace:GetDescendants())do watchPrompt(item)end
 readAttributes()
end
return TaxiController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000003B"><Properties><string name="Name">TutorialController</string><ProtectedString name="Source">-- TutorialController (ModuleScript)
-- Caminho: StarterPlayer &gt; StarterPlayerScripts &gt; Controllers &gt; TutorialController
-- Tutorial curto e pulável: boas-vindas do Seu Bento, tour de câmera pelos
-- estabelecimentos e dicas finais. Também roda quando o jogador conversa com o Seu Bento.
-- O cliente só avisa o servidor no final ("Finish"); quem salva é o servidor.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local DialogConfig = require(Shared:WaitForChild("DialogConfig"))
local DialogController = require(script.Parent:WaitForChild("DialogController"))

local TutorialController = {}

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local tutorialRequest = remotes:WaitForChild(GameConfig.Remotes.TutorialRequest)
local GUIDE_NAME = GameConfig.Guide.Name
local running = false

-- Liga/desliga o movimento do jogador (para ele não sair andando durante o tour)
local function setControls(enabled)
	pcall(function()
		local playerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		local controls = playerModule:GetControls()
		if enabled then
			controls:Enable()
		else
			controls:Disable()
		end
	end)
end

local function findSign(placeName)
	local map = Workspace:FindFirstChild("Map")
	local jobs = map and map:FindFirstChild("JobLocations")
	local shop = jobs and jobs:FindFirstChild(placeName)
	return shop and shop:FindFirstChild("Sign")
end

local function moveCamera(camera, target)
	local tween = TweenService:Create(camera, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = target })
	tween:Play()
end

-- Devolve "skip" se o jogador pulou o tour
local function runTour()
	local camera = Workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	setControls(false)

	local result = "done"
	moveCamera(camera, CFrame.lookAt(Vector3.new(170, 170, 170), Vector3.new(0, 0, 0)))
	if DialogController.show(GUIDE_NAME, { DialogConfig.TourIntro }, { { id = "next", text = "Próximo" } }, true) == "skip" then
		result = "skip"
	end

	if result ~= "skip" then
		for _, stop in ipairs(DialogConfig.TourStops) do
			local sign = findSign(stop.place)
			if sign then
				-- A placa olha para a rua (lado -Z); a câmera fica na frente dela
				local camPos = (sign.CFrame * CFrame.new(0, 8, -45)).Position
				moveCamera(camera, CFrame.lookAt(camPos, sign.Position))
			end
			if DialogController.show(GUIDE_NAME, { stop.text }, { { id = "next", text = "Próximo" } }, true) == "skip" then
				result = "skip"
				break
			end
		end
	end

	-- Devolve a câmera para o personagem
	camera.CameraType = Enum.CameraType.Custom
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
	setControls(true)
	return result
end

-- firstTime = true quando o servidor mandou começar o tutorial obrigatório
function TutorialController.run(firstTime)
	if running or DialogController.isOpen() then
		return
	end
	running = true

	local lines = firstTime and DialogConfig.Welcome or DialogConfig.GuideTalk
	local options = { { id = "tour", text = "Ver a cidade" } }
	if not firstTime then
		table.insert(options, { id = "jobs", text = "Empregos" })
	end
	table.insert(options, { id = "no", text = firstTime and "Agora não" or "Tchau" })
	local choice = DialogController.show(GUIDE_NAME, lines, options, firstTime)

	if choice == "jobs" then
		DialogController.show(GUIDE_NAME, DialogConfig.JobsInfo, { { id = "ok", text = "Entendi!" } }, false)
	elseif choice == "tour" then
		runTour()
	end
	if choice ~= "skip" and (firstTime or choice == "tour") then
		DialogController.show(GUIDE_NAME, DialogConfig.Final, { { id = "ok", text = "Vamos lá!" } }, false)
	end

	if firstTime then
		tutorialRequest:FireServer("Finish") -- concluiu ou pulou: não repete
	end
	running = false
end

return TutorialController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000003C"><Properties><string name="Name">UIScaler</string><ProtectedString name="Source">-- UIScaler (ModuleScript)
-- Caminho: StarterPlayer &gt; StarterPlayerScripts &gt; Controllers &gt; UIScaler
-- Deixa a interface menor em telas pequenas (celular) e normal no PC.
-- Uso: UIScaler.attach(frame)  -- o frame encolhe em volta do seu AnchorPoint.

local Workspace = game:GetService("Workspace")

local UIScaler = {}

local REFERENCE = 720 -- altura de tela (px) em que a escala é 1
local MIN_SCALE = 0.6
local scales = {}
local listeners = {}

local function currentScale()
	local camera = Workspace.CurrentCamera
	local size = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local shortest = math.min(size.X, size.Y)
	return math.clamp(shortest / REFERENCE, MIN_SCALE, 1)
end

local function refresh()
	local s = currentScale()
	for _, uiScale in ipairs(scales) do
		uiScale.Scale = s
	end
	for _, fn in ipairs(listeners) do
		fn(s)
	end
end

-- Chama fn(escala) agora e sempre que a tela mudar de tamanho
function UIScaler.onChanged(fn)
	table.insert(listeners, fn)
	fn(currentScale())
end

function UIScaler.attach(guiObject)
	local uiScale = Instance.new("UIScale")
	uiScale.Scale = currentScale()
	uiScale.Parent = guiObject
	table.insert(scales, uiScale)
	return uiScale
end

function UIScaler.get()
	return currentScale()
end

local function watchCamera()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(refresh)
	end
	refresh()
end
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

return UIScaler
</ProtectedString></Properties></Item></Item></Item></Item></roblox>